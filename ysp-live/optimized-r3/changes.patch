+def decode_proxy_ts_url(token: str, allow_engine=False) -> str:
+    try:
+        expiry, payload, signature = token.split('.')
+        value = f'{expiry}.{payload}'
+        expected = _hmac.new(_PROXY_SECRET, value.encode(), hashlib.sha256).hexdigest()
+        if not _hmac.compare_digest(signature, expected):
+            raise ValueError('invalid signature')
+        remaining = int(expiry) - time.time()
+        if remaining < 0 or remaining > PROXY_TOKEN_TTL:
+            raise ValueError('expired token')
