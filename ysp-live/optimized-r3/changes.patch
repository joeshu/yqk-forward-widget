+    def _proxy_segment(self, target, head_only=False, engine=False):
+        if not download_slots.acquire(blocking=False):
+            self._send(503, 'download capacity reached\n', head_only=head_only, extra_headers={'Retry-After': '1'})
+            return
+        range_value = self.headers.get('Range')
+        key = ('engine:' if engine else 'device:') + target
+        flight_key = (key, range_value, head_only)
+        owner = False
+        sent = False
+        try:
+            with _segment_flight_lock:
+                event = _segment_flights.get(flight_key)
+                if event is None:
+                    event = threading.Event()
+                    _segment_flights[flight_key] = event
+                    owner = True
+            if not owner:
+                if not event.wait(20):
+                    self._send(503, 'segment download pending\n', head_only=head_only)
+                    return
+            cached = global_ts_cache.get(key) if not range_value else None
+            if cached:
+                data, headers = cached
+                self._send(200, data, headers.get('Content-Type', 'video/mp2t'), head_only,
+                           {'X-Cache': 'HIT-RAM', 'Cache-Control': 'public, max-age=180'})
+                return
+            # Followers retry on the next player request if the leader failed or
+            # buffering is disabled, rather than launching duplicate downloads.
+            if not owner:
+                self._send(503, 'segment not cached; retry\n', head_only=head_only, extra_headers={'Retry-After': '1'})
+                return
+            playback = {'User-Agent': 'qqlive', 'Referer': 'https://live.cctv.cn/'} if engine else ({} if resolver is None else resolver.playback_headers_for_ts_url(target))
+            headers = _playback_request_headers(playback)
+            if range_value:
+                headers['Range'] = header_value_clean(range_value)
+            with open_proxy_upstream(target, headers, 'HEAD' if head_only else 'GET', allow_engine=engine) as upstream:
+                length = upstream.getheader('Content-Length')
+                if length and int(length) > MAX_SEGMENT_BYTES:
+                    raise YsptpError('upstream segment too large')
+                self.send_response(upstream.status)
+                for name in ('Content-Type', 'Content-Length', 'Content-Range', 'Accept-Ranges'):
+                    value = upstream.getheader(name)
+                    if value is not None:
+                        self.send_header(name, value)
+                self.send_header('X-Cache', 'MISS-UPSTREAM')
+                self.send_header('Access-Control-Allow-Origin', '*')
+                self.send_header('Cache-Control', 'public, max-age=180' if upstream.status == 200 else 'no-store')
+                self.end_headers()
+                sent = True
+                if head_only:
+                    return
+                cache_limit = min(MAX_SEGMENT_BYTES, global_ts_cache.max_bytes)
+                buffer = bytearray() if upstream.status == 200 and not range_value and cache_limit > 0 else None
+                total = 0
+                deadline = time.monotonic() + 45
+                while True:
+                    if time.monotonic() > deadline:
+                        raise YsptpError("segment transfer deadline exceeded")
+                    chunk = upstream.read(65536)
+                    if not chunk:
+                        break
+                    total += len(chunk)
+                    if total > MAX_SEGMENT_BYTES:
+                        raise YsptpError('upstream segment too large')
+                    self.wfile.write(chunk)
+                    if buffer is not None:
+                        if total <= cache_limit:
+                            buffer.extend(chunk)
+                        else:
+                            buffer = None
+                if buffer and (length is None or total == int(length)):
+                    global_ts_cache.set(key, bytes(buffer), {'Content-Type': upstream.getheader('Content-Type', 'video/mp2t')})
+        except (BrokenPipeError, ConnectionResetError):
+            pass  # Closing the context cancels the upstream download.
+        except Exception as exc:
+            if not sent:
+                self._send(502, 'upstream segment unavailable\n', head_only=head_only)
+            log(f'[proxy] {type(exc).__name__}: segment transfer failed', min_interval=10)
+        finally:
+            self.close_connection = True
+            if owner:
+                with _segment_flight_lock:
+                    _segment_flights.pop(flight_key, None)
+                    event.set()
+            download_slots.release()
