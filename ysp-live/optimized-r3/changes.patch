+def encode_proxy_ts_url(url: str) -> str:
+    payload = base64.urlsafe_b64encode(url.encode()).decode().rstrip('=')
+    value = f'{int(time.time()) + PROXY_TOKEN_TTL}.{payload}'
+    signature = _hmac.new(_PROXY_SECRET, value.encode(), hashlib.sha256).hexdigest()
+    return f'{value}.{signature}'
