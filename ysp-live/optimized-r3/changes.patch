+def gateway_playlist_urls(playlist, host, proto='http', base_url=None):
+    scheme = proto if proto in ('http', 'https') else 'http'
+    prefix = f'{scheme}://{host}/engine_proxy?token='
+    def wrap(value):
+        target = urllib.parse.urljoin(base_url, value) if base_url else value
+        validate_proxy_target(target, allow_engine=True)
+        return prefix + encode_proxy_ts_url(target)
+    result = []
+    for line in playlist.splitlines():
+        if line.startswith('#'):
+            result.append(re.sub(r'URI="([^"]+)"', lambda match: 'URI="' + wrap(match.group(1)) + '"', line))
+        elif line.strip():
+            result.append(wrap(line.strip()))
+        else:
+            result.append(line)
+    return '\n'.join(result) + '\n'
+
+def fetch_upstream_engine_playlist(canonical: str, host: str, proto: str = 'http'):
+    target = f'http://127.0.0.1:{engine_port}/live/{canonical}.m3u8'
+    try:
+        request = urllib.request.Request(target, headers={'User-Agent': UA})
+        with urllib.request.urlopen(request, timeout=12) as response:
+            text = response.read(2 * 1024 * 1024).decode('utf-8', errors='replace')
+            if response.status == 200 and text.startswith('#EXTM3U'):
+                return gateway_playlist_urls(text, host, proto, target)
+    except (OSError, ValueError, http.client.HTTPException, YsptpError):
+        pass
+    return None
