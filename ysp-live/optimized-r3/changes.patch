+def _is_loopback_host(host):
+    host = (host or '').strip('[]').lower()
+    if host == 'localhost':
+        return True
+    try:
+        return ipaddress.ip_address(host).is_loopback
+    except ValueError:
+        return False
+
+def configured_proxy(target):
+    parsed = urllib.parse.urlsplit(target)
+    if _is_loopback_host(parsed.hostname) or os.environ.get('YSP_DIRECT') == '1':
+        return None
+    if urllib.request.proxy_bypass(parsed.netloc):
+        return None
+    value = urllib.request.getproxies().get(parsed.scheme)
+    if not value:
+        return None
+    proxy = urllib.parse.urlsplit(value if '://' in value else 'http://' + value)
+    if proxy.scheme != 'http' or not proxy.hostname or proxy.query or proxy.fragment or proxy.path not in ('', '/'):
+        raise ValueError('Use an HTTP forward proxy (HTTP CONNECT for HTTPS upstreams)')
+    # Parse ports here so invalid configuration fails without leaking credentials.
+    _ = proxy.port
+    return proxy
+
+class EnvironmentProxyHandler(urllib.request.ProxyHandler):
+    def __init__(self):
+        super().__init__(urllib.request.getproxies())
+    def proxy_open(self, req, proxy, type):
+        chosen = configured_proxy(req.full_url)
+        if chosen is None:
+            return None
+        return super().proxy_open(req, chosen.geturl(), type)
+
