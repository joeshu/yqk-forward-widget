;; Host ABI memory adapter, not vendor SDK code. Uses the emulator's public C API.
(module
 (import "env" "memory" (memory 0))
 (import "env" "read" (func $read (param i32 i64 i32 i64) (result i32)))
 (import "env" "write" (func $write (param i32 i64 i32 i64) (result i32)))
 (import "env" "reg_read_batch" (func $regs (param i32 i32 i32 i32) (result i32)))
 (import "env" "reg_write" (func $regwrite (param i32 i32 i32) (result i32)))
 (import "env" "stop" (func $stop (param i32) (result i32)))
 (import "env" "malloc" (func $malloc (param i32) (result i32)))
 (import "env" "free" (func $free (param i32)))
 (global $control (mut i32) (i32.const 0))
 (global $scratch (mut i32) (i32.const 0))
 (global $capacity (mut i32) (i32.const 0))
 (global $pc (mut i32) (i32.const 0))
 (global $error (mut i32) (i32.const 0))
 (global $copies (mut i32) (i32.const 0))
 (global $fills (mut i32) (i32.const 0))
 (func $copy (export "copy") (param $handle i32) (param $dst i64) (param $src i64) (param $size i32) (param $scratch i32) (result i32)
  (local $error i32)
  (if (i32.eqz (local.get $size)) (then (return (i32.const 0))))
  (local.set $error (call $read (local.get $handle) (local.get $src) (local.get $scratch) (i64.extend_i32_u (local.get $size))))
  (if (local.get $error) (then (return (local.get $error))))
  (call $write (local.get $handle) (local.get $dst) (local.get $scratch) (i64.extend_i32_u (local.get $size))))
 (func $fill (export "fill") (param $handle i32) (param $dst i64) (param $value i32) (param $size i32) (param $scratch i32) (result i32)
  (if (i32.eqz (local.get $size)) (then (return (i32.const 0))))
  (memory.fill (local.get $scratch) (local.get $value) (local.get $size))
  (call $write (local.get $handle) (local.get $dst) (local.get $scratch) (i64.extend_i32_u (local.get $size))))


 (func (export "init") (param $x0 i32) (param $x1 i32) (param $x2 i32) (param $lr i32) (param $pcid i32) (result i32)
  (global.set $control (call $malloc (i32.const 64)))
  (if (i32.eqz (global.get $control)) (then (return (i32.const 1))))
  (global.set $pc (local.get $pcid))
  (i32.store (global.get $control) (local.get $x0))
  (i32.store offset=4 (global.get $control) (local.get $x1))
  (i32.store offset=8 (global.get $control) (local.get $x2))
  (i32.store offset=12 (global.get $control) (local.get $lr))
  (i32.store offset=16 (global.get $control) (i32.add (global.get $control) (i32.const 32)))
  (i32.store offset=20 (global.get $control) (i32.add (global.get $control) (i32.const 40)))
  (i32.store offset=24 (global.get $control) (i32.add (global.get $control) (i32.const 48)))
  (i32.store offset=28 (global.get $control) (i32.add (global.get $control) (i32.const 56)))
  (i32.const 0))
 (func $fail (param $handle i32) (param $error i32)
  (global.set $error (local.get $error)) (drop (call $stop (local.get $handle))))
 ;; Unicorn code-hook ABI: engine pointer, guest PC, instruction size, operation kind.
 (func (export "hook") (param $handle i32) (param $address i64) (param $size i32) (param $kind i32)
  (local $error i32) (local $n i32) (local $pointer i32)
  (local.set $error (call $regs (local.get $handle) (global.get $control) (i32.add (global.get $control) (i32.const 16)) (i32.const 4)))
  (if (local.get $error) (then (call $fail (local.get $handle) (local.get $error)) (return)))
  (if (i64.gt_u (i64.load offset=48 (global.get $control)) (i64.const 16777216))
   (then (call $fail (local.get $handle) (i32.const -1)) (return)))
  (local.set $n (i32.wrap_i64 (i64.load offset=48 (global.get $control))))
  (if (i32.gt_u (local.get $n) (global.get $capacity)) (then
   (local.set $pointer (call $malloc (local.get $n)))
   (if (i32.eqz (local.get $pointer)) (then (call $fail (local.get $handle) (i32.const -2)) (return)))
   (if (global.get $scratch) (then (call $free (global.get $scratch))))
   (global.set $scratch (local.get $pointer)) (global.set $capacity (local.get $n))))
  (if (local.get $kind) (then
    (global.set $fills (i32.add (global.get $fills) (i32.const 1)))
    (local.set $error (call $fill (local.get $handle) (i64.load offset=32 (global.get $control)) (i32.wrap_i64 (i64.load offset=40 (global.get $control))) (local.get $n) (global.get $scratch))))
   (else
    (global.set $copies (i32.add (global.get $copies) (i32.const 1)))
    (local.set $error (call $copy (local.get $handle) (i64.load offset=32 (global.get $control)) (i64.load offset=40 (global.get $control)) (local.get $n) (global.get $scratch)))))
  (if (local.get $error) (then (call $fail (local.get $handle) (local.get $error)) (return)))
  (local.set $error (call $regwrite (local.get $handle) (global.get $pc) (i32.add (global.get $control) (i32.const 56))))
  (if (local.get $error) (then (call $fail (local.get $handle) (local.get $error)))))
 (func (export "clear_error") (global.set $error (i32.const 0)))
 (func (export "last_error") (result i32) (global.get $error))
 (func (export "copies") (result i32) (global.get $copies))
 (func (export "fills") (result i32) (global.get $fills))
 (func (export "close")
  (if (global.get $scratch) (then (call $free (global.get $scratch))))
  (if (global.get $control) (then (call $free (global.get $control))))
  (global.set $scratch (i32.const 0)) (global.set $control (i32.const 0)) (global.set $capacity (i32.const 0)))
)
