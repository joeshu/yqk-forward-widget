vpic.com/apple3g/www/upload/image/20220504/1651624737519059713.jpg\",\"image2\":\"https://p1.img.cctvpic.com/apple3g/www/upload/image/20220504/1651624742216033497.jpg\",\"isCourse\":0,\"isSubed\":0,\"keywords\":\"五四青年节,马克思主义,自由恋爱,白话文\",\"labelId\":\"18aiYZ3m0926\",\"likeCount\":0,\"mediaId\":\"18ryeuIb0926\",\"mediaImg\":\"https://p1.img.cctvpic.com/apple3g/www/upload/image/20260828/1787896006290088494.jpg\",\"mediaName\":\"比划\",\"pubTime\":1651624744220,\"pv\":\"\",\"sc\":\"\",\"seqId\":1651624744220,\"seqStrId\":\"1651624744220\",\"size\":\"16:9\",\"source\":0,\"subTitle\":\"\",\"title\":\"我们为什么要纪念五四\",\"vbrief\":\"白话文、自由恋爱和马克思主义，你熟悉的这三样都跟“五四”有关系。每年五月，快到假期余额不足的时候都会赶上“青年节”，它到底是什么来头？五四青年节纪念的是谁？纪念的又是什么？\",\"vcount\":0,\"vduration\":202,\"vid\":\"673d73777393446a8b477afa9629011b\",\"videoType\":0,\"vip_flag\":0,\"webUrl\":\"https://v.cctv.com/reping/bh/index.shtml\",\"wwwUrl\":\"https://v.cctv.com/2022/05/04/VIDEM1r53QK3GSA3TsfM6i1R220504.shtml\"},{\"allowAd\":0,\"allowComment\":0,\"allowShare\":0,\"cateId\":\"18AzYZNf0926\",\"cateName\":\"热评\",\"cvid\":\"VIDEUcYnykYNEUXPa2OmRpUA220501\",\"episodes\":0,\"fc\":\"原创\",\"feedType\":\"3\",\"guid\":\"c4d41238f7c24ecb8928250b7795c612\",\"image1\":\"https://p1.img.cctvpic.com/apple3g/www/upload/image/20220501/1651363764337031929.jpg\",\"image2\":\"https://p2.img.cctvpic.com/apple3g/www/upload/image/20220501/1651363768420089674.jpg\",\"isCourse\":0,\"isSubed\":0,\"keywords\":\"小行星防御系统,太空,航天\",\"labelId\":\"18aiYZ3m0926\",\"likeCount\":0,\"mediaId\":\"18ryeuIb0926\",\"mediaImg\":\"https://p1.img.cctvpic.com/apple3g/www/upload/image/20260828/1787896006290088494.jpg\",\"mediaName\":\"比划\",\"pubTime\":1651363772975,\"pv\":\"\",\"sc\":\"\",\"seqId\":1651363772975,\"seqStrId\":\"1651363772975\",\"size\":\"16:9\",\"source\":0,\"subTitle\":\"\",\"title\":\"小行星防御系统要干啥 如何发现冲地球而来的小行星\",\"vbrief\":\"有一种世界末日遐想最能激发人们的想象力——小行星撞击地球。前不久，国家航天局称将组建近地小行星防御系统，假如发现一颗小行星正向我们飞来，我们该如何应对？是炸开？还是推走？美国星链卫星会阻碍我们观测小行星吗？\",\"vcount\":0,\"vduration\":274,\"vid\":\"3a868183a8db4c70b89f83071fcce466\",\"videoType\":0,\"vip_flag\":0,\"webUrl\":\"https://v.cctv.com/reping/bh/index.shtml\",\"wwwUrl\":\"https://v.cctv.com/2022/05/01/VIDEUcYnykYNEUXPa2OmRpUA220501.shtml\"},{\"allowAd\":0,\"allowComment\":0,\"allowShare\":0,\"cateId\":\"18AzYZNf0926\",\"cateName\":\"热评\",\"cvid\":\"VIDE7A4s2ZHQlxMcsBk6YiD3220426\",\"episodes\":0,\"fc\":\"原创\",\"feedType\":\"3\",\"guid\":\"d043588dd80e4271a6805418251d6361\",\"image1\":\"https://p3.img.cctvpic.com/apple3g/www/upload/image/20220426/1650948766360044627.jpg\",\"image2\":\"https://p2.img.cctvpic.com/apple3g/www/upload/image/20220426/1650948769615060046.jpg\",\"isCourse\":0,\"isSubed\":0,\"keywords\":\"刘畊宏,全民健身\",\"labelId\":\"18aiYZ3m0926\",\"likeCount\":0,\"mediaId\":\"18ryeuIb0926\",\"mediaImg\":\"https://p1.img.cctvpic.com/apple3g/www/upload/image/20260828/1787896006290088494.jpg\",\"mediaName\":\"比划\",\"pubTime\":1650948814129,\"pv\":\"\",\"sc\":\"\",\"seqId\":1650948814129,\"seqStrId\":\"1650948814129\",\"size\":\"16:9\",\"source\":0,\"subTitle\":\"\",\"title\":\"云健身火了 为什么人人都在跳刘畊宏\",\"vbrief\":\"本草纲目前奏一出，全身脂肪抱头痛哭，一小时的铭心刻骨，居然只是热身结束？！据有关（比划猫）专家介绍，刘畊宏健身操是继云办公、云上课之后兴起的又一全民云活动，是继“燃烧我的卡路里”后第二个现象级健身热潮。\",\"vcount\":0,\"vduration\":303,\"vid\":\"0ebc3c562dee4f169af20f673f733ca8\",\"videoType\":0,\"vip_flag\":0,\"webUrl\":\"https://v.cctv.com/reping/bh/index.shtml\",\"wwwUrl\":\"https://v.cctv.com/2022/04/26/VIDE7A4s2ZHQlxMcsBk6YiD3220426.shtml\"},{\"allowAd\":0,\"allowComment\":0,\"allowShare\":0,\"cateId\":\"18AzYZNf0926\",\"cateName\":\"热评\",\"cvid\":\"VIDE20L7qjSKgmsob8wFIzSG220423\",\"episodes\":0,\"fc\":\"原创\",\"feedType\":\"3\",\"guid\":\"55c2d49ec4134162a9c19a1960a91c73\",\"image1\":\"https://p3.img.cctvpic.com/apple3g/www/upload/image/20220423/1650699856162049740.jpg\",\"image2\":\"https://p2.img.cctvpic.com/apple3g/www/upload/image/20220423/1650699861473022954.jpg\",\"isCourse\":0,\"isSubed\":0,\"keywords\":\"鲸鱼,搁浅,鲸爆\",\"labelId\":\"18aiYZ3m0926\",\"likeCount\":0,\"mediaId\":\"18ryeuIb0926\",\"mediaImg\":\"https://p1.img.cctvpic.com/apple3g/www/upload/image/20260828/1787896006290088494.jpg\",\"mediaName\":\"比划\",\"pubTime\":1650699890285,\"pv\":\"\",\"sc\":\"\",\"seqId\":1650699890285,\"seqStrId\":\"1650699890285\",\"size\":\"16:9\",\"source\":0,\"subTitle\":\"\",\"title\":\"拯救搁浅鲸鱼有多难 鲸爆威力有多大\",\"vbrief\":\"最近，一条搁浅的巨型抹香鲸成功回归大海，成为了少有的救援成功案例。为何搁浅鲸鱼的救助这么难，茫茫大海都不迷路，鲸鱼为什么会频繁游往海滩？解救鲸鱼会遭遇哪些极端情况？鲸爆的威力有多大？\",\"vcount\":0,\"vduration\":244,\"vid\":\"02781b07b3554645919eaac6ced9654a\",\"videoType\":0,\"vip_flag\":0,\"webUrl\":\"https://v.cctv.com/reping/bh/index.shtml\",\"wwwUrl\":\"https://v.cctv.com/2022/04/23/VIDE20L7qjSKgmsob8wFIzSG220423.shtml\"},{\"allowAd\":0,\"allowComment\":0,\"allowShare\":0,\"cateId\":\"18AzYZNf0926\",\"cateName\":\"热评\",\"cvid\":\"VIDEAbizBRki0cqs0eQrm7vx220416\",\"episodes\":0,\"fc\":\"原创\",\"feedType\":\"3\",\"guid\":\"ce37eb43fa3e4549875d5d785ddf656e\",\"image1\":\"https://p3.img.cctvpic.com/apple3g/www/upload/image/20220416/1650065369953000101.jpg\",\"image2\":\"https://p3.img.cctvpic.com/apple3g/www/upload/image/20220416/1650065372564053801.jpg\",\"isCourse\":0,\"isSubed\":0,\"keywords\":\"天和一号核心舱,神舟十三号\",\"labelId\":\"18aiYZ3m0926\",\"likeCount\":0,\"mediaId\":\"18ryeuIb0926\",\"mediaImg\":\"https://p1.img.cctvpic.com/apple3g/www/upload/image/20260828/1787896006290088494.jpg\",\"mediaName\":\"比划\",\"pubTime\":1650065394107,\"pv\":\"\",\"sc\":\"\",\"seqId\":1650065394107,\"seqStrId\":\"1650065394107\",\"size\":\"16:9\",\"source\":0,\"subTitle\":\"\",\"title\":\"嗨！天和向你发出了一封转正申请书\",\"vbrief\":\"天和：在线等转正，挺急的！亲们，神舟十三回地球的家，我也要面对评估啦，希望早日把“试验”2个字摘掉，从“天和一号试验核心舱”在轨转正为“天和一号核心舱”，开启咱天宫空间站建造第二阶段——热火朝天的“在轨建造”！和问天、梦天牵手，等神舟十四、神舟十五会师，到时候，我们的长度能超过国际空间站任何舱段！\",\"vcount\":0,\"vduration\":212,\"vid\":\"879393a417934179b2e8d98c3721529f\",\"videoType\":0,\"vip_flag\":0,\"webUrl\":\"https://v.cctv.com/reping/bh/index.shtml\",\"wwwUrl\":\"https://v.cctv.com/2022/04/16/VIDEAbizBRki0cqs0eQrm7vx220416.shtml\"},{\"allowAd\":0,\"allowComment\":