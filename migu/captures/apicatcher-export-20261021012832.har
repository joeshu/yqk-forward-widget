            "size" : 18833,
            "text" : "/*搜索*/\r\nvar type = 'video';\t\t\r\nvar soucuoci=$('.headerSearch_ind01 .box ul').find('li').eq(0).html();\r\nString.prototype.hreplaceAll  = function(s1,s2){\r\n\treturn this.replace(new RegExp(s1,'g'),s2);\r\n}\r\nvar times = setInterval(function(){\r\n\t$('.headerSearch_ind01 .box ul').animate({'top':'-0.58rem'},function(){\r\n\t\t$('.headerSearch_ind01 .box ul').find('li').eq(0).appendTo($(this));\r\n\t\t$('.headerSearch_ind01 .box ul').css('top','0');\r\n\t\tsoucuoci=$(this).find('li').eq(0).html();\r\n\t})\r\n},3000);\r\nfunction blank_submit(){\r\n\twindow.location.href = \"https://tv.cctv.com/search/m/index.shtml\";\r\n}\r\nfunction searchForm_submit(){\r\n\twindow.goldlog.record(\"/spec.1.2\", \"\", \"snsScene=tvsearch&product=h5&navname=节目官网首页\", \"\")\r\n\twindow.location.href = \"//search.cctv.com/m/search.php?type=\"+type+\"&qtext=\"+soucuoci;\r\n}\r\n$('.headerSearch_ind01 .home').click(function(){\r\n\twindow.location.href = window.location.href;\r\n})\r\n/*顶通导航*/\r\nvar swiper = new Swiper('#wrapper03', {\r\n\tslidesPerView: \"auto\",\r\n\tinitialSlide :$('#wrapper03 .swiper-slide.cur').index()-1\r\n});\r\n$(window).resize(function() {\r\n\tsetTimeout(function(){\r\n\t\tswiper.update();\r\n\t},300);\r\n});\r\nvar zhezhao=true;\r\n/* 顶通固定*/\r\nfunction navtop(){\r\n\tvar headerscrollTop = document.body.scrollTop || document.documentElement.scrollTop;\r\n\tvar headTop=$(\".header_nav\").height();\r\n\tif(zhezhao){\r\n\t\theaderscrollTop=scrollTop;\r\n\t}\r\n\tif(headerscrollTop>headTop){\r\n\t\t$(\".header_nav\").addClass(\"fixednav\");\r\n\t\t$('.header_vspace').show();\r\n\t\t$(\"#navvspace\").css(\"display\",\"block\");\r\n\t}else{\r\n\t\t$(\".header_nav\").removeClass(\"fixednav\");\r\n\t\t$('.header_vspace').hide();\r\n\t}\r\n};\r\n\r\n/*轮播图*/\r\nif($('#lunbo_01 img').attr('src') != undefined){\r\n\t$('.xuqiu19629_lunbo .swiper-container .swiper-wrapper .swiper-slide').each(function(i){\r\n\t\tif(i==0){\r\n\t\t\t\r\n\t\t}else{\r\n\t\t\t$(this).find('.swiper-pagination-current').html(Number($(this).find('.swiper-pagination-current').html())+1);\r\n\t\t}\r\n\t\t\r\n\t})\r\n}else{}\r\n\r\nfunction lunbobegin(){\r\n\tvar lunboLength=$(\"#xuqiu19629_lunbo .swiper-container .swiper-wrapper .swiper-slide\").length;\r\n\tvar swiperlunbo = new Swiper('#xuqiu19629_lunbo .swiper-container',{\r\n\t\tautoplay: {\r\n\t\t\tdelay: 3000,\r\n\t\t\tdisableOnInteraction: false,\r\n\t\t},\r\n\t\tspeed:1000,\r\n\t\tinitialSlide:0,//默认显示第二个图片\r\n\t\tautoplayDisableOnInteraction : false,\r\n\t\tloop:true,\r\n\t\tcenteredSlides : true,\r\n\t\tslidesPerView:\"auto\",\r\n\t\tloopedSlides:lunboLength,//li的个数\r\n\t\tspaceBetween:0,\r\n\t\twatchSlidesVisibility:true,\r\n\t\tlazy: {\r\n\t\t\tloadPrevNext: true,\r\n\t\t\tloadOnTransitionStart: true\r\n\t\t},\r\n\t\ton:{\r\n\t\t\tinit:function(swiper){\r\n\t\t\t\t$(\"#xuqiu19629_lunbo .swiper-pagination-total\").text(lunboLength);\r\n\t\t\t\t// this.slides[2].className=\"swiper-slide swiper-slide-active\";//第一次打开不要动画\r\n\t\t\t},\r\n\t\t\ttransitionStart: function(swiper,event){\r\n\t\t\t\tvar colors = $('.xuqiu19629_lunbo .swiper-container .swiper-wrapper .swiper-slide').eq(this.realIndex).attr('color');\r\n\t\t\t\t$('.header_bg').css('background','linear-gradient('+colors+',transparent)')\r\n\t\t\t},\r\n\t\t}\r\n\t});\r\n}\r\n\r\n/*开始广告*/\r\n//window.history.pushState(\"\", \"\", window.location.href); \r\nvar scrollTop;\r\nvar tongb = true;\r\n/*window.addEventListener(\"popstate\", function () {//监听前进后退\r\n\t$(\".tonglan_guanggao\").hide();\r\n\t$(\".tonglan_guanggao\").remove();\r\n\ttongb = false;\r\n})*/\r\nfunction blindScroll(){\r\n\t$(window).scroll(()=>{\r\n\t\tnavtop();\r\n\t})\r\n\t$(\".page_wrap\").bind(\"touchmove\",function(e){\r\n\t\tnavtop();\r\n\t});\r\n}\r\nsetTimeout(function(){\r\n  if(tongb){\r\n\tif($('.tonglan_guanggao').attr(\"href\")){\r\n\t\t$('.tonglan_guanggao').show();\r\n\t\tscrollTop = document.body.scrollTop || document.documentElement.scrollTop;\r\n\t\tdocument.body.style.cssText += 'position:fixed;width:100%;top:-' + scrollTop + 'px;';\r\n\t\tnavtop();\r\n\t}else{\r\n\t\tzhezhao=false;\r\n\t\tnavtop();\r\n\t\tblindScroll();\r\n\t}\r\n  }else{\r\n  \t\tzhezhao=false;\r\n\t\tnavtop();\r\n\t\tblindScroll();\r\n  }\r\n},300)\r\n\r\n$('.tonglan_guanggao .boxs .close').click(function(){\r\n  $('.tonglan_guanggao').hide();\r\n  var body = document.body;\r\n  body.style.position = '';\r\n  var top = body.style.top;\r\n  document.body.scrollTop = document.documentElement.scrollTop = -parseInt(top);\r\n  body.style.top = '';\r\n  zhezhao=false;\r\n  blindScroll();\r\n})\r\n\r\nfunction createswiper(cla){\r\n\tvar swiper = new Swiper(cla, {\r\n\t\tslidesPerView: 'auto',\r\n\t\tpaginationClickable: true,\r\n\t\tfreeMode:true,\r\n\t\tfreeModeMomentumBounce:false,\r\n\t\tfreeModeMomentumBounceRatio:0,\r\n\t\tfreeModeMomentumVelocityRatio:0.5,\r\n\t\tlazy: {\r\n\t\t\tloadPrevNext: true,\r\n\t\t\tloadPrevNextAmount: 4,\r\n\t\t},\r\n\t});\r\n\treturn swiper;\r\n}\r\n\r\n/*推荐*/ \r\ncreateswiper('.xuqiu19629_ind01 .swiper-container');\r\n\r\n/*正在热播*/ \r\n\r\ncreateswiper('.xuqiu19629_con01 .swiper-container');\r\n/*今日热门*/\r\nvar con02_index=0;\r\n$('.xuqiu19629_con02 .change').click(function(){\r\n\tvar btnHuanyihuan=$(this);\r\n\tvar isClick=$(this).find(\"i\").attr(\"data-click\");\r\n\tif(isClick){\r\n\t\tbtnHuanyihuan.find(\"i\").attr(\"data-click\",'false');\r\n\t\tbtnHuanyihuan.find(\"i\").addClass(\"active\");//.stop(true,true)\r\n\t    setTimeout(function(){\r\n\t        btnHuanyihuan.find(\"i\").removeClass(\"active\");\r\n\t        btnHuanyihuan.find(\"i\").attr(\"data-click\",'true');\r\n\t    },400)\r\n\t}\r\n\t\r\n\tcon02_index++;\r\n\tif(con02_index==3){\r\n\t\tcon02_index=0;\r\n\t}\r\n\t$('.xuqiu19629_con02 li').hide();\r\n\tfor(var i=con02_index*4;i<(con02_index*4)+4;i++){\r\n\t\t$('.xuqiu19629_con02 li').eq(i).show();\r\n\t}\r\n\techo.render();\r\n})\r\n\r\n/*直播导视*/\r\n\r\n\r\nfunction addJs(url){\r\n\tvar sc = document.createElement(\"script\");\r\n\tsc.type=\"text/javascript\";\r\n\tsc.src=url;\r\n\tdocument.getElementsByTagName(\"body\")[0].appendChild(sc);\r\n  }\r\n  var url = \"//api.cntv.cn/epg/nowepg?serviceId=tvcctv&c=\"+con03pid+\"&t=jsonp&cb=fun\";\r\n  addJs(url);\r\n  var stime = \"\";\r\n  var etime = \"\";\r\n  function fun(data){\r\n\tvar strcon03='';\r\n\tfor(var i=0;i<data.length;i++){\r\n\t\tstrcon03+='<li class=\"swiper-slide\"><a href=\"'+con03url[i]+'\"><div class=\"img\"><img src=\"'+con03img[i]+'\" /></div><div class=\"dclas\"><p><span>'+data[i].t+'</span></p></div></a></li>';\r\n\t}\r\n\t$('#con03sw').prepend(strcon03);\r\n\tcreateswiper('.xuqiu19629_con03 .swiper-container');\r\n  }\r\n\r\n  createswiper('.xuqiu19629_con04 .swiper-container');\r\n  \r\n$('.xuqiu19629_con04 ul li').each(function(){\r\n\tif($(this).find(\"i\").html()==\"\"){\r\n\t\t$(this).find('i').hide();\r\n\t}\r\n})\r\n\r\n/*片库*/\r\nvar pianku01 = createswiper('.xuqiu19629_con05 .con01');\r\nvar pianku02;\r\nvar pianku03;\r\nvar pianku04;\r\nvar con05_index;\r\n$('.xuqiu19629_con05 li').each(function(){\r\n\tif($(this).find(\"i\").html()==\"\"){\r\n\t\t$(this).find('i').hide();\r\n\t}\r\n})\r\n\r\nvar con05w = $(document).width()<750?$(document).width():750;\r\nvar con05height = con05w/750*422;\r\n$('.xuqiu19629_con05 .cont_img img').css('height',con05height);\r\n\r\n$(window).resize(function(){\r\n\tcon05w = $(document).width()<750?$(document).width():750;\r\n\tcon05height = con05w/750*422;\r\n$('.xuqiu19629_con05 .cont_img img').css('height',con05height);\r\n})\r\nvar con05ofset = $('.xuqiu19629_con05').offset().top;\r\nvar mps = $('.xuqiu19629_con05 .con_list').find('.swiper-container').eq(0).find('li').eq(0).attr('mps');\r\n\r\n$('.xuqiu19629_con05 .cont_img a').attr('href',$('.xuqiu19629_con05 .con_list').find('.swiper-container').eq(0).find('li').eq(0).attr('link'));\r\n\r\n//if(($(window).scrollTop()-con05ofset+$(window).height())>0){\r\n//\tif(mps==''||mps==undefined){\r\n//\t\t$('.xuqiu19629_con05 .cont_img img').attr('src',$('.xuqiu19629_con05 .con_list').find('.swiper-container').eq(0).find('li').eq(0).attr('imgs'));\r\n//\t\t$('#imggif').show();\r\n//\t\t$('#videopl').attr('src','');\r\n//\t\t$('#videopl').hide();\r\n//\t}else{\r\n//\t\t$('.xuqiu19629_con05 .cont_img video').attr('src',mps);\r\n//\t\t$('#imggif').hide();\r\n//\t\t$('#videopl').show();\r\n//\t}\r\n//}else{\r\nvar nis = true;\r\n\t$(window).scroll(function(){\r\n\t\tif(nis){\r\n\t\t\tif((document.documentElement.scrollTop-con05ofset+$(window).height())>0){\r\n\t\t\t\tnis =false;\r\n\t\t\t\tif(mps==''||mps==undefined){\r\n\t\t\t\t\t$('.xuqiu19629_con05 .cont_img img').attr('src',$('.xuqiu19629_con05 .con_list').find('.swiper-container').eq(0).find('li').eq(0).attr('imgs'));\r\n\t\t\t\t\t$('#imggif').show();\r\n\t\t\t\t\t$('#videopl').attr('src','');\r\n\t\t\t\t\t$('#videopl').hide();\r\n\t\t\t\t}else{\r\n\t\t\t\t\t$('#videopl').remove();\r\n\t\t\t\t\t$('.xuqiu19629_con05 .cont_img').append(`<video src=\"${mps}\" autoplay  muted id=\"videopl\" loop=\"loop\" style=\"height:${con05height}\"></video>`);\r\n\t\t\t\t\tdocument.getElementById('videopl').play();\r\n\t\t\t\t\t$('#imggif').hide();\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t})\r\n\t\r\n\r\n//}\r\n\r\n\r\n\r\n$('.xuqiu19629_con05 .pk_t span').click(function(){\r\n\tcon05_index = $(this).index();\r\n\t$(this).addClass('cur').siblings().removeClass('cur');\r\n\t$('.xuqiu19629_con05 .cont_img img').attr('src','');\r\n\t$('.xuqiu19629_con05 .con_list').find('.swiper-container').eq(con05_index).addClass('cur').siblings().removeClass('cur');\r\n\t$('.xuqiu19629_con05 .cont_img a').attr('href',$('.xuqiu19629_con05 .con_list').find('.swiper-container').eq(con05_index).find('li.cur').attr('link'));\r\n\tmps = $('.xuqiu19629_con05 .con_list').find('.swiper-container').eq(con05_index).find('li.cur').attr('mps');\r\n\tif(mps==''||mps==undefined){\r\n\t\t$('.xuqiu19629_con05 .cont_img img').attr('src',$('.xuqiu19629_con05 .con_list').find('.swiper-container').eq(con05_index).find('li.cur').attr('imgs'));\r\n\t\t$('#imggif').show(0);\r\n\t\t$('#videopl').remove();\r\n\t\t$('#videopl').hide(0);\r\n\t}else{\r\n\t\t$('#videopl').remove();\r\n\t\t$('.xuqiu19629_con05 .cont_img').append(`<video src=\"${mps}\" autoplay  muted id=\"videopl\" loop=\"loop\" style=\"height:${con05height}\"></video>`);\r\n\t\tdocument.getElementById('videopl').play();\r\n\t\t$('#imggif').hide(0);\r\n\t}\r\n\tif(con05_index==0){\r\n\t\tpianku01.update();\r\n\t}else if(con05_index==1){\r\n\t\tif(pianku02){\r\n\t\t\tpianku02.update();\r\n\t\t}else{\r\n\t\t\tpianku02 = createswiper('.xuqiu19629_con05 .con02');\r\n\t\t}\r\n\t}else if(con05_index==2){\r\n\t\tif(pianku03){\r\n\t\t\tpianku03.update();\r\n\t\t}else{\r\n\t\t\tpianku03 = createswiper('.xuqiu19629_con05 .con03');\r\n\t\t}\r\n\t}else{\r\n\t\tif(pianku04){\r\n\t\t\tpianku04.update();\r\n\t\t}else{\r\n\t\t\tpianku04 = createswiper('.xuqiu19629_con05 .con04');\r\n\t\t}\r\n\t}\r\n})\r\n$('.xuqiu19629_con05 .swiper-container li').click(function(){\r\n\t$(this).addClass('cur').siblings().removeClass('cur');\r\n\t$('.xuqiu19629_con05 .cont_img a').attr('href',$(this).attr('link'));\r\n\t$('.xuqiu19629_con05 .cont_img img').attr('src','');\r\n\tmps = $(this).attr('mps');\r\n\tif(mps==''||mps==undefined){\r\n\t\t$('.xuqiu19629_con05 .cont_img img').attr('src',$(this).attr('imgs'));\r\n\t\t$('#imggif').show(0);\r\n\t\t$('#videopl').remove();\r\n\t\t$('#videopl').hide(0);\r\n\t}else{\r\n\t\t$('#videopl').remove();\r\n\t\t$('.xuqiu19629_con05 .cont_img').append(`<video src=\"${mps}\" autoplay  muted id=\"videopl\" loop=\"loop\" style=\"height:${con05height}\"></video>`);\r\n\t\tdocument.getElementById('videopl').play();\r\n\t\t$('#imggif').hide(0);\r\n\t}\r\n\t\r\n})\r\n\r\n\r\n\r\n\r\n\r\n\r\n/*听音轮播*/\r\nvar con09swiper = new Swiper('.xuqiu19629_con09 .swiper-container',{\r\n\tspeed:1000,\r\n\tinitialSlide:0,//默认显示第二个图片\r\n\tautoplayDisableOnInteraction : false,\r\n\tcenteredSlides : true,\r\n\tslidesPerView:\"auto\",\r\n\tloop:true,\r\n\twatchSlidesVisibility:true,\r\n\tlazy: {\r\n\t\tloadPrevNext: true,\r\n\t\tloadOnTransitionStart: true\r\n\t},\r\n\t//setWrapperSize :true,\r\n\ton:{\r\n\t\ttransitionEnd:function(){ \r\n\t\t\t$(\".xuqiu19629_con09 .text li\").eq(this.realIndex).show().siblings().hide();\r\n\t\t\t//swiper.update();  \r\n\t\t} \r\n\t}\r\n});\r\n\r\n$(window).resize(function() {\r\n\tsetTimeout(function(){\r\n\t\tcon09swiper.update();\r\n\t},300);\r\n})\r\n\r\n\r\n/*底通JS*/\r\n  //className命名  s起始条数 t每页显示条数  type显示还是隐藏\r\n  function contentShowLiditongJS(className,s,t,type){  \r\n\tsetTimeout(function(){\r\n\t\tvar sli= s;\r\n\t\tvar pageSize = t;\r\n\t\t// 获得ul下所有的li\r\n\t\tvar lis = className.find(\"li\");\r\n\t\t // 根据curPage计算出beginLi和endLi    就是要显示的li从那一条开始，到哪一条结束\r\n\t\tvar beginLi = sli;// 从0开始\r\n\t\tvar endLi = beginLi + pageSize - 1;\r\n\t\tif (endLi >= lis.length-1){\r\n\t\t\tendLi = lis.length-1;\r\n\t\t}\r\n\t\tif((endLi+1)%3 == 0){  //增加border样式\r\n\t\t\t$(lis).removeClass('noborder');\r\n\t\t\t$(lis).eq(endLi-0).addClass('noborder')\r\n\t\t\t$(lis).eq(endLi-1).addClass('noborder')\r\n\t\t\t$(lis).eq(endLi-2).addClass('noborder')\r\n\t\t}\r\n\t\tif((endLi+1)%3 == 1){\r\n\t\t\t$(lis).removeClass('noborder');\r\n\t\t\t$(lis).eq(endLi).addClass('noborder')\r\n\t\t}\r\n\t\tif((endLi+1)%3 == 2){\r\n\t\t\t$(lis).removeClass('noborder');\r\n\t\t\t$(lis).eq(endLi-0).addClass('noborder')\r\n\t\t\t$(lis).eq(endLi-1).addClass('noborder')\r\n\t\t}\r\n\r\n\t\tfor (var i=beginLi; i<=endLi; i++){\r\n\t\t\tif(type=='show'){\r\n\t\t\t\t$(lis).eq(i).css(\"display\",\"block\");\r\n\t\t\t}else if(type=='hide'){\r\n\t\t\t\t$(lis).eq(i).css(\"display\",\"none\");\r\n\t\t\t}\r\n\t\t}\r\n\t\t\r\n\t\t// if(endLi>=(lis.length-1) && endLi >=15){  //点击后的大于15条.\r\n\t\t// \tif(type=='show'){\r\n\t\t// \t\t$(\"#ditongJS .demo02\").eq(indexditongJS).find('.choiceLabel2 a').html(\"收起更多\");\r\n\t\t// \t\t$(\"#ditongJS .demo02\").eq(indexditongJS).find('.choiceLabel2').addClass(\"choiceLabel4\").removeClass(\"choiceLabel2\");\r\n\t\t// \t}else if(type=='hide'){\r\n\t\t// \t\t$(\"#ditongJS .demo02\").eq(indexditongJS).find('.choiceLabel4 a').html(\"查看更多\");\r\n\t\t// \t\t$(\"#ditongJS .demo02\").eq(indexditongJS).find('.choiceLabel4').addClass(\"choiceLabel2\").removeClass(\"choiceLabel4\");\r\n\t\t// \t\t$(lis).removeClass('noborder');  //控制boder样式\r\n\t\t// \t\t$(lis).eq(15-1).addClass('noborder')\r\n\t\t// \t\t$(lis).eq(15-2).addClass('noborder')\r\n\t\t// \t\t$(lis).eq(15-3).addClass('noborder')\r\n\t\t// \t}\r\n\t\t\t\r\n\t\t// }\r\n\t},300)  //因为点击按钮有300延迟\r\n}\r\n\r\n//点击切换内容\r\ncontentShowLiditongJS($(\"#ditongJS .demo02\").eq(0),0,50,\"show\");\r\n$(\"#ditongJS .demo02\").eq(0).show();\r\nvar indexditongJS=0;\r\n$(\"#ditongJS .demo01_0708 li\").bind(\"click\",function(){\r\n\tindexditongJS = $(this).index();\r\n\t$(this).addClass(\"cur\").siblings().removeClass(\"cur\");\r\n\tcontentShowLiditongJS($(\"#ditongJS .demo02\").eq(indexditongJS),0,50,\"show\");\r\n\r\n\tsetTimeout(function(){\r\n\t\t$(\"#ditongJS .demo02\").hide();\r\n\t\t$(\"#ditongJS .demo02\").eq(indexditongJS).show();\r\n\t},300)\r\n})\r\n\r\n\r\n/*返回顶部*/\r\nvar scrollToTopConfig = {oTop: $('.go_top'),}//返回顶部id\r\nfunction scrollToTop(options) {\r\n  var oTop = options.oTop;\r\n  if (oTop.length > 0) {\r\n    var sTop = document.documentElement.scrollTop || document.body.scrollTop;\r\n    if (sTop <$('.xuqiu19629_con02').offset().top) {            \r\n      $(\".gotop_list\").hide();\r\n    } else {\r\n      $(\".gotop_list\").show();\r\n    }\r\n    addOnscroll(function() {\r\n      sTop = document.documentElement.scrollTop || document.body.scrollTop;\r\n      if (sTop <$('.xuqiu19629_con02').offset().top) {            \r\n        $(\".gotop_list\").hide();\r\n      } else {\r\n        $(\".gotop_list\").show();\r\n      }\r\n    });\r\n    oTop.click(function() {\r\n      document.documentElement.scrollTop = document.body.scrollTop = 0;\r\n    });\r\n  }\r\n}\r\nfunction addOnscroll(fn) {\r\n\tif (typeof window.onscroll == 'function') {\r\n\t\tvar tempFn = window.onscroll;\r\n\t\twindow.onscroll = function() {\r\n\t\t\ttempFn();\r\n\t\t\tfn();\r\n\t\t}\r\n\t} else {\r\n\t\twindow.onscroll = function() {\r\n\t\t\tfn();\r\n\t\t}\r\n\t}\r\n}\r\nsetTimeout(function() {\r\n\tscrollToTop(scrollToTopConfig);\r\n},300);\r\n\r\n\r\n\r\n//央视节目官网新版首页埋码需求XUQIU-19780\r\n//h5曝光位置：正在热播下方，直播导视下方，片库下方，收视TOP榜下方，听音下方，年代剧下方\r\nvar Buryingpoint1=true,Buryingpoint2=true,Buryingpoint3=true,Buryingpoint4=true,Buryingpoint5=true,Buryingpoint6=true;\r\n$(document).ready(function(){\r\n\taddOnscroll(function() {\t\t//央视节目官网新版首页埋码需求XUQIU-19780\r\n\t\tsTop = document.documentElement.scrollTop || document.body.scrollTop;\r\n\t\tvar buryCode01 = $(\".xuqiu19629_con02\").offset().top + $(\".xuqiu19629_con02\").height();\r\n\t\tvar buryCode02 =$(\".xuqiu19629_con04\").offset().top + $(\".xuqiu19629_con04\").height();\r\n\t\tvar buryCode03 =$(\".xuqiu19629_con05\").offset().top + $(\".xuqiu19629_con05\").height();\r\n\t\tvar buryCode04 =$(\".xuqiu19629_con07\").offset().top + $(\".xuqiu19629_con07\").height();\r\n\t\tvar buryCode05 =$(\".xuqiu19629_con09\").offset().top + $(\".xuqiu19629_con09\").height();\r\n\t\tvar buryCode06 =$(\".xuqiu19629_con10\").offset().top + $(\".xuqiu19629_con10\").height();\r\n\t\tvar scrollTopdivH = sTop+window.innerHeight;\r\n\t\tif(scrollTopdivH >= buryCode01 && Buryingpoint1){\r\n\t\t\twindow.goldlog.record(\"/spec.1.1\", \"\", \"snsScene=tv&product=h5&navname=正在热播\", \"\")\r\n\t\t\tBuryingpoint1 = false;\r\n\t\t}\r\n\t\tif(scrollTopdivH >= buryCode02 && Buryingpoint2){\r\n\t\t\twindow.goldlog.record(\"/spec.1.1\", \"\", \"snsScene=tv&product=h5&navname=直播导视\", \"\")\r\n\t\t\tBuryingpoint2 = false;\r\n\t\t}\r\n\t\tif(scrollTopdivH >= buryCode03 && Buryingpoint3){\r\n\t\t\twindow.goldlog.record(\"/spec.1.1\", \"\", \"snsScene=tv&product=h5&navname=片库\", \"\")\r\n\t\t\tBuryingpoint3 = false;\r\n\t\t}\r\n\t\tif(scrollTopdivH >= buryCode04 && Buryingpoint4){\r\n\t\t\twindow.goldlog.record(\"/spec.1.1\", \"\", \"snsScene=tv&product=h5&navname=收视TOP榜\", \"\")\r\n\t\t\tBuryingpoint4 = false;\r\n\t\t}\r\n\t\tif(scrollTopdivH >= buryCode05 && Buryingpoint5){\r\n\t\t\twindow.goldlog.record(\"/spec.1.1\", \"\", \"snsScene=tv&product=h5&navname=听音\", \"\")\r\n\t\t\tBuryingpoint5 = false;\r\n\t\t}\r\n\t\tif(scrollTopdivH >= buryCode06 && Buryingpoint6){\r\n\t\t\twindow.goldlog.record(\"/spec.1.1\", \"\", \"snsScene=tv&product=h5&navname=年代剧\", \"\")\r\n\t\t\tBuryingpoint6 = false;\r\n\t\t}\r\n\r\n\t})\r\n})\r\n\r\n$('.xuqiu19629_con06').hide();\r\n$('.boxs .guangago02').hide();\r\n$('.xuqiu19629_con08').hide();\r\n$('.boxs .guanggao01').hide();\r\nvar kdnum = 0;\r\nvar kddd = 1;\r\nvar maxnum = 5;\r\nvar linum =0;\r\nvar tt= true;\r\n$('.xuqiu19629_con06').eq(-1).find('li').hide();\r\n$('.xuqiu19629_con06').eq(-1).show();\r\nif(kdnum==0){\r\n\tfor(var i=kdnum;i<kdnum+3;i++){\r\n\t\t$('.boxs .guangago02').eq(0).show();\r\n\t\t$('.xuqiu19629_con06').eq(i).show();\r\n\t\t$('.xuqiu19629_con08').eq(0).show();\r\n\t\t$('.boxs .guanggao01').eq(0).show();\r\n\t}\r\n\tkdnum=kdnum+3;\r\n}\r\n$(window).scroll(function(){\r\n\tvar sTop = document.body.scrollTop || document.documentElement.scrollTop;\t//距离body的距离\r\n\tvar clienth =document.documentElement.clientHeight;\r\n\tvar dHeight = $(document).height();\t//文档的高度\r\n\tif(sTop-($('.loading').offset().top-clienth)>100){\r\n\t\tif(tt){\r\n\t\t\ttt =false;\r\n\t\t\tsetTimeout(function(){\r\n\t\t\t\tif(kddd==1){\r\n\t\t\t\t\tfor(var i=kdnum;i<kdnum+3;i++){\r\n\t\t\t\t\t\t$('.boxs .guangago02').eq(1).show();\r\n\t\t\t\t\t\t$('.xuqiu19629_con06').eq(i).show();\r\n\t\t\t\t\t\t$('.xuqiu19629_con08').eq(1).show();\r\n\t\t\t\t\t\t$('.boxs .guanggao01').eq(1).show();\r\n\t\t\t\t\t}\r\n\t\t\t\t}else if(kddd>=(maxnum-1)){\r\n\t\t\t\t\t$('.xuqiu19629_con06').eq(-1).find('li[style*=\"display: none\"]').length\t\r\n\t\t\t\t\tfor(var i=linum;i<linum+6;i++){\r\n\t\t\t\t\t\t$('.xuqiu19629_con06').eq(-1).find('li').eq(i).show();\r\n\t\t\t\t\t}\r\n\t\t\t\t\t$('.loading').find('i').remove();\r\n\t\t\t\t\t$('.loading').find('p').html('已无更多内容');\r\n\t\t\t\t}else{\r\n\t\t\t\t\tfor(var i=linum;i<linum+12;i++){\r\n\t\t\t\t\t\t$('.xuqiu19629_con06').eq(-1).find('li').eq(i).show();\r\n\t\t\t\t\t}\r\n\t\t\t\t\tlinum = linum+12;\r\n\t\t\t\t}\r\n\t\t\t\tkddd ++;\r\n\t\t\t\ttt =true;\r\n\t\t\t\techo.render();\r\n\t\t\t\tif(kddd>maxnum){\r\n\t\t\t\t\ttt=false;\r\n\t\t\t\t}\r\n\t\t\t},500)\r\n\t\t}\r\n\t}\r\n})",
