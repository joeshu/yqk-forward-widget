https://v.cctv.com/2022/07/27/VIDEDlhoiAVt4avyGEy7aFeB220727.shtml\"},{\"allowAd\":0,\"allowComment\":0,\"allowShare\":0,\"cateId\":\"18AzYZNf0926\",\"cateName\":\"热评\",\"cvid\":\"VIDEiOIVOUx7Abqvh295RmoN220724\",\"episodes\":0,\"fc\":\"原创\",\"feedType\":\"3\",\"guid\":\"4adc457551ca42bc87208ae6b297562a\",\"image1\":\"https://p1.img.cctvpic.com/apple3g/www/upload/image/20220724/1658625232382088590.jpg\",\"image2\":\"https://p4.img.cctvpic.com/apple3g/www/upload/image/20220724/1658625236535038046.jpg\",\"isCourse\":0,\"isSubed\":0,\"keywords\":\"航天器,太空,交会对接\",\"labelId\":\"18aiYZ3m0926\",\"likeCount\":0,\"mediaId\":\"18ryeuIb0926\",\"mediaImg\":\"https://p1.img.cctvpic.com/apple3g/www/upload/image/20260828/1787896006290088494.jpg\",\"mediaName\":\"比划\",\"pubTime\":1658625293431,\"pv\":\"\",\"sc\":\"\",\"seqId\":1658625293431,\"seqStrId\":\"1658625293431\",\"size\":\"16:9\",\"source\":0,\"subTitle\":\"\",\"title\":\"两个航天器怎样找到彼此？3分钟看懂“交会对接”\",\"vbrief\":\"“交会对接”简简单单4个字里包含了2个阶段，是航天器在轨运行中最复杂的技术之一，也是建设中国空间站的关键技术。什么是“零窗口发射”？两个航天器在太空中怎样找到彼此？怎样保证航天器不把空间站掀翻了？快速交会对接的“快速”是快在哪？\",\"vcount\":0,\"vduration\":280,\"vid\":\"f3a883804cf34caaac02d9363e6ac58e\",\"videoType\":0,\"vip_flag\":0,\"webUrl\":\"https://v.cctv.com/reping/bh/index.shtml\",\"wwwUrl\":\"https://v.cctv.com/2022/07/24/VIDEiOIVOUx7Abqvh295RmoN220724.shtml\"},{\"allowAd\":0,\"allowComment\":0,\"allowShare\":0,\"cateId\":\"18AzYZNf0926\",\"cateName\":\"热评\",\"cvid\":\"VIDEWTZEjLdihvHy8SRyG13l220720\",\"episodes\":0,\"fc\":\"原创\",\"feedType\":\"3\",\"guid\":\"6517df89760d46c19189b978b822cd5c\",\"image1\":\"https://p2.img.cctvpic.com/apple3g/www/upload/image/20220720/1658302955819031143.jpg\",\"image2\":\"https://p4.img.cctvpic.com/apple3g/www/upload/image/20220720/1658302962314005786.jpg\",\"isCourse\":0,\"isSubed\":0,\"keywords\":\"星辰大海,月球\",\"labelId\":\"18aiYZ3m0926\",\"likeCount\":0,\"mediaId\":\"18ryeuIb0926\",\"mediaImg\":\"https://p1.img.cctvpic.com/apple3g/www/upload/image/20260828/1787896006290088494.jpg\",\"mediaName\":\"比划\",\"pubTime\":1658302983917,\"pv\":\"\",\"sc\":\"\",\"seqId\":1658302983917,\"seqStrId\":\"1658302983917\",\"size\":\"16:9\",\"source\":0,\"subTitle\":\"\",\"title\":\"我们的征途是星辰大海（上种菜）\",\"vbrief\":\"鱼丸的梦想是月球，我们的梦想是火锅。月壤上不能种菜？那怎么行，我们的目标可是把菜种遍星辰大海！\",\"vcount\":0,\"vduration\":85,\"vid\":\"37e08e7881724e3a902fa4b0b7d73789\",\"videoType\":0,\"vip_flag\":0,\"webUrl\":\"https://v.cctv.com/reping/bh/index.shtml\",\"wwwUrl\":\"https://v.cctv.com/2022/07/20/VIDE7R5psGCQzs6tF8zc73ul220720.shtml\"},{\"allowAd\":0,\"allowComment\":0,\"allowShare\":0,\"cateId\":\"18AzYZNf0926\",\"cateName\":\"热评\",\"cvid\":\"VIDEp8KgbRMT9xWhk1BSVjli220717\",\"episodes\":0,\"fc\":\"原创\",\"feedType\":\"3\",\"guid\":\"29e9b0cba399463b909ab78e63a38ced\",\"image1\":\"https://p2.img.cctvpic.com/apple3g/www/upload/image/20220717/1658032812588076868.jpg\",\"image2\":\"https://p2.img.cctvpic.com/apple3g/www/upload/image/20220717/1658032816457055156.jpg\",\"isCourse\":0,\"isSubed\":0,\"keywords\":\"表情包,斗图\",\"labelId\":\"18aiYZ3m0926\",\"likeCount\":0,\"mediaId\":\"18ryeuIb0926\",\"mediaImg\":\"https://p1.img.cctvpic.com/apple3g/www/upload/image/20260828/1787896006290088494.jpg\",\"mediaName\":\"比划\",\"pubTime\":1658032822923,\"pv\":\"\",\"sc\":\"\",\"seqId\":1658032822923,\"seqStrId\":\"1658032822923\",\"size\":\"16:9\",\"source\":0,\"subTitle\":\"\",\"title\":\"从颜文字到斗图大乱炖 表情包40年超级进化史\",\"vbrief\":\"三千多年前，人类发明甲骨文来交流记录，如今，人们利用表情包来传递情感态度，成人世界，管理表情包显然比管理表情容易。“没有表情包就不能愉快地聊天”是从什么时候开始的？\",\"vcount\":0,\"vduration\":223,\"vid\":\"9cc47831b83144e2af11081e233d5baf\",\"videoType\":0,\"vip_flag\":0,\"webUrl\":\"https://v.cctv.com/reping/bh/index.shtml\",\"wwwUrl\":\"https://v.cctv.com/2022/07/17/VIDEp8KgbRMT9xWhk1BSVjli220717.shtml\"},{\"allowAd\":0,\"allowComment\":0,\"allowShare\":0,\"cateId\":\"18AzYZNf0926\",\"cateName\":\"热评\",\"cvid\":\"VIDEvN19YSvoM1q6oBXPn0ty220629\",\"episodes\":0,\"fc\":\"原创\",\"feedType\":\"3\",\"guid\":\"98f015dc355c40b09b1aa82e68a90b08\",\"image1\":\"https://p2.img.cctvpic.com/apple3g/www/upload/image/20220629/1656473935467051959.jpg\",\"image2\":\"https://p3.img.cctvpic.com/apple3g/www/upload/image/20220629/1656473946517006778.jpg\",\"isCourse\":0,\"isSubed\":0,\"keywords\":\"宋朝,美食,梦华录\",\"labelId\":\"18aiYZ3m0926\",\"likeCount\":0,\"mediaId\":\"18ryeuIb0926\",\"mediaImg\":\"https://p1.img.cctvpic.com/apple3g/www/upload/image/20260828/1787896006290088494.jpg\",\"mediaName\":\"比划\",\"pubTime\":1656473961723,\"pv\":\"\",\"sc\":\"\",\"seqId\":1656473961723,\"seqStrId\":\"1656473961723\",\"size\":\"16:9\",\"source\":0,\"subTitle\":\"\",\"title\":\"知否知否 这个夏天宋朝美食聚首\",\"vbrief\":\"《梦华录》里的茶果子、《清平乐》里的李子雪花糕、《知否》里的软酪……还记得影视剧里令人心动的美食吗？民以食为天，为什么宋代“吃货”特别多？宋代的吃货又有多幸福？\",\"vcount\":0,\"vduration\":172,\"vid\":\"d078106ea2cd4efbbd3f3d5921dee01d\",\"videoType\":0,\"vip_flag\":0,\"webUrl\":\"https://v.cctv.com/reping/bh/index.shtml\",\"wwwUrl\":\"https://v.cctv.com/2022/06/29/VIDEvN19YSvoM1q6oBXPn0ty220629.shtml\"},{\"allowAd\":0,\"allowComment\":0,\"allowShare\":0,\"cateId\":\"18AzYZNf0926\",\"cateName\":\"热评\",\"cvid\":\"VIDEOUpEcHnRsXagGcSZrRle220628\",\"episodes\":0,\"fc\":\"原创\",\"feedType\":\"3\",\"guid\":\"425e53aa94084692931734fdee9948dd\",\"image1\":\"https://p3.img.cctvpic.com/apple3g/www/upload/image/20220628/1656381720713057086.jpg\",\"image2\":\"https://p2.img.cctvpic.com/apple3g/www/upload/image/20220628/1656381724078072359.jpg\",\"isCourse\":0,\"isSubed\":0,\"keywords\":\"TVB腔,香港,粤语\",\"labelId\":\"18aiYZ3m0926\",\"likeCount\":0,\"mediaId\":\"18ryeuIb0926\",\"mediaImg\":\"https://p1.img.cctvpic.com/apple3g/www/upload/image/20260828/1787896006290088494.jpg\",\"mediaName\":\"比划\",\"pubTime\":1656381751886,\"pv\":\"\",\"sc\":\"\",\"seqId\":1656381751886,\"seqStrId\":\"1656381751886\",\"size\":\"16:9\",\"source\":0,\"subTitle\":\"\",\"title\":\"TVB腔究竟是什么腔 为何听起来那么独特\",\"vbrief\":\"香港影视剧中，演员们的一口TVB腔，给观众留下了深刻的印象。他们之中涌现出一大批能撬动我们 DNA 的声音，那么，TVB腔为什么会这么奇特？它到底是怎么形成的？\\n\",\"vcount\":0,\"vduration\":239,\"vid\":\"703300de81b74915873ebbdfd8014e89\",\"videoType\":0,\"vip_flag\":0,\"webUrl\":\"https://v.cctv.com/reping/bh/index.shtml\",\"wwwUrl\":\"https://v.cctv.com/2022/06/28/VIDEOUpEcHnRsXagGcSZrRle220628.shtml\"},{\"allowAd\":0,\"allowComment\":0,\"allowShare\":0,\"cateId\":\"18AzYZNf0926\",\"cateName\":\"热评\",\"cvid\":\"VIDEYDWjOl3AwGEtv7hlsliz220619\",\"episodes\":0,\"fc\":\"原创\",\"feedType\":\"3\",\"guid\":\"2c942aabde2046359d40add399384f69\",\"image1\":\"https://p4.img.cctvpic.com/apple3g/www/upload/image/20220619/1655618370974061798.jpg\",\"image2\":\"https://p2.img.cctvpic.com/apple3g/www/upload/image/20220619/1655618375452083232.jpg\",\"isCourse\":0,\"isSubed\":0,\"keywords\":\"父亲节,爱国\",\"labelId\":\"18aiYZ3m0926\",\"likeCount\":0,\"mediaId\":\"18ryeuIb0926\",\"mediaImg\":\"https://p1.img.cctvpic.com/apple3g/www/upload/image/20260828/1787896006290088494.jpg\",\"mediaName\":\"比划\",\"pubTime\":1655618386152,\"pv\":\"\",\"sc\":\"\",\"seqId\":1655618386152,\"seqStrId\":\"1655618386152\",\"size\":\"16:9\",\"source\":0,\"subTitle\":\"\",\"title\":\"父亲节致敬他们！4分钟串起他们爱国奉献的一生\",\"vbrief\":\"隐姓埋名一生为国铸重器、挚爱田园寻梦天下粮仓、潜心研究踏平坎坷筑梦苍穹，从壮年到暮年，他们把一个个朴素的想法变成了国之重器，成就了中国在世界上独一无二。这才是中国的父亲节，致敬他们！\",\"vcount\":0,\"vduration\":258,\"vid\":\"d00b665b40164ed0a92a028ee937b058\",\"videoType\":0,\"vip_flag\":0,\"webUrl\":\"https://v.cctv.com/reping/bh/index.shtml\",\"wwwUrl\":\"https://v.cctv.com/2022/06/19/VIDEYDWjOl3AwGEtv7hlsliz220619.shtml\"},{\"allowAd\":0,\"allowComment\":0,\"allowShare\":0,\"cateId\":\"18AzYZNf0926\",\"cateName\":\"热评\",\"cvid\":\"VIDEtz4caPXmSrOgDf52vEAX220607\",\"episodes\":0,\"fc\":\"原创\",\"feedType\":\"3\",\"guid\":\"564646f796184adca5b94ae64279dee1\",\"image1\":\"https://p3.img.cctvpic.com/apple3g/www/upload/image/20220607/1654587095304025832.jpg\",\"image2\":\"https://p3.img.cctvpic.com/apple3g/www/upload/image/20220607/1654587106766092774.jpg\",\"isCourse\":0,\"isSubed\":0,\"keywords\":\"夏天,高考\",\"labelId\":\"18aiYZ3m0926\",\"likeCount\":0,\"mediaId\":\"18ryeuIb0926\",\"mediaImg\":\"https://p1.img.cctvpic.com/apple3g/www/upload/image/20260828/1787896006290088494.jpg\",\"mediaName\":\"比划\",\"pubTime\":1654587134480,\"pv\":\"\",\"sc\":\"\",\"seqId\":1654587134480,\"seqStrId\":\"1654587134480\",\"size\":\"16:9\",\"source\":0,\"subTitle\":\"\",\"title\":\"为什么夏天最容易被怀念\",\"vbrief\":\"六月的风，六月的雨，六月的考试，六月的抉择……仿佛所有的青春故事都一定发生在夏天。在逐渐爬升的温度里，风会带来最好的消息，夏天，这是我们滚烫的青春里最沸腾的一章，每一份努力都将绚烂绽放，今年夏天不留遗憾，加油冲鸭！\",\"vcount\":0,\"vduration\":193,\"vid\":\"d3a0428ef5d842d6b97cb8e041022076\",\"videoType\":0,\"vip_flag\":0,\"webUrl\":\"https://v.cctv.com/reping/bh/index.shtml\",\"wwwUrl\":\"https://v.cctv.com/2022/06/07/VIDEtz4caPXmSrOgDf52vEAX220607.shtml\"},{\"allowAd\":0,\"allowComment\":0,\"allowShare\":0,\"cateId\":\"18AzYZNf0926\",\"cateName\":\"热评\",\"cvid\":\"VIDEGNZmTuMWD9OrfIuzTBBX220602\",\"episodes\":0,\"fc\":\"原创\",\"feedType\":\"3\",\"guid\":\"4938725dfd894952aa387c55533ceec8\",\"image1\":\"https://p2.img.cctvpic.com/apple3g/www/upload/image/20220602/1654132520036064021.jpg\",\"image2\":\"https://p1.img.cctvpic.com/apple3g/www/upload/image/20220602/1654132524595093273.jpg\",\"isCourse\":0,\"isSubed\":0,\"keywords\":\"刘畊宏,王心凌,青春\",\"labelId\":\"18aiYZ3m0926\",\"likeCount\":0,\"mediaId\":\"18ryeuIb0926\",\"mediaImg\":\"https://p1.img.cctvpic.com/apple3g/www/upload/image/20260828/1787896006290088494.jpg\",\"mediaName\":\"比划\",\"pubTime\":1654132530115,\"pv\":\"\",\"sc\":\"\",\"seqId\":1654132530115,\"seqStrId\":\"1654132530115\",\"size\":\"16:9\",\"source\":0,\"subTitle\":\"\",\"title\":\"王心凌凭什么动了大家的DNA\",\"vbrief\":\"刘畊宏女孩，王心凌男孩，18年后的王心凌还是18岁的模样，当逝去的青春对你发起“总攻”，蒙了灰的记忆一个个被擦亮。\\n\",\"vcount\":0,\"vduration\":279,\"vid\":\"ea9b0440a57540e381b23de902da3525\",\"videoType\":0,\"vip_flag\":0,\"webUrl\":\"https://v.cctv.com/reping/bh/index.shtml\",\"wwwUrl\":\"https://v.cctv.com/2022/06/02/VIDEGNZmTuMWD9OrfIuzTBBX220602.shtml\"},{\"allowAd\":0,\"allowComment\":0,\"allowShare\":0,\"cateId\":\"18AzYZNf0926\",\"cateName\":\"热评\",\"cvid\":\"VIDEHtZXIz5HezlAwlZc93ve220528\",\"episodes\":0,\"fc\":\"原创\",\"feedType\":\"3\",\"guid\":\"afd7d9e123444fd5a0080f93a3772def\",\"image1\":\"https://p2.img.cctvpic.com/apple3g/www/upload/image/20220528/1653695159395017747.jpg\",\"image2\":\"https://p4.img.cctvpic.com/apple3g/www/upload/image/20220528/1653695164016046715.jpg\",\"isCourse\":0,\"isSubed\":0,\"keywords\":\"爱发日,脱发,成年人\",\"labelId\":\"18aiYZ3m0926\",\"likeCount\":0,\"mediaId\":\"18ryeuIb0926\",\"mediaImg\":\"https://p1.img.cctvpic.com/apple3g/www/upload/image/20260828/1787896006290088494.jpg\",\"mediaName\":\"比划\",\"pubTime\":1653695164856,\"pv\":\"\",\"sc\":\"\",\"seqId\":1653695164856,\"seqStrId\":\"1653695164856\",\"size\":\"16:9\",\"source\":0,\"subTitle\":\"\",\"title\":\"了解“头顶大事” 如何判断自己脱发严重\",\"vbrief\":\"成年人的世界，除了长胖和脱发容易，其他都不容易。我的冤种头发咋就先没了，528爱发日，一起呵护头顶的小可爱们吧！\",\"vcount\":0,\"vduration\":258,\"vid\":\"8dda9e3d0cb74bd7b85c6f079b7bf91c\",\"videoType\":0,\"vip_flag\":0,\"webUrl\":\"https://v.cctv.com/reping/bh/index.shtml\",\"wwwUrl\":\"https://v.cctv.com/2022/05/28/VIDEHtZXIz5HezlAwlZc93ve220528.shtml\"},{\"allowAd\":0,\"allowComment\":0,\"allowShare\":0,\"cateId\":\"18AzYZNf0926\",\"cateName\":\"热评\",\"cvid\":\"VIDEAB7bc1ym0T0rAUeGCgKu220522\",\"episodes\":0,\"fc\":\"原创\",\"feedType\":\"3\",\"guid\":\"dde29e6639b343eea0893d0f4117bdd9\",\"image1\":\"https://p2.img.cctvpic.com/apple3g/www/upload/image/20220522/1653212927028090187.jpg\",\"image2\":\"https://p2.img.cctvpic.com/apple3g/www/upload/image/20220522/1653212931026096695.jpg\",\"isCourse\":0,\"isSubed\":0,\"keywords\":\"动物,社会\",\"labelId\":\"18aiYZ3m0926\",\"likeCount\":0,\"mediaId\":\"18ryeuIb0926\",\"mediaImg\":\"https://p1.img.cctvpic.com/apple3g/www/upload/image/20260828/1787896006290088494.jpg\",\"mediaName\":\"比划\",\"pubTime\":1653212965320,\"pv\":\"\",\"sc\":\"\",\"seqId\":1653212965320,\"seqStrId\":\"1653212965320\",\"size\":\"16:9\",\"source\":0,\"subTitle\":\"\",\"title\":\"家门口的“神奇动物”为什么越来越多了\",\"vbrief\":\"15头亚洲象一路北上在云南“压马路”；东北虎“完达山一号”下山入村；千余貉在上海众多小区“落户”；顽皮野猴校园嬉戏、疯狂野猪都市狂飙……这几年，野生动物们为什么一改画风，从人迹罕至的深山老林频繁来到车水马龙的现代都市？\",\"vcount\":0,\"vduration\":217,\"vid\":\"d349c78a57c2487d81ab0e1c0358a782\",\"videoType\":0,\"vip_flag\":0,\"webUrl\":\"https://v.cctv.com/reping/bh/index.shtml\",\"wwwUrl\":\"https://v.cctv.com/2022/05/22/VIDEAB7bc1ym0T0rAUeGCgKu220522.shtml\"},{\"allowAd\":0,\"allowComment\":0,\"allowShare\":0,\"cateId\":\"18AzYZNf0926\",\"cateName\":\"热评\",\"cvid\":\"VIDE6qZFMq5PoRMM44O0pH8W220522\",\"episodes\":0,\"fc\":\"原创\",\"feedType\":\"3\",\"guid\":\"ecce1c58a8b5473c9e0661f4456288b6\",\"image1\":\"https://p3.img.cctvpic.com/apple3g/www/upload/image/20220522/1653175910488008471.jpg\",\"image2\":\"https://p2.img.cctvpic.com/apple3g/www/upload/image/20220522/1653175914952076361.jpg\",\"isCourse\":0,\"isSubed\":0,\"keywords\":\"袁隆平,吴孟超,悼念\",\"labelId\":\"18aiYZ3m0926\",\"likeCount\":0,\"mediaId\":\"18ryeuIb0926\",\"mediaImg\":\"https://p1.img.cctvpic.com/apple3g/www/upload/image/20260828/1787896006290088494.jpg\",\"mediaName\":\"比划\",\"pubTime\":1653175919862,\"pv\":\"\",\"sc\":\"\",\"seqId\":1653175919862,\"seqStrId\":\"1653175919862\",\"size\":\"16:9\",\"source\":0,\"subTitle\":\"\",\"title\":\"悼念︱袁隆平、吴孟超院士逝世一周年\",\"vbrief\":\"2021年5月22日，袁隆平、吴孟超两位院士离开了我们，双星陨落，举国同悲。仰望广袤的星空，宇宙中两颗小行星，编号8117——名叫袁隆平星，编号17606——名叫吴孟超星，精神不朽，依然璀璨。我们用3分钟回顾他们的一生。铭记，是最好的祭奠；传承，是最深的缅怀，赓续星光，不负先贤望白头。\",\"vcount\":0,\"vduration\":179,\"vid\":\"98308f5474a645b58713a5a936ad337a\",\"videoType\":0,\"vip_flag\":0,\"webUrl\":\"https://v.cctv.com/reping/bh/index.shtml\",\"wwwUrl\":\"https://v.cctv.com/2022/05/22/VIDE6qZFMq5PoRMM44O0pH8W220522.shtml\"},{\"allowAd\":0,\"allowComment\":0,\"allowShare\":0,\"cateId\":\"18AzYZNf0926\",\"cateName\":\"热评\",\"cvid\":\"VIDEFpWuk1wqQf8NEMbuYU4i220520\",\"episodes\":0,\"fc\":\"原创\",\"feedType\":\"3\",\"guid\":\"fd1a720e64ee4010a71c20ceba548d63\",\"image1\":\"https://p3.img.cctvpic.com/apple3g/www/upload/image/20220520/1653017401201052661.jpg\",\"image2\":\"https://p3.img.cctvpic.com/apple3g/www/upload/image/20220520/1653017405381013087.jpg\",\"isCourse\":0,\"isSubed\":0,\"keywords\":\"恋爱,动物\",\"labelId\":\"18aiYZ3m0926\",\"likeCount\":0,\"mediaId\":\"18ryeuIb0926\",\"mediaImg\":\"https://p1.img.cctvpic.com/apple3g/www/upload/image/20260828/1787896006290088494.jpg\",\"mediaName\":\"比划\",\"pubTime\":1653017446047,\"pv\":\"\",\"sc\":\"\",\"seqId\":1653017446047,\"seqStrId\":\"1653017446047\",\"size\":\"16:9\",\"source\":0,\"subTitle\":\"\",\"title\":\"不是我说哦 动物都比你会谈恋爱\",\"vbrief\":\"520被动物们的恋爱虐哭，这年头动物都比人会谈恋爱多了。\",\"vcount\":0,\"vduration\":155,\"vid\":\"cc5149f6cd6f4e688e0445b1190fb469\",\"videoType\":0,\"vip_flag\":0,\"webUrl\":\"https://v.cctv.com/reping/bh/index.shtml\",\"wwwUrl\":\"https://v.cctv.com/2022/05/20/VIDEFpWuk1wqQf8NEMbuYU4i220520.shtml\"},{\"allowAd\":0,\"allowComment\":0,\"allowShare\":0,\"cateId\":\"18AzYZNf0926\",\"cateName\":\"热评\",\"cvid\":\"VIDE1XoEcLQ1geBsk57XFnyU220516\",\"episodes\":0,\"fc\":\"原创\",\"feedType\":\"3\",\"guid\":\"70e34639310e4e3a9cdc5dd78b3d63fd\",\"image1\":\"https://p3.img.cctvpic.com/apple3g/www/upload/image/20220516/1652673545189039758.jpg\",\"image2\":\"https://p1.img.cctvpic.com/apple3g/www/upload/image/20220516/1652673549953044032.jpg\",\"isCourse\":0,\"isSubed\":0,\"keywords\":\"祝融号,火星,过冬\",\"labelId\":\"18aiYZ3m0926\",\"likeCount\":0,\"mediaId\":\"18ryeuIb0926\",\"mediaImg\":\"https://p1.img.cctvpic.com/apple3g/www/upload/image/20260828/1787896006290088494.jpg\",\"mediaName\":\"比划\",\"pubTime\":1652673610425,\"pv\":\"\",\"sc\":\"\",\"seqId\":1652673610425,\"seqStrId\":\"1652673610425\",\"size\":\"16:9\",\"source\":0,\"subTitle\":\"\",\"title\":\"祝融号火星上班打卡1周年 准备在火星过冬啦\",\"vbrief\":\"祝融号着陆火星上班打卡1周年!“地球家人们，沵們適①姩過嘚怎庅樣迡？”初夏时节里，正在火星上工作的“祝融号”火星车，将迎来它的第一个冬季——温度低至-100℃以下，长达6个月。和地球相比，火星的冬天是什么样子的，“当代火神”揣了哪些“法宝”来应对？\",\"vcount\":0,\"vduration\":262,\"vid\":\"a1c4e4f2da5e4766bc0bff796287d1a6\",\"videoType\":0,\"vip_flag\":0,\"webUrl\":\"https://v.cctv.com/reping/bh/index.shtml\",\"wwwUrl\":\"https://v.cctv.com/2022/05/16/VIDE1XoEcLQ1geBsk57XFnyU220516.shtml\"},{\"allowAd\":0,\