            "text" : "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, minimum-scale=1, user-scalable=no\">\n    <title>京彩不间断 时刻在眼前_北京时间</title>\n    <meta name=\"keywords\" content=\"\" />\n    <meta name=\"description\" content=\"\" />\n    <link rel=\"shortcut icon\" href=\"\" type=\"image/x-icon\">\n    <link type=\"text/css\" rel=\"stylesheet\" href=\"https://s3.ssl.qhres2.com/!01e65930/swiper4/css/swiper.min.css\" />\n    <script src=\"https://s2.ssl.qhres2.com/!01e65930/swiper4/js/swiper.min.js\"></script>\n    <!-- iconfont -->\n    <link rel=\"stylesheet\" type=\"text/css\" href=\"https://s5.ssl.qhres2.com/static/56f959a5d52afad4.css\">\n    <link rel=\"stylesheet\" href=\"//s3.ssl.qhres2.com/static/3bd97afdf55308b8/v5/common/reset.css\">\n    <link href=\"//s0.ssl.qhres2.com/static/94579dc4c404f109/v5/teshu_special_h5_bundle.css\" rel=\"stylesheet\">\n<link rel=\"stylesheet\" type=\"text/css\" href=\"//at.alicdn.com/t/font_2380581_v4v6k43u6ec.css\" />\n    <script src=\"//s1.ssl.qhres2.com/static/9b7767d66f99ee17/v5/libs/jquery-3.6.0.min.js\"></script>\n    <script src=\"https://static.btime.com/common/jssdk/monitor/monitor.js\"></script>\n    <script src=\"//s1.ssl.qhres2.com/!95ba8546/mobile_device.js\"></script>\n    <script type=\"text/javascript\" src=\"https://s0.ssl.qhres2.com/static/f95aa9fac72341eb.js\"></script>\n    <script type=\"text/javascript\" src=\"https://s0.ssl.qhres2.com/static/5eb61e019478efde.js\"></script>\n    <script src=\"https://s4.ssl.qhres2.com/!10801a25/feb/votes.js\"></script>\n    <script src=\"//s1.ssl.qhres2.com/static/c75e82004310a152/v5/libs/md5.js\"></script>\n    <script src=\"//res.wx.qq.com/open/js/jweixin-1.0.0.js\"></script>\n<script src=\"//qzonestyle.gtimg.cn/qzone/qzact/common/share/share.js\"></script>\n            <script src=\"https://turing.captcha.qcloud.com/TCaptcha.js\"></script>\n        <!-- <script src=\"https://turing.captcha.qcloud.com/TCaptcha.js\"></script> -->\n    <script type=\"text/javascript\">var Topic_shareConf = {\n            content: '' || '更多精彩，尽在北京时间APP',\n            title: '京彩不间断 时刻在眼前_北京时间',\n            imageurl: (\"https://p1.ssl.cdn.btime.com/t11a477708fb1977bfb73b2004d.png?size=1920x1080\" ? \"https://p1.ssl.cdn.btime.com/t11a477708fb1977bfb73b2004d.png?size=1920x1080\" : \"https://p1.ssl.cdn.btime.com/t01800424013ba883e5.png?size=148x148\"),\n            link: 'https://item.btime.com/f0r4fdej5qq9hbrttr129bduafb',\n        }\n        var player = {};\n        window.closePage = function(){\n           Object.keys(player).forEach(function(key) {\n             if (player[key] && player[key].pause) player[key].pause();\n           });\n        }</script><!--专题-->\n\n<script>var _hmt = _hmt || [];\n\t(function() {\n\t  var hm = document.createElement(\"script\");\n\t  hm.src = \"https://hm.baidu.com/hm.js?e2cf9dfe69d31b5760faf14b50853ac9\";\n\t  var s = document.getElementsByTagName(\"script\")[0]; \n\t  s.parentNode.insertBefore(hm, s);\n\t})();</script><!--北京时间 - 私有化火山--><!-- <script src=\"https://s4.ssl.qhres2.com/!dfa57588/monitor_volcengine.js\"></script> -->\n\n\n    \n</head>\n<body class=\"h5\">\n    <section class=\"header\" id=\"j-header\">\n        <div class=\"bar\">\n            <div class=\"bar-left\">\n                <p class=\"bar-left-logo\"></p>\n                <!-- <i class=\"logo iconfont bticon-logo\"></i> -->\n            </div>\n            <div class=\"bar-right\">\n                <span id=\"j_openapp\" class=\"bar-right-item\">打开App</span>\n                <!-- <span class=\"bar-right-item nav-control\"><i class=\"iconfont bticon-menu\"></i><i class=\"iconfont bticon-close\"></i></span> -->\n            </div>\n        </div>\n        <div id=\"j-nav-list\"></div>\n        <!-- <div id=\"nav_list\"></div> -->\n    </section>\n\n    <div class=\"module-container\">\n    </div>\n\n    <div class=\"footer\">\n        <p>Copyright &#169 2026 Btime.com, All Rights Reserved</p>\n        <p>关于北京时间 | 责任编辑韩薇</p>\n    </div>\n\n    <div class=\"modal\" id=\"j-wx-app\">\n        <img class=\"lazy\" data-original=\"/static/img/v5/wx_to_app.png\">\n    </div>\n\n<!-- banner -->\n\n<script type=\"text/html\" id=\"j-tpl-banner\">{{if data.appUrl}}\n    <section class=\"banner\" id=\"{{id}}\" bk_name=\"{{data.title}}\" data-slog=\"{{data.s_log}}\" data-sclog=\"{{data.sc_log}}\">\n        <img class=\"lazy\" data-original=\"{{cutter(data.appUrl,'750-420-100')}}\" src=\"//p0.ssl.qhimg.com/d/inn/f417f7be01a9/transparent.png\" width=\"100%\">\n    </section>\n    {{/if}}</script><!-- iframe -->\n\n\n<script type=\"text/html\" id=\"j-tpl-iframe\"><div class=\"mod\" id=\"{{id}}\" bk_name=\"{{data.title || title}}\" data-slog=\"{{data.s_log}}\" data-sclog=\"{{data.sc_log}}\">\n        {{if data.title}}\n            <div class=\"mod-hd\">\n                <div class=\"mod-hd-left\">\n                    <div class=\"title\">{{data.title}}</div>\n                </div>\n                <div class=\"mod-hd-right\">\n                {{if data.moreUrl}}\n                    <a class=\"more fr\" href=\"{{data.moreUrl}}\" target=\"_blank\">更多></a>\n                {{/if}}\n                </div>\n            </div>\n        {{/if}}\n        <div class=\"mod-bd\" style=\"height:{{data.height || 300}}px;overflow-y: scroll;\">\n            <iframe src=\"{{data.iframeUrl}}\" {{if data.canScroll}}scrolling=\"auto\" {{/if}} style=\"height: 100%;width: 100%;\" frameborder=\"no\" allowtransparency=\"true\"></iframe>\n        </div>\n    </div></script><!-- channel -->\n\n\n<script type=\"text/html\" id=\"j-tpl-channel\"><div class=\"nav-list\" id=\"{{id}}\" bk_name=\"{{data.title}}\" style=\"background:{{data.bgColor}}\" data-slog=\"{{data.s_log}}\" data-sclog=\"{{data.sc_log}}\">\n        {{each data.nav as item}}\n        <a class=\"nav-item\" href=\"{{item.link}}\" target=\"_self\">{{item.name}}</a>\n        {{/each}}\n    </div>\n    <div class=\"module_channel scrollNav\" id=\"{{id}}\" style=\"background:{{data.bgColor}}\" bk_name=\"{{data.title}}\" data-slog=\"{{data.s_log}}\" data-sclog=\"{{data.sc_log}}\">\n        <div class=\"channel_nav_box\">\n            <div class=\"swiper-containersss \">\n                <div class=\"swiper-wrapper\">\n                    {{each data.nav as item}}\n                        <a class=\"swiper-slide nav-item click_item {{$index == 0 ? 'back' : ''}}\" href=\"{{item.link}}\">\n                            <div class=\"text\">{{item.name}}</div>\n                        </a>\n                        <!-- <a class=\"nav-item\" href=\"{{item.link}}\" target=\"_self\">{{item.name}}</a> -->\n                    {{/each}}\n                </div>\n            </div>\n        </div>\n        \n    </div>\n    <div class=\"nav_more\" style=\"background:{{data.bgColor}}\"><span class=\"bar-right-item nav-control\"><i class=\"iconfont bticon-menu\"></i><i class=\"iconfont bticon-close\"></i></span></div></script><!-- 专题导航 --><!-- <script type=\"text/html\" id=\"j-tpl-channel\">\n    <div class=\"nav-list\" id=\"{{id}}\" bk_name=\"{{data.title}}\" data-slog=\"{{data.s_log}}\" data-sclog=\"{{data.sc_log}}\">\n        {{each data.nav as item}}\n        <a class=\"nav-item\" href=\"{{item.link}}\" target=\"_self\">{{item.name}}</a>\n        {{/each}}\n    </div>\n</script> --><!-- summary -->\n\n\n\n\n\n<script type=\"text/html\" id=\"j-tpl-summary\"><section class=\"summary\" id=\"{{id}}\" bk_name=\"{{data.title}}\" data-slog=\"{{data.s_log}}\" data-sclog=\"{{data.sc_log}}\">\n        {{if data.title}}\n        <div class=\"summary-hd\">\n            <div class=\"summary-hd-left\">\n                <div class=\"title\">{{data.title}}</div>\n            </div>\n            <div class=\"summary-hd-right\">\n                {{if data.smType && data.showMore}}\n                    {{if data.smType == 'gid'}}\n                      <a class=\"more fr\" href=\"https://item.btime.com/{{data.smGid}}\" target=\"_blank\">更多></a>\n                    {{/if}}\n                    {{if data.smType == 'list'}}\n                      <a class=\"more fr\" href=\"https://item.btime.com/{{gid}}/{{data.smList}}\" target=\"_blank\">更多></a>\n                    {{/if}}\n                    {{if data.smType == 'url'}}\n                      <a class=\"more fr\" href=\"{{data.smUrl}}\" target=\"_blank\">更多></a>\n                    {{/if}}\n                {{else}}\n                    {{if data.moreUrl}}\n                    <a class=\"more\" href=\"{{data.moreUrl}}\">更多></a>\n                    {{/if}}\n                {{/if}}\n            </div>\n        </div>\n        {{/if}}\n        <div class=\"summary_box\">\n            <div class=\"summary_content\">\n            {{data.summary}}\n\n            </div>\n            <i class=\"icon_showMore\">展开</i>\n        </div>\n    </section></script><!-- 带摘要头条 -->\n\n\n<script type=\"text/html\" id=\"j-tpl-headnews\"><div class=\"mod\" id=\"{{id}}\" bk_name=\"{{data.title || title}}\" data-slog=\"{{data.s_log}}\" data-sclog=\"{{data.sc_log}}\">\n        {{if data.title}}\n        <div class=\"mod-hd\">\n            <div class=\"mod-hd-left\">\n                <div class=\"title\">{{data.title}}</div>\n            </div>\n            <div class=\"mod-hd-right\">\n                {{if data.smType && data.showMore}}\n                    {{if data.smType == 'gid'}}\n                      <a class=\"more fr\" href=\"https://item.btime.com/{{data.smGid}}\" target=\"_blank\">更多></a>\n                    {{/if}}\n                    {{if data.smType == 'list'}}\n                      <a class=\"more fr\" href=\"https://item.btime.com/{{gid}}/{{data.smList}}\" target=\"_blank\">更多></a>\n                    {{/if}}\n                    {{if data.smType == 'url'}}\n                      <a class=\"more fr\" href=\"{{data.smUrl}}\" target=\"_blank\">更多></a>\n                    {{/if}}\n                {{else}}\n                    {{if data.moreUrl}}\n                    <a class=\"more\" href=\"{{data.moreUrl}}\">更多></a>\n                    {{/if}}\n                {{/if}}\n            </div>\n        </div>\n        {{/if}}\n        <div class=\"mod-bd\">\n            <div class=\"title-list\">\n                {{each data.news as item}}\n                <a class=\"title-item\" data-gid=\"{{item.gid}}\" data-slog=\"{{item.s_log}}\" data-sclog=\"{{item.sc_log}}\" href=\"{{item.open_url}}\">\n                    <div class=\"title\">{{item.data.title}}</div>\n                    {{if item.data.summary}}\n                    <div class=\"summary-text\">\n                        {{item.data.summary.slice(0, data.maxLength)}}{{if item.data.summary && item.data.summary.length>data.maxLength}}...{{/if}}\n                    </div>\n                    {{/if}}\n                    <div class=\"tags\">\n                        <span class=\"tag\">{{item.data.source}}</span>\n                        <span class=\"tag\">{{item.data.pdate_str}}</span>\n                    </div>\n                </a>\n                {{/each}}\n            </div>\n        </div>\n    </div></script><!-- 文字列表 -->\n\n\n<script type=\"text/html\" id=\"j-tpl-titlelist\"><div class=\"mod\" id=\"{{id}}\" bk_name=\"{{data.title || title}}\" data-slog=\"{{data.s_log}}\" data-sclog=\"{{data.sc_log}}\" data-id=\"{{id}}\" data-module-id=\"{{data.moduleId}}\">\n        {{if data.title}}\n        <div class=\"mod-hd\">\n            <div class=\"mod-hd-left\">\n                <div class=\"title\">{{data.title}}</div>\n            </div>\n            <div class=\"mod-hd-right\">\n                {{if data.showMore}}\n                    {{if data.smType == 'gid'}}\n                      <a class=\"more fr\" href=\"https://item.btime.com/{{data.smGid}}\" target=\"_blank\">更多></a>\n                    {{/if}}\n                    {{if data.smType == 'list'}}\n                      <a class=\"more fr\" href=\"https://item.btime.com/{{gid}}/{{data.smList}}\" target=\"_blank\">更多></a>\n                    {{/if}}\n                    {{if data.smType == 'url'}}\n                      <a class=\"more fr\" href=\"{{data.smUrl}}\" target=\"_blank\">更多></a>\n                    {{/if}}\n                {{else}}\n                    {{if data.moreUrl}}\n                    <a class=\"more\" href=\"{{data.moreUrl}}\">更多></a>\n                    {{/if}}\n                {{/if}}\n            </div>\n        </div>\n        {{/if}}\n        <div class=\"mod-bd\">\n            <div class=\"title-list\">\n                {{each data.news as item}}\n                <a class=\"title-item\" data-gid=\"{{item.gid}}\" data-slog=\"{{item.s_log}}\" data-sclog=\"{{item.sc_log}}\" href=\"{{item.open_url}}\">\n                    <div class=\"title\">{{item.data.title}}</div>\n                    <div class=\"tags\">\n                        <span class=\"tag\">{{item.data.source}}</span>\n                        <!-- <span class=\"tag\">{{item.data.pdate_str}}</span> -->\n                    </div>\n                </a>\n                {{/each}}\n            </div>\n            {{if data.news.length >= data.newsCount && data.paging == 1}}\n            <div class=\"load-more\">\n                加载更多+\n            </div>\n            {{/if}}\n        </div>\n    </div></script><!-- 焦点图1、焦点图2 -->\n\n\n<script type=\"text/html\" id=\"j-tpl-focus\"><div class=\"mod mod-nopadding\" id=\"{{id}}\" data-slog=\"{{data.s_log}}\" data-sclog=\"{{data.sc_log}}\" data-module-id=\"{{data.moduleId}}\" bk_name=\"{{data.title || title}}\">\n        {{if data.title}}\n            <div class=\"mod-hd\">\n                <div class=\"mod-hd-left\">\n                    <div class=\"title\">{{data.title}}</div>\n                </div>\n                <div class=\"mod-hd-right\">\n                    {{if data.showMore}}\n                        {{if data.smType == 'gid'}}\n                          <a class=\"more fr\" href=\"https://item.btime.com/{{data.smGid}}\" target=\"_blank\">更多></a>\n                        {{/if}}\n                        {{if data.smType == 'list'}}\n                          <a class=\"more fr\" href=\"https://item.btime.com/{{gid}}/{{data.smList}}\" target=\"_blank\">更多></a>\n                        {{/if}}\n                        {{if data.smType == 'url'}}\n                          <a class=\"more fr\" href=\"{{data.smUrl}}\" target=\"_blank\">更多></a>\n                        {{/if}}\n                    {{else}}\n                        {{if data.moreUrl}}\n                        <a class=\"more\" href=\"{{data.moreUrl}}\">更多></a>\n                        {{/if}}\n                    {{/if}}\n                </div>\n            </div>\n        {{/if}}\n        <div class=\"focus swiper-container\">\n        <div class=\"swiper-wrapper\">\n            {{each data.news as item}}\n            <a class=\"swiper-slide\" data-gid=\"{{item.gid}}\" data-slog=\"{{item.s_log}}\" data-sclog=\"{{item.sc_log}}\" href=\"{{item.open_url}}\">\n                <img class=\"swiper-lazy\" data-src=\"{{cutter(item.data.covers[0],data.moduleId\n == 'artificial_475l29p6de9ue8ln5q3ioq9eq1' ? '750-562-50': '750-376-50')}}\">\n                <div class=\"text\">{{item.data.title}}</div>\n                <div class=\"swiper-lazy-preloader swiper-lazy-preloader-white\"></div>\n            </a>\n            {{/each}}\n        </div>\n        <div class=\"swiper-pagination\"></div>\n    </div>\n    </div></script><!-- 上文下图 -->\n\n\n<script type=\"text/html\" id=\"j-tpl-ttbp\"><div class=\"mod\" id=\"{{id}}\" bk_name=\"{{data.title || title}}\" data-slog=\"{{data.s_log}}\" data-sclog=\"{{data.sc_log}}\" data-module-id=\"{{data.moduleId}}\" data-id=\"{{id}}\">\n        {{if data.title}}\n        <div class=\"mod-hd\">\n            <div class=\"mod-hd-left\">\n                <div class=\"title\">{{data.title}}</div>\n            </div>\n            <div class=\"mod-hd-right\">\n                {{if data.showMore}}\n                    {{if data.smType == 'gid'}}\n                      <a class=\"more fr\" href=\"https://item.btime.com/{{data.smGid}}\" target=\"_blank\">更多></a>\n                    {{/if}}\n                    {{if data.smType == 'list'}}\n                      <a class=\"more fr\" href=\"https://item.btime.com/{{gid}}/{{data.smList}}\" target=\"_blank\">更多></a>\n                    {{/if}}\n                    {{if data.smType == 'url'}}\n                      <a class=\"more fr\" href=\"{{data.smUrl}}\" target=\"_blank\">更多></a>\n                    {{/if}}\n                {{else}}\n                    {{if data.moreUrl}}\n                    <a class=\"more\" href=\"{{data.moreUrl}}\">更多></a>\n                    {{/if}}\n                {{/if}}\n            </div>\n        </div>\n        {{/if}}\n        <div class=\"mod-bd\">\n            <div class=\"ttbp-list\">\n                {{each data.news as item}}\n                <a class=\"tpbt-item\" data-gid=\"{{item.gid}}\" data-slog=\"{{item.s_log}}\" data-sclog=\"{{item.sc_log}}\" href=\"{{item.open_url}}\">\n                    \n                    <div class=\"title\">\n                        {{item.data.title}}\n                    </div>\n                    <div class=\"img-box\">\n                        <img class=\"lazy\" src=\"{{cutter(item.data.covers[0],'355-266-100')}}\">\n                        {{if item.type==3 || item.type==6}}<i class=\"iconfont icon-icon_play_\"></i>{{/if}}\n                    </div>\n                </a>\n                {{/each}}\n            </div>\n            {{if data.news.length >= data.newsCount && data.paging == 1}}\n            <div class=\"load-more\">\n                加载更多+\n            </div>\n            {{/if}}\n        </div>\n    </div></script><!-- 上图下文 -->\n\n\n<script type=\"text/html\" id=\"j-tpl-tpbt\"><div class=\"mod\" id=\"{{id}}\" bk_name=\"{{data.title || title}}\" data-slog=\"{{data.s_log}}\" data-sclog=\"{{data.sc_log}}\" data-module-id=\"{{data.moduleId}}\" data-id=\"{{id}}\">\n        {{if data.title}}\n        <div class=\"mod-hd\">\n            <div class=\"mod-hd-left\">\n                <div class=\"title\">{{data.title}}</div>\n            </div>\n            <div class=\"mod-hd-right\">\n                {{if data.showMore}}\n                    {{if data.smType == 'gid'}}\n                      <a class=\"more fr\" href=\"https://item.btime.com/{{data.smGid}}\" target=\"_blank\">更多></a>\n                    {{/if}}\n                    {{if data.smType == 'list'}}\n                      <a class=\"more fr\" href=\"https://item.btime.com/{{gid}}/{{data.smList}}\" target=\"_blank\">更多></a>\n                    {{/if}}\n                    {{if data.smType == 'url'}}\n                      <a class=\"more fr\" href=\"{{data.smUrl}}\" target=\"_blank\">更多></a>\n                    {{/if}}\n                {{else}}\n                    {{if data.moreUrl}}\n                    <a class=\"more\" href=\"{{data.moreUrl}}\">更多></a>\n                    {{/if}}\n                {{/if}}\n            </div>\n        </div>\n        {{/if}}\n        <div class=\"mod-bd\">\n            <div class=\"tpbt-list\">\n                {{each data.news as item}}\n                <a class=\"tpbt-item\" data-gid=\"{{item.gid}}\" data-slog=\"{{item.s_log}}\" data-sclog=\"{{item.sc_log}}\" href=\"{{item.open_url}}\">\n                    <div class=\"img-box\">\n                        <img class=\"lazy\" data-original=\"{{cutter(item.data.covers[0],'340-192-50')}}\" src=\"//p0.ssl.qhimg.com/d/inn/f417f7be01a9/transparent.png\">\n                        {{if item.type==3 || item.type==6}}<i class=\"iconfont icon-icon_play_\"></i>{{/if}}\n                    </div>\n                    <div class=\"title\">\n                        {{item.data.title}}\n                    </div>\n                </a>\n                {{/each}}\n            </div>\n            {{if data.news.length >= data.newsCount && data.paging == 1}}\n            <div class=\"load-more\">\n                加载更多+\n            </div>\n            {{/if}}\n        </div>\n    </div></script><!-- 左图右文 -->\n\n\n<script type=\"text/html\" id=\"j-tpl-tuwen\"><div class=\"mod\" id=\"{{id}}\" bk_name=\"{{data.title || title}}\" data-slog=\"{{data.s_log}}\" data-sclog=\"{{data.sc_log}}\" data-module-id=\"{{data.moduleId}}\" data-id=\"{{id}}\">\n        {{if data.title}}\n        <div class=\"mod-hd\">\n            <div class=\"mod-hd-left\">\n                <div class=\"title\">{{data.title}}</div>\n            </div>\n            <div class=\"mod-hd-right\">\n                {{if data.smType && data.showMore}}\n                    {{if data.smType == 'gid'}}\n                      <a class=\"more fr\" href=\"https://item.btime.com/{{data.smGid}}\" target=\"_blank\">更多></a>\n                    {{/if}}\n                    {{if data.smType == 'list'}}\n                      <a class=\"more fr\" href=\"https://item.btime.com/{{gid}}/{{data.smList}}\" target=\"_blank\">更多></a>\n                    {{/if}}\n                    {{if data.smType == 'url'}}\n                      <a class=\"more fr\" href=\"{{data.smUrl}}\" target=\"_blank\">更多></a>\n                    {{/if}}\n                {{else}}\n                    {{if data.moreUrl}}\n                    <a class=\"more\" href=\"{{data.moreUrl}}\">更多></a>\n                    {{/if}}\n                {{/if}}\n            </div>\n        </div>\n        {{/if}}\n        <div class=\"mod-bd\">\n            <div class=\"tuwen-list\">\n                {{each data.news as item}}\n                <a class=\"tuwen-item\" data-gid=\"{{item.gid}}\" data-slog=\"{{item.s_log}}\" data-sclog=\"{{item.sc_log}}\" href=\"{{item.open_url}}\">\n                    <div class=\"tuwen-left\">\n                        <div class=\"title\">{{item.data.title}}</div>\n                        <div class=\"tags\">\n                            <span class=\"tag\">{{item.data.source}}</span>\n                            <span class=\"tag\">{{item.data.pdate_str}}</span>\n                        </div>\n                    </div>\n                    <div class=\"tuwen-right\">\n                        <img class=\"lazy\" data-original=\"{{cutter(item.data.covers[0],'236-148-50')}}\" src=\"//p0.ssl.qhimg.com/d/inn/f417f7be01a9/transparent.png\">\n                        {{if item.type==3 || item.type==6}}<i class=\"iconfont icon-icon_play_\"></i>{{/if}}\n                    </div>\n                </a>\n                {{/each}}\n            </div>\n            {{if data.news.length >= data.newsCount && data.paging == 1}}\n            <div class=\"load-more\">\n                加载更多+\n            </div>\n            {{/if}}\n        </div>\n\n    </div></script><!-- 征集活动 -->\n\n\n<script type=\"text/html\" id=\"j-tpl-activity\"><div class=\"mod\" id=\"{{id}}\" bk_name=\"{{data.title || title}}\" data-slog=\"{{data.s_log}}\" data-sclog=\"{{data.sc_log}}\" data-id=\"{{id}}\">\n        {{if data.title}}\n        <div class=\"mod-hd\">\n            <div class=\"mod-hd-left\">\n                <div class=\"title\">{{data.title}}</div>\n            </div>\n            <div class=\"mod-hd-right\">\n                {{if data.smType && data.showMore}}\n                    {{if data.smType == 'gid'}}\n                      <a class=\"more fr\" href=\"https://item.btime.com/{{data.smGid}}\" target=\"_blank\">更多></a>\n                    {{/if}}\n                    {{if data.smType == 'list'}}\n                      <a class=\"more fr\" href=\"https://item.btime.com/{{gid}}/{{data.smList}}\" target=\"_blank\">更多></a>\n                    {{/if}}\n                    {{if data.smType == 'url'}}\n                      <a class=\"more fr\" href=\"{{data.smUrl}}\" target=\"_blank\">更多></a>\n                    {{/if}}\n                {{else}}\n                    {{if data.moreUrl}}\n                    <a class=\"more\" href=\"{{data.moreUrl}}\">更多></a>\n                    {{/if}}\n                {{/if}}\n            </div>\n        </div>\n        {{/if}}\n        <div class=\"mod-bd\">\n            <div class=\"activity-list\">\n                {{each data.news as item}}\n                <a href=\"//h5.btime.com/active/media?gid={{item.activity_gid}}&id={{item.product_gid}}\" class=\"activity-item\" data-gid=\"{{item.activity_gid}}\" data-id=\"{{item.product_gid}}\" data-subid=\"{{item.subj_id}}\" data-itemid=\"{{item.item_id}}\">\n                    <div class=\"product-cover\" style=\"background-image: url({{cutter(item.cover,'340-192-100')}})\">\n                        <span class=\"list-num\">NO.{{item.product_id}}</span>\n                        {{if item.type == 3}}\n                        <div class=\"video-icon\"></div>\n                        {{/if}}\n                    </div>\n                    <div class=\"product-info\">\n                        <div class=\"info-content\">\n                            <p class=\"product-title\">{{item.title}}</p>\n                            {{if data.activityData.uploader_info*1 != 2}}\n                            <!-- 美丽乡村活动  北京影响力 gid特殊处理 -->\n                                {{if [\"f5ic65pn9st8s0o1v8543570ufv\",\"f1mtarhbigp8do86pslj5rt7p1m\",\"f1tiqhastuc9k0qjl85vdur753u\", \"f77bb4uqahc8eg8rs0jdihjhrpi\", \"f07c9f8c24t9b2alo1lrn4qg0is\", \"f63j81g30g08u39bafq8dkhtk9t\", \"f0pqeilo3ef8vj8kcv502150isb\", \"f08uq6ebehs9fsa7j0e9v773pqd\", , \"f7gbu4aol509r5otuj758r2mq6c\", \"f7do1jhub2k99vpo6ld3vun3m0j\"].indexOf(item.activity_gid)== -1}}\n                                    <p class=\"product-author\">{{item.source}}</p>\n                                {{/if}}\n                            {{/if}}\n                        </div>\n                        <!-- 投票部分 -->\n                        {{if item.activity_gid == 'f08uq6ebehs9fsa7j0e9v773pqd'}}\n                        <div class=\"product-vote\" style=\"border:0;\">\n                            <span class=\"vote-count canvote\">\n                                <em>{{item.vote_count}}</em>\n                                {{if [\"f5ic65pn9st8s0o1v8543570ufv\", \"f1mtarhbigp8do86pslj5rt7p1m\", \"f08uq6ebehs9fsa7j0e9v773pqd\", \"f7gbu4aol509r5otuj758r2mq6c\", \"f7do1jhub2k99vpo6ld3vun3m0j\"\n\t\t\t\t\t\t\t\t, \"f2lpuam9qap9tpa2g29ir0rolhm\"\n\t\t\t\t\t\t\t\t, \"f2sr0nn1r548bbos8mibmoj1737\"\n\t\t\t\t\t\t\t\t, \"f23kpepk3fi8lia5nade50s8tpm\"\n\t\t\t\t\t\t\t\t, \"f6pid68luh19tba7qu7uqabp47u\"\n\t\t\t\t\t\t\t\t, \"f310899aka884c9gq8por2m5b9t\"\n\t\t\t\t\t\t\t\t, \"f51ahb8paqj8jua82urcjgrcb1c\"\n\t\t\t\t\t\t\t\t, \"f3piujodmjl9rqpnrmlb7cgqog0\"\n\t\t\t\t\t\t\t\t, \"f3dtv2brk719ap8elan1ek4bqaj\"\n\t\t\t\t\t\t\t\t, \"f4vphi6e9t19239k3g6al29tnkf\"\n\t\t\t\t\t\t\t\t, \"f16epra4u2r8949ht3hscu2q4sj\"\n\t\t\t\t\t\t\t\t, \"f6k594v1p5n8d8amb5ta6as9h6a\"\n\t\t\t\t\t\t\t\t, \"f2nqjlaaji38uma109tvo2mrn87\"\n\t\t\t\t\t\t\t\t, \"f7l3dsqpdq19hm88u9pd5dn7rkl\"\n\t\t\t\t\t\t\t\t, \"f614uqnjdh5942qc2icb429o02a\"\n\t\t\t\t\t\t\t\t, \"f3dtpdmtb348u1prpo2gth94139\"\n\t\t\t\t\t\t\t\t, \"f53a8gdca2i83gpmg7v7easdhq7\"\n\t\t\t\t\t\t\t\t, \"f6nfmic74cn8o482p2bls3qkj8b\"\n                                , \"f6vl5dv21qa86mag5skffpdej7p\"\n                                , \"f72jjljmuvt93o8h9hfnqfvjhd1\"\n                                , \"f37vd3e73pv9c3oshsageiuq6ua\"\n                                , \"f3d1b7imrqt8ilb8nte5bstqm6j\"\n                                , \"f7gdmdtbutu965qj50tvrrmbkjr\"].indexOf(item.activity_gid)!= -1}}\n                                    <img src=\"https://p1.ssl.qhimg.com/t0195d0b4692c7fee4a.png\">\n                                {{else}}\n                                    票\n                                {{/if}}\n                            </span>\n                            <div class=\"vote-btn\">\n                                {{if [\"f5ic65pn9st8s0o1v8543570ufv\", \"f1mtarhbigp8do86pslj5rt7p1m\", \"f08uq6ebehs9fsa7j0e9v773pqd\", \"f7gbu4aol509r5otuj758r2mq6c\", \"f7do1jhub2k99vpo6ld3vun3m0j\"\n\t\t\t\t\t\t\t\t, \"f2lpuam9qap9tpa2g29ir0rolhm\"\n\t\t\t\t\t\t\t\t, \"f2sr0nn1r548bbos8mibmoj1737\"\n\t\t\t\t\t\t\t\t, \"f23kpepk3fi8lia5nade50s8tpm\"\n\t\t\t\t\t\t\t\t, \"f6pid68luh19tba7qu7uqabp47u\"\n\t\t\t\t\t\t\t\t, \"f310899aka884c9gq8por2m5b9t\"\n\t\t\t\t\t\t\t\t, \"f51ahb8paqj8jua82urcjgrcb1c\"\n\t\t\t\t\t\t\t\t, \"f3piujodmjl9rqpnrmlb7cgqog0\"\n\t\t\t\t\t\t\t\t, \"f3dtv2brk719ap8elan1ek4bqaj\"\n\t\t\t\t\t\t\t\t, \"f4vphi6e9t19239k3g6al29tnkf\"\n\t\t\t\t\t\t\t\t, \"f16epra4u2r8949ht3hscu2q4sj\"\n\t\t\t\t\t\t\t\t, \"f6k594v1p5n8d8amb5ta6as9h6a\"\n\t\t\t\t\t\t\t\t, \"f2nqjlaaji38uma109tvo2mrn87\"\n\t\t\t\t\t\t\t\t, \"f7l3dsqpdq19hm88u9pd5dn7rkl\"\n\t\t\t\t\t\t\t\t, \"f614uqnjdh5942qc2icb429o02a\"\n\t\t\t\t\t\t\t\t, \"f3dtpdmtb348u1prpo2gth94139\"\n\t\t\t\t\t\t\t\t, \"f53a8gdca2i83gpmg7v7easdhq7\"\n\t\t\t\t\t\t\t\t, \"f6nfmic74cn8o482p2bls3qkj8b\"\n                                , \"f6vl5dv21qa86mag5skffpdej7p\"\n                                , \"f72jjljmuvt93o8h9hfnqfvjhd1\"\n                                , \"f37vd3e73pv9c3oshsageiuq6ua\"\n                                , \"f3d1b7imrqt8ilb8nte5bstqm6j\"\n                                , \"f7gdmdtbutu965qj50tvrrmbkjr\"].indexOf(item.activity_gid)!= -1}}\n                                    点赞\n                                {{else}}\n                                    投票\n                                {{/if}}\n                            </div>\n                        </div>\n                        {{else if data.activityData.is_vote == 1}}\n                        <div class=\"product-vote\">\n                            <span class=\"vote-count canvote\">\n                                <em>{{item.vote_count}}</em>\n                                {{if [\"f5ic65pn9st8s0o1v8543570ufv\", \"f1mtarhbigp8do86pslj5rt7p1m\", \"f08uq6ebehs9fsa7j0e9v773pqd\", \"f7gbu4aol509r5otuj758r2mq6c\", \"f7do1jhub2k99vpo6ld3vun3m0j\"\n\t\t\t\t\t\t\t\t, \"f2lpuam9qap9tpa2g29ir0rolhm\"\n\t\t\t\t\t\t\t\t, \"f2sr0nn1r548bbos8mibmoj1737\"\n\t\t\t\t\t\t\t\t, \"f23kpepk3fi8lia5nade50s8tpm\"\n\t\t\t\t\t\t\t\t, \"f6pid68luh19tba7qu7uqabp47u\"\n\t\t\t\t\t\t\t\t, \"f310899aka884c9gq8por2m5b9t\"\n\t\t\t\t\t\t\t\t, \"f51ahb8paqj8jua82urcjgrcb1c\"\n\t\t\t\t\t\t\t\t, \"f3piujodmjl9rqpnrmlb7cgqog0\"\n\t\t\t\t\t\t\t\t, \"f3dtv2brk719ap8elan1ek4bqaj\"\n\t\t\t\t\t\t\t\t, \"f4vphi6e9t19239k3g6al29tnkf\"\n\t\t\t\t\t\t\t\t, \"f16epra4u2r8949ht3hscu2q4sj\"\n\t\t\t\t\t\t\t\t, \"f6k594v1p5n8d8amb5ta6as9h6a\"\n\t\t\t\t\t\t\t\t, \"f2nqjlaaji38uma109tvo2mrn87\"\n\t\t\t\t\t\t\t\t, \"f7l3dsqpdq19hm88u9pd5dn7rkl\"\n\t\t\t\t\t\t\t\t, \"f614uqnjdh5942qc2icb429o02a\"\n\t\t\t\t\t\t\t\t, \"f3dtpdmtb348u1prpo2gth94139\"\n\t\t\t\t\t\t\t\t, \"f53a8gdca2i83gpmg7v7easdhq7\"\n\t\t\t\t\t\t\t\t, \"f6nfmic74cn8o482p2bls3qkj8b\"\n                                , \"f6vl5dv21qa86mag5skffpdej7p\"\n                                , \"f72jjljmuvt93o8h9hfnqfvjhd1\"\n                                , \"f37vd3e73pv9c3oshsageiuq6ua\"\n                                , \"f3d1b7imrqt8ilb8nte5bstqm6j\"\n                                , \"f7gdmdtbutu965qj50tvrrmbkjr\"].indexOf(item.activity_gid)!= -1}}\n                                    <img src=\"https://p1.ssl.qhimg.com/t0195d0b4692c7fee4a.png\">\n                                {{else}}\n                                    票\n                                {{/if}}\n                            </span>\n                            <div class=\"vote-btn\">\n                                {{if [\"f5ic65pn9st8s0o1v8543570ufv\", \"f1mtarhbigp8do86pslj5rt7p1m\", \"f08uq6ebehs9fsa7j0e9v773pqd\", \"f7gbu4aol509r5otuj758r2mq6c\", \"f7do1jhub2k99vpo6ld3vun3m0j\"\n\t\t\t\t\t\t\t\t, \"f2lpuam9qap9tpa2g29ir0rolhm\"\n\t\t\t\t\t\t\t\t, \"f2sr0nn1r548bbos8mibmoj1737\"\n\t\t\t\t\t\t\t\t, \"f23kpepk3fi8lia5nade50s8tpm\"\n\t\t\t\t\t\t\t\t, \"f6pid68luh19tba7qu7uqabp47u\"\n\t\t\t\t\t\t\t\t, \"f310899aka884c9gq8por2m5b9t\"\n\t\t\t\t\t\t\t\t, \"f51ahb8paqj8jua82urcjgrcb1c\"\n\t\t\t\t\t\t\t\t, \"f3piujodmjl9rqpnrmlb7cgqog0\"\n\t\t\t\t\t\t\t\t, \"f3dtv2brk719ap8elan1ek4bqaj\"\n\t\t\t\t\t\t\t\t, \"f4vphi6e9t19239k3g6al29tnkf\"\n\t\t\t\t\t\t\t\t, \"f16epra4u2r8949ht3hscu2q4sj\"\n\t\t\t\t\t\t\t\t, \"f6k594v1p5n8d8amb5ta6as9h6a\"\n\t\t\t\t\t\t\t\t, \"f2nqjlaaji38uma109tvo2mrn87\"\n\t\t\t\t\t\t\t\t, \"f7l3dsqpdq19hm88u9pd5dn7rkl\"\n\t\t\t\t\t\t\t\t, \"f614uqnjdh5942qc2icb429o02a\"\n\t\t\t\t\t\t\t\t, \"f3dtpdmtb348u1prpo2gth94139\"\n\t\t\t\t\t\t\t\t, \"f53a8gdca2i83gpmg7v7easdhq7\"\n\t\t\t\t\t\t\t\t, \"f6nfmic74cn8o482p2bls3qkj8b\"\n                                , \"f6vl5dv21qa86mag5skffpdej7p\"\n                                , \"f72jjljmuvt93o8h9hfnqfvjhd1\"\n                                , \"f37vd3e73pv9c3oshsageiuq6ua\"\n                                , \"f3d1b7imrqt8ilb8nte5bstqm6j\"\n                                , \"f7gdmdtbutu965qj50tvrrmbkjr\"\n\t\t\t\t\t\t\t\t].indexOf(item.activity_gid)!= -1}}\n                                    点赞\n                                {{else}}\n                                    投票\n                                {{/if}}\n                            </div>\n                        </div>\n                        {{/if}}\n                    </div>\n                </a>\n                {{/each}}\n            </div>\n            {{if data.news.length >= data.productCount && data.paging == 1}}\n            <div class=\"load-more\">\n                加载更多+\n            </div>\n            {{/if}}\n        </div>\n    </div></script><!-- 视频 -->\n\n\n<script type=\"text/html\" id=\"j-tpl-video\"><div class=\"mod\" id=\"{{id}}\" bk_name=\"{{data.title || title}}\" data-slog=\"{{data.s_log}}\" data-sclog=\"{{data.sc_log}}\">\n        {{if data.title}}\n        <div class=\"mod-hd\">\n            <div class=\"mod-hd-left\">\n                <div class=\"title\">{{data.title}}</div>\n            </div>\n            <div class=\"mod-hd-right\">\n                {{if data.smType && data.showMore}}\n                    {{if data.smType == 'gid'}}\n                      <a class=\"more fr\" href=\"https://item.btime.com/{{data.smGid}}\" target=\"_blank\">更多></a>\n                    {{/if}}\n                    {{if data.smType == 'list'}}\n                      <a class=\"more fr\" href=\"https://item.btime.com/{{gid}}/{{data.smList}}\" target=\"_blank\">更多></a>\n                    {{/if}}\n                    {{if data.smType == 'url'}}\n                      <a class=\"more fr\" href=\"{{data.smUrl}}\" target=\"_blank\">更多></a>\n                    {{/if}}\n                {{else}}\n                    {{if data.moreUrl}}\n                    <a class=\"more\" href=\"{{data.moreUrl}}\">更多></a>\n                    {{/if}}\n                {{/if}}\n            </div>\n        </div>\n        {{/if}}\n        <div class=\"mod-bd\">\n            <div class=\"video-box\" data-src=\"{{data.stream}}\" data-poster=\"{{cutter(data.cover,'750-422-50')}}\" bk_name=\"{{title}}\">\n                <div id=\"video\"></div>\n                \n            </div>\n        </div>\n    </div></script><!-- 关键词 -->\n\n\n<script type=\"text/html\" id=\"j-tpl-hotwords\"><div class=\"mod\" id=\"{{id}}\" bk_name=\"{{data.title || title}}\" data-slog=\"{{data.s_log}}\" data-sclog=\"{{data.sc_log}}\">\n        {{if data.title}}\n        <div class=\"mod-hd\">\n            <div class=\"mod-hd-left\">\n                <div class=\"title\">{{data.title}}</div>\n            </div>\n            <div class=\"mod-hd-right\">\n                {{if data.smType && data.showMore}}\n                    {{if data.smType == 'gid'}}\n                      <a class=\"more fr\" href=\"https://item.btime.com/{{data.smGid}}\" target=\"_blank\">更多></a>\n                    {{/if}}\n                    {{if data.smType == 'list'}}\n                      <a class=\"more fr\" href=\"https://item.btime.com/{{gid}}/{{data.smList}}\" target=\"_blank\">更多></a>\n                    {{/if}}\n                    {{if data.smType == 'url'}}\n                      <a class=\"more fr\" href=\"{{data.smUrl}}\" target=\"_blank\">更多></a>\n                    {{/if}}\n                {{else}}\n                    {{if data.moreUrl}}\n                    <a class=\"more\" href=\"{{data.moreUrl}}\">更多></a>\n                    {{/if}}\n                {{/if}}\n            </div>\n        </div>\n        {{/if}}\n        <div class=\"mod-bd\">\n            <ul class='hotwords-list clearfix'>\n                {{if list = data.hotwords.split(',')}} {{/if}}\n                {{each list as title}}\n                <li data-keyword=\"{{title}}\">{{title}}</li>\n                {{/each}}\n            </ul>\n        </div>\n    </div></script><!-- 图片广告 -->\n\n\n<script type=\"text/html\" id=\"j-tpl-ads_1\"><div class=\"mod mod-nopadding\" id=\"{{id}}\" bk_name=\"{{title}}\" data-slog=\"{{data.s_log}}\" data-sclog=\"{{data.sc_log}}\">\n        {{if data.title}}\n        <div class=\"mod-hd\">\n            <div class=\"mod-hd-left\">\n                <div class=\"title\">{{data.title}}</div>\n            </div>\n            <div class=\"mod-hd-right\">\n            </div>\n        </div>\n        {{/if}}\n        {{if data.smType && data.showMore}}\n            {{if data.smType == 'gid'}}\n              <a data-url=\"{{data.linkUrl}}\" href=\"{{data.linkUrl}}\" target=\"_blank\">\n                  <img class=\"lazy\" data-original=\"{{data.adsImg}}\" src=\"//p0.ssl.qhimg.com/d/inn/f417f7be01a9/transparent.png\" width=\"100%\">\n              </a>\n            {{/if}}\n            {{if data.smType == 'list'}}\n              <a data-url=\"{{data.linkUrl}}\" href=\"{{data.linkUrl}}\" target=\"_blank\">\n                  <img class=\"lazy\" data-original=\"{{data.adsImg}}\" src=\"//p0.ssl.qhimg.com/d/inn/f417f7be01a9/transparent.png\" width=\"100%\">\n              </a>\n            {{/if}}\n            {{if data.smType == 'url'}}\n              <a data-url=\"{{data.linkUrl}}\" href=\"{{data.linkUrl}}\" target=\"_blank\">\n                  <img class=\"lazy\" data-original=\"{{data.adsImg}}\" src=\"//p0.ssl.qhimg.com/d/inn/f417f7be01a9/transparent.png\" width=\"100%\">\n              </a>\n            {{/if}}\n        {{else}}\n            {{if data.adsLink}}\n                <a class=\"more\" data-url=\"{{data.adsLink}}\" href=\"{{data.linkUrl}}\">\n                    <img class=\"lazy\" data-original=\"{{data.adsImg}}\" src=\"//p0.ssl.qhimg.com/d/inn/f417f7be01a9/transparent.png\" width=\"100%\">\n                </a>\n            {{else}}\n                <a class=\"more\">\n                    <img class=\"lazy\" data-original=\"{{data.adsImg}}\" src=\"//p0.ssl.qhimg.com/d/inn/f417f7be01a9/transparent.png\" width=\"100%\">\n                </a>\n            {{/if}}\n        {{/if}}\n    </div></script><!-- 代码广告 -->\n\n\n<script type=\"text/html\" id=\"j-tpl-ads_2\"><div class=\"mod\" id=\"{{id}}\" bk_name=\"{{title}}\" data-slog=\"{{data.s_log}}\" data-sclog=\"{{data.sc_log}}\">\n        {{if data.title}}\n        <div class=\"mod-hd\">\n            <div class=\"mod-hd-left\">\n                <div class=\"title\">{{data.title}}</div>\n            </div>\n            <div class=\"mod-hd-right\">\n                {{if data.smType && data.showMore}}\n                    {{if data.smType == 'gid'}}\n                      <a class=\"more fr\" href=\"https://item.btime.com/{{data.smGid}}\" target=\"_blank\">更多></a>\n                    {{/if}}\n                    {{if data.smType == 'list'}}\n                      <a class=\"more fr\" href=\"https://item.btime.com/{{gid}}/{{data.smList}}\" target=\"_blank\">更多></a>\n                    {{/if}}\n                    {{if data.smType == 'url'}}\n                      <a class=\"more fr\" href=\"{{data.smUrl}}\" target=\"_blank\">更多></a>\n                    {{/if}}\n                {{else}}\n                    {{if data.moreUrl}}\n                    <a class=\"more\" href=\"{{data.moreUrl}}\">更多></a>\n                    {{/if}}\n                {{/if}}\n            </div>\n        </div>\n        {{/if}}\n        {{#data.code}}\n    </div></script><!-- 评论 -->\n\n\n<script type=\"text/html\" id=\"j-tpl-comment\"><div id=\"{{id}}\" class=\"comment-amount\" bk_name=\"{{title}}\" data-slog=\"{{data.s_log}}\" data-sclog=\"{{data.sc_log}}\" data-title=\"{{data.title}}\"></div></script><!-- 版块导航 -->\n\n\n<script type=\"text/html\" id=\"j-tpl-module_nav\"><div></div></script><!-- 版块导航 -->\n\n\n\n<script type=\"text/html\" id=\"j-tpl-module_nav_scroll\"><div class=\"module_nav module_nav_scroll scrollNav\" style=\"display:none\">\n        <div class=\"line\"></div>\n        <div class=\"swiper-containerss \">\n            <div class=\"swiper-wrapper\">\n\n            </div>\n        </div>\n    </div></script><!-- 版块导航 -->\n\n\n<script type=\"text/html\" id=\"j-tpl-module_nav_type1\"><style>.module_nav_type1.module_nav_{{id}}{background:url(\"{{data.backImage}}\") no-repeat center {{data.backDirection == 'fill' ? 'center' : (data.backDirection || 'top')}}/100% {{data.backDirection == 'fill' ? '100%' : 'auto'}};background-color:{{data.bgColor || 'FFFFFF'}}}\n        .module_nav_type1.module_nav_{{id}} a.swiper-slide{color:#{{data.fontColor}}}\n        .module_nav_type1.module_nav_{{id}} a.swiper-slide:hover,\n        .module_nav_type1.module_nav_{{id}} a.swiper-slide.active{color:#{{data.fontColor}}}</style>\n    <div class=\"module_nav module_nav_type1 module_nav_{{id}}\">\n        <div class=\"line\"></div>\n        <div class=\"swiper-containers\">\n            <div class=\"swiper-wrapper\" id=\"{{'module_nav_' + id}}\">\n\n            </div>\n        </div>\n    </div></script><!-- 版块导航 -->\n\n<script type=\"text/html\" id=\"j-tpl-module_nav_type2\"><style>.module_nav_type2.module_nav_{{id}}{\n            background:url(\"{{data.backImage}}\") no-repeat center {{data.backDirection == 'fill' ? 'center' : (data.backDirection || 'top')}}/100% {{data.backDirection == 'fill' ? '100%' : 'auto'}};\n            background-color:{{data.bgColor || 'FFFFFF'}}\n        }\n        {{if (data.itemBackImage)}}\n        .module_nav_type2.module_nav_{{id}} a.item{background:url(\"{{data.itemBackImage}}\") no-repeat center center/100% 100%;color:{{data.fontColor}}}\n        .module_nav_type2.module_nav_{{id}} a.item.active,\n        .module_nav_type2.module_nav_{{id}} a.item:hover{background-image:url(\"{{data.itemBackImage}}\");}\n        {{else}}\n        .module_nav_type2.module_nav_{{id}} a.item{color:#333333;border:1px solid #666666;border-radius:3rem;background:#FFFFFF;color:{{data.fontColor}}}\n        .module_nav_type2.module_nav_{{id}} a.item.active,\n        .module_nav_type2.module_nav_{{id}} a.item:hover{color:#ff3644;border:1px solid #ff3644;border-radius:3rem;background:#FFFFFF;}\n        {{/if}}</style>\n    <div class=\"module_nav module_nav_type2 module_nav_{{id}}\">\n\n    </div></script><!-- 版块导航 -->\n\n<script type=\"text/html\" id=\"j-tpl-module_nav_type3\"><style>.module_nav_type3.module_nav_{{id}}{background:url(\"{{data.backImage}}\") no-repeat center {{data.backDirection == 'fill' ? 'center' : (data.backDirection || 'top')}}/100% {{data.backDirection == 'fill' ? '100%' : 'auto'}};background-color:{{data.bgColor || 'FFFFFF'}}}\n        .module_nav_type3.module_nav_{{id}} a.item{color:{{data.fontColor}}}\n        .module_nav_type3.module_nav_{{id}} a.item.active,\n        .module_nav_type3.module_nav_{{id}} a.item:hover{color:{{data.fontColor}}}</style>\n    <div class=\"module_nav module_nav_type3 module_nav_{{id}}\"\">\n\n    </div></script><!-- 版块导航 - 项 -->\n\n<script type=\"text/html\" id=\"j-tpl-module_nav_item_type1\">{{each list as item}}\n    <a class=\"swiper-slide click_item {{$index == 0 ? 'back' : ''}}\" href=\"javascript:;\" data-id=\"{{item.module_id}}\">\n        <img src=\"{{item.img}}\">\n        <div class=\"text\">{{item.title}}</div>\n    </a>\n    {{/each}}</script><!-- 版块导航 - 项 - 类型2 -->\n\n<script type=\"text/html\" id=\"j-tpl-module_nav_item_type2\">{{each list as item}}\n    <a class=\"item click_item {{$index == 0 ? 'back' : ''}}\" href=\"javascript:;\" data-id=\"{{item.module_id}}\">\n        <div class=\"text\">{{item.title}}</div>\n    </a>\n    {{/each}}</script><!-- 版块导航 - 项 -->\n\n<script type=\"text/html\" id=\"j-tpl-module_nav_item_type3\">{{each list as item}}\n    <a class=\"item click_item {{$index == 0 ? 'back' : ''}}\" href=\"javascript:;\" data-id=\"{{item.module_id}}\">\n        {{if (item.img)}}\n            <div class=\"line\"></div>\n            <img src=\"{{item.img}}\">\n        {{/if}}\n        <div class=\"text\">{{item.title}}</div>\n    </a>\n    {{/each}}</script><!-- 评论 -->\n\n<script type=\"text/html\" id=\"j-tpl-vote_tool\"><div id=\"{{id}}\"></div></script>\n<script type=\"text/html\" id=\"j-tpl-comment-inner\"><div class=\"mod\">\n        {{if title}}\n        <div class=\"mod-hd\">\n            <div class=\"mod-hd-left\">\n                <div class=\"title\">{{title}}</div>\n            </div>\n            <div class=\"mod-hd-right\">\n            </div>\n        </div>\n        {{/if}}\n        <div class=\"mod-bd\">\n            <div class=\"comment-box clearfix\">\n                <a href=\"{{listUrl}}\"><input type=\"text\" readonly=\"true\" name=\"\" placeholder=\"我来说两句...\"></a>\n                <div class=\"comment-list\">\n                    {{each list as item}}\n                    <div class=\"comment-item\" data-id=\"{{item.id}}\">\n                        <div class=\"flex-btw\">\n                            <div>\n                                <img class=\"avatar\" src=\"{{item.userInfo.img_url}}\">\n                                <span class=\"name\">{{item.userInfo.nick_name}}</span>\n                            </div>\n                            <div>\n                                <span class=\"like-count\">{{item.likes}}</span>\n                                <i class=\"iconfont icon-zan_ like-btn {{if item.isLike}}active{{/if}}\"></i>\n                            </div>\n                        </div>\n                        <div class=\"content-box\">\n                            <div class=\"content\">{{item.message}}</div>\n                            <div class=\"time\">{{item.pdate}}</div>\n                        </div>\n                    </div>\n                    {{/each}}\n                </div>\n                <a class=\"more\" href=\"{{listUrl}}\">查看全部</a>\n            </div>\n        </div>\n    </div></script>\n<script type=\"text/html\" id=\"j-tpl-live_module\">\n\n\n\n<div class=\"mod\" id=\"{{id}}\" bk_name=\"{{data.title || title}}\" data-slog=\"{{data.s_log}}\" data-sclog=\"{{data.sc_log}}\" data-module-id=\"{{data.moduleId}}\" data-id=\"{{id}}\" style=\"margin: 0;padding: 0;\">\n{{if data.title}}\n<div class=\"mod-hd\">\n<div class=\"mod-hd-left\">\n<div class=\"title\">{{data.title}}</div>\n</div>\n<div class=\"mod-hd-right\">\n{{if data.smType && data.showMore}}\n{{if data.smType == 'gid'}}\n  <a class=\"more fr\" href=\"https://item.btime.com/{{data.smGid}}\" target=\"_blank\">更多></a>\n{{/if}}\n{{if data.smType == 'list'}}\n  <a class=\"more fr\" href=\"https://item.btime.com/{{gid}}/{{data.smList}}\" target=\"_blank\">更多></a>\n{{/if}}\n{{if data.smType == 'url'}}\n  <a class=\"more fr\" href=\"{{data.smUrl}}\" target=\"_blank\">更多></a>\n{{/if}}\n{{else}}\n{{if data.moreUrl}}\n<a class=\"more\" href=\"{{data.moreUrl}}\">更多></a>\n{{/if}}\n{{/if}}\n</div>\n</div>\n{{/if}}\n{{if data.news.length > 0}}\n{{each data.news as item}}\n\n<div id={{'player' + item.gid}} style=\"position:relative;background: url({{cutter(item.data.covers[0],'750-422-100')}}) no-repeat\">\n\n <div id=\"countdown\" class=\"countdown\">\n <div class=\"hour\">\n <span class=\"hourT iconfont icon-shuzi_0\"></span>\n <span class=\"hourG iconfont icon-shuzi_0\"></span>\n </div>\n <div class=\"minutes\">\n <span class=\"minutesT iconfont icon-shuzi_0\"></span>\n <span class=\"minutesG iconfont icon-shuzi_0\"></span>\n </div>\n <div class=\"seconds\">\n <span class=\"secondsT iconfont icon-shuzi_0\"></span>\n <span class=\"secondsG iconfont icon-shuzi_0\"></span>\n </div>\n </div>\n <div id=\"playBtn\" class=\"playBtn\"></div>\n</div>\n{{/each}}\n{{/if}}\n</div></script><!--海报的模板-->\n\n\n<script type=\"text/html\" id=\"j-tpl-poster\"><div class=\"poster-area\">\n      <div class=\"poster-wrapper\">\n        <div class=\"poster-info\">\n          <div class=\"poster-top-img has_img\" data-src=\"{{topimg}}\" style=\"background-image: url({{topimg}});\"></div>\n          <div class=\"poster-top-title\">{{topimgtitle}}</div>\n          {{if hascover }}\n          <div class=\"poster-info-cover has_img\" data-src=\"{{cover}}>\" style=\"background-image: url({{cover}});\">\n\n            </div>\n          {{/if}}\n          <p class=\"poster-info-title \"><img src=\"https://p6.qhimg.com/t01e843ea0b327fc050.png\">{{title}}</p>\n\n\n        </div>\n        {{if !hascover }}\n            <p class=\"poster-info-des-kg\"></p>\n        {{/if}}\n        <div class=\"poster-popularize\">\n          <img class=\"poster-qrcode\" src=\"{{qrcode}}\" />\n          <div class='poster-qrcode-tip'>\n            <p>长按识别二维码</p><p>阅读全文</p>\n          </div>\n          <img class=\"poster-bottom-logo has_img\" data-src=\"{{bottomlogo}}\" src=\"{{bottomlogo}}\" />\n        </div>\n      </div>\n    </div></script>\n  <div class=\"poster-hidden\"></div>\n\n\n<!-- 全局通用配置，smarty数据也都在里面 -->\n\n<!-- 作用域 全站 -->\n\n<script>/* 用于通过 smarty 获取一些配置信息和属性 */\n;(function(window){\n\n    // 代替 Object.assign\n    var each=function(n,l,e){if(null!=n)if(n.length===+n.length)for(var r=0,a=n.length;r<a;r++)l.call(e,r,n[r],n);else for(var t in n)_.has(n,t)&&l.call(e,t,n[t],n)},extend=function(n){return each(Array.prototype.slice.call(arguments,1),function(l,e){if(e)for(var r in e)n[r]=e[r]}),n};\n\n    // 页面get参数\n    var params = (function(){var params = {}; location.search.substr(1).replace(/([\\w]+)=([-\\w]+)/ig, function(a, b, c){params[b] = unescape(c)}); return params})();\n\n    var App = {\n        config: {            // 页面开始时间\n            G_start_time: new Date(),\n            /* domain相关，网站有两个域名，所以做了这些配置 */\n            domain: 'btime.com',\n            webRoot: '//www.btime.com',\n            // 判断是测试和开发环境 dev|test\n            environ: 'bjwdt',\n            /* url参数 from */\n            from: '',\n            nav_list_head: {\"6b14e780f86c70d8f172560a2df76f15\":{\"c\":\"\",\"category_type\":\"category\",\"code\":\"\",\"extends\":\"\",\"fold\":0,\"icon\":\"\",\"keyword\":\"\\u5317\\u4eac\\u65f6\\u95f4,\\u5317\\u4eac\\u65f6\\u95f4\\u9996\\u9875,\\u95e8\\u6237\\u7f51\\u7ad9,\\u8d44\\u8baf,\\u65b0\\u5a92\\u4f53,\\u7f51\\u7edc\\u5a92\\u4f53,\\u65b0\\u95fb,\\u8d22\\u7ecf,\\u519b\\u4e8b,\\u4f53\\u80b2,\\u5a31\\u4e50,\\u65f6\\u5c1a,\\u79d1\\u6280,\\u751f\\u6d3b,\\u7f8e\\u98df,\\u65c5\\u6e38,\\u5065\\u5eb7,\\u56fe\\u7247,\\u89c6\\u9891,\\u7535\\u89c6,\\u7535\\u5f71,\\u7535\\u89c6\\u5267\",\"logogram\":\"index\",\"meta\":\"[{\\\"key\\\":\\\"skip_icon\\\",\\\"value\\\":\\\"{\\\\\\\"img\\\\\\\":\\\\\\\"https:\\\\\\\\\\/\\\\\\\\\\/p0.ssl.cdn.btime.com\\\\\\\\\\/t01a3f3fb556486014e.png?size=224x120\\\\\\\",\\\\\\\"open_url\\\\\\\":\\\\\\\"https:\\\\\\\\\\/\\\\\\\\\\/item.btime.com\\\\\\\\\\/f53amf9d0qr9kd9na1agaqo1mkk\\\\\\\"}\\\"},{\\\"title\\\":\\\"\\u9875\\u9762\\u642d\\u5efa\\u5916\\u5e7f\\u544a\\\",\\\"key\\\":\\\"ads\\\",\\\"value\\\":\\\"1,2,3,9,21,121\\\"},{\\\"key\\\":\\\"data_cid\\\",\\\"value\\\":\\\"main_index_page_all\\\"}]\",\"origin_subcid\":\"pc_6b14e780f86c70d8f172560a2df76f15\",\"relation_nav\":[],\"score\":1,\"subcid\":\"6b14e780f86c70d8f172560a2df76f15\",\"summary\":\"\\u5317\\u4eac\\u65f6\\u95f4\\u662f\\u4e2d\\u56fd\\u65b0\\u578b\\u4e3b\\u6d41\\u5a92\\u4f53\\uff0c\\u62e5\\u6709\\u5e7f\\u7535\\u7ea7\\u89c6\\u9891\\u91c7\\u96c6\\u5236\\u4f5c\\u80fd\\u529b\\u548c\\u56fd\\u5185\\u4e00\\u6d41\\u7684\\u8c03\\u67e5\\u8bb0\\u8005\\u961f\\u4f0d\\uff0c\\u9996\\u521b\\u4e91\\u8bb0\\u8005\\u548c\\u4e91\\u5a92\\u4f53\\u7406\\u5ff5\\uff0c\\u4ee5\\u79fb\\u52a8\\u4e92\\u8054\\u7f51\\u7406\\u5ff5\\u548c\\u65b9\\u5f0f\\u91cd\\u6784\\u65b0\\u95fb\\u751f\\u4ea7\\u4f20\\u64ad\\u5168\\u94fe\\u6761\\uff0c\\u6210\\u4e3a\\u4e2d\\u56fd\\u4f20\\u7edf\\u5a92\\u4f53\\u5411\\u878d\\u5a92\\u4f53\\u8f6c\\u578b\\u7684\\u9886\\u5bfc\\u8005\\u3002\",\"title\":\"\\u9996\\u9875\",\"view_path\":\"\\/\",\"nav_icon\":\"\",\"url\":\"https:\\/\\/www.btime.com\\/\"},\"7389193781085e10178780f6bbb3c79e\":{\"c\":\"\",\"category_type\":\"category\",\"code\":\"01\",\"extends\":\"\",\"fold\":0,\"icon\":\"\",\"keyword\":\"\\u65b0\\u95fb,\\u8d44\\u8baf,\\u653f\\u6cbb,\\u56fd\\u9645,\\u56fd\\u5185,\\u793e\\u4f1a,\\u8bc4\\u8bba,\\u8da3\\u95fb,\\u5feb\\u8baf,\\u7ecf\\u6d4e,\\u4e13\\u680f\",\"logogram\":\"news\",\"meta\":\"[{\\\"title\\\":\\\"\\u9875\\u9762\\u642d\\u5efa\\u5916\\u5e7f\\u544a\\\",\\\"key\\\":\\\"ads\\\",\\\"value\\\":\\\"1,2,3,9,20\\\"},{\\\"key\\\":\\\"data_cid\\\",\\\"value\\\":\\\"artificial_52lv8uung58lro5hi4hvgecpaa\\\"}]\",\"origin_subcid\":\"pc_7389193781085e10178780f6bbb3c79e\",\"relation_nav\":[],\"score\":2,\"subcid\":\"7389193781085e10178780f6bbb3c79e\",\"summary\":\"\\u5317\\u4eac\\u65f6\\u95f4-\\u65b0\\u95fb\\u9891\\u9053\\u662f\\u65b0\\u9510\\u95e8\\u6237\\u201c\\u5317\\u4eac\\u65f6\\u95f4\\u201d\\u7684\\u7b2c\\u4e00\\u65b0\\u95fb\\u5e73\\u53f0\\uff0c24\\u5c0f\\u65f6\\u5b9e\\u65f6\\u53d1\\u6398\\u4e0e\\u6574\\u5408\\u5168\\u7403\\u65b0\\u95fb\\uff0c\\u4e3a\\u7528\\u6237\\u63d0\\u4f9b\\u9c9c\\u6d3b\\u4e0e\\u6709\\u6e29\\u5ea6\\u7684\\u8d44\\u8baf\\u4e0e\\u8da3\\u95fb\\uff0c\\u65b0\\u95fb\\u9891\\u9053\\u8bbe\\u6709\\u56fd\\u5185\\u3001\\u56fd\\u9645\\u3001\\u793e\\u4f1a\\u3001\\u8bc4\\u8bba\\u7b49\\u5b50\\u680f\\u76ee\\u3002\",\"title\":\"\\u8981\\u95fb\",\"view_path\":\"\\/news\",\"nav_icon\":\"\",\"url\":\"https:\\/\\/