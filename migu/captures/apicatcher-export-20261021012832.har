6th46CvGF20xwTvp230831.jpg\",\"vset_update_info\":\"\",\"list_url\":\"\",\"category_id\":\"\",\"category_title\":\"\",\"category_url\":\"\",\"category_ad_id\":\"\",\"cname\":\"小央视频\",\"sign\":\"wsp\",\"oms_flag\":\"178\",\"ext_field\":\"\",\"keyword\":\"\",\"size\":\"9:16\",\"fc\":\"原创\",\"sc\":\"\",\"vset_fc\":\"新闻\",\"vset_sc\":\"社会\",\"vset_cs\":0,\"update_time\":\"2026-10-20 21:38:25\",\"vip_flag\":\"0\",\"vip_platform_flag\":\"\",\"ad\":\"1\"},{\"id\":\"c5436a43525442b4ac639cfe9e2e91a4\",\"title\":\"霍尔木兹海峡漂满iPhone？假的！\",\"image\":\"https://p4.img.cctvpic.com/apple3g/www/upload/image/20261020/1792481469822063710.jpg\",\"image2\":\"https://p3.img.cctvpic.com/apple3g/www/upload/image/20261020/1792481477284030175.jpg\",\"image3\":\"https://p2.img.cctvpic.com/fmspic/2026/10/20/c5436a43525442b4ac639cfe9e2e91a4-300.jpg\",\"brief\":\"霍尔木兹海峡漂满iPhone？假的！\",\"length\":\"00:00:53\",\"vtype\":2,\"type\":0,\"vsetid\":\"VSET100335053389\",\"vset_title\":\"小央视频\",\"vset_img\":\"https://p4.img.cctvpic.com/photoAlbum/vms/standard/img/2023/8/31/VSETazDM6th46CvGF20xwTvp230831.jpg\",\"vset_update_info\":\"\",\"list_url\":\"\",\"category_id\":\"\",\"category_title\":\"\",\"category_url\":\"\",\"category_ad_id\":\"\",\"cname\":\"小央视频\",\"sign\":\"wsp\",\"oms_flag\":\"178\",\"ext_field\":\"\",\"keyword\":\"\",\"size\":\"9:16\",\"fc\":\"原创\",\"sc\":\"\",\"vset_fc\":\"新闻\",\"vset_sc\":\"社会\",\"vset_cs\":0,\"update_time\":\"2026-10-20 21:39:32\",\"vip_flag\":\"0\",\"vip_platform_flag\":\"\",\"ad\":\"1\"},{\"id\":\"bd6ce68ee1a84d45ae917b98fa7026e9\",\"title\":\"微视频丨从长征路到腾飞路\",\"image\":\"https://p4.img.cctvpic.com/apple3g/www/upload/image/20261020/1792460907238047359.jpg\",\"image2\":\"https://p2.img.cctvpic.com/apple3g/www/upload/image/20261020/1792460912284019197.jpg\",\"image3\":\"https://p5.img.cctvpic.com/fmspic/2026/10/20/bd6ce68ee1a84d45ae917b98fa7026e9-300.jpg\",\"brief\":\"1936年10月，中国工农红军完成了彪炳史册的伟大远征，二万五千里“红飘带”，横贯华夏大地。如今，神州日新月异，腾飞之姿已如先辈所愿。谨以此片，纪念中国工农红军胜利90周年，致敬伟大长征精神。\",\"length\":\"00:02:51\",\"vtype\":2,\"type\":0,\"vsetid\":\"VSET100335053389\",\"vset_title\":\"小央视频\",\"vset_img\":\"https://p4.img.cctvpic.com/photoAlbum/vms/standard/img/2023/8/31/VSETazDM6th46CvGF20xwTvp230831.jpg\",\"vset_update_info\":\"\",\"list_url\":\"\",\"category_id\":\"\",\"category_title\":\"\",\"category_url\":\"\",\"category_ad_id\":\"\",\"cname\":\"军事频道\",\"sign\":\"junshi\",\"oms_flag\":\"404\",\"ext_field\":\"\",\"keyword\":\"\",\"size\":\"16:9\",\"fc\":\"原创\",\"sc\":\"\",\"vset_fc\":\"新闻\",\"vset_sc\":\"社会\",\"vset_cs\":0,\"update_time\":\"2026-10-20 21:39:55\",\"vip_flag\":\"0\",\"vip_platform_flag\":\"\",\"ad\":\"1\"},{\"id\":\"c2ace6469af444e19d5807ce9307b1eb\",\"title\":\"云南景迈山迎来日出云海最佳观赏季\",\"image\":\"https://p5.img.cctvpic.com/fmspic/2026/10/20/c2ace6469af444e19d5807ce9307b1eb-1.jpg\",\"image2\":\"https://p5.img.cctvpic.com/fmspic/2026/10/20/c2ace6469af444e19d5807ce9307b1eb-1.jpg\",\"image3\":\"https://p4.img.cctvpic.com/fmspic/2026/10/20/c2ace6469af444e19d5807ce9307b1eb-300.jpg\",\"brief\":\"深秋时节，云南省普洱市景迈山迎来日出云海观赏季。清晨，太阳从层叠的山峦间升起，金色晨光洒向古茶林和村寨；云海在山谷间流动，古寨时隐时现。晴好天气里，不少游客早早来到观景点，欣赏景迈山的秋日晨景。\",\"length\":\"00:00:40\",\"vtype\":2,\"type\":0,\"vsetid\":\"VSET1g676vulck9kla6t0vm1ba\",\"vset_title\":\"地方频道视频\",\"vset_img\":\"https://p3.img.cctvpic.com/photoAlbum/vms/standard/img/2022/8/12/VSETAcCtn4lmv7iwKwaR1i6Y220812.jpg\",\"vset_update_info\":\"\",\"list_url\":\"\",\"category_id\":\"\",\"category_title\":\"\",\"category_url\":\"\",\"category_ad_id\":\"\",\"cname\":\"直播中国\",\"sign\":\"zhongguo\",\"oms_flag\":\"875\",\"ext_field\":\"\",\"keyword\":\"其他\",\"size\":\"16:9\",\"fc\":\"特别节目\",\"sc\":\"其他\",\"vset_fc\":\"新闻\",\"vset_sc\":\"科技,经济,国内,文化,其他\",\"vset_cs\":1,\"update_time\":\"2026-10-20 21:37:04\",\"vip_flag\":\"0\",\"vip_platform_flag\":\"\",\"ad\":\"1\"},{\"id\":\"16d1a974890d498c9d7293443ebd2b70\",\"title\":\"伊朗表示若再遭袭 将更严厉回应\",\"image\":\"https://p2.img.cctvpic.com/apple3g/www/upload/image/20261020/1792481564469051123.jpg\",\"image2\":\"https://p4.img.cctvpic.com/apple3g/www/upload/image/20261020/1792481570720075205.jpg\",\"image3\":\"https://p5.img.cctvpic.com/fmspic/2026/10/20/16d1a974890d498c9d7293443ebd2b70-300.jpg\",\"brief\":\"伊朗表示若再遭袭 将更严厉回应\",\"length\":\"00:00:18\",\"vtype\":2,\"type\":0,\"vsetid\":\"VSET100335053389\",\"vset_title\":\"小央视频\",\"vset_img\":\"https://p4.img.cctvpic.com/photoAlbum/vms/standard/img/2023/8/31/VSETazDM6th46CvGF20xwTvp230831.jpg\",\"vset_update_info\":\"\",\"list_url\":\"\",\"category_id\":\"\",\"category_title\":\"\",\"category_url\":\"\",\"category_ad_id\":\"\",\"cname\":\"军事频道\",\"sign\":\"junshi\",\"oms_flag\":\"404\",\"ext_field\":\"\",\"keyword\":\"\",\"size\":\"9:16\",\"fc\":\"原创\",\"sc\":\"\",\"vset_fc\":\"新闻\",\"vset_sc\":\"社会\",\"vset_cs\":0,\"update_time\":\"2026-10-20 21:39:07\",\"vip_flag\":\"0\",\"vip_platform_flag\":\"\",\"ad\":\"1\"},{\"id\":\"e7e370aa377a4cf8b451eb2b6d0cca73\",\"title\":\"中国轮椅击剑队包揽花剑团体三金\",\"image\":\"https://p3.img.cctvpic.com/photoworkspace/2026/10/20/2026102018461954553.jpg\",\"image2\":\"https://p2.img.cctvpic.com/fmspic/2026/10/20/e7e370aa377a4cf8b451eb2b6d0cca73-64036585-1.jpg\",\"image3\":\"https://p2.img.cctvpic.com/fmspic/2026/10/20/e7e370aa377a4cf8b451eb2b6d0cca73-64036585-2.jpg\",\"brief\":\"亚残运会轮椅击剑比赛继续进行，中国轮椅击剑队包揽花剑团体三金。\",\"length\":\"00:03:36\",\"vtype\":1,\"type\":0,\"vsetid\":\"\",\"vset_title\":\"\",\"vset_img\":\"\",\"vset_update_info\":\"\",\"list_url\":\"\",\"category_id\":\"\",\"category_title\":\"\",\"category_url\":\"\",\"category_ad_id\":\"\",\"cname\":\"体育频道\",\"sign\":\"tiyu\",\"oms_flag\":\"186\",\"ext_field\":\"\",\"keyword\":\"新闻,击剑\",\"size\":\"16:9\",\"fc\":\"体育\",\"sc\":\"新闻,击剑\",\"vset_fc\":\"\",\"vset_sc\":\"\",\"vset_cs\":null,\"update_time\":\"2026-10-20 21:41:02\",\"vip_flag\":\"0\",\"vip_platform_flag\":\"\",\"ad\":\"1\"},{\"id\":\"7fa30fedaf7a4794a8134935739cdfc4\",\"title\":\"望海观潮丨近年最严重骚乱 法国人在愤怒什么？\",\"image\":\"https://p3.img.cctvpic.com/apple3g/www/upload/image/20261020/1792482834596088959.jpg\",\"image2\":\"https://p4.img.cctvpic.com/apple3g/www/upload/image/20261020/1792482860927023332.jpg\",\"image3\":\"https://p4.img.cctvpic.com/fmspic/2026/10/20/7fa30fedaf7a4794a8134935739cdfc4-300.jpg\",\"brief\":\"一夜之间，法国多座城市陷入混乱。原本由学校师资不足、基础设施老旧等引发的抗议，逐渐演变成大范围的打砸抢烧等暴力事件。法国人到底在愤怒什么？\",\"length\":\"00:03:37\",\"vtype\":2,\"type\":0,\"vsetid\":\"VSET100335053389\",\"vset_title\":\"小央视频\",\"vset_img\":\"https://p4.img.cctvpic.com/photoAlbum/vms/standard/img/2023/8/31/VSETazDM6th46CvGF20xwTvp230831.jpg\",\"vset_update_info\":\"\",\"list_url\":\"\",\"category_id\":\"\",\"category_title\":\"\",\"category_url\":\"\",\"category_ad_id\":\"\",\"cname\":\"小央视频\",\"sign\":\"wsp\",\"oms_flag\":\"178\",\"ext_field\":\"\",\"keyword\":\"\",\"size\":\"9:16\",\"fc\":\"原创\",\"sc\":\"\",\"vset_fc\":\"新闻\",\"vset_sc\":\"社会\",\"vset_cs\":0,\"update_time\":\"2026-10-20 21:38:08\",\"vip_flag\":\"0\",\"vip_platform_flag\":\"\",\"ad\":\"1\"},{\"id\":\"ce2bfbb4f86848e3881148de367e9365\",\"title\":\"全国帆板锦标赛、全国风筝板锦标赛汕尾开赛\",\"image\":\"https://p4.img.cctvpic.com/photoworkspace/2026/10/20/2026102018574219584.jpg\",\"image2\":\"https://p5.img.cctvpic.com/fmspic/2026/10/20/ce2bfbb4f86848e3881148de367e9365-64037177-0.jpg\",\"image3\":\"https://p3.img.cctvpic.com/fmspic/2026/10/20/ce2bfbb4f86848e3881148de367e9365-64037177-2.jpg\",\"brief\":\"北京时间10月20日，全国帆板锦标赛、全国风筝板锦标赛在汕尾开赛。\",\"length\":\"00:01:21\",\"vtype\":1,\"type\":0,\"vsetid\":\"\",\"vset_title\":\"\",\"vset_img\":\"\",\"vset_update_info\":\"\",\"list_url\":\"\",\"category_id\":\"\",\"category_title\":\"\",\"category_url\":\"\",\"category_ad_id\":\"\",\"cname\":\"体育频道\",\"sign\":\"tiyu\",\"oms_flag\":\"186\",\"ext_field\":\"\",\"keyword\":\"新闻,帆船\",\"size\":\"16:9\",\"fc\":\"体育\",\"sc\":\"新闻,帆船\",\"vset_fc\":\"\",\"vset_sc\":\"\",\"vset_cs\":null,\"update_time\":\"2026-10-20 21:40:45\",\"vip_flag\":\"0\",\"vip_platform_flag\":\"\",\"ad\":\"1\"},{\"id\":\"0f6d64567e0744e69bfeb5df131b36b2\",\"title\":\"美乌总统争执升级 泽连斯基列举美“不友好举措”\",\"image\":\"https:/