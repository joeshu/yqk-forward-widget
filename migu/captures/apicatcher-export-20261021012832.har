一换\",\"moreConfigId\":\"\"}],\"channelLocation\":0,\"displayMode\":\"102x102\",\"extH5High\":0,\"extH5Width\":0,\"fetchCount\":18,\"foreground_color\":\"\",\"h5High\":0,\"h5Url\":\"\",\"h5Width\":0,\"hasBackground\":0,\"hasCopyright\":1,\"hasImgmarkLt\":1,\"hasSpecialTitle\":0,\"id\":1016,\"imgmarkLtBgColor\":\"#1a66ff\",\"imgmarkLtColor\":\"#ffffff\",\"isAdvertisement\":1,\"isButtons\":1,\"isMerge\":0,\"isShowLocalChannel\":0,\"isTitleKeyWord\":1,\"is_media_account\":0,\"items\":[{\"adid\":\"\",\"brief\":\"2026年10月15日《足球之夜》为您带来：U16国家队：艰难中重新起步；中超保级：信念与执行；广东铭途：寻找自主发展道路。\",\"cornerColour\":\"\",\"cornerStr\":\"足球之夜\",\"cornerStrRb\":\"\",\"endTime\":0,\"epgChnlChar\":\"\",\"epgDarkDiamondPic\":\"\",\"epgDarkHorizontalPic\":\"\",\"epgDiamondPic\":\"\",\"epgHorizontalPic\":\"\",\"epgId\":0,\"epgName\":\"\",\"epgType\":\"\",\"fc\":\"\",\"homologous\":0,\"hoverText\":\"\",\"img1\":\"https://p4.img.cctvpic.com/photoAlbum/page/performance/img/2026/10/16/1792116762788_306.jpg\",\"img2\":\"\",\"img3\":\"\",\"imgRGB\":\"\",\"isTop\":0,\"is_media_account\":0,\"itemId\":\"VIDEf6vFlOAckV2YZFUSFkMX261015\",\"itemUrl\":\"https://tv.cctv.com/2026/10/15/VIDEf6vFlOAckV2YZFUSFkMX261015.shtml\",\"jumpUrl\":\"cntvcbox%3A%2F%2Fapp.cntv.cn%2FsingleVideo%3Fplayid%3D62292b3fedbe47608fa959d9b56f644a%26title%3D%25E2%2580%258CU16%25E5%259B%25BD%25E5%25AE%25B6%25E9%2598%259F%25EF%25BC%259A%25E5%259C%25A8%25E9%2598%25B5%25E7%2597%259B%25E4%25B8%258E%25E9%2587%258D%25E6%259E%2584%25E4%25B8%25AD%25E8%2589%25B0%25E9%259A%25BE%25E8%25B5%25B7%25E6%25AD%25A5%26vipFlag%3D0\",\"media_account_id\":\"\",\"mid\":\"\",\"playid\":\"62292b3fedbe47608fa959d9b56f644a\",\"price\":\"\",\"recordNumber\":0,\"sc\":\"\",\"showStyle\":\"0\",\"skinColor\":\"\",\"source\":\"足球之夜 U16国家队 中超\",\"startTime\":0,\"subTitle\":\"\",\"timeLineDate\":0,\"title\":\"‌U16国家队：在阵痛与重构中艰难起步\",\"trackId\":1,\"videoLength\":\"00:54:24\",\"videoSetId\":\"\",\"vip_flag\":0,\"vsetType\":\"\",\"vtype\":\"1\"},{\"adid\":\"\",\"brief\":\"改组未“满月”，高市内阁连遭冲击，多名自民党成员被曝丑闻。日本政府任命新任农林水产大臣，前任农林水产大臣已辞职，社会争论未平息。急修“安保三文件”，日“新型军国主义”狂奔，日右翼无法逃避国内质疑和反对之声。\",\"cornerColour\":\"\",\"cornerStr\":\"环球视线\",\"cornerStrRb\":\"\",\"endTime\":0,\"epgChnlChar\":\"\",\"epgDarkDiamondPic\":\"\",\"epgDarkHorizontalPic\":\"\",\"epgDiamondPic\":\"\",\"epgHorizontalPic\":\"\",\"epgId\":0,\"epgName\":\"\",\"epgType\":\"\",\"fc\":\"\",\"homologous\":0,\"hoverText\":\"\",\"img1\":\"https://p4.img.cctvpic.com/photoAlbum/page/performance/img/2026/10/16/1792116901085_744.jpg\",\"img2\":\"\",\"img3\":\"\",\"imgRGB\":\"\",\"isTop\":0,\"is_media_account\":0,\"itemId\":\"VIDEdrfJGQy8sQX5twiR6gvI261016\",\"itemUrl\":\"https://tv.cctv.com/2026/10/16/VIDEdrfJGQy8sQX5twiR6gvI261016.shtml?spm=C53156045404.Pkyvnhz1hJ5W.0.0\",\"jumpUrl\":\"cntvcbox%3A%2F%2Fapp.cntv.cn%2FsingleVideo%3Fplayid%3Dd0fcedf3751f495aa15569967fc4e988%26title%3D%25E6%2589%25A7%25E6%2584%258F%25E5%25A4%25A7%25E6%2590%259E%25E5%2586%259B%25E4%25BA%258B%25E6%259D%25BE%25E7%25BB%2591%2B%25E9%25AB%2598%25E5%25B8%2582%25E5%2586%2585%25E9%2598%2581%25E9%259D%25A2%25E4%25B8%25B4%25E5%25A4%259A%25E9%2587%258D%25E8%2580%2583%25E9%25AA%258C%25EF%25BC%259F%26vipFlag%3D0\",\"media_account_id\":\"\",\"mid\":\"\",\"playid\":\"d0fcedf3751f495aa15569967fc4e988\",\"price\":\"\",\"recordNumber\":0,\"sc\":\"\",\"showStyle\":\"0\",\"skinColor\":\"\",\"source\":\"日本 高市内阁 军国主义\",\"startTime\":0,\"subTitle\":\"\",\"timeLineDate\":0,\"title\":\"执意大搞军事松绑 高市内阁面临多重考验？\",\"trackId\":2,\"videoLength\":\"00:25:06\",\"videoSetId\":\"\",\"vip_flag\":0,\"vsetType\":\"\",\"vtype\":\"1\"},{\"adid\":\"\",\"brief\":\"每砸一颗金蛋就能保底出200万现金或等价高端收藏品，如果说砸中现金还能当场转账、即时到账。在网络直播间里，一个诈骗团伙用这样的金蛋骗取了上千名老年被害者的钱财，涉案总金额超千万元。\",\"cornerColour\":\"\",\"cornerStr\":\"法治在线\",\"cornerStrRb\":\"\",\"endTime\":0,\"epgChnlChar\":\"\",\"epgDarkDiamondPic\":\"\",\"epgDarkHorizontalPic\":\"\",\"epgDiamondPic\":\"\",\"epgHorizontalPic\":\"\",\"epgId\":0,\"epgName\":\"\",\"epgType\":\"\",\"fc\":\"\",\"homologous\":0,\"hoverText\":\"\",\"img1\":\"https://p4.img.cctvpic.com/photoAlbum/page/performance/img/2026/10/16/1792116693469_405.jpg\",\"img2\":\"\",\"img3\":\"\",\"imgRGB\":\"\",\"isTop\":0,\"is_media_account\":0,\"itemId\":\"VIDEOtvCmJflno94taDIWIXw261015\",\"itemUrl\":\"https://tv.cctv.com/2026/10/15/VIDEOtvCmJflno94taDIWIXw261015.shtml?spm=C53156045404.PD7xid85zOz7.0.0\",\"jumpUrl\":\"cntvcbox%3A%2F%2Fapp.cntv.cn%2FsingleVideo%3Fplayid%3D7c1ec924eda84dcbb31cd341634cb13b%26title%3D%25E2%2580%259C%25E7%25A0%25B8%25E9%2587%2591%25E8%259B%258B%25E2%2580%259D%25E4%25B8%25AD200%25E4%25B8%2587%25EF%25BC%259F%25E8%2597%258F%25E5%2593%2581%25E8%25BF%259E%25E7%258E%25AF%25E5%25A5%2597%25E4%25B8%2593%25E5%259D%2591%25E8%2580%2581%25E4%25BA%25BA%26vipFlag%3D0\",\"media_account_id\":\"\",\"mid\":\"\",\"playid\":\"7c1ec924eda84dcbb31cd341634cb13b\",\"price\":\"\",\"recordNumber\":0,\"sc\":\"\",\"showStyle\":\"0\",\"skinColor\":\"\",\"source\":\"“砸金蛋” 藏品回收骗局\",\"startTime\":0,\"subTitle\":\"\",\"timeLineDate\":0,\"title\":\"“砸金蛋”中200万？藏品连环套专坑老人\",\"trackId\":3,\"videoLength\":\"00:16:16\",\"videoSetId\":\"\",\"vip_flag\":0,\"vsetType\":\"\",\"vtype\":\"1\"},{\"adid\":\"\",\"brief\":\"本期节目主要内容：机组是大型设备的核心设备，通过精密协作，将能源转化为所需动力，它广泛用于电力、工业、交通等领域，几乎所有现代工程都依赖机组运转，大型机组的检维修工作是一项非常精细且复杂的任务。（《人物·故事》 20261015 精工砺刃·岳景春）\",\"cornerColour\":\"\",\"cornerStr\":\"人物·故事\",\"cornerStrRb\":\"\",\"endTime\":0,\"epgChnlChar\":\"\",\"epgDarkDiamondPic\":\"\",\"epgDarkHorizontalPic\":\"\",\"epgDiamondPic\":\"\",\"epgHorizontalPic\":\"\",\"epgId\":0,\"epgName\":\"\",\"epgType\":\"\",\"fc\":\"\",\"homologous\":0,\"hoverText\":\"\",\"img1\":\"https://p1.img.cctvpic.com/photoAlbum/page/performance/img/2026/10/16/1792116645794_319.jpg\",\"img2\":\"\",\"img3\":\"\",\"imgRGB\":\"\",\"isTop\":0,\"is_media_account\":0,\"itemId\":\"VIDEi5LfjvKmWHhE2eP49smE261015\",\"itemUrl\":\"https://tv.cctv.com/2026/10/15/VIDEi5LfjvKmWHhE2eP49smE261015.shtml\",\"jumpUrl\":\"cntvcbox%3A%2F%2Fapp.cntv.cn%2FsingleVideo%3Fplayid%3D59f099ea3ee1412fb8772932330adcbd%26title%3D%25E5%25B2%25B3%25E6%2599%25AF%25E6%2598%25A5%25EF%25BC%259A%25E7%25BB%2599%25E9%2592%25A2%25E9%2593%2581%25E2%2580%259C%25E5%2581%259A%25E6%2589%258B%25E6%259C%25AF%25E2%2580%259D%25E7%259A%2584%25E5%25A4%25A7%25E5%259B%25BD%25E5%25B7%25A5%25E5%258C%25A0%26vipFlag%3D0\",\"media_account_id\":\"\",\"mid\":\"\",\"playid\":\"59f099ea3ee1412fb8772932330adcbd\",\"price\":\"\",\"recordNumber\":0,\"sc\":\"\",\"showStyle\":\"0\",\"skinColor\":\"\",\"source\":\"人物·故事 岳景春 大型机组\",\"startTime\":0,\"subTitle\":\"\",\"timeLineDate\":0,\"title\":\"岳景春：给钢铁“做手术”的大国工匠\",\"trackId\":4,\"videoLength\":\"00:18:58\",\"videoSetId\":\"\",\"vip_flag\":0,\"vsetType\":\"\",\"vtype\":\"1\"},{\"adid\":\"\",\"brief\":\"本期节目主要内容：巡检机器人的出现不仅让安防巡检工作得到了加强，还有效节省了人力。在未来，巡检机器人将成为保障老百姓生命财产安全的重要伙伴，在我们的生活中发挥越来越重要的作用。（《时尚科技秀》 20261015）\",\"cornerColour\":\"\",\"cornerStr\":\"时尚科技秀\",\"cornerStrRb\":\"\",\"endTime\":0,\"epgChnlChar\":\"\",\"epgDarkDiamondPic\":\"\",\"epgDarkHorizontalPic\":\"\",\"epgDiamondPic\":\"\",\"epgHorizontalPic\":\"\",\"epgId\":0,\"epgName\":\"\",\"epgType\":\"\",\"fc\":\"\",\"homologous\":0,\"hoverText\":\"\",\"img1\":\"https://p5.img.cctvpic.com/photoAlbum/page/performance/img/2026/10/16/1792116581540_403.jpg\",\"img2\":\"\",\"img3\":\"\",\"imgRGB\":\"\",\"isTop\":0,\"is_media_account\":0,\"itemId\":\"VIDEXECdnO61tWwP7WacLq5f261015\",\"itemUrl\":\"https://tv.cctv.com/2026/10/15/VIDEXECdnO61tWwP7WacLq5f261015.shtml\",\"jumpUrl\":\"cntvcbox%3A%2F%2Fapp.cntv.cn%2FsingleVideo%3Fplayid%3D41f05e15b9a142b6a198f0a0bcc78d51%26title%3D%25E2%2580%258C%25E4%25B8%258D%25E7%259F%25A5%25E7%2596%25B2%25E5%2580%25A6%25E7%259A%2584%25E2%2580%259C%25E5%2593%25A8%25E5%2585%25B5%25E2%2580%259D%25EF%25BC%259A%25E6%258F%25AD%25E7%25A7%2598%25E5%25B7%25A1%25E6%25A3%2580%25E6%259C%25BA%25E5%2599%25A8%25E4%25BA%25BA%25E7%259A%2584%25E5%25AE%2588%25E6%258A%25A4%25E6%2597%25A5%25E5%25B8%25B8%26vipFlag%3D0\",\"media_account_id\":\"\",\"mid\":\"\",\"playid\":\"41f05e15b9a142b6a198f0a0bcc78d51\",\"price\":\"\",\"recordNumber\":0,\"sc\":\"\",\"showStyle\":\"0\",\"skinColor\":\"\",\"source\":\"时尚科技秀 巡检机器人 智能加油机器人\",\"startTime\":0,\"subTitle\":\"\",\"timeLineDate\":0,\"title\":\"‌不知疲倦的“哨兵”：揭秘巡检机器人的守护日常\",\"trackId\":5,\"videoLength\":\"00:10:00\",\"videoSetId\":\"\",\"vip_flag\":0,\"vsetType\":\"\",\"vtype\":\"1\"},{\"adid\":\"\",\"brief\":\"本集主要内容：\\n    生活在乡村的老年人对待人生最后一站有自己的秩序，在劳作一生的土地上，他们坦然舒展自己的筋骨，早早盘算身后的体面，在泥土之上开垦出梦幻花园。\\n（《幸福到老》 第3集 村晚）\",\"cornerColour\":\"\",\"cornerStr\":\"幸福到老\",\"cornerStrRb\":\"\",\"endTime\":0,\"epgChnlChar\":\"\",\"epgDarkDiamondPic\":\"\",\"epgDarkHorizontalPic\":\"\",\"epgDiamondPic\":\"\",\"epgHorizontalPic\":\"\",\"epgId\":0,\"epgName\":\"\",\"epgType\":\"\",\"fc\":\"\",\"homologous\":0,\"hoverText\":\"\",\"img1\":\"https://p3.img.cctvpic.com/photoAlbum/page/performance/img/2026/10/16/1792116548892_977.jpg\",\"img2\":\"\",\"img3\":\"\",\"imgRGB\":\"\",\"isTop\":0,\"is_media_account\":0,\"itemId\":\"VIDEucmmygghoSFVhlzjjVmH261015\",\"itemUrl\":\"https://tv.cctv.com/2026/10/15/VIDEucmmygghoSFVhlzjjVmH261015.shtml\",\"jumpUrl\":\"cntvcbox%3A%2F%2Fapp.cntv.cn%2FsingleVideo%3Fplayid%3D6aabd17ff2034fbfb8f730a052e49c69%26title%3D80%25E5%25B2%2581%25E8%2580%2581%25E4%25BA%25BA%25E6%258A%258A%25E7%25A0%25B4%25E6%2597%25A7%25E8%2580%2581%25E5%25B1%258B%25E4%25BA%25B2%25E6%2589%258B%25E6%2589%2593%25E9%2580%25A0%25E6%2588%2590%25E7%25AB%25A5%25E8%25AF%259D%25E8%2588%25AC%25E7%259A%2584%25E6%25A2%25A6%25E5%25B9%25BB%25E8%258A%25B1%25E5%259B%25AD%26vipFlag%3D0\",\"media_account_id\":\"\",\"mid\":\"\",\"playid\":\"6aabd17ff2034fbfb8f730a052e49c69\",\"price\":\"\",\"recordNumber\":0,\"sc\":\"\",\"showStyle\":\"0\",\"skinColor\":\"\",\"source\":\"幸福到老 张治新 重庆南川\",\"startTime\":0,\"subTitle\":\"\",\"timeLineDate\":0,\"title\":\"80岁老人把破旧老屋亲手打造成童话般的梦幻花园\",\"trackId\":6,\"videoLength\":\"00:24:10\",\"videoSetId\":\"\",\"vip_flag\":0,\"vsetType\":\"\",\"vtype\":\"1\"},{\"adid\":\"\",\"brief\":\"“卖脸”赚收益，人脸授权暗藏哪些风险？\",\"cornerColour\":\"\",\"cornerStr\":\"今日环球\",