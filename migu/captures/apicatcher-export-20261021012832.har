class=\"common\">\r\n                          <div class=\"img\">\r\n                              <a href=\"https://tv.cctv.com/2026/08/15/VIDErJQzRZUhV4EV5ClOcqRh260815.shtml\" target=\"_blank\"><img src=\"//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/zwPic1_1.gif\" class=\"lazy\" data-echo=\"//p3.img.cctvpic.com/photoAlbum/page/performance/img/2026/8/17/1786943594341_112.jpg\" /><em class=\"\"></em></a>\r\n                          </div>\r\n                          <div class=\"text\"><a href=\"https://tv.cctv.com/2026/08/15/VIDErJQzRZUhV4EV5ClOcqRh260815.shtml\" target=\"_blank\">《你好时光》第二季</a></div>\r\n                      </div>\r\n                      <div class=\"hover\">\r\n                          <div class=\"img\" data-img=\"//p4.img.cctvpic.com/photoAlbum/page/performance/img/2026/8/17/1786943541781_829.gif\" data-src=\"\">\r\n                              <a href=\"https://tv.cctv.com/2026/08/15/VIDErJQzRZUhV4EV5ClOcqRh260815.shtml\" target=\"_blank\"><img src=\"//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/zwPic1_1.gif\" /></a>\r\n                          </div>\r\n                          <div class=\"text\">\r\n                              <h3><a href=\"https://tv.cctv.com/2026/08/15/VIDErJQzRZUhV4EV5ClOcqRh260815.shtml\" target=\"_blank\">《你好时光》第二季</a></h3>\r\n                              <span><a href=\"https://tv.cctv.com/2026/08/15/VIDErJQzRZUhV4EV5ClOcqRh260815.shtml\" target=\"_blank\">节目关注普通职业群体，通过丰富的现实题材与立体的人物叙事，探寻时光背后的情感与故事。</a></span>\r\n                              <div class=\"label\"><a  href=\"http://tv.cctv.com/yxg/?spm=C28340.P9dhkRStLqPh.EYq0LGFLODJm.71#datacid=tbjm&datapd=&datafl=%E7%BB%BC%E8%89%BA&fc=%E7%89%B9%E5%88%AB%E8%8A%82%E7%9B%AE&datajr=&dataszm=\"target=\"_blank\">综艺</a></div>\r\n                          </div>\r\n                      </div>\r\n                  </div>\r\n                  <div class=\"typeLabel\"><a  href=\"http://tv.cctv.com/yxg/?spm=C28340.P9dhkRStLqPh.EYq0LGFLODJm.71#datacid=tbjm&datapd=&datafl=%E7%BB%BC%E8%89%BA&fc=%E7%89%B9%E5%88%AB%E8%8A%82%E7%9B%AE&datajr=&dataszm=\"target=\"_blank\">综艺</a></div>\r\n              </li>\r\n              <li>\r\n                  <div class=\"conTop\">\r\n                      <div class=\"common\">\r\n                          <div class=\"img\">\r\n                              <a href=\"https://tv.cctv.com/2026/08/14/VIDEZ1o9WldQJAyBh23dUDy6260814.shtml\" target=\"_blank\"><img src=\"//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/zwPic1_1.gif\" class=\"lazy\" data-echo=\"//p4.img.cctvpic.com/photoAlbum/page/performance/img/2026/8/18/1787037183147_904.jpg\" /><em class=\"\"></em></a>\r\n                          </div>\r\n                          <div class=\"text\"><a href=\"https://tv.cctv.com/2026/08/14/VIDEZ1o9WldQJAyBh23dUDy6260814.shtml\" target=\"_blank\">《新花路放》</a></div>\r\n                      </div>\r\n                      <div class=\"hover\">\r\n                          <div class=\"img\" data-img=\"//p5.img.cctvpic.com/photoAlbum/page/performance/img/2026/8/18/1787037138086_385.gif\" data-src=\"\">\r\n                              <a href=\"https://tv.cctv.com/2026/08/14/VIDEZ1o9WldQJAyBh23dUDy6260814.shtml\" target=\"_blank\"><img src=\"//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/zwPic1_1.gif\" /></a>\r\n                          </div>\r\n                          <div class=\"text\">\r\n                              <h3><a href=\"https://tv.cctv.com/2026/08/14/VIDEZ1o9WldQJAyBh23dUDy6260814.shtml\" target=\"_blank\">《新花路放》</a></h3>\r\n                              <span><a href=\"https://tv.cctv.com/2026/08/14/VIDEZ1o9WldQJAyBh23dUDy6260814.shtml\" target=\"_blank\">以沉浸式自驾体验为载体，展现鲜活的旅途故事与壮阔的山河图景，并深挖当地非遗等多元文脉。</a></span>\r\n                              <div class=\"label\"><a  href=\"http://tv.cctv.com/yxg/?spm=C28340.P9dhkRStLqPh.EYq0LGFLODJm.71#datacid=tbjm&datapd=&datafl=%E7%BB%BC%E8%89%BA&fc=%E7%89%B9%E5%88%AB%E8%8A%82%E7%9B%AE&datajr=&dataszm=\"target=\"_blank\">综艺</a></div>\r\n                          </div>\r\n                      </div>\r\n                  </div>\r\n                  <div class=\"typeLabel\"><a  href=\"http://tv.cctv.com/yxg/?spm=C28340.P9dhkRStLqPh.EYq0LGFLODJm.71#datacid=tbjm&datapd=&datafl=%E7%BB%BC%E8%89%BA&fc=%E7%89%B9%E5%88%AB%E8%8A%82%E7%9B%AE&datajr=&dataszm=\"target=\"_blank\">综艺</a></div>\r\n              </li>\r\n              <li class=\"end3\">\r\n                  <div class=\"conTop\">\r\n                      <div class=\"common\">\r\n                          <div class=\"img\">\r\n                              <a href=\"https://tv.cctv.com/2026/02/27/VIDEAH0yFyrnLgiphmmtJyY5260227.shtml\" target=\"_blank\"><img src=\"//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/zwPic1_1.gif\" class=\"lazy\" data-echo=\"//p3.img.cctvpic.com/photoAlbum/page/performance/img/2026/1/16/1768542269240_474.jpg\" /><em class=\"\"></em></a>\r\n                          </div>\r\n                          <div class=\"text\"><a href=\"https://tv.cctv.com/2026/02/27/VIDEAH0yFyrnLgiphmmtJyY5260227.shtml\" target=\"_blank\">《金石探文明》</a></div>\r\n                      </div>\r\n                      <div class=\"hover\">\r\n                          <div class=\"img\" data-img=\"//p4.img.cctvpic.com/photoAlbum/page/performance/img/2026/1/16/1768542225787_127.gif\" data-src=\"\">\r\n                              <a href=\"https://tv.cctv.com/2026/02/27/VIDEAH0yFyrnLgiphmmtJyY5260227.shtml\" target=\"_blank\"><img src=\"//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/zwPic1_1.gif\" /></a>\r\n                          </div>\r\n                          <div class=\"text\">\r\n                              <h3><a href=\"https://tv.cctv.com/2026/02/27/VIDEAH0yFyrnLgiphmmtJyY5260227.shtml\" target=\"_blank\">《金石探文明》</a></h3>\r\n                              <span><a href=\"https://tv.cctv.com/2026/02/27/VIDEAH0yFyrnLgiphmmtJyY5260227.shtml\" target=\"_blank\">以“金石不朽，文明永续”为主题，以“金石”为钥，叩问历史，照见未来，继续为“何以中国”作答。</a></span>\r\n                              <div class=\"label\"><a href=\"https://tv.cctv.com/yxg/index.shtml?spm=C28340.PdNvWY0LYxCP.E3alv6pYzpwM.8#datacid=tbjm&datapd=&datafl=%E6%96%87%E5%8C%96&fc=%E7%89%B9%E5%88%AB%E8%8A%82%E7%9B%AE&datajr=&dataszm=\" target=\"_blank\">文化</a></div>\r\n                          </div>\r\n                      </div>\r\n                  </div>\r\n                  <div class=\"typeLabel\"><a href=\"https://tv.cctv.com/yxg/index.shtml?spm=C28340.PdNvWY0LYxCP.E3alv6pYzpwM.8#datacid=tbjm&datapd=&datafl=%E6%96%87%E5%8C%96&fc=%E7%89%B9%E5%88%AB%E8%8A%82%E7%9B%AE&datajr=&dataszm=\" target=\"_blank\">文化</a></div>\r\n              </li>\r\n              <li class=\"end2\">\r\n                  <div class=\"conTop\">\r\n                      <div class=\"common\">\r\n                          <div class=\"img\">\r\n                              <a href=\"https://tv.cctv.com/2026/10/07/VIDEgL0bcOxexpqXdcOizBXn261007.shtml\" target=\"_blank\"><img src=\"//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/zwPic1_1.gif\" class=\"lazy\" data-echo=\"//p3.img.cctvpic.com/photoAlbum/page/performance/img/2026/10/8/1791432928605_664.jpg\" /><em class=\"\"></em></a>\r\n                          </div>\r\n                          <div class=\"text\"><a href=\"https://tv.cctv.com/2026/10/07/VIDEgL0bcOxexpqXdcOizBXn261007.shtml\" target=\"_blank\">《国音正青春》</a></div>\r\n                      </div>\r\n                      <div class=\"hover\">\r\n                          <div class=\"img\" data-img=\"//p3.img.cctvpic.com/photoAlbum/page/performance/img/2026/10/8/1791433116717_70.gif\" data-src=\"\">\r\n                              <a href=\"https://tv.cctv.com/2026/10/07/VIDEgL0bcOxexpqXdcOizBXn261007.shtml\" target=\"_blank\"><img src=\"//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/zwPic1_1.gif\" /></a>\r\n                          </div>\r\n                          <div class=\"text\">\r\n                              <h3><a href=\"https://tv.cctv.com/2026/10/07/VIDEgL0bcOxexpqXdcOizBXn261007.shtml\" target=\"_blank\">《国音正青春》</a></h3>\r\n                              <span><a href=\"https://tv.cctv.com/2026/10/07/VIDEgL0bcOxexpqXdcOizBXn261007.shtml\" target=\"_blank\">邀请多位乐坛实力唱将，完成6场沉浸式音乐互动快闪秀演。</a></span>\r\n                              <div class=\"label\"><a  href=\"https://tv.cctv.com/yxg/?spm=C96370.PPDB2vhvSivD.EDB1jFexOIP1.105#datacid=tbjm&datapd=&datafl=%E9%9F%B3%E4%B9%90&fc=%E7%89%B9%E5%88%AB%E8%8A%82%E7%9B%AE&datajr=&dataszm=\"target=\"_blank\">音乐</a></div>\r\n                          </div>\r\n                      </div>\r\n                  </div>\r\n                  <div class=\"typeLabel\"><a  href=\"https://tv.cctv.com/yxg/?spm=C96370.PPDB2vhvSivD.EDB1jFexOIP1.105#datacid=tbjm&datapd=&datafl=%E9%9F%B3%E4%B9%90&fc=%E7%89%B9%E5%88%AB%E8%8A%82%E7%9B%AE&datajr=&dataszm=\"target=\"_blank\">音乐</a></div>\r\n              </li>\r\n              <li class=\"end1\">\r\n                  <div class=\"conTop\">\r\n                      <div class=\"common\">\r\n                          <div class=\"img\">\r\n                              <a href=\"https://tv.cctv.com/2026/04/14/VIDEtmq1IE9Rwl6NllI1V43c260414.shtml\" target=\"_blank\"><img src=\"//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/zwPic1_1.gif\" class=\"lazy\" data-echo=\"//p4.img.cctvpic.com/photoAlbum/page/performance/img/2026/4/15/1776231549982_862.jpg\" /><em class=\"\"></em></a>\r\n                          </div>\r\n                          <div class=\"text\"><a href=\"https://tv.cctv.com/2026/04/14/VIDEtmq1IE9Rwl6NllI1V43c260414.shtml\" target=\"_blank\">《子恺先生》</a></div>\r\n                      </div>\r\n                      <div class=\"hover\">\r\n                          <div class=\"img\" data-img=\"//p2.img.cctvpic.com/photoAlbum/page/performance/img/2026/4/15/1776231507743_824.gif\" data-src=\"\">\r\n                              <a href=\"https://tv.cctv.com/2026/04/14/VIDEtmq1IE9Rwl6NllI1V43c260414.shtml\" target=\"_blank\"><img src=\"//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/zwPic1_1.gif\" /></a>\r\n                          </div>\r\n                          <div class=\"text\">\r\n                              <h3><a href=\"https://tv.cctv.com/2026/04/14/VIDEtmq1IE9Rwl6NllI1V43c260414.shtml\" target=\"_blank\">《子恺先生》</a></h3>\r\n                              <span><a href=\"https://tv.cctv.com/2026/04/14/VIDEtmq1IE9Rwl6NllI1V43c260414.shtml\" target=\"_blank\">全景展现了丰子恺先生作为漫画家、散文家、教育家、翻译家等多领域的卓越建树。</a></span>\r\n                              <div class=\"label\"><a  href=\"https://tv.cctv.com/yxg/index.shtml?spm=C55953877151.PXXwefeHcOAR.0.0#datacid=tbjm&datapd=&datafl=%E7%A7%91%E6%95%99&fc=%E7%89%B9%E5%88%AB%E8%8A%82%E7%9B%AE&datajr=&dataszm=\"target=\"_blank\">科教</a></div>\r\n                          </div>\r\n                      </div>\r\n                  </div>\r\n                  <div class=\"typeLabel\"><a  href=\"https://tv.cctv.com/yxg/index.shtml?spm=C55953877151.PXXwefeHcOAR.0.0#datacid=tbjm&datapd=&datafl=%E7%A7%91%E6%95%99&fc=%E7%89%B9%E5%88%AB%E8%8A%82%E7%9B%AE&datajr=&dataszm=\"target=\"_blank\">科教</a></div>\r\n              </li>\r\n              \r\n          </ul>\r\n      </div>\r\n  </div>\r\n</div>\r\n  </div>\r\n</div>\r\n<div class=\"column_wrapper\">\r\n\t\r\n\t\t<div id=\"SUBD1628675590410519\" data-spm=\"S10519\">\r\n\t\t\t<div class=\"tvCCTV_galaxy01\" data-spm= \"EibrohbiYxU1\">\r\n\t<a href=\"\" target=\"_blank\">\r\n\t\t<img class=\"galaxyEnd4 lazy\" src=\"\">\r\n\t\t<img class=\"galaxyEnd3 lazy\" src=\"\">\r\n\t\t<img class=\"galaxyEnd2 lazy\" src=\"\">\r\n\t\t<img class=\"galaxyEnd1 lazy\" src=\"\">\r\n\t\t<div class=\"tips\">广告</div>\r\n\t</a>\r\n</div>\r\n\t\t</div>\r\n\t\r\n</div><div class=\"column_wrapper\">\r\n\t\r\n\t\t<div id=\"SUBD1628672394895747\" data-spm=\"S