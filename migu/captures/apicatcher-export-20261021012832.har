nt-size: 12px; background: #272727;color: #cacaca;}\n.footerPC .footer_bd  img{height: 20px;}\n.footerPC .footer_bd a{color: #cacaca;text-decoration: none;}\n.footerPC .footer_bd .footer_bdCon_l{padding-top: 17px;float: left;}\n.footerPC .footer_bd .footer_bdCon_l p{line-height:32px;}\n.footerPC .footer_bd .footer_bdCon_l p img{margin: 0 8px; height: 20px; vertical-align: middle;} \n.footerPC .footer_bd .footer_bdCon_l a:hover{color: #c10714 !important;text-decoration: underline;}\n.footerPC .footer_bd .footer_bdCon_r{float: right;}\n.footerPC .footer_bd .footer_bdCon_r dl{padding:21px 15px 10px 95px;overflow: hidden;}\n.footerPC .footer_bd .footer_bdCon_r dt img{ height: 25px;}\n.footerPC .footer_bd .footer_bdCon_r dt,.footerPC .footer_bd .footer_bdCon_r dd{float: left;}\n.footerPC .footer_bd .footer_bdCon_r dd{width:85px;margin-left:10px;line-height: 17px; text-align: right;}\n.footerPC .footer_bd .footer_bdCon_r dd a:hover{ color: #cacaca !important;}\n.footerPC .footer_bd .footer_bdCon_r dd img{float: left; height: 25px; margin-right: 15px;}\n.footerPC .footer_bd .footer_bdCon_r p{text-align: right;}\n\n\n/*默认分辨率小于1579 大于1280 ，内容宽度1200  备份(min-width: 1280px) and (max-width: 1579px)*/\n@media screen and (min-width: 1350px) and (max-width: 1683px){\n\t.column_wrapper{width: 1200px;}\n\t.column_wrapper .l{width: 812px;}\n\t.column_wrapper .r{width: 388px;}\n\t\n\t.end3{display: block;}\n\n\t/*广告位*/\n\t.galaxyEnd1{display: none;}\n\t.galaxyEnd2{display: none;}\n\t.galaxyEnd3{display: block;border-radius: 5px;}\n\t.galaxyEnd4{display: none;}\n\n\t.tvCCTV_galaxy01{}\n\t.tvCCTV_galaxy02{ padding-top: 9px;}\n\t.tvCCTV_galaxy02 ul{width: 1204px;}\n\t.tvCCTV_galaxy02 ul li{width: 297px; height: 105px;}\n\t.tvCCTV_galaxy02 ul li.piclast{margin-right: 4px;}\n\t.tvCCTV_galaxy02 ul li.piclast1{margin-right: 0;}\n\t.tvCCTV_galaxy02 ul li .text{padding: 31px 20px 27px 0;}\n\t.tvCCTV_galaxy03{ padding-top: 9px;}\n\t/* .tvCCTV_galaxy04{ padding-top: 9px;}\n\t.tvCCTV_galaxy04 ul{w