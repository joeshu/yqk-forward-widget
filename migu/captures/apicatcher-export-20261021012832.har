cordNumber\":0,\"sc\":\"\",\"showStyle\":\"\",\"skinColor\":\"\",\"source\":\"牙科\",\"startTime\":0,\"subTitle\":\"\",\"timeLineDate\":0,\"title\":\"《从“齿”健康》\",\"trackId\":2578603,\"videoLength\":\"\",\"videoSetId\":\"\",\"vip_flag\":0,\"vsetType\":\"\",\"vtype\":\"2\"},{\"adid\":\"\",\"brief\":\"该片以历史上著名的关隘为叙述本体，讲述围绕关隘发生的影响中国历史发展进程、在中华民族发展史上具有重大意义的历史事件和著名人物故事，挖掘关隘蕴含的历史文化价值，彰显中华民族的文化自信和家国情怀。\",\"cornerColour\":\"\",\"cornerStr\":\"\",\"cornerStrRb\":\"\",\"endTime\":0,\"epgChnlChar\":\"\",\"epgDarkDiamondPic\":\"\",\"epgDarkHorizontalPic\":\"\",\"epgDiamondPic\":\"\",\"epgHorizontalPic\":\"\",\"epgId\":0,\"epgName\":\"\",\"epgType\":\"\",\"fc\":\"\",\"homologous\":0,\"hoverText\":\"\",\"img1\":\"https://p1.img.cctvpic.com/photoAlbum/vms/image/89c76a6a724042bcfec61479cca0ab48.jpg?q=75\",\"img2\":\"\",\"img3\":\"\",\"imgRGB\":\"#856553\",\"isTop\":0,\"is_media_account\":0,\"itemId\":\"VSET1hvokhdfna5dfuh3tpgi83\",\"itemUrl\":\"\",\"jumpUrl\":\"cntvcbox%3A%2F%2Fapp.cntv.cn%2FvideoSet%3Fplayid%3D%26itemId%3DVSET1hvokhdfna5dfuh3tpgi83%26title%3D%25E3%2580%258A%25E5%25A4%25A9%25E4%25B8%258B%25E9%259B%2584%25E5%2585%25B3%25E3%2580%258B%26vipFlag%3D0\",\"media_account_id\":\"\",\"mid\":\"\",\"playid\":\"\",\"price\":\"\",\"recordNumber\":0,\"sc\":\"\",\"showStyle\":\"\",\"skinColor\":\"\",\"source\":\"关隘\",\"startTime\":0,\"subTitle\":\"\",\"timeLineDate\":0,\"title\":\"《天下雄关》\",\"trackId\":2578112,\"videoLength\":\"\",\"videoSetId\":\"\",\"vip_flag\":0,\"vsetType\":\"\",\"vtype\":\"2\"},{\"adid\":\"\",\"brief\":\"本片用创新视角，采用医学+科学的融合方式，以“水”在人体八大系统中的循环、代谢以及其在各个系统（如消化系统、血液循环系统、泌尿系统等）中的关键作用为主线，全方位展现那些隐藏在细胞深处、流淌于血管之中、浸润着组织间隙的“水”所蕴含的巨大奥秘与力量，让观众深刻认识到“水”是生命活动的核心要素之一，维持人体“水”世界的平衡是保持健康的重要基础。\",\"cornerColour\":\"\",\"cornerStr\":\"\",\"cornerStrRb\":\"\",\"endTime\":0,\"epgChnlChar\":\"\",\"epgDarkDiamondPic\":\"\",\"epgDarkHorizontalPic\":\"\",\"epgDiamondPic\":\"\",\"epgHorizontalPic\":\"\",\"epgId\":0,\"epgName\":\"\",\"epgType\":\"\",\"fc\":\"\",\"homologous\":0,\"hoverText\":\"\",\"img1\":\"https://p1.img.cctvpic.com/photoAlbum/vms/image/f729e82eb73692720cef4d5a479e41ce.jpg?q=75\",\"img2\":\"\",\"img3\":\"\",\"imgRGB\":\"#856553\",\"isTop\":0,\"is_media_account\":0,\"itemId\":\"VSET1jt5hc6un06uq2ortbeug7\",\"itemUrl\":\"\",\"jumpUrl\":\"cntvcbox%3A%2F%2Fapp.cntv.cn%2FvideoSet%3Fplayid%3D%26itemId%3DVSET1jt5hc6un06uq2ortbeug7%26title%3D%25E3%2580%258A%25E4%25BA%25BA%25E4%25BD%2593%25E2%2580%259C%25E6%25B0%25B4%25E2%2580%259D%25E4%25B8%2596%25E7%2595%258C%25E3%2580%258B%26vipFlag%3D0\",\"media_account_id\":\"\",\"mid\":\"\",\"playid\":\"\",\"price\":\"\",\"recordNumber\":0,\"sc\":\"\",\"showStyle\":\"\",\"skinColor\":\"\",\"source\":\"水\",\"startTime\":0,\"subTitle\":\"\",\"timeLineDate\":0,\"title\":\"《人体“水”世界》\",\"trackId\":2578111,\"videoLength\":\"\",\"videoSetId\":\"\",\"vip_flag\":0,\"vsetType\":\"\",\"vtype\":\"2\"},{\"adid\":\"\",\"brief\":\"该片为电视剧《生命树》同名纪录片，选取三江源地区生态保护、野生动物保护、盐湖资源保护、暗夜星空保护等生态保护话题，邀请专家与演员走进相关生态保护地，讲述生态建设故事。\",\"cornerColour\":\"\",\"cornerStr\":\"\",\"cornerStrRb\":\"\",\"endTime\":0,\"epgChnlChar\":\"\",\"epgDarkDiamondPic\":\"\",\"epgDarkHorizontalPic\":\"\",\"epgDiamondPic\":\"\",\"epgHorizontalPic\":\"\",\"epgId\":0,\"epgName\":\"\",\"epgType\":\"\",\"fc\":\"\",\"homologous\":0,\"hoverText\":\"\",\"img1\":\"https://p1.img.cctvpic.com/photoAlbum/vms/image/1d35c32502e3df26332c2a574cd8875d.jpg?q=75\",\"img2\":\"\",\"img3\":\"\",\"imgRGB\":\"#856553\",\"isTop\":0,\"is_media_account\":0,\"itemId\":\"VSET1jh0n8kar2i56stt1uado2\",\"itemUrl\":\"\",\"jumpUrl\":\"cntvcbox%3A%2F%2Fapp.cntv.cn%2FvideoSet%3Fplayid%3D%26itemId%3DVSET1jh0n8kar2i56stt1uado2%26title%3D%25E3%2580%258A%25E7%2594%259F%25E5%2591%25BD%25E6%25A0%2591%25E3%2580%258B%26vipFlag%3D0\",\"media_account_id\":\"\",\"mid\":\"\",\"playid\":\"\",\"price\":\"\",\"recordNumber\":0,\"sc\":\"\",\"showStyle\":\"\",\"skinColor\":\"\",\"source\":\"野生动物保护\",\"startTime\":0,\"subTitle\":\"\",\"timeLineDate\":0,\"title\":\"《生命树》\",\"trackId\":2578110,\"videoLength\":\"\",\"