            "text" : "{\"data\":{\"abId\":\"0\",\"code\":\"9000\",\"totalNum\":500,\"utdid\":\"ateUbgIoOAADALXs1kck00N7\",\"hotRes\":[{\"id\":\"291bae003cd325f6295e398fe6201641\",\"title\":\"俄罗斯老板娘带来热腾腾的哈尔滨烧烤，热情好客，全场沸腾了\",\"image\":\"https://p5.img.cctvpic.com/fmspic/2026/09/05/5355558479189329.jpeg\",\"image2\":\"https://p1.img.cctvpic.com/fmspic/2026/09/05/291bae003cd325f6295e398fe6201641-63357759-0.jpg\",\"image3\":\"https://p5.img.cctvpic.com/fmspic/2026/09/05/291bae003cd325f6295e398fe6201641-63357759-2.jpg\",\"brief\":\"\",\"length\":\"00:00:46\",\"vtype\":2,\"type\":0,\"vsetid\":\"VSET1k0rq00meo5jf7f06ovn79\",\"vset_title\":\"畅看\",\"vset_img\":\"https://p1.img.cctvpic.com/photoAlbum/vms/image/1d64afe9672d1fee5e718dc7bd46d471.jpg\",\"vset_update_info\":\"\",\"list_url\":\"\",\"category_id\":\"\",\"category_title\":\"\",\"category_url\":\"\",\"category_ad_id\":\"\",\"cname\":\"综艺频道\",\"sign\":\"zongyi\",\"oms_flag\":\"97\",\"ext_field\":\"\",\"keyword\":\"真人秀\",\"size\":\"16:9\",\"fc\":\"综艺\",\"sc\":\"真人秀\",\"vset_fc\":\"综艺\",\"vset_sc\":\"综艺\",\"vset_cs\":1,\"update_time\":\"2026-09-07 11:30:45\",\"vip_flag\":\"0\",\"vip_platform_flag\":\"\",\"ad\":\"1\"},{\"id\":\"360e6428d4bc449797d709224b8dbd5a\",\"title\":\"AI奇谈  三山老辈赴重阳：老怪不忙，今日打烊\",\"image\":\"https://p4.img.cctvpic.com/apple3g/www/upload/image/20261018/1792279669520064444.jpg\",\"image2\":\"https://p4.img.cctvpic.com/apple3g/www/upload/image/20261018/1792279673973027303.jpg\",\"image3\":\"https://p4.img.cctvpic.com/fmspic/2026/10/18/360e6428d4bc449797d709224b8dbd5a-300.jpg\",\"brief\":\"找点空闲，找点时间，领着小妖，常回洞看看。带上画饼的笑容，带上顺手的差事，陪同大王，常回洞看看——重阳佳节，压龙山、竹节山、荆棘岭的老辈们赴了一场热闹的家宴，席间彻底顿悟：儿孙自有儿孙福，老辈今天先享福。\",\"length\":\"00:05:51\",\"vtype\":2,\"type\":0,\"vsetid\":\"VSET100335053389\",\"vset_title\":\"小央视频\",\"vset_img\":\"https://p4.img.cctvpic.com/photoAlbum/vms/standard/img/2023/8/31/VSETazDM6th46CvGF20xwTvp230831.jpg\",\"vset_update_info\":\"\",\"list_url\":\"\",\"category_id\":\"\",\"category_title\":\"\",\"category_u