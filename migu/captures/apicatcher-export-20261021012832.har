 .content ul li.first .brief{color:#999999;}\n\n/* 直播导视 */\n.tvCCTV_ind04 .content{border-top:2px solid #e5e5e5;padding: 0px 28px; position: relative;}\n.tvCCTV_ind04 .content .bottom_fuceng{background: url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/jiemudan_yy_962.png) no-repeat center center; width: 100%; height: 13px; position: absolute; left: 0; bottom: -13px;}\n.tvCCTV_ind04 .content .zbds_left{background: #FFFFFF; width: 40px; height: 168px; position: absolute; left: 0; top: 0px; z-index: 9;}\n.tvCCTV_ind04 .content .zbds_right{background: #FFFFFF; width: 40px; height: 168px; position: absolute; right: 0; top: 0px;z-index: 9;}\n.tvCCTV_ind04 .content .zbds_left .btnLeft{position: absolute; width: 27px; height: 130px; left: 0; top: 19px; background: #FFFFFF url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/left.png) no-repeat center center; cursor: pointer;}\n.tvCCTV_ind04 .content .zbds_right .btnRight{position: absolute; width: 27px; height: 130px; right: 0; top: 19px; background: #FFFFFF url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/right.png) no-repeat center center; cursor: pointer;}\n.tvCCTV_ind04 .content .zbds_left .btnLeft:hover{background: #0084FF url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/zbds_left_hover.png) no-repeat center center;}\n.tvCCTV_ind04 .content .zbds_right .btnRight:hover{background: #0084FF url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/zbds_right_hover.png) no-repeat center center;}\n.tvCCTV_ind04 .content .zbds_left .btnLeft.pro{background: #e5e5e5 url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/zbds_left_hover.png) no-repeat center center; cursor: default;}\n.tvCCTV_ind04 .content .zbds_right .btnRight.pro{background: #e5e5e5 url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/zbds_right_hover.png) no-repeat center center;cursor: default;}\n\n.tvCCTV_ind04 .content .con{position: relative; z-index: 1;overflow: hidden;}\n.tvCCTV_ind04 .content .con ul{width: 99999px;}\n.tvCCTV_ind04 .content .con ul li{padding: 28px 0px 26px 0; float: left;position: relative;}\n.tvCCTV_ind04 .content .con ul li .li_con{border-right: 1px solid #e7e7e7;padding: 8px 20px 0px 20px;height: 104px;width: 186px;}\n.tvCCTV_ind04 .content .con ul li .img a{width: 100%; display: block;line-height: 21px;}\n.tvCCTV_ind04 .content .con ul li .img img{width: 84px; height: 21px; display: inline-block; vertical-align: top;}\n.tvCCTV_ind04 .content .con ul li .img i{font-size: 18px; color: #000000; line-height: 21px; font-weight: bold; margin-left: 10px;}\n.tvCCTV_ind04 .content .con ul li .title{font-size: 14px; line-height: 24px; margin: 5px auto 10px 0px;color: #222222;}\n.tvCCTV_ind04 .content .con ul li .title a{color: #222222;}\n.tvCCTV_ind04 .content .con ul li .brief{font-size: 14px; line-height: 24px;color: #222222; height: 42px; }\n.tvCCTV_ind04 .content .con ul li .brief a{color: #222222; display: block; width: 100%; height: 100%; line-height: 24px;}\n.tvCCTV_ind04 .content .con ul li:hover .brief a{color: #0084FF;}\n.tvCCTV_ind04 .content .con ul li:hover .title a{color: #222222 !important;}\n.tvCCTV_ind04 .content .con ul li .li_line{background: #0084ff;width: 186px;height: 2px;position: absolute;bottom: 0;left: 20px;display: none;}\n.tvCCTV_ind04 .content .con ul li:hover .li_line{display: inline-block;}\n\n.tvCCTV_ind05 { padding-bottom:35px;}\n.tvCCTV_ind05 .zbds_center_con{height: 106px; width: 100%; background: url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/line.jpg) repeat-x 0 79px;}\n.tvCCTV_ind05 .zbds_center_con ul{width: 1000px;}\n.tvCCTV_ind05 .zbds_center_con ul li{padding-top: 24px; padding-bottom: 20px; text-align: center; width: 178px; margin-right: 18px; float: left;}\n.tvCCTV_ind05 .zbds_center_con ul li .title{font-size: 14px; line-height: 22px; font-weight: bold;color: #222222;}\n.tvCCTV_ind05 .zbds_center_con ul li .brief{font-size: 14px; line-height: 22px;color: #999999; padding-bottom: 18px; background: url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/now.png) no-repeat bottom center;}\n.tvCCTV_ind05 .content{position: relative;}\n.tvCCTV_ind05 .content ul{width: 1000px;}\n.tvCCTV_ind05 .content ul li{width: 178px; margin-right: 18px; float: left;position: relative; z-index: 1;}\n.tvCCTV_ind05 .content ul li .common .img{width: 100%; height: 223px; position: relative; border-radius: 5px; overflow: hidden; background:#e6e6e6 url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/zwPic126_36.png) no-repeat 40% center;}\n.tvCCTV_ind05 .content ul li .common .img em{position: absolute;width: 32px; height: 18px;top: 10px; right: 10px;  display: block;}\n.tvCCTV_ind05 .content ul li .common .img .HOT{ background-image: url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/nav_hot.png);}\n.tvCCTV_ind05 .content ul li .common .img .NEW{background-image: url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/nav_new.png);}\n.tvCCTV_ind05 .content ul li .common .title{font-size: 14px; line-height: 26px;color: #222222; margin-top: 8px;font-weight: bold;}\n.tvCCTV_ind05 .content ul li .common .brief{font-size: 14px; line-height: 24px;color: #999999; }\n.tvCCTV_ind05 .content ul li .hover{width:218px; height:307px; position: absolute;left:-20px;top:-10px; border-radius: 5px; z-index: 333;display: none; background-color: #fff; overflow:hidden;box-shadow:0px 0px 8px rgba(51, 51, 51, 0.45);}\n.tvCCTV_ind05 .content ul li .hover .img{width: 218px;height:123px;background:#e6e6e6 url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/zwPic165_47.png) no-repeat center center;}\n.tvCCTV_ind05 .content ul li .hover .img a{display:block;width: 100%;height: 100%;}\n.tvCCTV_ind05 .content ul li .hover .img img{width:100%;height: 100%;}\n.tvCCTV_ind05 .content ul li .hover .img video{width:218px;height: 123px; display:block;}\n.tvCCTV_ind05 .content ul li .hover .text{padding:0 15px;}\n.tvCCTV_ind05 .content ul li .hover .text h3{font-size:14px;height:42px;line-height:42px; padding-top:7px;font-weight:bold;font-style: normal;color: #222222;}\n.tvCCTV_ind05 .content ul li .hover .text span{font-size:14px;line-height:20px;height:80px; padding-bottom: 12px;color: #999999; overflow: hidden;font-style:normal;border-bottom:1px solid #e8e8e8;display:block;}\n.tvCCTV_ind05 .content ul li .hover .text span a{color: #666666;}\n.tvCCTV_ind05 .content ul li .hover .text .label{ line-height: 43px;height: 43px;font-size:0px; overflow:hidden;} \n.tvCCTV_ind05 .content ul li .hover .text .label a{font-size:14px;padding-right:10px;color:#666666;display:inline-block;}\n\n\n/*棋盘*/\n.tvCCTV_ind06{ height:240px; padding: 38px 0; background-image:url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/ind06_bg962.png); background-repeat: no-repeat; background-position:center center; margin-bottom: 30px;}\n.tvCCTV_ind06 ul{margin: 0 auto; width:960px; padding: 0 1px;}\n.tvCCTV_ind06 ul li{height: 76px;width: 76px;margin: 2px;border-radius:3px;overflow: hidden;float: left; text-align: center; background-image:url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/ind06_cel.png); overflow: hidden; background-size: 100% 100%; position: relative;}\n.tvCCTV_ind06 ul li table{ width: 100%; height:100%;}\n.tvCCTV_ind06 ul li.cel01{ background-image:url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/ind06_cel1.png);}\n.tvCCTV_ind06 ul li.cel02{ background-image:url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/ind06_cel2.png);width: 156px;}\n.tvCCTV_ind06 ul li.cel01 img{ width: 76px;height: 76px; }\n.tvCCTV_ind06 ul li.cel02 img{ width: 156px;height: 76px;}\n.tvCCTV_ind06 ul li.cel01:hover{background-image:url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/ind06_cel1H.png);}\n.tvCCTV_ind06 ul li.cel02:hover{background-image:url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/ind06_cel2H.png);}\n.tvCCTV_ind06 ul li img{ width: 100%; height: 100%;}\n.tvCCTV_ind06 ul li a{ font-size:16px; color:#009dff;font-weight: bold; text-align: center;}\n.tvCCTV_ind06 ul li a:hover{color:#009dff !important;}\n.tvCCTV_ind06 ul li .code{padding:11px; width:54px; height:54px;position: absolute; top: 0; right: 0;cursor: pointer;display: none;}\n.tvCCTV_ind06 ul li .code img{width:54px; height:54px;}\n.tvCCTV_ind06 ul li.celCode:hover{ background-image:url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/ind06_cel1.png);}\n.tvCCTV_ind06 ul li.celCode:hover .code{display:block;}\n\n\n/*片库*/\n.tvCCTV_ind07 {width: 962px;padding: 0 30px;margin-left: -30px;position:relative;overflow:hidden; padding-bottom:40px;}\n.tvCCTV_ind07 .content {height:307px;position: relative;}\n.tvCCTV_ind07 .content .inside{width:962px; height:307px;position: absolute;left: 0px; top: 0px;}\n/*.tvCCTV_ind07 .content .inside.cur{overflow:hidden;}*/\n.tvCCTV_ind07 .content .cont{width: 962px;display: inline-block;position: absolute;left:1222px;top: 0px; display: none;}\n.tvCCTV_ind07 .content .cont ul{width: 980px;}\n.tvCCTV_ind07 .content .cont ul li{width:178px;margin-right:18px;float:left;position:relative;z-index:1;}\n.tvCCTV_ind07 .content .cont ul li .conTop{ margin-bottom:4px;}\n.tvCCTV_ind07 .content .cont ul li .common .img{width: 178px;height:223px;background:#e6e6e6 url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/zwPic152_44.png) no-repeat center center; border-radius: 5px; overflow: hidden;}\n.tvCCTV_ind07 .content .cont ul li .common .img a{ display:block;}\n.tvCCTV_ind07 .content .cont ul li .common .img img{width: 178px;height:223px;display: block;}\n.tvCCTV_ind07 .content .cont ul li .common .img em{position: absolute;width: 32px; height: 18px;top: 10px; right: 10px;  display: block;}\n.tvCCTV_ind07 .content .cont ul li .common .img .HOT{ background-image: url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/nav_hot.png);}\n.tvCCTV_ind07 .content .cont ul li .common .img .NEW{background-image: url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/nav_new.png);}\n.tvCCTV_ind07 .content .cont ul li .common .text{height:44px;line-height:44px;font-size: 14px;width:100%; font-weight: bold;}\n.tvCCTV_ind07 .content .cont ul li .common .text a{color: #333333;}\n\n.tvCCTV_ind07 .content .cont ul li .hover{width:218px; height:307px; position: absolute;left:-20px;top:-10px; border-radius: 5px; z-index: 333;display: none; background-color: #fff; overflow:hidden;box-shadow:0px 0px 8px rgba(51, 51, 51, 0.45);}\n.tvCCTV_ind07 .content .cont ul li .hover .img{width: 218px;height:123px;background:#e6e6e6 url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/zwPic165_47.png) no-repeat center center;}\n.tvCCTV_ind07 .content .cont ul li .hover .img a{display:block;width: 100%;height: 100%;}\n.tvCCTV_ind07 .content .cont ul li .hover .img img{width:100%;height: 100%;}\n.tvCCTV_ind07 .content .cont ul li .hover .img video{width:218px;height: 123px; display:block;}\n.tvCCTV_ind07 .content .cont ul li .hover .text{padding:0 15px;}\n.tvCCTV_ind07 .content .cont ul li .hover .text h3{font-size:14px;height:42px;line-height:42px; padding-top:7px;font-weight:bold;font-style: normal;}\n.tvCCTV_ind07 .content .cont ul li .hover .text h3 a{color: #333333;}\n.tvCCTV_ind07 .content .cont ul li .hover .text span{font-size:14px;line-height:20px;height:80px; padding-bottom: 12px;color: #999999; overflow: hidden;font-style:normal;border-bottom:1px solid #e8e8e8;display:block;}\n.tvCCTV_ind07 .content .cont ul li .hover .text span a{color: #666666;}\n.tvCCTV_ind07 .content .cont ul li .hover .text .label{ line-height: 43px;height: 43px;font-size:0px; overflow:hidden;} \n.tvCCTV_ind07 .content .cont ul li .hover .text .label a{font-size:14px;padding-right:10px;color:#666666;display:inline-block;}\n\n.tvCCTV_ind07 .content .cont ul li .typeLabel{height:36px;line-height:36px;width:150px;font-size: 14px; text-align: center; color: #999999; margin: 0 auto;background-image:url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/ind07_textBg962_1200.png); }\n.tvCCTV_ind07 .content .cont ul li .typeLabel a{color: #999999; display: inline-block; width: 100%; height: 100%;}\n.tvCCTV_ind07 .content .cont ul li .typeLabel:hover{box-shadow:0px 0px 10px rgba(51, 51, 51, 0.15);border-radius: 5px;}\n\n\n/* 看点 */\n.tvCCTV_ind08 ul li{float: left; margin-right: 18px;width: 178px;margin-bottom: 17px; overflow: hidden;}\n.tvCCTV_ind08 ul li .image{width:178px; height: 101px;border-radius: 5px; overflow: hidden; background:#e6e6e6 url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/zwPic152_44.png) no-repeat center center;}\n.tvCCTV_ind08 ul li .image img{ width:100%; height: 100%;}\n.tvCCTV_ind08 ul li .text .title{font-size: 14px;line-height:20px; margin-top:6px; height:40px; overflow: hidden;}\n.tvCCTV_ind08 ul li .text .brief{font-size: 14px; color: #999999; line-height: 44px;}\n.tvCCTV_ind08 ul li .text .brief a{color: #999999;}\n\n\n\n/* 榜单 */\n.tvCCTV_ind09 {position: relative;}\n.tvCCTV_ind09 .bangdan_top{font-size: 24px; font-weight: bold; margin-bottom: 16px; line-height: 28px;position: relative; top: -2px;}\n.tvCCTV_ind09 .bangdan_bg{background: url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/tingyin_bg.png) no-repeat 0 0; position: absolute; width: 100px; height: 48px; z-index: 0; top: 0px; right: 20px;}\n.tvCCTV_ind09 .bangdan_all{ text-align: center; font-size: 16px; line-height: 58px; width: 100%;}\n.tvCCTV_ind09 .bangdan_all a{background: url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/icon.png) no-repeat right center; display: inline-block;padding-right: 17px;}\n.tvCCTV_ind09 .bangdan_all a:hover{ background-image: url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/iconH.png);}\n\n.tvCCTV_ind09 .bangdan_con{position: relative; z-index: 9;width:374px; height: 547px; box-shadow: 0 0 8px rgba(51,51,51,.15); border-radius: 5px; background:#FFFFFF url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/bangdan_con.png) no-repeat 0 0;}\n.tvCCTV_ind09 .bangdan_con ul{padding: 18px 30px 0 30px;clear: both; overflow: hidden;}\n.tvCCTV_ind09 .bangdan_con ul li{width: 100%;height: 44px; clear: both; overflow: hidden; padding:0; margin: 0;}\n.tvCCTV_ind09 .bangdan_con ul li:hover{ *cursor: pointer;}\n.tvCCTV_ind09 .bangdan_con ul li span{font-size: 16px; line-height: 44px;display: inline-block; vertical-align: middle;}\n.tvCCTV_ind09 .bangdan_con ul li i{width: 20px; height: 44px; margin-right: 18px; display: inline-block;float: left; background: url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/top_1.jpg) no-repeat left center;vertical-align: middle;cursor: default;}\n.tvCCTV_ind09 .bangdan_con ul li.top1 i{background-image: url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/top_1.jpg);}\n.tvCCTV_ind09 .bangdan_con ul li.top2 i{background-image: url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/top_2.jpg);}\n.tvCCTV_ind09 .bangdan_con ul li.top3 i{background-image: url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/top_3.jpg);}\n.tvCCTV_ind09 .bangdan_con ul li.top4 i{background-image: url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/top_4.jpg);}\n.tvCCTV_ind09 .bangdan_con ul li.top5 i{background-image: url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/top_5.jpg);}\n.tvCCTV_ind09 .bangdan_con ul li.top6 i{background-image: url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/top_6.jpg);}\n.tvCCTV_ind09 .bangdan_con ul li.top7 i{background-image: url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/top_7.jpg);}\n.tvCCTV_ind09 .bangdan_con ul li.top8 i{background-image: url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/top_8.jpg);}\n.tvCCTV_ind09 .bangdan_con ul li.top9 i{background-image: url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/top_9.jpg);}\n.tvCCTV_ind09 .bangdan_con ul li.top10 i{background-image: url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/top_10.jpg);}\n.tvCCTV_ind09 .bangdan_con ul li.top10{padding-bottom: 17px; margin-bottom: 0; border-bottom: 1px solid #e7e7e7;}\n\n\n/* 听音 */\n.tvCCTV_ind09 .tingyin_con{position: relative;z-index: 9;width: 100%; background-color: #FFFFFF;}\n.tvCCTV_ind09 .tingyin_con ul li{box-shadow: 0 0 8px rgba(51,51,51,.15); border-radius: 5px; overflow: hidden; height: 95px; width: 100%;margin-bottom: 18px;}\n.tvCCTV_ind09 .tingyin_con ul li.last{margin-bottom: 0;}\n.tvCCTV_ind09 .tingyin_con ul li .image{width: 95px; height: 100%; float: left;margin-right: 20px;border-radius: 5px;}\n.tvCCTV_ind09 .tingyin_con ul li .image .img{border-top-right-radius: 5px;border-bottom-right-radius: 5px;}\n.tvCCTV_ind09 .tingyin_con ul li .image .img_hover{display: none;width: 80px; height: 80px;*padding: 0 7px 0  8px;}\n.tvCCTV_ind09 .tingyin_con ul li .image:hover{padding:8px 7px 7px 8px;*padding:8px 0px 7px 0;box-sizing: border-box;}\n.tvCCTV_ind09 .tingyin_con ul li .image:hover .img{display: none;}\n.tvCCTV_ind09 .tingyin_con ul li .image:hover .img_hover{display: block;}\n.tvCCTV_ind09 .tingyin_con ul li .text{float: left; padding: 15px 20px 19px 0px; overflow: hidden;}\n.tvCCTV_ind09 .tingyin_con ul li .text .title{font-size: 16px; line-height: 36px;color: #222222; }\n.tvCCTV_ind09 .tingyin_con ul li .text .title a{color: #222222;}\n.tvCCTV_ind09 .tingyin_con ul li .text .title a:hover{color: #0084FF;}\n.tvCCTV_ind09 .tingyin_con ul li .text .brief{font-size: 14px; line-height: 26px;color: #999999;}\n\n/* 剧推荐 */\n.tvCCTV_ind09 .bangdan_con.jutuijian_con ul{padding: 35px 31px 0 30px;}\n.tvCCTV_ind09 .bangdan_con.jutuijian_con ul li.top10{padding-bottom: 41px;}\n.tvCCTV_ind09 .bangdan_con.jutuijian_con ul li{width: 100%;height: 82px;}\n.tvCCTV_ind09 .bangdan_con.jutuijian_con ul li p{line-height: 82px;float: none; padding-left: 0;}\n\n\n\n/* 底通节目单 */\n.program_wrapper{width:100%;background-color: #fff; padding-bottom: 40px;}\n.program_wrapper .kj{position:relative;}\n.program_wrapper .kj .bt{ width:100%;text-align: center;height:54px; }\n.program_wrapper .kj .bt a{display: block; width: 279px; height: 34px;margin: 0 auto;}\n.program_wrapper .kjf{clear:both}\n.program_wrapper .kjf table{border-collapse:collapse;height:142px;}\n.program_wrapper .kjf table td {text-align:center;border:1px solid #ebebeb;width: 105px; position: relative;cursor:pointer;}\n.program_wrapper .kjf table td.cur span{ position: absolute; width: 100%; height: 4px; bottom: 0; left: 0; background-color:#bf0614; display:block;}\n.program_wrapper .kjf table td a{ color:#535353; font-size:16px; line-height:20px; color:#535353; font-weight:bold;}\n.program_wrapper .kjf table td a:hover{text-decoration:none}\n.program_wrapper .kjf table td.cur a{ color:#bf0614 !important;}\n.program_wrapper .kjf table td:hover a{ color:#bf0614 !important;}\n.program_wrapper .kjf table td.empty{ cursor:default;}\n.program_wrapper .kjr{ overflow:hidden; border-left:1px solid #ebebeb; border-right:1px solid #ebebeb; border-bottom:1px solid #ebebeb; width: 960px; min-height: 168px;clear:both;}\n.program_wrapper .kjr .list_box{display: none;}\n.program_wrapper .kjr .list_box.cur{display: block;}\n.program_wrapper .kjr .conBox{ overflow:hidden;_zoom:1;}\n.program_wrapper .kjr .conBox .playBox{padding: 20px 10px 20px 28px; width: 150px;min-height:130px;float:left;border-right: 1px solid #ebebeb;}\n.program_wrapper .kjr .conBox .playBox .imageBox{overflow:hidden;}\n.program_wrapper .kjr .conBox .playBox .imageBox .hd{height:21px; padding-bottom: 3px;}\n.program_wrapper .kjr .conBox .playBox .imageBox .hd a{color:#000;}\n.program_wrapper .kjr .conBox .playBox .imageBox .hd a:hover{text-decoration:none;}\n.program_wrapper .kjr .conBox .playBox .imageBox .hd img{display:block;float:left;width: auto; min-height:21px;}\n.program_wrapper .kjr .conBox .playBox .imageBox .tr{ color:#333; }\n.program_wrapper .kjr .conBox .playBox .imageBox .tr p{ font-weight:bold; color:#bf0614; font-size:16px;line-height:20px;margin-bottom: 5px;margin-top: 14px;}\n.program_wrapper .kjr .conBox .playBox .imageBox .tr a{color:#333;font-size: 13px;line-height: 20px;}\n.program_wrapper .kjr .conBox .playBox .imageBox .tr a:hover{color:#333 !important;}\n.program_wrapper .kjr .conBox .promList{ width:770px;padding:12px 0 12px 0;float:right;}    \n.program_wrapper .kjr .conBox .promList .listBox table tr td{ font-size:13px;color:#333; text-align:left;width: 130px;height: 28px;line-height: 28px;}\n.program_wrapper .kjr .conBox .promList .listBox table tr td:first-child{padding-left: 20px;}\n.program_wrapper .kjr .conBox .promList .listBox table tr td a{width:115px;color:#333;}\n.program_wrapper .kjr .conBox .promList .listBox table tr td a:hover{ color:#bf0614 !important;}\n\n/* 悬浮导航 */\n.header_nav{width: 100%;height: 59px;border-bottom: 1px solid #0084ff;background:#fff;position: fixed;top: 0; z-index: 15; display: none;}\n.tvCCTV_nav { width: 962px; height: 100%; margin: 0 auto; clear: both;}\n.tvCCTV_nav .logoNav .navUl .navLi.xfend2{display: none;}\n.tvCCTV_nav .logoNav .navUl .navLi.xfend3{display: none;}\n.tvCCTV_nav .logoNav{float: left;height: 100%; }\n.tvCCTV_nav .logoNav span{float: left;margin: 22px 24px 0 0;}\n.tvCCTV_nav .logoNav span img{width: 138px;height: 15px;}\n.tvCCTV_nav .logoNav .navUl{float: left;height: 100%; }\n.tvCCTV_nav .logoNav .navUl .navLi{float: left;line-height: 59px;height: 100%; }\n.tvCCTV_nav .logoNav .navUl .navLi a{padding: 0 15px;font-size: 14px;color: #222;display: inline-block;height: 100%; }\n.tvCCTV_nav .logoNav .navUl .navLi a i{display: inline-block;ma