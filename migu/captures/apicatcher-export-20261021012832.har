mage2\":\"https://p3.img.cctvpic.com/apple3g/www/upload/image/20231023/1698016539576016148.jpg\",\"isCourse\":0,\"isSubed\":0,\"keywords\":\"重阳节,亲情,传承\",\"labelId\":\"18aiYZ3m0926\",\"likeCount\":0,\"mediaId\":\"18ryeuIb0926\",\"mediaImg\":\"https://p1.img.cctvpic.com/apple3g/www/upload/image/20260828/1787896006290088494.jpg\",\"mediaName\":\"比划\",\"pubTime\":1698016566415,\"pv\":\"\",\"sc\":\"\",\"seqId\":1698016566415,\"seqStrId\":\"1698016566415\",\"size\":\"4:3\",\"source\":0,\"subTitle\":\"\",\"title\":\"质疑父母理解父母超越父母 国人血脉觉醒指南\",\"vbrief\":\"二十弱冠，血脉觉醒，听凤凰传奇，买黄金首饰，看周公解梦，去庙里拜佛，拍山水花草，看中医养生，攒塑料袋子，喝枸杞花茶……以父母辈为己任，求同存异，靠拢而行！\",\"vcount\":0,\"vduration\":223,\"vid\":\"9ee6aef6280240ddb289b7d28abcb961\",\"videoType\":0,\"vip_flag\":0,\"webUrl\":\"https://v.cctv.com/reping/bh/index.shtml\",\"wwwUrl\":\"https://v.cctv.com/2023/10/23/VIDEnCeFIhggtS33ZxbaD6m6231023.shtml\"},{\"allowAd\":0,\"allowComment\":0,\"allowShare\":0,\"cateId\":\"18AzYZNf0926\",\"cateName\":\"热评\",\"cvid\":\"VIDEsasq8hJu2UayU3zkSvb7230918\",\"episodes\":0,\"fc\":\"\",\"feedType\":\"3\",\"guid\":\"20c62737629041f29983c699fddb2ece\",\"image1\":\"https://p4.img.cctvpic.com/apple3g/www/upload/image/20230918/1695000161052065819.jpg\",\"image2\":\"https://p1.img.cctvpic.com/apple3g/www/upload/image/20230918/1695000164659051417.jpg\",\"isCourse\":0,\"isSubed\":0,\"keywords\":\"“九一八”事变,中国,文物\",\"labelId\":\"18aiYZ3m0926\",\"likeCount\":0,\"mediaId\":\"18ryeuIb0926\",\"mediaImg\":\"https://p1.img.cctvpic.com/apple3g/www/upload/image/20260828/1787896006290088494.jpg\",\"mediaName\":\"比划\",\"pubTime\":1695000200853,\"pv\":\"\",\"sc\":\"\",\"seqId\":1695000200853,\"seqStrId\":\"1695000200853\",\"size\":\"4:3\",\"source\":0,\"subTitle\":\"\",\"title\":\"九一八，这组触目惊心的数字不容忘却！\",\"vbrief\":\"今天是9月18日，“九一八”事变爆发92周年。14年的浴血奋战，中国军民伤亡3500多万人，期间930余座城市被侵占，4200万难民无家可归，被抢文物超360万件……这一连串血淋淋的数字，揭露了侵华日军的累累暴行，也目睹着一个民族的不屈与抗争。勿忘国耻，吾辈自强！\",\"vcount\":0,\"vduration\":118,\"vid\":\"48e533c147b649e4b7fa0cad32692aee\",\"videoType\":0,\"vip_flag\":0,\"webUrl\":\"https://v.cctv.com/reping/bh/index.shtml\",\"wwwUrl\":\"https://v.cctv.com/2023/09/18/VIDEsasq8hJu2UayU3zkSvb7230918.shtml\"},{\"allowAd\":0,\"allowComment\":0,\"allowShare\":0,\"cateId\":\"18AzYZNf0926\",\"cateName\":\"热评\",\"cvid\":\"VIDEHZIJ9z26Zi4KObjzy1cC230903\",\"episodes\":0,\"fc\":\"\",\"feedType\":\"3\",\"guid\":\"43f962a1b9db4215a73a0fbf6876deb2\",\"image1\":\"https://p4.img.cctvpic.com/apple3g/www/upload/image/20230903/1693699456367042591.jpg\",\"image2\":\"https://p2.img.cctvpic.com/apple3g/www/upload/image/20230903/1693699460261037092.jpg\",\"isCourse\":0,\"isSubed\":0,\"keywords\":\"原子弹,核污染,历史\",\"labelId\":\"18aiYZ3m0926\",\"likeCount\":0,\"mediaId\":\"18ryeuIb0926\",\"mediaImg\":\"https://p1.img.cctvpic.com/apple3g/www/upload/image/20260828/1787896006290088494.jpg\",\"mediaName\":\"比划\",\"pubTime\":1693699488687,\"pv\":\"\",\"sc\":\"\",\"seqId\":1693699488687,\"seqStrId\":\"1693699488687\",\"size\":\"4:3\",\"source\":0,\"subTitle\":\"\",\"title\":\"重返二战回忆 落在日本的两颗原子弹\",\"vbrief\":\"1945年8月，日本在遭到原子弹爆炸后，约有7万人因核爆死亡，20万人因核辐射引发疾病相继死去。而当初遭受原子弹袭击的日本，很多右翼势力也并没有正视历史，反思过去的战争罪行。核武器的研发和使用就像打开了潘多拉魔盒，到今天，核辐射成为了隐形的威胁，伤害全人类。\",\"vcount\":0,\"vduration\":224,\"vid\":\"fdd326d7c5d54c539c3e882c9d244621\",\"videoType\":0,\"vip_flag\":0,\"webUrl\":\"https://v.cctv.com/reping/bh/index.shtml\",\"wwwUrl\":\"https://v.cctv.com/2023/09/03/VIDEHZIJ9z26Zi4KObjzy1cC230903.shtml\"},{\"allowAd\":0,\"allowComment\":0,\"allowShare\":0,\"cateId\":\"18AzYZNf0926\",\"cateName\":\"热评\",\"cvid\":\"VIDEET2trDVCdmj1EngbTEwO230828\",\"episodes\":0,\"fc\":\"\",\"feedType\":\"3\",\"guid\":\"c6a3728054b24a92b1a738788ee54de7\",\"image1\":\"https://p2.img.cctvpic.com/apple3g/www/upload/image/20230828/1693203797505024719.jpg\",\"image2\":\"https://p3.img.cctvpic.com/apple3g/www/upload/image/20230828/1693203801951038445.jpg\",\"isCourse\":0,\"isSubed\":0,\"keywords\":\"暑假,游乐场,国潮\",\"labelId\":\"18aiYZ3m0926\",\"likeCount\":0,\"mediaId\":\"18ryeuIb0926\",\"mediaImg\":\"https