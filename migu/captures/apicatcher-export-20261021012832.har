            "mimeType" : "application/json;charset=UTF-8",
            "text" : "cb({\"code\":200,\"msg\":\"Sucess\",\"status\":\"Sucess\",\"data\":[{\"allowAd\":0,\"allowComment\":0,\"allowShare\":0,\"cateId\":\"18BjmqQf0926\",\"cateName\":\"科普\",\"cvid\":\"VIDEeS87fKEr2R3lMFkIaloJ261016\",\"episodes\":0,\"fc\":\"\",\"feedType\":\"3\",\"guid\":\"ab17469edb134718aa106317122a1631\",\"image1\":\"https://p4.img.cctvpic.com/apple3g/www/upload/image/20261016/1792157230059075508.jpg\",\"image2\":\"https://p3.img.cctvpic.com/apple3g/www/upload/image/20261016/1792157239792065144.jpg\",\"isCourse\":0,\"isSubed\":0,\"keywords\":\"肺鼠疫,科普,热点话题\",\"labelId\":\"18fIv2ya0926\",\"likeCount\":0,\"mediaId\":\"18ryeuIb0926\",\"mediaImg\":\"https://p1.img.cctvpic.com/apple3g/www/upload/image/20260828/1787896006290088494.jpg\",\"mediaName\":\"比划\",\"pubTime\":1792157241883,\"pv\":\"100.2万\",\"sc\":\"\",\"seqId\":1792157241883,\"seqStrId\":\"1792157241883\",\"size\":\"4:3\",\"source\":0,\"subTitle\":\"\",\"title\":\"不碰老鼠也会感染？2分钟读懂最凶险的“肺鼠疫”\",\"vbrief\":\"最近，一则“俄罗斯28岁鼠疫防控研究员突然病亡”的消息，从迅速传遍全球网络，也让渐渐被淡忘的鼠疫重回公众视野。肺鼠疫为何能绕过老鼠和跳蚤，实现人际传播？它究竟有多凶险，如今又有哪些治疗手段？普通人在户外该如何避开感染风险？本期视频带你看懂肺鼠疫，科学防范，不必恐慌。\",\"vcount\":0,\"vduration\":157,\"vid\":\"3e8b9cf41fe049e5a49e4a578ebaf37a\",\"videoType\":0,\"vip_flag\":0,\"webUrl\":\"https://v.cctv.com/reping/bh/index.shtml\",\"wwwUrl\":\"https://v.cctv.com/2026/10/16/VIDEeS87fKEr2R3lMFkIaloJ261016.shtml\"},{\"allowAd\":0,\"allowComment\":0,\"allowShare\":0,\"cateId\":\"18MZvI3a0926\",\"cateName\":\"资讯\",\"cvid\":\"VIDEKftrsMFJKhsJy5558qhy261004\",\"episodes\":0,\"fc\":\"原创\",\"feedType\":\"3\",\"guid\":\"42259aaacf6a42a186e3057661581a0a\",\"image1\":\"https://p1.img.cctvpic.com/apple3g/www/upload/image/20261004/1791106685296035518.jpg\",\"image2\":\"https://p3.img.cctvpic.com/apple3g/www/upload/image/20261004/1791106690609063496.jpg\",\"isCourse\":0,\"isSubed\":0,\"keywords\":\"美国白蛾,虫子\",\"labelId\":\"18Jj6nUj0926\",\"likeCount\":0,\"mediaId\":\"18ryeuIb0926\",\"mediaImg\":\"https://p1.img.cctvpic.com/apple3g/www/upload/image/20260828/1787896006290088494.jpg\",\"mediaName\":\"比划\",\"pubTime\":1791106717726,\"pv\":\"79.9万\",\"sc\":\"\",\"seqId\":1791106717726,\"seqStrId\":\"1791106717726\",\"size\":\"16:9\",\"source\":0,\"subTitle\":\"\",\"title\":\"随手一拍就遭殃！北京泛滥害虫揭秘\",\"vbrief\":\"树上挂白网的毛毛虫、身上黑橘相间的“小蚂蚁”，到底什么来头？美国白蛾、隐翅虫怎么认，落在身上怎么处理？这份防虫避坑指南赶紧收好！\",\"vcount\":0,\"vduration\":183,\"vid\":\"dcaec378a3e144c6bdd2329468078136\",\"videoType\":0,\"vip_flag\":0,\"webUrl\":\"https://v.cctv.com/reping/bh/index.shtml\",\"wwwUrl\":\"https://v.cctv.com/2026/10/04/VIDEKftrsMFJKhsJy5558qhy261004.shtml\"},{\"allowAd\":0,\"allowComment\":0,\"allowShare\":0,\"cateId\":\"18AzYZNf0926\",\"cateName\":\"热评\",\"cvid\":\"VIDEbq2TSgKlXuAO8fFxcyfo260829\",\"episodes\":0,\"fc\":\"\",\"feedType\":\"3\",\"guid\":\"52c1c9d90d144457b3f6f0338d70a2ef\",\"image1\":\"https://p3.img.cctvpic.com/apple3g/www/upload/image/20260829/1787973681785009461.jpg\",\"image2\":\"https://p1.img.cctvpic.com/apple3g/www/upload/image/20260829/1787973690273078614.jpg\",\"isCourse\":0,\"isSubed\":0,\"keywords\":\"吉隆,尼泊尔,灾害\",\"labelId\":\"18aiYZ3m0926\",\"likeCount\":0,\"mediaId\":\"18ryeuIb0926\",\"mediaImg\":\"https://p1.img.cctvpic.com/apple3g/www/upload/image/20260828/1787896006290088494.jpg\",\"mediaName\":\"比划\",\"pubTime\":1787973752105,\"pv\":\"280.1万\",\"sc\":\"\",\"seqId\":1787973752105,\"seqStrId\":\"1787973752105\",\"size\":\"4:3\",\"source\":0,\"subTitle\":\"\",\"title\":\"7分钟形成致命冲击！吉隆跨境泥石流为何如此凶猛\",\"vbrief\":\"近日，尼泊尔一侧突发泥石流，仅用7分钟便冲至西藏吉隆口岸。当地此前并无明显强降雨，专家初步判断，灾害可能由高位冰崩引发。它为何来得如此快、冲击力如此强？救援难在哪？\",\"vcount\":0,\"vduration\":163,\"vid\":\"c86779d96afc47de97188312d32042ad\",\"videoType\":0,\"vip_flag\":0,\"webUrl\":\"https://v.cctv.com/reping/bh/index.shtml\",\"wwwUrl\":\"https://v.cctv.com/2026/08/29/VIDEbq2TSgKlXuAO8fFxcyfo260829.shtml\"},{\"allowAd\":0,\"allowComment\":0,\"allowShare\":0,\"cateId\":\"18AzYZNf0926\",\"cateName\":\"热评\",\"cvid\":\"VIDEzRNEd4FzpEU5PEjQsdX1260826\",\"episodes\":0,\"fc\":\"\",\"feedType\":\"3\",\"guid\":\"6f77b827d89b4be3a7462d94818a1273\",\"image1\":\"https://p1.img.cctvpic.com/apple3g/www/upload/image/20260826/1787699411680094818.jpg\",\"image2\":\"https://p3.img.cctvpic.com/apple3g/www/upload/image/20260826/1787699418272017385.jpg\",\"isCourse\":0,\"isSubed\":0,\"keywords\":\"美国,专机,导弹\",\"labelId\":\"18aiYZ3m0926\",\"likeCount\":0,\"mediaId\":\"18ryeuIb0926\",\"mediaImg\":\"https://p1.img.cctvpic.com/apple3g/www/upload/image/20260828/1787896006290088494.jpg\",\"mediaName\":\"比划\",\"pubTime\":1787699517049,\"pv\":\"361.8万\",\"sc\":\"\",\"seqId\":1787699517049,\"seqStrId\":\"1787699517049\",\"size\":\"4:3\",\"source\":0,\"subTitle\":\"\",\"title\":\"弹来！美国总统专机如何躲导弹？\",\"vbrief\":\"近日，美国总统特朗普因导弹威胁“藏”餐车秘密换机引发关注，那么，号称“空中堡垒”的美国总统专机，配备了哪些防御手段？面对一颗热追踪导弹袭击，它如何预警反制？当高端装备叠满技术“buff”，特朗普为何最终还是选择“躲”为上策？\",\"vcount\":0,\"vduration\":218,\"vid\":\"441a2c5365354c7186559bf74c29c9b2\",\"videoType\":0,\"vip_flag\":0,\"webUrl\":\"https://v.cctv.com/reping/bh/index.shtml\",\"wwwUrl\":\"https://v.cctv.com/2026/08/26/VIDEzRNEd4FzpEU5PEjQsdX1260826.shtml\"},{\"allowAd\":0,\"allowComment\":0,\"allowShare\":0,\"cateId\":\"18AzYZNf0926\",\"cateName\":\"热评\",\"cvid\":\"VIDEzgyyvYNGaKjEUQsEDXme260812\",\"episodes\":0,\"fc\":\"\",\"feedType\":\"3\",\"guid\":\"24efc742551449cca7c84360bd69b772\",\"image1\":\"https://p2.img.cctvpic.com/apple3g/www/upload/image/20260812/1786533125272056488.jpg\",\"image2\":\"https://p4.img.cctvpic.com/apple3g/www/upload/image/20260812/1786533133324051992.jpg\",\"isCourse\":0,\"isSubed\":0,\"keywords\":\"自然灾害,极端天气,科普\",\"labelId\":\"18aiYZ3m0926\",\"likeCount\":0,\"mediaId\":\"18ryeuIb0926\",\"mediaImg\":\"https://p1.img.cctvpic.com/apple3g/www/upload/image/20260828/1787896006290088494.jpg\",\"mediaName\":\"比划\",\"pubTime\":1786533139088,\"pv\":\"31.4万\",\"sc\":\"\",\"seqId\":1786533139088,\"seqStrId\":\"1786533139088\",\"size\":\"4:3\",\"source\":0,\"subTitle\":\"\",\"title\":\"地球异动说明书：30秒透视六大自然灾害\",\"vbrief\":\"今年，极端天气频频刷屏。台风、暴雨、内涝为何越来越猛？厄尔尼诺又如何搅动全球气候？拆解灾害的形成、爆发与影响，看懂地球的“异常模式”。\",\"vcount\":0,\"vduration\":31,\"vid\":\"1b8c815998eb4d50a1339e0191af5ecf\",\"videoType\":0,\"vip_flag\":0,\"webUrl\":\"https://v.cctv.com/reping/bh/index.shtml\",\"wwwUrl\":\"https://v.cctv.com/2026/08/12/VIDEzgyyvYNGaKjEUQsEDXme260812.shtml\"},{\"allowAd\":0,\"allowComment\":0,\"allowShare\":0,\"cateId\":\"18AzYZNf0926\",\"cateName\":\"热评\",\"cvid\":\"VIDEZbFFdC75HXxNfivzrO9e260710\",\"episodes\":0,\"fc\":\"\",\"feedType\":\"3\",\"guid\":\"2c484d0b21d6449d9f95c0658fff4192\",\"image1\":\"https://p4.img.cctvpic.com/apple3g/www/upload/image/20260710/1783668456175093808.jpg\",\"image2\":\"https://p1.img.cctvpic.com/apple3g/www/upload/image/20260710/1783668461353001174.jpg\",\"isCourse\":0,\"isSubed\":0,\"keywords\":\"台风\",\"labelId\":\"18aiYZ3m0926\",\"likeCount\":0,\"mediaId\":\"18ryeuIb0926\",\"mediaImg\":\"https://p1.img.cctvpic.com/apple3g/www/upload/image/20260828/1787896006290088494.jpg\",\"mediaName\":\"比划\",\"pubTime\":1783668496379,\"pv\":\"240.6万\",\"sc\":\"\",\"seqId\":1783668496379,\"seqStrId\":\"1783668496379\",\"size\":\"4:3\",\"source\":0,\"subTitle\":\"\",\"title\":\"硬核揭秘：为什么不能用炸弹摧毁台风？\",\"vbrief\":\"面对破坏力惊人的台风，能不能直接扔颗炸弹把它炸散？为什么人类最强大的武器在台风面前不仅无济于事，甚至还会沦为给台风“火上浇油”的燃料？用炸弹对抗台风，究竟会引发怎样意想不到的灾难？点击视频，带你破解这个疯狂的科学悖论。\",\"vcount\":0,\"vduration\":173,\"vid\":\"1b750b468a764dfda1f41dd89fc9df21\",\"videoType\":0,\"vip_flag\":0,\"webUrl\":\"https://v.cctv.com/reping/bh/index.shtml\",\"wwwUrl\":\"https://v.cctv.com/2026/07/10/VIDEZbFFdC75HXxNfivzrO9e260710.shtml\"},{\"allowAd\":0,\"allowComment\":0,\"allowShare\":0,\"cateId\":\"18AzYZNf0926\",\"cateName\":\"热评\",\"cvid\":\"VIDEfekfaAyloBWpByEXveyY260330\",\"episodes\":0,\"fc\":\"\",\"feedType\":\"3\",\"guid\":\"6d60aa0af68e4be9adcff931b1c71ffc\",\"image1\":\"https://p3.img.cctvpic.com/apple3g/www/upload/image/20260330/1774864070308022624.jpg\",\"image2\":\"https://p4.img.cctvpic.com/apple3g/www/upload/image/20260330/1774864076006070103.jpg\",\"isCourse\":0,\"isSubed\":0,\"keywords\":\"心脏猝死,健康\",\"labelId\":\"18aiYZ3m0926\",\"likeCount\":0,\"mediaId\":\"18ryeuIb0926\",\"mediaImg\":\"https://p1.img.cctvpic.com/apple3g/www/upload/image/20260828/1787896006290088494.jpg\",\"mediaName\":\"比划\",\"pubTime\":1774864105371,\"pv\":\"26.6万\",\"sc\":\"\",\"seqId\":1774864105371,\"seqStrId\":\"1774864105371\",\"size\":\"4:3\",\"source\":0,\"subTitle\":\"\",\"title\":\"30秒透视：心脏猝死瞬间发生了什么？\",\"vbrief\":\"心跳飙到600次/分？80%的猝死源于心脏“漏电”。直击发病全过程。别让熬夜透支生命，从今天起，对健康负责！\",\"vcount\":0,\"vduration\":30,\"vid\":\"76c39bb854e04622b49e42fed98dd005\",\"videoType\":0,\"vip_flag\":0,\"webUrl\":\"https://v.cctv.com/reping/bh/index.shtml\",\"wwwUrl\":\"https://v.cctv.com/2026/03/26/VIDEvO7xbxSFCfUQs5YozlNT260326.shtml\"},{\"allowAd\":0,\"allowComment\":0,\"allowShare\":0,\"cateId\":\"18BjQNVv0926\",\"cateName\":\"纪实\",\"cvid\":\"VIDEyBFxfs0mayU9OZyz63oi260204\",\"episodes\":0,\"fc\":\"\",\"feedType\":\"3\",\"guid\":\"2125e3f6285749a19f59c19dd3d66e41\",\"image1\":\"https://p4.img.cctvpic.com/apple3g/www/upload/image/20260204/1770170083139047812.jpg\",\"image2\":\"https://p4.img.cctvpic.com/apple3g/www/upload/image/20260204/1770170088573004497.jpg\",\"isCourse\":0,\"isSubed\":0,\"keywords\":\"立春\",\"labelId\":\"186Ff63i0926\",\"likeCount\":0,\"mediaId\":\"18ryeuIb0926\",\"mediaImg\":\"https://p1.img.cctvpic.com/apple3g/www/upload/image/20260828/1787896006290088494.jpg\",\"mediaName\":\"比划\",\"pubTime\":1770170150024,\"pv\":\"5.5万\",\"sc\":\"\",\"seqId\":1770170150024,\"seqStrId\":\"1770170150024\",\"size\":\"4:3\",\"source\":0,\"subTitle\":\"\",\"title\":\"立春报到，春节为啥在阳历“迷路”？破案动画来了！\",\"vbrief\":\"今天立春，全国大回暖！为啥立春没“迟到”，春节日期为啥每年在阳历上“乱逛”？其实，这是太阳（阳历）与月亮（农历）的“宇宙拉扯”。3分钟动画，揭秘老祖宗的智慧！\\n\",\"vcount\":0,\"vduration\":108,\"vid\":\"ec0f746e36404bbabb08f841c125077c\",\"videoType\":0,\"vip_flag\":0,\"webUrl\":\"https://v.cctv.com/reping/bh/index.shtml\",\"wwwUrl\":\"https://v.cctv.com/2026/02/04/VIDEyBFxfs0mayU9OZyz63oi260204.shtml\"},{\"allowAd\":0,\"allowComment\":0,\"allowShare\":0,\"cateId\":\"18AzYZNf0926\",\"cateName\":\"热评\",\"cvid\":\"VIDE1scV7wJPyn8O3tjRtobb260112\",\"episodes\":0,\"fc\":\"原创\",\"feedType\":\"3\",\"guid\":\"5c68d8be6c82480a9357faa55e1b55b1\",\"image1\":\"https://p4.img.cctvpic.com/apple3g/www/upload/image/20260112/1768206851173011507.jpg\",\"image2\":\"https://p4.img.cctvpic.com/apple3g/www/upload/image/20260112/1768206857259004197.jpg\",\"isCourse\":0,\"isSubed\":0,\"keywords\":\"鳌太线,登山\",\"labelId\":\"18aiYZ3m0926\",\"likeCount\":0,\"mediaId\":\"18ryeuIb0926\",\"mediaImg\":\"https://p1.img.cctvpic.com/apple3g/www/upload/image/20260828/1787896006290088494.jpg\",\"mediaName\":\"比划\",\"pubTime\":1768206879297,\"pv\":\"365.2万\",\"sc\":\"\",\"seqId\":1768206879297,\"seqStrId\":\"1768206879297\",\"size\":\"16:9\",\"source\":0,\"subTitle\":\"\",\"title\":\"屡次夺人性命 鳌太线为何被称为“第一夺命线”\",\"vbrief\":\"这条被吹捧为\\\"强驴毕业礼\\\"的线路，为何成为国内死亡率第一的夺命线？\",\"vcount\":0,\"vduration\":150,\"vid\":\"0336ca667a8b4323a95ab375c4ebbb23\",\"videoType\":0,\"vip_flag\":0,\"webUrl\":\"https://v.cctv.com/reping/bh/index.shtml\",\"wwwUrl\":\"https://v.cctv.com/2026/01/12/VIDE1scV7wJPyn8O3tjRtobb260112.shtml\"},{\"allowAd\":0,\"allowComment\":0,\"allowShare\":0,\"cateId\":\"18MZvI3a0926\",\"cateName\":\"资讯\",\"cvid\":\"VIDEDQivoS539U85FcRd1kMF251227\",\"episodes\":0,\"fc\":\"\",\"feedType\":\"3\",\"guid\":\"b9507a097c554eaca7cc3dcee04b01d2\",\"image1\":\"https://p4.img.cctvpic.com/apple3g/www/upload/image/20251227/1766793812133029398.jpg\",\"image2\":\"https://p1.img.cctvpic.com/apple3g/www/upload/image/20251227/1766793815286015631.jpg\",\"isCourse\":0,\"isSubed\":0,\"keywords\":\"年终策划,2025年,AI\",\"labelId\":\"18Jj6nUj0926\",\"likeCount\":0,\"mediaId\":\"18ryeuIb0926\",\"mediaImg\":\"https://p1.img.cctvpic.com/apple3g/www/upload/image/20260828/1787896006290088494.jpg\",\"mediaName\":\"比划\",\"pubTime\":1766793973550,\"pv\":\"91.9万\",\"sc\":\"\",\"seqId\":1766793973550,\"seqStrId\":\"1766793973550\",\"size\":\"4:3\",\"source\":0,\"subTitle\":\"\",\"title\":\"2025温度存档：那些被平凡人点亮的日常\",\"vbrief\":\"2025年，世界热衷于讨论每一个“爆款”。但回过头看，真正支撑起这一年的，是无数具体而鲜活的人，用最真挚的热爱与真诚，构成了2025最温暖的底色。在这个视频里，我们试着用AI作为一支温柔的画笔，为无数平凡的日常添彩，为微小的梦想加冕。愿2026年，生活本身，就是你最高级的童话。\\n\",\"vcount\":0,\"vduration\":198,\"vid\":\"11a3e9ca9d744dc7b31c31ad8acb3e4e\",\"videoType\":0,\"vip_flag\":0,\"webUrl\":\"https://v.cctv.com/reping/bh/index.shtml\",\"wwwUrl\":\"https://v.cctv.com/2025/12/27/VIDEDQivoS539U85FcRd1kMF251227.shtml\"},{\"allowAd\":0,\"allowComment\":0,\"allowShare\":0,\"cateId\":\"18MZvI3a0926\",\"cateName\":\"资讯\",\"cvid\":\"VIDELjYuvNTeK2LTVB2urewR251127\",\"episodes\":0,\"fc\":\"\",\"feedType\":\"3\",\"guid\":\"87619978de8f417796c38f3f77d9ed3d\",\"image1\":\"https://p3.img.cctvpic.com/apple3g/www/upload/image/20251127/1764249893773003476.jpg\",\"image2\":\"https://p1.img.cctvpic.com/apple3g/www/upload/image/20251127/1764249899478044185.jpg\",\"isCourse\":0,\"isSubed\":0,\"keywords\":\"香港\",\"labelId\":\"18Jj6nUj0926\",\"likeCount\":0,\"mediaId\":\"18ryeuIb0926\",\"mediaImg\":\"https://p1.img.cctvpic.com/apple3g/www/upload/image/20260828/1787896006290088494.jpg\",\"mediaName\":\"比划\",\"pubTime\":1764249913045,\"pv\":\"10.4万\",\"sc\":\"\",\"seqId\":1764249913045,\"seqStrId\":\"1764249913045\",\"size\":\"4:3\",\"source\":0,\"subTitle\":\"\",\"title\":\"30秒AI演示香港大埔宏福苑火灾蔓延路径  警钟长鸣\",\"vbrief\":\"4小时，火警等级连升5级！香港宏福苑火势为何失控这么快？除了现场的风力，到底是什么特殊的建筑环境因素，加速了火势的垂直蔓延？看清隐患，只为防患于未然。愿逝者安息，生者坚强，悲剧不再重演。\",\"vcount\":0,\"vduration\":39,\"vid\":\"7302504540834f54b12a77968380ab9f\",\"videoType\":0,\"vip_flag\":0,\"webUrl\":\"https://v.cctv.com/reping/bh/index.shtml\",\"wwwUrl\":\"https://v.cctv.com/2025/11/27/VIDELjYuvNTeK2LTVB2urewR251127.shtml\"},{\"allowAd\":0,\"allowComment\":0,\"allowShare\":0,\"cateId\":\"18MZvI3a0926\",\"cateName\":\"资讯\",\"cvid\":\"VIDEyTiXoZgKGqBCYdJmRwzB251124\",\"episodes\":0,\"fc\":\"\",\"feedType\":\"3\",\"guid\":\"14e9fce1628443c1a8f4e5036bf5b110\",\"image1\":\"https://p4.img.cctvpic.com/apple3g/www/upload/image/20251124/1763988716112058379.jpg\",\"image2\":\"https://p4.img.cctvpic.com/apple3g/www/upload/image/20251124/1763988723729031115.jpg\",\"isCourse\":0,\"isSubed\":0,\"keywords\":\"日本,侵略\",\"labelId\":\"18Jj6nUj0926\",\"likeCount\":0,\"mediaId\":\"18ryeuIb0926\",\"mediaImg\":\"https://p1.img.cctvpic.com/apple3g/www/upload/image/20260828/1787896006290088494.jpg\",\"mediaName\":\"比划\",\"pubTime\":1763988733186,\"pv\":\"3.3万\",\"sc\":\"\",\"seqId\":1763988733186,\"seqStrId\":\"1763988733186\",\"size\":\"4:3\",\"source\":0,\"subTitle\":\"\",\"title\":\"“对日本这个国家 一定要打到它怕”\",\"vbrief\":\"“打到它服气！”\",\"vcount\":0,\"vduration\":15,\"vid\":\"2c41816013254f2e9f643888da8906a7\",\"videoType\":0,\"vip_flag\":0,\"webUrl\":\"https://v.cctv.com/reping/bh/index.shtml\",\"wwwUrl\":\"https://v.cctv.com/2025/11/24/VIDEyTiXoZgKGqBCYdJmRwzB251124.shtml\"},{\"allowAd\":0,\"allowComment\":0,\"allowShare\":0,\"cateId\":\"18AzYZNf0926\",\"cateName\":\"热评\",\"cvid\":\"VIDEdao6093znRmEQB3NPeqt251115\",\"episodes\":0,\"fc\":\"\",\"feedType\":\"3\",\"guid\":\"97cb35a290f44ea9a45da71ceca00a5b\",\"image1\":\"https://p2.img.cctvpic.com/apple3g/www/upload/image/20251115/1763162263966041627.jpg\",\"image2\":\"https://p1.img.cctvpic.com/apple3g/www/upload/image/20251115/1763162269502037907.jpg\",\"isCourse\":0,\"isSubed\":0,\"keywords\":\"太空救援,神舟二十号\",\"labelId\":\"18aiYZ3m0926\",\"likeCount\":0,\"mediaId\":\"18ryeuIb0926\",\"mediaImg\":\"https://p1.img.cctvpic.com/apple3g/www/upload/image/20260828/1787896006290088494.jpg\",\"mediaName\":\"比划\",\"pubTime\":1763162315702,\"pv\":\"290.6万\",\"sc\":\"\",\"seqId\":1763162315702,\"seqStrId\":\"1763162315702\",\"size\":\"4:3\",\"source\":0,\"subTitle\":\"\",\"title\":\"9天 VS 9个月 同为太空救援 差距咋这么大捏\",\"vbrief\":\"面对“子弹撞击”级的太空意外，我们审慎按下“暂停键”，但强大的应急体系让救援部署仅需9天。对比美国宇航员9个月的滞留，神舟这波“极限救援”究竟有多硬核？点击视频，看神舟如何上演教科书级“接力操作”！\",\"vcount\":0,\"vduration\":146,\"vid\":\"2caf20a186e040afaeb62a9fbd5e552f\",\"videoType\":0,\"vip_flag\":0,\"webUrl\":\"https://v.cctv.com/reping/bh/index.shtml\",\"wwwUrl\":\"https://v.cctv.com/2025/11/15/VIDEdao6093znRmEQB3NPeqt251115.shtml\"},{\"allowAd\":0,\"allowComment\":0,\"allowShare\":0,\"cateId\":\"18AzYZNf0926\",\"cateName\":\"热评\",\"cvid\":\"VIDEqA4AUfhq1RnXjqtLbNAx250926\",\"episodes\":0,\"fc\":\"\",\"feedType\":\"3\",\"guid\":\"acdaee76ec53436484a568750dece874\",\"image1\":\"https://p2.img.cctvpic.com/apple3g/www/upload/image/20250926/1758883095009041316.jpg\",\"image2\":\"https://p2.img.cctvpic.com/apple3g/www/upload/image/20250926/1758883102330010380.jpg\",\"isCourse\":0,\"isSubed\":0,\"keywords\":\"桦加沙,台风,自然灾害\",\"labelId\":\"18aiYZ3m0926\",\"likeCount\":0,\"mediaId\":\"18ryeuIb0926\",\"mediaImg\":\"https://p1.img.cctvpic.com/apple3g/www/upload/image/20260828/1787896006290088494.jpg\",\"mediaName\":\"比划\",\"pubTime\":1758883103311,\"pv\":\"2.7万\",\"sc\":\"\",\"seqId\":1758883103311,\"seqStrId\":\"1758883103311\",\"size\":\"4:3\",\"source\":0,\"subTitle\":\"\",\"title\":\"AI全景还原花莲堰塞湖溃决  30秒重现天灾瞬间\",\"vbrief\":\"暴雨之下，悬顶的7000余万吨洪水瞬间失控。AI三维动态模拟，30秒还原花莲马太鞍溪堰塞湖从水位暴涨到瞬间溃决的全过程。\",\"vcount\":0,\"vduration\":42,\"vid\":\"f55224ac30304306870abbaa853dc8e2\",\"videoType\":0,\"vip_flag\":0,\"webUrl\":\"https://v.cctv.com/reping/bh/index.shtml\",\"wwwUrl\":\"https://v.cctv.com/2025/09/26/VIDEqA4AUfhq1RnXjqtLbNAx250926.shtml\"},{\"allowAd\":0,\"allowComment\":0,\"allowShare\":0,\"cateId\":\"18AzYZNf0926\",\"cateName\":\"热评\",\"cvid\":\"VIDEtVsx4L9MTzHWV4Niy1da240810\",\"episodes\":0,\"fc\":\"原创\",\"feedType\":\"3\",\"guid\":\"6f13a083000d41d79577266216572cc4\",\"image1\":\"https://p2.img.cctvpic.com/apple3g/www/upload/image/20240810/1723246837922088336.jpg\",\"image2\":\"https://p1.img.cctvpic.com/apple3g/www/upload/image/20240810/1723246841972035121.jpg\",\"isCourse\":0,\"isSubed\":0,\"keywords\":\"乒乓球\",\"labelId\":\"18aiYZ3m0926\",\"likeCount\":0,\"mediaId\":\"18ryeuIb0926\",\"mediaImg\":\"https://p1.img.cctvpic.com/apple3g/www/upload/image/20260828/1787896006290088494.jpg\",\"mediaName\":\"比划\",\"pubTime\":1723246964245,\"pv\":\"1.7万\",\"sc\":\"\",\"seqId\":1723246964245,\"seqStrId\":\"1723246964245\",\"size\":\"16:9\",\"source\":0,\"subTitle\":\"\",\"title\":\"国乒男团五连冠 “大魔王们”的取胜法宝 揭秘国球乒乓旋转神技\",\"vbrief\":\"8月9日，中国乒乓男团战胜瑞典男团，夺得金牌。握拍要稳，站位要准，中国乒乓球队的乒乓神技像是一部动作大片，正手、反手、上旋、下旋，每一招每一式都让人目不暇接。那么，“大魔王”们的挥球神技——“旋转”是怎么打出来的？这些旋转分别有什么特点，如何接住国手们的飞来横球呢？\",\"vcount\":0,\"vduration\":308,\"vid\":\"97c951c3e70f432ca61b6fa06fef4e3e\",\"videoType\":0,\"vip_flag\":0,\"webUrl\":\"https://v.cctv.com/reping/bh/index.shtml\",\"wwwUrl\":\"https://v.cctv.com/2024/08/10/VIDEtVsx4L9MTzHWV4Niy1da240810.shtml\"},{\"allowAd\":0,\"allowComment\":0,\"allowShare\":0,\"cateId\":\"18MZvI3a0926\",\"cateName\":\"资讯\",\"cvid\":\"VIDEAb6uXbuHsuyFxgVwUisH240606\",\"episodes\":0,\"fc\":\"\",\"feedType\":\"3\",\"guid\":\"78524fc85ba14d2e82173a0226f5bc9a\",\"image1\":\"https://p2.img.cctvpic.com/apple3g/www/upload/image/20240606/1717677866794015452.jpg\",\"image2\":\"https://p1.img.cctvpic.com/apple3g/www/upload/image/20240606/1717677887727076219.jpg\",\"isCourse\":0,\"isSubed\":0,\"keywords\":\"高考\",\"labelId\":\"18Jj6nUj0926\",\"likeCount\":0,\"mediaId\":\"18ryeuIb0926\",\"mediaImg\":\"https://p1.img.cctvpic.com/apple3g/www/upload/image/20260828/1787896006290088494.jpg\",\"mediaName\":\"比划\",\"pubTime\":1717677897042,\"pv\":\"\",\"sc\":\"\",\"seqId\":1717677897042,\"seqStrId\":\"1717677897042\",\"size\":\"4:3\",\"source\":0,\"subTitle\":\"\",\"title\":\"【高考应援版】转给所有高考生，祝金榜题名！ \",\"vbrief\":\"小央比划猫为青春的你疯狂打call，加满状态！祝“喵”笔生花，一举夺“葵”！\",\"vcount\":0,\"vduration\":16,\"vid\":\"7090a0ea279c48148bc158a20708b224\",\"videoType\":0,\"vip_flag\":0,\"webUrl\":\"https://v.cctv.com/reping/bh/index.shtml\",\"wwwUrl\":\"https://v.cctv.com/2024/06/06/VIDEAb6uXbuHsuyFxgVwUisH240606.shtml\"},{\"allowAd\":0,\"allowComment\":0,\"allowShare\":0,\"cateId\":\"18AzYZNf0926\",\"cateName\":\"热评\",\"cvid\":\"VIDEgLzVwbkJcmNSFzBAXBFo240323\",\"episodes\":0,\"fc\":\"原创\",\"feedType\":\"3\",\"guid\":\"84c38a0c41f9453fa5fef238c6286b03\",\"image1\":\"https://p1.img.cctvpic.com/apple3g/www/upload/image/20240323/1711151739046090668.jpg\",\"image2\":\"https://p2.img.cctvpic.com/apple3g/www/upload/image/20240323/1711151744658061215.jpg\",\"isCourse\":0,\"isSubed\":0,\"keywords\":\"中国基建,沙丘,电影\",\"labelId\":\"18aiYZ3m0926\",\"likeCount\":0,\"mediaId\":\"18ryeuIb0926\",\"mediaImg\":\"https://p1.img.cctvpic.com/apple3g/www/upload/image/20260828/1787896006290088494.jpg\",\"mediaName\":\"比划\",\"pubTime\":1711151799173,\"pv\":\"\",\"sc\":\"\",\"seqId\":1711151799173,\"seqStrId\":\"1711151799173\",\"size\":\"16:9\",\"source\":0,\"subTitle\":\"\",\"title\":\"用电影《沙丘》的方式打开中国基建\",\"vbrief\":\"在科幻世界里，“沙虫”是“沙丘世界”的高铁；在现实世界里，沙海筑路，是中国才有的奇迹！一起回顾世界首条环沙漠铁路，1012天中国人把塔克拉玛干围起来了，可谓地表最强“套圈”→\",\"vcount\":0,\"vduration\":158,\"vid\":\"07c04672423e483ca8f823fcaf896e7e\",\"videoType\":0,\"vip_flag\":0,\"webUrl\":\"https://v.cctv.com/reping/bh/index.shtml\",\"wwwUrl\":\"https://v.cctv.com/2024/03/23/VIDEgLzVwbkJcmNSFzBAXBFo240323.shtml\"},{\"allowAd\":0,\"allowComment\":0,\"allowShare\":0,\"cateId\":\"18AzYZNf0926\",\"cateName\":\"热评\",\"cvid\":\"VIDEd2IbXr2G4JoP8yK2G5kT240214\",\"episodes\":0,\"fc\":\"\",\"feedType\":\"3\",\"guid\":\"1066c90d78324f39a66aa69c615d0bf0\",\"image1\":\"https://p3.img.cctvpic.com/apple3g/www/upload/image/20240214/1707866756919098450.jpg\",\"image2\":\"https://p3.img.cctvpic.com/apple3g/www/upload/image/20240214/1707866760618084746.jpg\",\"isCourse\":0,\"isSubed\":0,\"keywords\":\"财神,民俗,春节\",\"labelId\":\"18aiYZ3m0926\",\"likeCount\":0,\"mediaId\":\"18ryeuIb0926\",\"mediaImg\":\"https://p1.img.cctvpic.com/apple3g/www/upload/image/20260828/1787896006290088494.jpg\",\"mediaName\":\"比划\",\"pubTime\":1707866806687,\"pv\":\"\",\"sc\":\"\",\"seqId\":1707866806687,\"seqStrId\":\"1707866806687\",\"size\":\"4:3\",\"source\":0,\"subTitle\":\"\",\"title\":\"正月初五迎来的财神，除了比干还有哪些神仙\",\"vbrief\":\"春节你拜哪位财神？民俗文化里所信奉的神仙谱系，听说过哪些？拜一拜神仙，是人们愿望的一种具象化的体现。可能是一种对于自己本心的一种承诺，一种激励自我的符号。今年情人节正好迎财神，祝发财爱情双丰收~\",\"vcount\":0,\"vduration\":276,\"vid\":\"7a669a3a2182447d8aaf2b74091fb417\",\"videoType\":0,\"vip_flag\":0,