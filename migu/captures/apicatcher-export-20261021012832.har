Buttons\":0,\"isMerge\":0,\"isShowLocalChannel\":0,\"isTitleKeyWord\":0,\"is_media_account\":0,\"items\":[{\"adid\":\"\",\"brief\":\"紧紧围绕“弘扬伟大长征精神、走好新时代的长征路”主题，回顾呈现中国共产党领导红军进行伟大长征的光辉历程，全面反映胜利完成震撼世界、彪炳史册的长征的伟大意义，集中展示人民军队听党指挥的赤胆忠诚和一往无前的英雄气概，生动展现新时代新征程万众一心推进强国强军事业的壮阔图景。\",\"cornerColour\":\"\",\"cornerStr\":\"\",\"cornerStrRb\":\"\",\"endTime\":0,\"epgChnlChar\":\"\",\"epgDarkDiamondPic\":\"\",\"epgDarkHorizontalPic\":\"\",\"epgDiamondPic\":\"\",\"epgHorizontalPic\":\"\",\"epgId\":0,\"epgName\":\"\",\"epgType\":\"\",\"fc\":\"\",\"homologous\":0,\"hoverText\":\"\",\"img1\":\"https://p3.img.cctvpic.com/photoAlbum/vms/standard/img/2026/10/15/VSETljuxUPmnwP6kjCxepsLy261015.jpg?q=75\",\"img2\":\"\",\"img3\":\"\",\"imgRGB\":\"#856553\",\"isTop\":0,\"is_media_account\":0,\"itemId\":\"VSET1k4vk44vv5bp16kk46n7ha\",\"itemUrl\":\"\",\"jumpUrl\":\"cntvcbox%3A%2F%2Fapp.cntv.cn%2FvideoSet%3Fplayid%3D%26itemId%3DVSET1k4vk44vv5bp16kk46n7ha%26title%3D%25E3%2580%258A%25E4%25BC%259F%25E5%25A4%25A7%25E8%25BF%259C%25E5%25BE%2581%25E3%2580%258B%26vipFlag%3D0\",\"media_account_id\":\"\",\"mid\":\"\",\"playid\":\"\",\"price\":\"\",\"recordNumber\":0,\"sc\":\"\",\"showStyle\":\"0\",\"skinColor\":\"\",\"source\":\"伟大远征\",\"startTime\":0,\"subTitle\":\"\",\"timeLineDate\":0,\"title\":\"《伟大远征》\",\"trackId\":2581393,\"videoLength\":\"\",\"videoSetId\":\"\",\"vip_flag\":0,\"vsetType\":\"\",\"vtype\":\"2\"},{\"adid\":\"\",\"brief\":\"长征，是中国共产党和红军谱写的壮丽史诗。漫漫征途，红军将士在极端艰难的环境与艰苦卓绝的战斗中，始终坚定理想信念、斗志昂扬。长征这一人类历史上的伟大壮举，留给我们最可宝贵的精神财富，就是中国共产党人和红军将士用生命和热血铸就的伟大长征精神。\",\"cornerColour\":\"\",\"cornerStr\":\"\",\"cornerStrRb\":\"\",\"endTime\":0,\"epgChnlChar\":\"\",\"epgDarkDiamondPic\":\"\",\"epgDarkHorizontalPic\":\"\",\"epgDiamondPic\":\"\",\"epgHorizontalPic\":\"\",\"epgId\":0,\"epgName\":\"\",\"epgType\":\"\",\"fc\":\"\",\"homologous\":0,\"hoverText\":\"\",\"img1\":\"https://p1.img.cctvpic.com/photoAlbum/vms/image/32db2db121fcaa531dba2d0d7a85d875.jpg?q=75\",\"img2\":\"\",\"img3\":\"\",\"imgRGB\":\"#856553\",\"i