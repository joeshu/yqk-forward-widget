shtml\",\"jumpUrl\":\"cntvcbox%3A%2F%2Fapp.cntv.cn%2FsingleVideo%3Fplayid%3D6001d571d84b443badaf6ac4c2858384%26title%3D%25E8%25B0%2581%25E5%25B0%2586%25E4%25BC%25B8%25E5%2587%25BA%25E6%258F%25B4%25E6%2589%258B%25EF%25BC%259F%25E6%25B2%2599%25E7%2589%25B9%25E6%25B1%2582%25E6%258F%25B4%2B%25E5%2590%2584%25E6%2596%25B9%25E6%258B%2589%25E6%2589%25AF%25E5%258D%259A%25E5%25BC%2588%26vipFlag%3D0\",\"media_account_id\":\"\",\"mid\":\"\",\"playid\":\"6001d571d84b443badaf6ac4c2858384\",\"price\":\"\",\"recordNumber\":0,\"sc\":\"\",\"showStyle\":\"0\",\"skinColor\":\"\",\"source\":\"沙特求援 也门战事\",\"startTime\":0,\"subTitle\":\"\",\"timeLineDate\":0,\"title\":\"谁将伸出援手？沙特求援 各方拉扯博弈\",\"trackId\":8,\"videoLength\":\"00:04:48\",\"videoSetId\":\"\",\"vip_flag\":0,\"vsetType\":\"\",\"vtype\":\"1\"},{\"adid\":\"\",\"brief\":\"本期节目主要内容：\\n    盘龙城，这座从尘土中重见天日的煌煌商邑，不仅是今天一座现代化大城市的“根”，也把黄河、长江这两条哺育中华的大河从文化上串联起来。这座雄踞长江之滨的商代城邑，以其规整的建制、巍峨的城墙、铸造精良的青铜重器，展现商文明的辉煌。\\n（《寻古中国》 20261014 解码盘龙城·煌煌商邑）\",\"cornerColour\":\"\",\"cornerStr\":\"寻古中国\",\"cornerStrRb\":\"\",\"endTime\":0,\"epgChnlChar\":\"\",\"epgDarkDiamondPic\":\"\",\"epgDarkHorizontalPic\":\"\",\"epgDiamondPic\":\"\",\"epgHorizontalPic\":\"\",\"epgId\":0,\"epgName\":\"\",\"epgType\":\"\",\"fc\":\"\",\"homologous\":0,\"hoverText\":\"\",\"img1\":\"https://p1.img.cctvpic.com/photoAlbum/page/performance/img/2026/10/15/1792030995976_288.jpg\",\"img2\":\"\",\"img3\":\"\",\"imgRGB\":\"\",\"isTop\":0,\"is_media_account\":0,\"itemId\":\"VIDE63DbsqkQQHMJLqxw5WNM261014\",\"itemUrl\":\"https://tv.cctv.com/2026/10/14/VIDE63DbsqkQQHMJLqxw5WNM261014.shtml\",\"jumpUrl\":\"cntvcbox%3A%2F%2Fapp.cntv.cn%2FsingleVideo%3Fplayid%3Def25769cd6784e13aa5ce4a781b6f584%26title%3D3500%25E5%25B9%25B4%25E5%2589%258D%25E7%259A%2584%25E2%2580%259C%25E9%2592%25A2%25E7%25AD%258B%25E6%25B0%25B4%25E6%25B3%25A5%25E2%2580%259D%25E9%2595%25BF%25E5%2595%25A5%25E6%25A0%25B7%25EF%25BC%259F%25E5%25A4%25AA%25E7%25A1%25AC%25E6%25A0%25B8%25E4%25BA%2586%25EF%25BC%2581%26vipFlag%3D0\",\"media_account_id\":\"\",\"mid\":\"\",\"playid\":\"ef25769cd6784e13aa5ce4a781b6f584\",\"price\":\"\",\"recordNumber\":0,\"sc\":\"\",\"showStyle\":\"0\",\"skinColor\":\"\",\"source\":\"寻古中国 王音棋 盘龙城遗址\",\"startTime\":0,\"subTitle\":\"\",\"timeLineDate\":0,\"title\":\"3500年前的“钢筋水泥”长啥样？太硬核了！\",\"trackId\":9,\"videoLength\":\"00:29:59\",\"videoSetId\":\"\",\"vip_flag\":0,\"vsetType\":\"\",\"vtype\":\"1\"},{\"adid\":\"\",\"brief\":\"本期节目主要内容：在全球核博弈形势复杂、个别国家持续调整核政策的乱局之中，中国维持战略定力，成为全球安全治理中的稳定力量。中国发展核武器，是在特殊历史时期，为应对核威胁，打破核垄断，被迫做出的防御性选择。（《国家记忆》 20261014 和合之声 安全）\",\"cornerColour\":\"\",\"cornerStr\":\"国家记忆\",\"cornerStrRb\":\"\",\"endTime\":0,\"epgChnlChar\":\"\",\"epgDarkDiamondPic\":\"\",\"epgDarkHorizontalPic\":\"\",\"epgDiamondPic\":\"\",\"epgHorizontalPic\":\"\",\"epgId\":0,\"epgName\":\"\",\"epgType\":\"\",\"fc\":\"\",\"homologous\":0,\"hoverText\":\"\",\"img1\":\"https://p1.img.cctvpic.com/photoAlbum/page/performance/img/2026/10/15/1792028093646_389.jpg\",\"img2\":\"\",\"img3\":\"\",\"imgRGB\":\"\",\"isTop\":0,\"is_media_account\":0,\"itemId\":\"VIDEZbjXs8mAJclqYyw0oJSN261014\",\"itemUrl\":\"https://tv.cctv.com/2026/10/14/VIDEZbjXs8mAJclqYyw0oJSN261014.shtml\",\"jumpUrl\":\"cntvcbox%3A%2F%2Fapp.cntv.cn%2FsingleVideo%3Fplayid%3D7dca011fdc674b0d82f59dce530d18bb%26title%3D%25E4%25B8%25AD%25E5%259B%25BD%25E7%25BB%25B4%25E6%258C%2581%25E6%2588%2598%25E7%2595%25A5%25E5%25AE%259A%25E5%258A%259B%2B%25E4%25B8%25BA%25E5%258A%25A8%25E8%258D%25A1%25E4%25B8%2596%25E7%2595%258C%25E6%25B3%25A8%25E5%2585%25A5%25E5%25AE%259D%25E8%25B4%25B5%25E7%25A8%25B3%25E5%25AE%259A%25E6%2580%25A7%26vipFlag%3D0\",\"media_account_id\":\"\",\"mid\":\"\",\"playid\":\"7dca011fdc674b0d82f59dce530d18bb\",\"price\":\"\",\"recordNumber\":0,\"sc\":\"\",\"showStyle\":\"0\",\"skinColor\":\"\",\"source\":\"国家记忆 和合之声 全球核博弈\",\"startTime\":0,\"subTitle\":\"\",\"timeLineDate\":0,\"title\":\"中国维持战略定力 为动荡世界注入宝贵稳定性\",\"trackId\":10,\"videoLength\":\"00:26:20\",\"videoSetId\":\"\",\"vip_flag\":0,\"vsetType\":\"\",\"vtype\":\"1\"},{\"adid\":\"\",\"brief\":\"本期节目主要内容：对于海马体，还有太多未知的谜题等待人类去探索，而除了大脑，人类对自身的衰老也非常关心，该如何留住青春成为永恒的话题。（《解码科技史》 20261014 抵御遗忘与衰老）\",\"cornerColour\":\"\",\"cornerStr\":\"解码科技史\",\"cornerStrRb\":\"\",\"endTime\":0,\"epgChnlChar\":\"\",\"epgDarkDiamondPic\":\"\",\"epgDarkHorizontalPic\":\"\",\"epgDiamondPic\":\"\",\"epgHorizontalPic\":\"\",\"epgId\":0,\"epgName\":\"\",\"epgType\":\"\",\"fc\":\"\",\"homologous\":0,\"hoverText\":\"\",\"img1\":\"https://p3.img.cctvpic.com/photoAlbum/page/performance/img/2026/10/15/1792030728827_208.jpg\",\"img2\":\"\",\"img3\":\"\",\"imgRGB\":\"\",\"isTop\":0,\"is_media_account\":0,\"itemId\":\"VIDEe0iTtr4SklAvpumQoxLF261015\",\"itemUrl\":\"https://tv.cctv.com/2026/10/15/VIDEe0iTtr4SklAvpumQoxLF261015.shtml\",\"jumpUrl\":\"cntvcbox%3A%2F%2Fapp.cntv.cn%2FsingleVideo%3Fplayid%3Df4d9c0fce035478f84e39f25bd995010%26title%3D%25E4%25BA%25BA%25E7%25B1%25BB%25E5%25AF%25BF%25E5%2591%25BD%25E6%2598%25AF%25E5%2590%25A6%25E6%259C%2589%25E6%259E%2581%25E9%2599%2590%25EF%25BC%259F%25E6%2598%25AF%25E4%25BB%2580%25E4%25B9%2588%25E5%2586%25B3%25E5%25AE%259A%25E7%259D%2580%25E8%25BF%2599%25E4%25B8%25AA%25E6%259E%2581%25E9%2599%2590%25EF%25BC%259F%26vipFlag%3D0\",\"media_account_id\":\"\",\"mid\":\"\",\"playid\":\"f4d9c0fce035478f84e39f25bd995010\",\"price\":\"\",\"recordNumber\":0,\"sc\":\"\",\"showStyle\":\"0\",\"skinColor\":\"\",\"source\":\"解码科技史 海马体 大脑\",\"startTime\":0,\"subTitle\":\"\",\"timeLineDate\":0,\"title\":\"人类寿命是否有极限？是什么决定着这个极限？\",\"trackId\":11,\"videoLength\":\"00:57:36\",\"videoSetId\":\"\",\"vip_flag\":0,\"vsetType\":\"\",\"vtype\":\"1\"},{\"adid\":\"\",\"brief\":\"本期节目主要内容：\\n    寻音之旅继续深入内蒙古鄂尔多斯。总台主持人马凡舒携手多位优秀音乐人，穿行驰骋于库布其大漠，沉浸式体会旷野的肆意洒脱。众人迎接零彩排街头演出的严苛挑战，邂逅本土民间音乐传承者，挖掘国音年轻化的多元表达。在草原、沙漠、湖泊共生的别样景致之间，细细聆听传统民乐与新潮音乐交融迸发的青春回响。\\n（《国音正青春》 20261014 去野）\",\"cornerColour\":\"\",\"cornerStr\":\"国音正青春\",\"cornerStrRb\":\"\",\"endTime\":0,\"epgChnlChar\":\"\",\"epgDarkDiamondPic\":\"\",\"epgDarkHorizontalPic\":\"\",\"epgDiamondPic\":\"\",\"epgHorizontalPic\":\"\",\"epgId\":0,\"epgName\":\"\",\"epgType\":\"\",\"fc\":\"\",\"homologous\":0,\"hoverText\":\"\",\"img1\":\"https://p2.img.cctvpic.com/photoAlbum/page/performance/img/2026/10/15/1792031599234_676.jpg\",\"img2\":\"\",\"img3\":\"\",\"imgRGB\":\"\",\"isTop\":0,\"is_media_account\":0,\"itemId\":\"VIDEJ0qKlUG5eYGmzdh9TiQo261014\",\"itemUrl\":\"https://tv.cctv.com/2026/10/14/VIDEJ0qKlUG5eYGmzdh9TiQo261014.shtml\",\"jumpUrl\":\"cntvcbox%3A%2F%2Fapp.cntv.cn%2FsingleVideo%3Fplayid%3Dd71e925d62ee43ed9c4c931434de33da%26title%3D%25E4%25BC%25A0%25E7%25BB%259F%25E9%2581%2587%25E6%2596%25B0%25E6%25BD%25AE%2B%25E6%2597%25B7%25E9%2587%258E%25E5%2590%25AC%25E5%259B%25BD%25E9%259F%25B3%2B%25E4%25B8%2580%25E8%25B5%25B7%25E6%2594%25BE%25E8%2582%2586%25E5%258E%25BB%25E9%2587%258E%25EF%25BC%2581%26vipFlag%3D0\",\"media_account_id\":\"\",\"mid\":\"\",\"playid\":\"d71e925d62ee43ed9c4c931434de33da\",\"price\":\"\",\"recordNumber\":0,\"sc\":\"\",\"showStyle\":\"0\",\"skinColor\":\"\",\"source\":\"国音正青春 马凡舒 《故乡》\",\"startTime\":0,\"subTitle\":\"\",\"timeLineDate\":0,\"title\":\"传统遇新潮 旷野听国音 一起放肆去野！\",\"trackId\":12,\"videoLength\":\"01:00:00\",\"videoSetId\":\"\",\"vip_flag\":0,\"vsetType\":\"\",\"vtype\":\"1\"},{\"adid\":\"\",\"brief\":\"本期节目主要内容：《聊斋志异·聂小倩》中，宁采臣和聂小倩的那场相遇告诉我们什么叫邪不压正。正直的宁采臣在面对聂小倩抛出的种种诱惑时不为所动，得到了聂小倩的信任和尊重，最终收获了幸福。（《百家说故事》 20261014）\",\"cornerColour\":\"\",\"cornerStr\":\"百家说故事\",\"cornerStrRb\":\"\",\"endTime\":0,\"epgChnlChar\":\"\",\"epgDarkDiamondPic\":\"\",\"epgDarkHorizontalPic\":\"\",\"epgDiamondPic\":\"\",\"epgHorizontalPic\":\"\",\"epgId\":0,\"epgName\":\"\",\"epgType\":\"\",\"fc\":\"\",\"homologous\":0,\"hoverText\":\"\",\"img1\":\"https://p1.img.cctvpic.com/photoAlbum/page/performance/img/2026/10/15/1792029892489_596.jpg\",\"img2\":\"\",\"img3\":\"\",\"imgRGB\":\"\",\"isTop\":0,\"is_media_account\":0,\"itemId\":\"VIDE6Pp7v9UKsyve6iaJb22L261014\",\"itemUrl\":\"https://tv.cctv.com/2026/10/14/VIDE6Pp7v9UKsyve6iaJb22L261014.shtml\",\"jumpUrl\":\"cntvcbox%3A%2F%2Fapp.cntv.cn%2FsingleVideo%3Fplayid%3D8c49ea57844848908929f32793516bd8%26title%3D%25E4%25B8%2580%25E5%259C%25BA%25E6%2580%258E%25E6%25A0%25B7%25E7%259A%2584%25E7%259B%25B8%25E9%2581%2587%25E8%25AE%25A9%25E5%2589%258D%25E6%259D%25A5%25E8%25AF%25B1%25E6%2583%2591%25E7%259A%2584%25E2%2580%259C%25E9%25AC%25BC%25E2%2580%259D%25E9%2583%25BD%25E6%2584%259F%25E5%2588%25B0%25E7%25BE%259E%25E6%2584%25A7%26vipFlag%3D0\",\"media_account_id\":\"\",\"mid\":\"\",\"playid\":\"8c49ea57844848908929f32793516bd8\",\"price\":\"\",\"recordNumber\":0,\"sc\":\"\",\"showStyle\":\"0\",\"skinColor\":\"\",\"source\":\"百家说故事 成敏 遇见·宁采臣与聂小倩\",\"startTime\":0,\"subTitle\":\"\",\"timeLineDate\":0,\"title\":\"一场怎样的相遇让前来诱惑的“鬼”都感到羞愧\",\"trackId\":13,\"videoLength\":\"00:10:00\",\"videoSetId\":\"\",\"vip_flag\":0,\"vsetType\":\"\",\"vtype\":\"1\"},{\"adid\":\"\",\"brief\":\"本期节目主要内容：\\n    茉莉花茶制作技艺来之不易，跟随国家级非物质文化遗产代表性项目花茶制作技艺代表性传承人孙丹威，看一朵茉莉花如何变成一窨茶。这个秋天，再与中国社会科学院古代史研究所研究员沈冬梅一起体验宋代点茶。它不只是喝茶，更是融合技艺、审美与精神的生活艺术。\\n（《我的艺术清单》 20261012）\",\"cornerColour\":\"\",\"cornerStr\":\"我的艺术清单\",\"cornerStrRb\":\"\",\"endTime\":0,\"epgChnlChar\":\"\",\"epgDarkDiamondPic\":\"\",\"epgDarkHorizontalPic\":\"\",\"epgDiamondPic\":\"\",\"epgHorizontalPic\":\"\",\"epgId\":0,\"epgName\":\"\",\"epgType\":\"\",\"fc\":\"\",\"homologous\":0,\"hoverText\":\"\",\"img1\":\"https://p4.img.cctvpic.com/photoAlbum/page/performance/img/2026/10/15/1792028663130_660.jpg\",\"img2\":\"\",\"img3\":\"\",\"imgRGB\":\"\",\"isTop\":0,\"is_media_account\":0,\"itemId\":\"VIDEqin8gdXXdIZkUSkOgC4D261012\",\"itemUrl\":\"https://tv.cctv.com/2026/10/12/VIDEqin8gdXXdIZkUSkOgC4D261012.shtml\",\"jumpUrl\":\"cntvcbox%3A%2F%2Fapp.cntv.cn%2FsingleVideo%3Fplayid%3D4fd8a07517324f53ad25b63db86ed6fb%26title%3D%25E4%25BD%25A0%25E7%259F%25A5%25E9%2581%2593%25E4%25BD%25A0%25E5%2596%259D%25E7%259A%2584%25E9%2582%25A3%25E6%259D%25AF%25E8%258C%2589%25E8%258E%2589%25E8%258A%25B1%25E8%258C%25B6%25E5%2588%25B6%25E4%25BD%259C%25E6%258A%2580%25E8%2589%25BA%25E6%259C%2589%25E5%25A4%259A%25E5%25A4%258D%25E6%259D%2582%25EF%25BC%259F%26vipFlag%3D0\",\"media_account_id\":\"\",\"mid\":\"\",\"playid\":\"4fd8a07517324f53ad25b63db86ed6fb\",\"price\":\"\",\"recordNumber\":0,\"sc\":\"\",\"showStyle\":\"0\",\"skinColor\":\"\",\"source\":\"我的艺术清单 朱迅 孙丹威\",\"startTime\":0,\"subTitle\":\"\",\"timeLineDate\":0,\"title\":\"你知道你喝的那杯茉莉花茶制作技艺有多复杂？\",\"trackId\":14,\"videoLength\":\"00:49:53\",\"videoSetId\":\"\",\"vip_flag\":0,\"vsetType\":\"\",\"vtype\":\"1\"},{\"adid\":\"\",\"brief\":\"本期节目主要内容：\\n    秋季，正是品尝发酵海鲜的好时节。秋季海鲜肉质肥美，经腌制发酵后风味更浓郁醇厚。本期节目特邀京鲁菜大厨刘强、融合菜大厨童伟，手把手教大家巧用发酵海鲜烹制特色佳肴，解锁地道鲜美滋味。\\n（《回家吃饭》 20261014 虾酱鲜 腌鱼香 海味发酵正当时）\",\"cornerColour\":\"\",\"cornerStr\":\"回家吃饭\",\"cornerStrRb\":\"\",\"endTime\":0,\"epgChnlChar\":\"\",\"epgDarkDiamondPic\":\"\",\"epgDarkHorizontalPic\":\"\",\"epgDiamondPic\":\"\",\"epgHorizontalPic\":\"\",\"epgId\":0,\"epgName\":\"\",\"epgType\":\"\",\"fc\":\"\",\"homologous\":0,\"hoverText\":\"\",\"img1\":\"https://p1.img.cctvpic.com/photoAlbum/page/performance/img/2026/10/15/1792029641343_802.jpg\",\"img2\":\"\",\"img3\":\"\",\"imgRGB\":\"\",\"isTop\":0,\"is_media_account\":0,\"itemId\":\"VIDE4XXMnDVwirsP9yharDlP261014\",\"itemUrl\":\"https://tv.cctv.com/2026/10/14/VIDE4XXMnDVwirsP9yharDlP261014.shtml\",\"jumpUrl\":\"cntvcbox%3A%2F%2Fapp.cntv.cn%2FsingleVideo%3Fplayid%3D0bb725a3e784407fbeb2223ed90639b1%26title%3D%25E7%25A7%258B%25E5%25AD%25A3%25E6%25B5%25B7%25E9%25B2%259C%25E8%2582%2589%25E8%25B4%25A8%25E8%2582%25A5%25E7%25BE%258E%2B%25E8%2585%258C%25E5%2588%25B6%25E5%258F%2591%25E9%2585%25B5%25E5%2590%258E%25E9%25A3%258E%25E5%2591%25B3%25E6%259B%25B4%25E8%2583%259C%25E4%25B8%2580%25E7%25AD%25B9%26vipFlag%3D0\",\"media_account_id\":\"\",\"mid\":\"\",\"playid\":\"0bb725a3e784407fbeb2223ed90639b1\",\"price\":\"\",\"recordNumber\":0,\"sc\":\"\",\"showStyle\":\"0\",\"skinColor\":\"\",\"source\":\"回家吃饭 小迟 刘强\",\"startTime\":0,\"subTitle\":\"\",\"timeLineDate\":0,\"title\":\"秋季海鲜肉质肥美 腌制发酵后风味更胜一筹\",\"trackId\":15,\"videoLength\":\"00:25:15\",\"videoSetId\":\"\",\"vip_flag\":0,\"vsetType\":\"\",\"vtype\":\"1\"},{\"adid\":\"\",\"brief\":\"本期节目主要内容：\\n    中国物流与采购联合会10月13日发布9月份电商物流指数新数据，9月份中国电商物流指数111.9点，环比回升0.4点。电商物流呈现供需同步改善的特征，城市市场和农村下沉市场业务量双双创出年内高点。\\n（《央视财经评论》 20261013 电商物流指数上行 线上消费活力释放）\",\"cornerColour\":\"\",\"cornerStr\":\"央视财经评论\",\"cornerStrRb\":\"\",\"endTime\":0,\"epgChnlChar\":\"\",\"epgDarkDiamondPic\":\"\",\"epgDarkHorizontalPic\":\"\",\"epgDiamondPic\":\"\",\"epgHorizontalPic\":\"\",\"epgId\":0,\"epgName\":\"\",\"epgType\":\"\",\"fc\":\"\",\"homologous\":0,\"hoverText\":\"\",\"img1\":\"https://p2.img.cctvpic.com/photoAlbum/page/performance/img/2026/10/14/1791945345903_746.jpg\",\"img2\":\"\",\"img3\":\"\",\"imgRGB\":\"\",\"isTop\":0,\"is_media_account\":0,\"itemId\":\"VIDEA40K6w24DUlkzATxh0v7261013\",\"itemUrl\":\"https://tv.cctv.com/2026/10/13/VIDEA40K6w24DUlkzATxh0v7261013.shtml\",\"jumpUrl\":\"cntvcbox%3A%2F%2Fapp.cntv.cn%2FsingleVideo%3Fplayid%3Dd73bea61044544b0bf873d01b21e1606%26title%3D%25E7%2594%25B5%25E5%2595%2586%25E7%2589%25A9%25E6%25B5%2581%2B%25E6%259A%2596%25E6%2584%258F%25E5%259B%259E%25E5%258D%2587%25EF%25BC%2581%25E7%259C%258B%25E4%25B8%25AD%25E5%259B%25BD%25E7%2589%25A9%25E6%25B5%2581%25E5%25A6%2582%25E4%25BD%2595%25E8%25B7%2591%25E5%2587%25BA%25E6%2596%25B0%25E9%2580%259F%25E5%25BA%25A6%26vipFlag%3D0\",\"media_account_id\":\"\",\"mid\":\"\",\"playid\":\"d73bea61044544b0bf873d01b21e1606\",\"price\":\"\",\"recordNumber\":0,\"sc\":\"\",\"showStyle\":\"0\",\"skinColor\":\"\",\"source\":\"央视财经评论 张琳 周密\",\"startTime\":0,\"subTitle\":\"\",\"timeLineDate\":0,\"title\":\"电商物流 暖意回升！看中国物流如何跑出新速度\",\"trackId\":16,\"videoLength\":\"00:20:02\",\"videoSetId\":\"\",\"vip_flag\":0,\"vsetType\":\"\",\"vtype\":\"1\"},{\"adid\":\"\",\"brief\":\"本期节目主要内容：在大张家界国际旅游区的“三山”中，邵阳占据了两座山：崀山和雪峰山。崀山是世界自然遗产，拥有中国丹霞地貌；雪峰山是避暑康养之地，也是花瑶文化的家园。（《走遍中国》 20261013 湘域山海行——邵阳）\",\"cornerColour\":\"\",\"cornerStr\":\"走遍中国\",\"cornerStrRb\":\"\",\"endTime\":0,\"epgChnlChar\":\"\",\"epgDarkDiamondPic\":\"\",\"epgDa