0403041280.jpeg?q=75\",\"img2\":\"\",\"img3\":\"\",\"imgRGB\":\"#33496C\",\"isTop\":0,\"is_media_account\":0,\"itemId\":\"C10616\",\"itemUrl\":\"\",\"jumpUrl\":\"cntvcbox%3A%2F%2Fapp.cntv.cn%2FsingleVideo%3Fplayid%3D815080fd58204565a8b5adad557f467d%26title%3D%25E5%25A4%2596%25E4%25BA%25A4%25E9%2583%25A8%25EF%25BC%259A%25E4%25B8%25AD%25E6%25AC%25A7%25E5%2585%25B1%25E5%2590%258C%25E5%2588%25A9%25E7%259B%258A%25E5%25B9%25BF%25E6%25B3%259B%26vipFlag%3D0\",\"media_account_id\":\"\",\"mid\":\"\",\"playid\":\"815080fd58204565a8b5adad557f467d\",\"price\":\"\",\"recordNumber\":0,\"sc\":\"社会,国内\",\"showStyle\":\"0\",\"skinColor\":\"\",\"source\":\"中国外交部 中欧经贸问题\",\"startTime\":0,\"subTitle\":\"\",\"timeLineDate\":0,\"title\":\"外交部：中欧共同利益广泛\",\"trackId\":2581398,\"type\":0,\"videoLength\":\"00:01:30\",\"videoSetId\":\"C10616\",\"vip_flag\":0,\"vsetType\":\"\",\"vtype\":\"2\"},{\"ad\":1,\"adid\":\"\",\"brief\":\"本集主要内容：\\n    中国共产党根基在人民、血脉在人民、力量在人民！这是红军跨越万水千山、历尽千难万险，用鲜血和生命换来的启示。同人民风雨同舟、血脉相通、生死与共，是中国共产党和红军取得长征胜利的根本保证，也是我们战胜一切困难和风险的根本保证。\\n（《伟大远征》 第6集 根基）\",\"cornerColour\":\"\",\"cornerStr\":\"\",\"cornerStrRb\":\"\",\"endTime\":0,\"epgChnlChar\":\"\",\"epgDarkDiamondPic\":\"\",\"epgDarkHorizontalPic\":\"\",\"epgDiamondPic\":\"\",\"epgHorizontalPic\":\"\",\"epgId\":0,\"epgName\":\"\",\"epgType\":\"\",\"fc\":\"纪录片\",\"homologous\":0,\"hoverText\":\"\",\"img1\":\"https://p1.img.cctvpic.com/oms/upload/image/2026/10/20/oms_pic_3345967901761724416.jpeg?q=75\",\"img2\":\"\",\"img3\":\"\",\"imgRGB\":\"#792319\",\"isTop\":0,\"is_media_account\":0,\"itemId\":\"VSET1k4vk44vv5bp16kk46n7ha\",\"itemUrl\":\"\",\"jumpUrl\":\"cntvcbox%3A%2F%2Fapp.cntv.cn%2FsingleVideo%3Fplayid%3D7c3b2008a59e41a3a0e8d4ab458371c9%26title%3D%25E3%2580%258A%25E4%25BC%259F%25E5%25A4%25A7%25E8%25BF%259C%25E5%25BE%2581%25E3%2580%258B%25E7%25AC%25AC%25E5%2585%25AD%25E9%259B%2586%25E3%2580%258A%25E6%25A0%25B9%25E5%259F%25BA%25E3%2580%258B%26vipFlag%3D0\",\"media_account_id\":\"\",\"mid\":\"\",\"playid\":\"7c3b2008a59e41a