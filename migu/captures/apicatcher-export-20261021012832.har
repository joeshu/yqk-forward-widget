    <div class=\"text\">\r\n\t\t                <h3><a href=\"https://tv.cctv.com/2026/10/19/VIDEkfPQdDn49YVC84bK8krl261019.shtml\" target=\"_blank\">彰显邪不压正的严肃主题</a></h3>\r\n\t\t                <span><a href=\"https://tv.cctv.com/2026/10/19/VIDEkfPQdDn49YVC84bK8krl261019.shtml\" target=\"_blank\">以新的视角重新审视历史和现实生活中发生的重大法治事件。</a></span>\r\n\t\t                <div class=\"label\"><a href=\"https://tv.cctv.com/lm/tianwang/index.shtml\" target=\"_blank\">天网</a></div>\r\n\t\t            </div>\r\n\t\t        </div>\r\n\t\t    </div>\r\n\t\t</li>\r\n\t\t<li class=\"end1\">\r\n\t\t    <div class=\"conTop\">\r\n\t\t        <div class=\"common\">\r\n\t\t            <div class=\"img\">\r\n\t\t              <a href=\"https://tv.cctv.com/2026/10/19/VIDEuaCkf6o5W8ByrOAdjVez261019.shtml\" target=\"_blank\"><img src=\"//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/zwPic1_1.gif\" class=\"lazy\" data-echo=\"//p2.img.cctvpic.com/photoAlbum/page/performance/img/2021/10/19/1634633294533_760.jpg\" /><em class=\"\"></em></a>\r\n\t\t            </div>\r\n\t\t            <div class=\"text\">\r\n\t\t              <div class=\"title\"><a href=\"https://tv.cctv.com/2026/10/19/VIDEuaCkf6o5W8ByrOAdjVez261019.shtml\" target=\"_blank\">聚焦乡村振兴</a></div>\r\n\t\t              <div class=\"brief\">执着坚守的新农人</div>\r\n\t\t            </div>\r\n\t\t        </div>\r\n\t\t        <div class=\"hover\">\r\n\t\t            <div class=\"img\" data-img=\"//p1.img.cctvpic.com/photoAlbum/page/performance/img/2021/10/19/1634633303770_951.jpg\" data-src=\"\">\r\n\t\t              <a href=\"https://tv.cctv.com/2026/10/19/VIDEuaCkf6o5W8ByrOAdjVez261019.shtml\" target=\"_blank\"><img src=\"//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/zwPic1_1.gif\" /></a>\r\n\t\t            </div>\r\n\t\t            <div class=\"text\">\r\n\t\t                <h3><a href=\"https://tv.cctv.com/2026/10/19/VIDEuaCkf6o5W8ByrOAdjVez261019.shtml\" target=\"_blank\">他们是默默奉献的耕耘者</a></h3>\r\n\t\t                <span><a href=\"https://tv.cctv.com/2026/10/19/VIDEuaCkf6o5W8ByrOAdjVez261019.shtml\" target=\"_blank\">展现他们在践行乡村振兴战略的路上，面对重重困难，勇于担当、攻坚克难、砥砺前行的精彩故事。</a></span>\r\n\t\t                <div class=\"label\"><a href=\"https://tv.cctv.com/lm/snqyh/index.shtml\" target=\"_blank\">三农群英汇</a></div>\r\n\t\t            </div>\r\n\t\t        </div>\r\n\t\t    </div>\r\n\t\t</li>\r\n      \r\n    </ul>\r\n</div>\r\n  </div>\r\n</div>\r\n<div class=\"tvCCTV_ind06\" id=\"nav03\" data-spm= \"Evxvi9PlMx4I\">\r\n  \r\n  <ul>\r\n          <li class=\"cel02\">\r\n          <table cellspacing=\"0\" cellpadding=\"0\" border=\"0\">\r\n              <tbody>\r\n                  <tr>\r\n                      <td>\r\n                          <a href=\"https://tv.cctv.com/2026/09/24/VIDAjmJ7aTgfioo9JaXqzMVi260924.shtml\" target=\"_blank\"><img src=\"//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/zwPic1_1.gif\" class=\"lazy\" data-echo=\"//p4.img.cctvpic.com/photoAlbum/page/performance/img/2026/10/13/1791859315974_702.png\"></a>\r\n                      </td>\r\n                  </tr>\r\n              </tbody>\r\n          </table>\r\n      </li>\r\n      <li class=\"\"></li>\r\n      <li class=\"cel02\">\r\n          <table cellspacing=\"0\" cellpadding=\"0\" border=\"0\">\r\n              <tbody>\r\n                  <tr>\r\n                      <td>\r\n                          <a href=\"https://tv.cctv.com/2026/10/15/VIDAx88h6fa84nWO6wiIqEtf261015.shtml\" target=\"_blank\"><img src=\"//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/zwPic1_1.gif\" class=\"lazy\" data-echo=\"//p4.img.cctvpic.com/photoAlbum/page/performance/img/2026/10/19/1792383483938_483.png\"></a>\r\n                      </td>\r\n                  </tr>\r\n              </tbody>\r\n          </table>\r\n      </li>\r\n      <li class=\"\"></li>\r\n      <li class=\"cel02\">\r\n          <table cellspacing=\"0\" cellpadding=\"0\" border=\"0\">\r\n              <tbody>\