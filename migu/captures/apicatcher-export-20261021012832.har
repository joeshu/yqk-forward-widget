d\":\"VIDEdELMXPG95rM2at3dIB6V220920\",\"episodes\":0,\"fc\":\"\",\"feedType\":\"3\",\"guid\":\"ccd3e8b6bc914235a4f92846d42a48ff\",\"image1\":\"https://p1.img.cctvpic.com/apple3g/www/upload/image/20220920/1663629801312079478.jpg\",\"image2\":\"https://p3.img.cctvpic.com/apple3g/www/upload/image/20220920/1663629804891037304.jpg\",\"isCourse\":0,\"isSubed\":0,\"keywords\":\"外交部,日本核污水,核污染食品\",\"labelId\":\"18aiYZ3m0926\",\"likeCount\":0,\"mediaId\":\"18ryeuIb0926\",\"mediaImg\":\"https://p1.img.cctvpic.com/apple3g/www/upload/image/20260828/1787896006290088494.jpg\",\"mediaName\":\"比划\",\"pubTime\":1663629810543,\"pv\":\"\",\"sc\":\"\",\"seqId\":1663629810543,\"seqStrId\":\"1663629810543\",\"size\":\"4:3\",\"source\":0,\"subTitle\":\"\",\"title\":\"外交部再谈日本核污水排海 吃下核污染食品后果会有多严重？   \",\"vbrief\":\"针对日本强推核污染水排海，外交部发言人毛宁表示，“海洋不是日本的垃圾桶，太平洋不是日本的下水道。”遭遇核辐射后，人体会发生哪些恐怖变化？日本福岛核废水中的危险放射物究竟有哪些？如果没有直接遭遇核辐射，只是吃下被核辐射污染的食物，后果会有多严重？\",\"vcount\":0,\"vduration\":256,\"vid\":\"3c549d9656424b8f87d07af88710f599\",\"videoType\":0,\"vip_flag\":0,\"webUrl\":\"https://v.cctv.com/reping/bh/index.shtml\",\"wwwUrl\":\"https://v.cctv.com/2022/09/20/VIDEdELMXPG95rM2at3dIB6V220920.shtml\"},{\"allowAd\":0,\"allowComment\":0,\"allowShare\":0,\"cateId\":\"18AzYZNf0926\",\"cateName\":\"热评\",\"cvid\":\"VIDEYeFKFGOy0qdbJgrjJtcr220910\",\"episodes\":0,\"fc\":\"\",\"feedType\":\"3\",\"guid\":\"65b3c94e6bb9476ea1bb02773d92adef\",\"image1\":\"https://p4.img.cctvpic.com/apple3g/www/upload/image/20220910/1662780074421001930.jpg\",\"image2\":\"https://p4.img.cctvpic.com/apple3g/www/upload/image/20220910/1662780078341027939.jpg\",\"isCourse\":0,\"isSubed\":0,\"keywords\":\"教师节,老师\",\"labelId\":\"18aiYZ3m0926\",\"likeCount\":0,\"mediaId\":\"18ryeuIb0926\",\"mediaImg\":\"https://p1.img.cctvpic.com/apple3g/www/upload/image/20260828/1787896006290088494.jpg\",\"mediaName\":\"比划\",\"pubTime\":1662780094993,\"pv\":\"\",\"sc\":\"\",\"seqId\":1662780094993,\"seqStrId\":\"1662780094993\",\"size\":\"4:3\",\"source\":0,\"subTi