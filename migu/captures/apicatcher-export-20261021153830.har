            "mimeType" : "text/css",
            "text" : "@charset \"utf-8\";\r\nhtml{margin:0;padding:0;font-size: 100%;}\r\nhtml, body, form, p, div, h1, h2, h3, h4, h5, h6{-webkit-text-size-adjust:none;-moz-text-size-adjust:none;-o-text-size-adjust:none;}\r\nbody{margin:0;padding:0; width:100%;font-size:15px;font-family:sans-serif;/*font-family:'PingFang SC','PingFang TC','Microsoft YaHei',\"STHeiti\",arial,helvetica,sans-serif;*/font-weight:normal;}\r\nul,li,h1,h2,h3,h4,h5,h6,p{padding:0;margin:0; list-style:none;font-weight:normal;}\r\na{ text-decoration:none;outline:none;}\r\na img,img{border:0;}\r\ni{font-style: normal;}\r\nimg{display: block;width: 100%;}\r\nbody{background-color: #f9f9f9;}\r\ninput,textarea{font-family:'PingFang SC','PingFang TC','Microsoft YaHei',\"STHeiti\",arial,helvetica,sans-serif;font-weight:normal;-webkit-appearance: none;outline:none;}\r\ntextarea{box-sizing: border-box;}\r\n.page_wrap{ width:100%;margin:0 auto;position: relative;min-width: 320px;max-width:750px;overflow: hidden;}\r\n.clear{clear:both;height:0px}\r\n.vertical-container{display: -webkit-box;display: -moz-box;display: -ms-flexbox;display: -o-box;display: box;-webkit-box-orient: horizontal;-moz-box-orient: horizontal;-ms-flex-direction: row;-o-box-orient: horizontal;box-orient: horizontal;-webkit-box-pack: start;-moz-box-pack: start;-ms-flex-pack: start;-o-box-pack: start;box-pack: start;-webkit-box-align: center;-moz-box-align: center;-ms-flex-align: center;-o-box-align: center;box-align: center;}\r\n.add_button_area p{position:relative;z-index:2;font-size: 15px;}\r\n.vspace_shouyang {width:100%;clear:both;}\r\n.vspace {width:100%;clear:both;}\r\n\r\n/*导航*/\r\n.nav{position:relative;padding-right:0.88rem;height:0.76rem;background-color:#f9f9f9;overflow: hidden;}\r\n.nav .icon_menu{position:absolute;right:0;top:0;width:0.88rem;height:0.76rem;background:url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1604367490409644/ysw19422_14icon_menu.png) no-repeat center center #f9f9f9;background-size:0.64rem 0.64rem;}\r\n.nav .swiper-container{position:relative;}\r\n.nav .swiper-container ul{font-size: 0;white-space: nowrap;}\r\n.nav .swiper-container ul li{cursor:pointer;display:inline-block;font-size:0.32rem;line-height:0.32rem;padding:0.22rem 0.36rem;color:#000000;}\r\n.nav .swiper-container ul li a{color:#000000;}\r\n.nav .swiper-container ul li:first-of-type{padding-left:0.26rem;}\r\n.nav .swiper-container ul li:last-of-type{padding-right:0.26rem;}\r\n.nav .swiper-container ul li.cur{color:#BF0614;}\r\n.nav .swiper-container ul li.cur a{color:#BF0614;}\r\n.nav .swiper-container ul li .box{position:relative;}\r\n.nav .swiper-container ul li .box .hot{display:none;position:absolute;top:-0.24rem;right:-0.54rem;padding:0 .06rem;text-align: center;border-radius:0.28rem;background: #e42626;background-clip: padding-box;font-size: .22rem;color: #fff;font-weight: normal;line-height:0.36rem;height:0.36rem;overflow:hidden;}\r\n.navvspace{display:none;width:100%;height:0.76rem;}\r\n.nav.fixednav {position: fixed;top: 0;left: 0;right:0;z-index: 800;max-width: 750px;width: 100%;margin:0 auto; box-sizing: border-box;}\r\n.menufuceng{position:fixed;/* top:0px; */z-index: 999;width:100%;height:100%;min-width:320px;max-width:750px;overflow: hidden;background-color:#ffffff;/*-webkit-tap-highlight-color: rgba(0,0,0,0);*/}\r\n\r\n/*头条区*/\r\n.toutiao{width:100%;margin-top:0.06rem;}\r\n.toutiao .main{position:relative;width:93.33%;margin:0 auto;padding:0.25rem 0;margin-bottom:0.2rem;background-color:#ffffff;border-radius:3px;-webkit-border-radius:3px;}\r\n.toutiao .main .left{ display: none;width:11.43%;text-align:center;color:#bf0614;font-size:0.42rem;line-height:0.44rem;}\r\n.toutiao .main .left:after{content: \"\";position:absolute;left:11.43%;top:50%;margin-top:-0.44rem;width:1px;height:0.88rem;background-color:#bf0614;}\r\n.toutiao .main .right{width:100%;padding:0;text-align:center;color:#333333;font-size:0.34rem;line-height:0.5rem;}\r\n.toutiao .main .right a{color:#333333;}\r\n.toutiao .main.special .left{display: block;}\r\n.toutiao .main.special .right{width:82.29%;padding:0 3.14%;text-align:left;}\r\n\r\n/*轮播图*/\r\n.lunbo{padding:0 0 0.23rem;}\r\n.lunbo .swiper-container{position:relative;/*padding:0 5.87%;*/padding:0 6%;}\r\n.lunbo .swiper-container .swiper-wrapper{position:relative;z-index:1;display:-webkit-box;display:-moz-box;display:-ms-flexbox;display:-webkit-flex;display:flex;-webkit-transition-property:-webkit-transform;-moz-transition-property:-moz-transform;-o-transition-property:-o-transform;-ms-transition-property:-ms-transform;transition-property:transform;-webkit-box-sizing:content-box;-moz-box-sizing:content-box;box-sizing:content-box;}\r\n.lunbo .swiper-container .swiper-wrapper a{display:block;position: relative;}\r\n.lunbo .swiper-container .swiper-wrapper img{font-size: 0;vertical-align: top;width:100%;height: auto;}\r\n.lunbo .swiper-container .swiper-wrapper i{background:#e42626;border-radius:0.05rem;-webkit-border-radius:0.05rem;padding:0 0.06rem;line-height:0.36rem;font-size:0.22rem;color:#fff;font-style:normal;position:absolute;right:0.06rem;top:0.06rem;}\r\n.lunbo .swiper-container .swiper-wrapper .text{position:relative;width:100%;height:1.4rem;background-color: #fff;}\r\n.lunbo .swiper-container .swiper-wrapper .text p{-webkit-box-sizing: border-box;box-sizing: border-box;width: 100%;padding:0.22rem 1.2rem 0 0.24rem;font-size:0.32rem;color:#333333;line-height: 0.48rem;overflow: hidden;text-overflow:ellipsis;display: -webkit-box;-webkit-line-clamp: 2;-webkit-box-orient: vertical;}\r\n.lunbo .swiper-container .swiper-wrapper .swiper-slide.swiper-slide-prev{-webkit-transform: scale(0.93);-moz-transform: scale(0.93);transform: scale(0.93);}\r\n.lunbo .swiper-container .swiper-wrapper .swiper-slide.swiper-slide-next{-webkit-transform: scale(0.93);-moz-transform: scale(0.93);transform: scale(0.93);}\r\n.lunbo .swiper-container .swiper-wrapper .swiper-slide.swiper-slide-active{-webkit-transform: scale(1);-moz-transform: scale(1);transform: scale(1);}\r\n.lunbo .swiper-container .swiper-wrapper .swiper-slide.swiper-slide-active .tit{-webkit-transform: scale(1);-moz-transform: scale(1);transform: scale(1);}\r\n.lunbo .swiper-container .swiper-wrapper .swiper-slide.swiper-slide-duplicate-prev{-webkit-transform: scale(0.93);-moz-transform: scale(0.93);transform: scale(0.93);}\r\n.lunbo .swiper-container .swiper-wrapper .swiper-slide.swiper-slide-duplicate-next{-webkit-transform: scale(0.93);-moz-transform: scale(0.93);transform: scale(0.93);}\r\n.lunbo .swiper-container .swiper-wrapper .swiper-slide.swiper-slide-duplicate-active{-webkit-transform: scale(1);-moz-transform: scale(1);transform: scale(1);}\r\n.lunbo .swiper-container .swiper-wrapper .swiper-slide.swiper-slide-duplicate-active .tit{-webkit-transform: scale(1);-moz-transform: scale(1);transform: scale(1);}\r\n.lunbo .swiper-container .swiper-wrapper .swiper-slide{-webkit-flex-shrink:0;-ms-flex:0 0 auto;flex-shrink:0;width:100%;height: auto !important;margin:0 auto;position:relative;pointer-events:pointer;-webkit-backface-visibility:hidden;-moz-backface-visibility:hidden;-ms-backface-visibility:hidden;backface-visibility:hidden;z-index:1;-webkit-transition: transform 1.0s;-moz-transition: transform 1.0s;-ms-transition: transform 1.0s; -o-transition: transform 1.0s;transition: transform 1.0s;-webkit-transform: scale(0.93);-moz-transform: scale(0.93);transform: scale(0.93);border-radius: 0.1rem;overflow: hidden;}\r\n.lunbo .swiper-container .swiper-wrapper .swiper-slide .img{position:relative;width: 100%;}\r\n.lunbo .swiper-pagination{position: absolute;right:0;bottom:0.1rem;width:1.2rem;text-align:center;font-size:0.24rem;line-height:0.4rem;color: #333333;z-index:998;}\r\n.lunbo .swiper-pagination .swiper-pagination-current{color:#bf0614;font-size:0.4rem;position: relative;top: -0.05rem;}\r\n\r\n/* 通用模块头 */\r\n.md{width:100%;overflow:hidden;}\r\n.md .md_hd{position:relative;padding:0.23rem 3.335% 0.16rem;}\r\n.md .md_hd .mh_title{font-size:0.4rem;line-height:0.48rem;color:#bf0614;}\r\n.md .md_hd:after{content: \"\";display: block;height:0px;line-height: 0px;clear: both;visibility: hidden;}\r\n.md .md_bd{width:100%;position:relative;overflow:hidden;}\r\n.md002 .md_hd{position:relative;padding:0.4rem 3.335% 0.34rem;}\r\n.md002 .md_hd .mh_title{float:left;padding-top:0.12rem;padding-left:0.2rem;color:#333333;background:url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1604367490409644/ysw19422_hotzhuantiicon.png) no-repeat left top;background-size:0.46rem 0.50rem;}\r\n.md002 .md_hd .mh_title.junshi{background:url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1604367490409644/ysw19422_junshiicon.png) no-repeat left top;background-size:0.46rem 0.43rem;}\r\n.md002 .md_hd .mh_title.tiyu{background:url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1604367490409644/ysw19422_14tiyuicon.png) no-repeat left top;background-size:0.46rem 0.46rem;}\r\n.md002 .md_hd .mh_title.pian{background:url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1604367490409644/ysw19422_piankuicon.png) no-repeat left top;background-size:0.46rem 0.46rem;}\r\n.md002 .md_hd .mh_title.xiongmao{background:url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1604367490409644/ysw19422_pandaicon.png) no-repeat left top;background-size:0.46rem 0.47rem;}\r\n.md002 .md_hd .mh_title.yangshikandian{background:url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1604367490409644/ysw19422_yangshikandianicon.png) no-repeat left top;background-size:0.46rem 0.55rem;}\r\n.md002 .md_hd .mh_title.wenlvmeishi{background:url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1604367490409644/ysw19422_wenlvmeishiicon.png) no-repeat left top;background-size:0.46rem 0.43rem;}\r\n.md002 .md_hd .mh_title.activelijian{background:url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1604367490409644/ysw19422_activelijianicon.png) no-repeat left top;background-size:0.5rem 0.5rem;}\r\n.md002 .md_hd .mh_title.jiemuyugao{background:url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1604367490409644/ysw19422_lineredicon.png) no-repeat left 0.12rem;background-size:0.08rem 0.54rem;}\r\n.md002 .md_hd .mh_title.gaoqingtupian{background:url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1604367490409644/ysw19422_gaoqingtupianicon.png) no-repeat left top;background-size:0.46rem 0.4rem;}\r\n.md002 .md_hd .mh_title.zhuanquk{background:url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1604367490409644/ysw19422_lineredicon.png) no-repeat left 0.12rem;background-size:0.08rem 0.54rem;}\r\n.md002 .md_hd .mh_title.lanmudaquan{background:url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1604367490409644/ysw19422_lineredicon.png) no-repeat left 0.12rem;background-size:0.08rem 0.54rem;}\r\n.md002 .md_hd .mh_more{float:right;margin-top:0.26rem;color:#666666;font-size:0.28rem;line-height:0.32rem;} \r\n.md002 .md_hd .mh_more a{margin-right:0.3rem;color:#666666;}\r\n.md002 .md_hd .mh_more a:last-of-type{margin-right:0;}\r\n.md002 .md_hd .mh_option{float:right;width:71%;height:0.44rem;margin-top:0.12rem;margin-right:0.2rem;border-bottom:1px solid #81DCC4;-webkit-box-sizing: border-box;box-sizing: border-box;}\r\n.md002 .md_hd .mh_option span{position:absolute;right:3.335%;bottom:0.38rem;font-size:0.28rem;color:#666666;padding-left:0.72rem;padding-right:0.26rem;background:url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1604367490409644/ysw19422_14xiaoxiongmao.png) no-repeat left bottom;background-size:0.59rem 0.21rem;}\r\n.md002 .md_hd .mh_option span a{color:#666666;}\r\n.md002 .md_hd .mh_option:before{content: \"\";position:absolute;right:-0.04rem;bottom:0.38rem;width:0.46rem;height:0.37rem;background:url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1604367490409644/ysw19422_14shuye.png) no-repeat center center;background-size:100% 100%;}\r\n.md003 .md_hd{position:relative;padding:0.6rem 6% 0.4rem;}\r\n.md003 .md_hd .mh_title {float: left;font-size: 0.32rem;line-height: 0.32rem;color: #333333;font-weight: bold;padding-left: 0.16rem;border-left: 0.04rem solid #bf0614;}\r\n.md003 .md_hd .mh_guanbi{float:right;margin-top:-0.16rem;width:0.64rem;height: 0.64rem;background:url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1604367490409644/ysw19422_14btnguanbi.png) no-repeat center center; background-size:100% 100%;}\r\n.mdBg_pianku{position:relative;background:url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1604367490409644/ysw19422_14piankamodeBgFin.png) no-repeat 0 top;background-size:3000px 100%;width:100%;height:auto;}\r\n.mdBg_pianku .md_bd{position:relative;}\r\n.yaowenstyle .md_hd{padding: 0.4rem 3.335% 0.24rem;}\r\n/*片库tab切*/\r\n.tabScore2_pianku_Con5 .tab{overflow: hidden;justify-content: center;-webkit-box-pack: center;-ms-flex-pack: center;display: -webkit-box;display: -webkit-flex;display: -ms-flexbox;display: flex;}\r\n.tabScore2_pianku_Con5 .tab span{cursor: pointer;display:inline-block;padding:0 0.35rem;font-size:0.32rem;color:#333;line-height:0.6rem;}\r\n.tabScore2_pianku_Con5 .tab span.cur{color:#bf0614;box-shadow:0 0.02rem 0.03rem 0.02rem rgba(0,0,0,0.2) inset;-webkit-box-shadow:0 0.02rem 0.03rem 0.02rem rgba(0,0,0,0.2) inset;border-radius:0.3rem;-webkit-border-radius:0.3rem;}\r\n\r\n/*要闻文字列表*/\r\n.yaowenlist{width:88%;padding:0.3rem 2.665% 0.1rem;margin:0 auto;margin-bottom:0.2rem;background-color:#ffffff;border-radius:3px;-webkit-border-radius:3px;}\r\n.yaowenlist h1{padding-bottom:0.26rem;color:#333333;font-size:0.34rem;line-height:0.48rem;}\r\n.yaowenlist h1 a{color:#333333;}\r\n.yaowenlist ul{width:100%;}\r\n.yaowenlist ul li{padding-bottom:0.3rem;color:#333333;font-size:0.32rem;line-height:0.36rem;overflow: hidden;text-overflow: ellipsis;white-space: nowrap;}\r\n.yaowenlist ul li a{color:#333333;}\r\n.yaowenlist ul li i{display:inline-block;vertical-align:top;height:0.36rem;text-align:center;margin-right:0.2rem;color:#ffffff;font-size:0.22rem;line-height:0.36rem;}\r\n.yaowenlist ul li i a{display:block;height:100%;min-width:0.9rem;padding:0 0.1rem;background-color:#bf0614;color:#ffffff;-webkit-border-radius: 0 5px;-moz-border-radius: 0 5px;border-radius: 0 5px;}\r\n\r\n/*图文列表*/\r\n.imgtextList{width:100%;}\r\n.imgtextList ul{width:93.33%;margin:0 auto;}\r\n.imgtextList ul li{display:none;background-color:#ffffff;border-radius:3px;-webkit-border-radius:3px;margin-bottom:0.2rem;}\r\n.imgtextList ul li a{color:#333333;}\r\n.imgtextList ul li .common{position: relative;width: 100%;}\r\n.imgtextList ul li .common .content_box{-webkit-box-sizing: border-box;box-sizing: border-box;width:100%;padding:0.27rem 0.2rem;}\r\n.imgtextList ul li .common .content_box h3{font-size:0.32rem;color:#333333;line-height:0.48rem;overflow: hidden;}\r\n.imgtextList ul li .common.youtu{position: relative;width: 100%;display: -webkit-box;display: -moz-box;display: -ms-flexbox;display: -o-box;display: box;}\r\n.imgtextList ul li .common.youtu .img{width:37.86%;}\r\n.imgtextList ul li .common.youtu .img img{display:block;width:100%;border-radius:3px;-webkit-border-radius:3px;}\r\n.imgtextList ul li .common.youtu .content_box{width:62.14%;text-overflow: ellipsis;display: -webkit-box;-webkit-line-clamp: 2;-webkit-box-orient: vertical;-moz-box-flex:1.0;-webkit-box-flex:1.0;-ms-flex:1.0;box-flex:1.0;}\r\n.imgtextList ul li .common.youtu .content_box h3{text-overflow: ellipsis;display: -webkit-box;-webkit-line-clamp: 2;-webkit-box-orient: vertical;}\r\n/* .imgtextList ul li .common.youtu .content_box h3 a{text-overflow: ellipsis;display: -webkit-box;-webkit-line-clamp: 2;-webkit-box-orient: vertical;} */\r\n.imgtextList .btnmore{cursor: pointer;width:93.33%;margin:0 auto;height: 0.8rem;margin-bottom: 0.2rem;background-color: #ffffff;border-radius:3px;-webkit-border-radius:3px;text-align: center;font-size: 0.28rem;color: #bf0614;line-height: 0.8rem;}\r\n\r\n/* 图文左右横滑 */\r\n.henghuaimgtextList {padding:0 3.335%;overflow: hidden;}\r\n.henghuaimgtextList .swiper-container ul.swiper-wrapper {display: -webkit-box;display: -ms-flexbox; -webkit-box-pack: justify; -ms-flex-pack: justify;}\r\n.henghuaimgtextList .swiper-container ul li.swiper-slide {position: relative;width:37.71%;margin-right:2.86%;background-color:#ffffff;border-radius:3px;-webkit-border-radius:3px;}\r\n.henghuaimgtextList .swiper-container ul li.swiper-slide:last-of-type{margin-right: 0;}\r\n.henghuaimgtextList .swiper-container ul li.swiper-slide img {width: 100%; display: block;border-radius:3px;-webkit-border-radius:3px;}\r\n.henghuaimgtextList .swiper-container ul li p{height:1.68rem;color: #333333;font-size: 0.28rem;line-height: 0.42rem;padding: 0.12rem 0.2rem 0;margin-bottom:0.33rem;overflow: hidden;text-overflow: ellipsis; display: -webkit-box;-webkit-line-clamp:4; -webkit-box-orient: vertical;}\r\n.henghuaimgtextList .swiper-container ul li p a{display:block;color: #333333;}\r\n.henghuaimgtextList .swiper-container ul li .column{margin-left:0.2rem;margin-bottom:0.2rem;display:inline-block;vertical-align:top;height:0.36rem;text-align:center;margin-right:0.2rem;color:#ffffff;font-size:0.22rem;line-height:0.36rem;}\r\n.henghuaimgtextList .swiper-container ul li .column a{display:block;height:100%;min-width:0.9rem;padding:0 0.1rem;background-color:#bf0614;color:#ffffff;-webkit-border-radius: 0 5px;-moz-border-radius: 0 5px;border-radius: 0 5px;}\r\n\r\n/* 大图左右横滑 */\r\n.henghuaimgList {padding:0 3.335% 0;overflow: hidden;}\r\n.henghuaimgList .swiper-container ul.swiper-wrapper {display: -webkit-box;display: -ms-flexbox; -webkit-box-pack: justify; -ms-flex-pack: justify;}\r\n.henghuaimgList .swiper-container li.swiper-slide {position: relative;width:59.57%;margin-right:3.57%;background-color:#ffffff;border-radius:3px;-webkit-border-radius:3px;}\r\n.henghuaimgList .swiper-container li.swiper-slide:last-of-type{margin-right: 0;}\r\n.henghuaimgList .swiper-container li.swiper-slide img {width: 100%; display: block;border-radius:3px;-webkit-border-radius:3px;}\r\n\r\n/* 栏目大全 */\r\n.lanmuimgList {padding:0 3.335% 0;overflow: hidden;}\r\n.lanmuimgList .swiper-container li.swiper-slide {position: relative;width:35.33%;border-radius: 5px;-webkit-border-radius:5px;overflow: hidden;}\r\n.lanmuimgList .swiper-container li.swiper-slide:last-of-type{margin-right: 0;}\r\n.lanmuimgList .swiper-container li.swiper-slide .img{border-radius: 5px;-webkit-border-radius:5px;overflow: hidden;}\r\n.lanmuimgList .swiper-container li:nth-child(1){background: url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1604367490409644/ysw19422_kannew.png) center -0.1px no-repeat;background-size:100% 100%;background-color:#FFFFFF;}\r\n.lanmuimgList .swiper-container li:nth-child(2){background: url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1604367490409644/ysw19422_lanzongyi.png) center -0.1px no-repeat;background-size:100% 100%;background-color:#FFFFFF;}\r\n.lanmuimgList .swiper-container li:nth-child(3){background: url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1604367490409644/ysw19422_aishenghuo.png) 0px -0.1px no-repeat;background-size:100% 100%;background-color:#FFFFFF;}\r\n.lanmuimgList .swiper-container li:nth-child(4){background: url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1604367490409644/ysw19422_tanjingji.png) -0.4px -0.1px no-repeat;background-size:100% 100%;background-color:#FFFFFF;}\r\n.lanmuimgList .swiper-container li:nth-child(5){background: url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1604367490409644/ysw19422_dongfazhi.png) -0.4px -0.1px no-repeat;background-size:100% 100%;background-color:#FFFFFF;}\r\n.lanmuimgList .swiper-container li:nth-child(6){background: url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1604367490409644/ysw19422_guantiyu.png) center -0.1px no-repeat;background-size:100% 100%;background-color:#FFFFFF;}\r\n.lanmuimgList .swiper-container li:nth-child(7){background: url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1604367490409644/ysw19422_xiangjiangkang.png) center -0.1px no-repeat;background-size:100% 100%;back