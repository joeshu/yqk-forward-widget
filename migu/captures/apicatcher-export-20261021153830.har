\r\nfunction weixinSucess(data){\t\r\n\twx.config({\r\n\tdebug: false, \r\n\tappId: \"wx2723c0deaa5a97e9\", \r\n\ttimestamp: data.data.timestamp, \r\n\tnonceStr:  data.data.nonceStr, \r\n\tsignature: data.data.signature,\r\n\tjsApiList: ['onMenuShareTimeline', 'onMenuShareAppMessage'] // 功能列表，我们要使用JS-SDK的什么功能\r\n\t});\r\n}\r\n\r\n// config信息验证后会执行ready方法，所有接口调用都必须在config接口获得结果之后，config是一个客户端的异步操作，所以如果需要在 页面加载时就调用相关接口，则须把相关接口放在ready函数中调用来确保正确执行。对于用户触发时才调用的接口，则可以直接调用，不需要放在ready 函数中。\r\nwx.ready(function(){\r\n\t// 获取“分享到朋友圈”按钮点击状态及自定义分享内容接口\r\n\twx.onMenuShareTimeline({\r\n\t\ttitle: '央视网_世界就在眼前', // 分享标题\r\n\t\tlink:window.location.href,\r\n\t\timgUrl: \"https:\"+\"//p3.img.cctvpic.com/photoAlbum/page/performance/img/2020/11/12/1605177821010_218.jpg\" // 分享图标\r\n\t});\r\n\t// 获取“分享给朋友”按钮点击状态及自定义分享内容接口\r\n\twx.onMenuShareAppMessage({\r\n\t\ttitle: '央视网_世界就在眼前', // 分享标题\r\n\t\tdesc: \"央视网是中央广播电视总台主办，以视频为特色的中央重点新闻网站。\", // 分享描述\r\n\t\tlink:window.location.href,\r\n\t\timgUrl: \"https:\"+\"//p3.img.cctvpic.com/photoAlbum/page/performance/img/2020/11/12/1605177821010_218.jpg\", // 分享图标\r\n\t\ttype: 'link'// 分享类型,music、video或link，不填默认为link\r\n\t});\r\n});\r\nwx.error(function(res){\r\n\tconsole.log(\"失败\");\r\n});\r\n\r\nfunction isdingding_20190304(){\r\n　　//判断是不是钉钉\r\n　　var ua = navigator.userAgent.toLowerCase();\r\n　　return ua.indexOf(\"dingtalk\") >= 0;\r\n}\r\n\r\nif(isdingding_20190304()){\r\n　　dd.ready(function(){\r\n\t　　dd.biz.navigation.setRight({\r\n\t　　show: true,//控制按钮显示， true 显示， false 隐藏， 默认true\r\n\t　　control: true,//是否控制点击事件，true 控制，false 不控制， 默认false\r\n\t　　text: '',//控制显示文本，空字符串表示显示默认文本\r\n\t　　onSuccess : function(result) {\r\n\t　　//如果control为true，则onSuccess将在发生按钮点击事件被回调\r\n\t　　dd.biz.util.share({\r\n\t　　type: 0, //分享类型，0:全部组件 默认； 1:只能分享到钉钉；2:不能分享，只有刷新按钮\r\n\t　　url: window.location.href,\r\n\t　　content: \"央视网是中央广播电视总台主办，以视频为特色的中央重点新闻网站。\",\r\n\t　　title: '央视网_世界就在眼前',\r\n\t　　image: \"https:\"+\"//p3.img.cctvpic.com/photoAlbum/page/performance/img/2020/11/1