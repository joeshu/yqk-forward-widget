11/3/1635927080994_113.jpg\" /><em class=\"\"></em></a>\r\n                    </div>\r\n                    <div class=\"text\">\r\n                      <div class=\"title\"><a href=\"https://tv.cctv.com/2026/10/19/VIDE33Tmf4BFvBXXVrvQNzhU261019.shtml\" target=\"_blank\">生动有趣的动物</a></div>\r\n                      <div class=\"brief\">动物故事的鲜活呈现</div>\r\n                    </div>\r\n                </div>\r\n                <div class=\"hover\">\r\n                    <div class=\"img\" data-img=\"//p2.img.cctvpic.com/photoAlbum/page/performance/img/2025/12/8/1765201979158_515.jpg\" data-src=\"\">\r\n                      <a href=\"https://tv.cctv.com/2026/10/19/VIDE33Tmf4BFvBXXVrvQNzhU261019.shtml\" target=\"_blank\"><img src=\"//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/zwPic1_1.gif\" /></a>\r\n                    </div>\r\n                    <div class=\"text\">\r\n                        <h3><a href=\"https://tv.cctv.com/2026/10/19/VIDE33Tmf4BFvBXXVrvQNzhU261019.shtml\" target=\"_blank\">生态文明的成就</a></h3>\r\n                        <span><a href=\"https://tv.cctv.com/2026/10/19/VIDE33Tmf4BFvBXXVrvQNzhU261019.shtml\" target=\"_blank\">我们的自然邻居，从秘境之中走到了我们面前，实现着不被打扰的相逢。</a></span>\r\n                        <div class=\"label\"><a href=\"https://tv.cctv.com/lm/mjzy/index.shtml\" target=\"_blank\">秘境之眼</a></div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </li>\r\n\t\t<li>\r\n\t\t    <div class=\"conTop\">\r\n\t\t        <div class=\"common\">\r\n\t\t            <div class=\"img\">\r\n\t\t              <a href=\"https://tv.cctv.com/2026/10/19/VIDEnstoXouwix1C7j9TU1sc261019.shtml\" target=\"_blank\"><img src=\"//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/zwPic1_1.gif\" class=\"lazy\" data-echo=\"//p2.img.cctvpic.com/photoAlbum/page/performance/img/2024/2/28/1709127031792_406.jpg\" /><em class=\"\"></em></a>\r\n\t\t            </div>\r\n\t\t            <div class=\"text\">\r\n\t\t              <div class=\"title\"><a href=\"https://tv.cctv.com/2026/10/19/VIDEnstoXouwix1C7j9TU1sc261019.shtml\" target=\"_blank\">深度解读财经事件</a></div>\r\n\t\t              <div class=\"brief\">让多元达成和谐</div>\r\n\t\t            </div>\r\n\t\t        </div>\r\n\t\t        <div class=\"hover\">\r\n\t\t            <div class=\"img\" data-img=\"//p1.img.cctvpic.com/photoAlbum/page/performance/img/2021/11/4/1636008576591_544.jpg\" data-src=\"\">\r\n\t\t              <a href=\"https://tv.cctv.com/2026/10/19/VIDEnstoXouwix1C7j9TU1sc261019.shtml\" target=\"_blank\"><img src=\"//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/zwPic1_1.gif\" /></a>\r\n\t\t            </div>\r\n\t\t            <div class=\"text\">\r\n\t\t                <h3><a href=\"https://tv.cctv.com/2026/10/19/VIDEnstoXouwix1C7j9TU1sc261019.shtml\" target=\"_blank\">深度解读财经事件</a></h3>\r\n\t\t                <span><a href=\"https://tv.cctv.com/2026/10/19/VIDEnstoXouwix1C7j9TU1sc261019.shtml\" target=\"_blank\">主持人和嘉宾以多元化、多方位的视角，对中国或国际财经事件进行深度解读。</a></span>\r\n\t\t                <div class=\"label\"><a href=\"https://tv.cctv.com/lm/yscjpl/index.shtml\" target=\"_blank\">央视财经评论</a></div>\r\n\t\t            </div>\r\n\t\t        </div>\r\n\t\t    </div>\r\n\t\t</li>\r\n\t\t<li>\r\n\t\t    <div class=\"conTop\">\r\n\t\t        <div class=\"common\">\r\n\t\t            <div class=\"img\">\r\n\t\t              <a href=\"https://tv.cctv.com/2026/10/19/VIDE8EeUamFsKKknvMM5qV9P261019.shtml\" target=\"_blank\"><img src=\"//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/zwPic1_1.gif\" class=\"lazy\" data-echo=\"//p1.img.cctvpic.com/photoAlbum/page/performance/img/2021/10/28/1635411079142_908.jpg\" /><em class=\"\"></em></a>\r\n\t\t            </div>\r\n\t\t            <div class=\"text\">\r\n\t\t              <div class=\"title\"><a href=\"https://tv.cctv.com/2026/10/19/VIDE8EeUamFsKKknvMM5qV9P261019.shtml\" target=\"_blank\">按响幸运的门铃</a></div>\r\n\t\t              <div class=\"brief\">这里是勇敢者的游戏</div>\r\n\t\t            </div>\r\n\t\t        </div>\r\n\t\t        <div class=\"hover\">\r\n\t\t            <div class=\"img\" data-img=\"//p2.img.cctvpic.com/photoAlbum/page/performance/img/2021/10/28/1635411133893_561.jpg\" data-src=\"\">\r\n\t\t              <a href=\"https://tv.cctv.com/2026/10/19/VIDE8EeUamFsKKknvMM5qV9P261019.shtml\" target=\"_blank\"><img src=\"//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/zwPic1_1.gif\" /></a>\r\n\t\t            </div>\r\n\t\t            <div class=\"text\">\r\n\t\t                <h3><a href=\"https://tv.cctv.com/2026/10/19/VIDE8EeUamFsKKknvMM5qV9P261019.shtml\" target=\"_blank\">这里是追梦人的舞台</a></h3>\r\n\t\t                <span><a href=\"https://tv.cctv.com/2026/10/19/VIDE8EeUamFsKKknvMM5qV9P261019.shtml\" target=\"_blank\">你有足够勇气加入开门团，为梦想角逐，与门铃君一决高下吗？</a></span>\r\n\t\t                <div class=\"label\"><a href=\"https://tv.cctv.com/lm/kmdj/index.shtml\" target=\"_blank\">开门大吉</a></div>\r\n\t\t            </div>\r\n\t\t        </div>\r\n\t\t    </div>\r\n\t\t</li>\r\n\t\t<li>\r\n\t\t    <div class=\"conTop\">\r\n\t\t        <div class=\"common\">\r\n\t\t            <div class=\"img\">\r\n\t\t              <a href=\"https://tv.cctv.com/2026/10/19/VIDENrrtYmHQ1kJsRGZMbeFq261019.shtml\" target=\"_blank\"><img src=\"//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/zwPic1_1.gif\" class=\"lazy\" data-echo=\"//p3.img.cctvpic.com/photoAlbum/page/performance/img/2025/1/14/1736820195457_667.jpg\" /><em class=\"\"></em></a>\r\n\t\t            </div>\r\n\t\t            <div class=\"text\">\r\n\t\t              <div class=\"title\"><a href=\"https://tv.cctv.com/2026/10/19/VIDENrrtYmHQ1kJsRGZMbeFq261019.shtml\" target=\"_blank\">最纯粹的足球</a></div>\r\n\t\t              <div class=\"brief\">最高级的享受</div>\r\n\t\t            </div>\r\n\t\t        </div>\r\n\t\t        <div class=\"hover\">\r\n\t\t            <div class=\"img\" data-img=\"//p1.img.cctvpic.com/photoAlbum/page/performance/img/2025/5/20/1747726382047_108.jpg\" data-src=\"\">\r\n\t\t              <a href=\"https://tv.cctv.com/2026/10/19/VIDENrrtYmHQ1kJsRGZMbeFq261019.shtml\" target=\"_blank\"><img src=\"//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/zwPic1_1.gif\" /></a>\r\n\t\t            </div>\r\n\t\t            <div class=\"text\">\r\n\t\t                <h3><a href=\"https://tv.cctv.com/2026/10/19/VIDENrrtYmHQ1kJsRGZMbeFq261019.shtml\" target=\"_blank\">世界足坛一周赛事精华</a></h3>\r\n\t\t                <span><a href=\"https://tv.cctv.com/2026/10/19/VIDENrrtYmHQ1kJsRGZMbeFq261019.shtml\" target=\"_blank\">报道球场内外趣闻趣事，通过不同的视角来介绍世界足坛所发生的重大新闻，带给观众最精彩的赛事精华。</a></span>\r\n\t\t                <div class=\"label\"><a href=\"https://tv.cctv.com/lm/txzq/index.shtml\" target=\"_blank\">天下足球</a></div>\r\n\t\t            </div>\r\n\t\t        </div>\r\n\t\t    </div>\r\n\t\t</li>\r\n\t\t<li>\r\n\t\t    <div class=\"conTop\">\r\n\t\t        <div class=\"common\">\r\n\t\t            <div class=\"img\">\r\n\t\t              <a href=\"https://tv.cctv.com/2026/10/19/VIDEVFhmsKml3lzVtMuYuUL2261019.shtml\" target=\"_blank\"><img src=\"//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/zwPic1_1.gif\" class=\"lazy\" data-echo=\"//p4.img.cctvpic.com/photoAlbum/page/performance/img/2023/11/30/1701328500114_577.jpg\" /><em class=\"\"></em></a>\r\n\t\t            </div>\r\n\t\t            <div class=\"text\">\r\n\t\t              <div class=\"title\"><a href=\"https://tv.cctv.com/2026/10/19/VIDEVFhmsKml3lzVtMuYuUL2261019.shtml\" target=\"_blank\">播报国防军事资讯</a></div>\r\n\t\t              <div class=\"brief\">聚焦国防军事动态消息</div>\r\n\t\t            </div>\r\n\t\t        </div>\r\n\t\t        <div class=\"hover\">\r\n\t\t            <div class=\"img\" data-img=\"//p3.img.cctvpic.com/photoAlbum/page/performance/img/2023/11/30/1701328743682_790.jpg\" data-src=\"\">\r\n\t\t              <a href=\"https://tv.cctv.com/2026/10/19/VIDEVFhmsKml3lzVtMuYuUL2261019.shtml\" target=\"_blank\"><i