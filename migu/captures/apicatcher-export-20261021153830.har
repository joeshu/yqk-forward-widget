 .diaAll .allpd ul li{margin:10px 0;margin-right: 31px;line-height: normal;height: 31px; float: left;}\n.tvCCTV_nav .logoNav .navUl .navLi .diaAll .allpd ul li.last{margin-right: 0;}\n.tvCCTV_nav .logoNav .navUl .navLi .diaAll .allpd ul li a{padding: 0;}\n.tvCCTV_nav .logoNav .navUl .navLi .diaAll .allpd ul li a img{width: 69px;height: 31px;}\n/* 全部弹层--栏目大全 */\n.tvCCTV_nav .logoNav .navUl .navLi .diaAll .alllm{margin-bottom: 10px;}\n.tvCCTV_nav .logoNav .navUl .navLi .diaAll .alllm i{float: left;margin-top: 0px;width:86px;font-size: 14px;font-weight: bold;color: #999;line-height:24px;}\n.tvCCTV_nav .logoNav .navUl .navLi .diaAll .alllm ul{float: left;width:876px;margin-top: 0px;}\n.tvCCTV_nav .logoNav .navUl .navLi .diaAll .alllm ul li{width: 116px;height:24px;line-height:24px; float: left;}\n.tvCCTV_nav .logoNav .navUl .navLi .diaAll .alllm ul li a{color: #222;}\n.tvCCTV_nav .logoNav .navUl .navLi .diaAll .alllm ul li a:hover{color: #0084ff;}\n.tvCCTV_nav .logoNav .navUl .navLi .diaAll .alllm ul li.allmore{text-align: center;width: 58px;}\n.tvCCTV_nav .logoNav .navUl .navLi .diaAll .alllm ul li.allmore a{ line-height: 22px; height: 22px; color: #0084ff;font-size: 14px;width: 58px;border: 1px solid #0084ff;border-radius: 22px;}\n.tvCCTV_nav .logoNav .navUl .navLi .diaAll .alllm ul li.allmore:hover a{background: #0084ff;color: #fff !important;}\n.tvCCTV_nav .logoNav .navUl .navLi .diaAll .alllm ul li a{padding: 0;}\n\n.tvCCTV_nav .searchHead{ float: right; padding-top:16px;}\n.tvCCTV_nav .searchHead .firstSearch{float: right; position: static;}\n.tvCCTV_nav .searchHead .firstSearch .inputVal{ background-color: #fff; border: 1px solid #0084ff; width: 230px;height:28px;}\n.tvCCTV_nav .searchHead .firstSearch .inputVal input{ color: #222222;}\n.tvCCTV_nav .searchHead .firstSearch .inputVal .heatSearch{ color:#222222;}\n.tvCCTV_nav .searchHead .firstSearch .inputVal input::-webkit-input-placeholder{color:#222222;}\n.tvCCTV_nav .searchHead .firstSearch .inputVal input::-moz-placeholder{color:#222222;}  \t/* Mozilla Firefox 19+ */\n.tvCCTV_nav .searchHead .firstSearch .inputVal input:-moz-placeholder{color:#222222;}  \t/* Mozilla Firefox 4 to 18 */\n.tvCCTV_nav .searchHead .firstSearch .inputVal input:-ms-input-placeholder{color:#222222;} /* Internet Explorer 10-11 */ \n.tvCCTV_nav .searchHead .firstSearch .inputVal input.cur::-webkit-input-placeholder{color:#999999;}\n.tvCCTV_nav .searchHead .firstSearch .inputVal input.cur::-moz-placeholder{color:#999999;}  \t/* Mozilla Firefox 19+ */\n.tvCCTV_nav .searchHead .firstSearch .inputVal input.cur:-moz-placeholder{color:#999999;}  \t/* Mozilla Firefox 4 to 18 */\n.tvCCTV_nav .searchHead .firstSearch .inputVal input.cur:-ms-input-placeholder{color:#999999;} /* Internet Explorer 10-11 */ \n.tvCCTV_nav .searchHead .headpic{display: none; float: right; cursor: pointer; background: url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/headpic.png) no-repeat; width:30px; height: 30px; background-size: 100%;}\n.tvCCTV_nav .searchHead .headpic:hover{ background-image: url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/headpicH.png);}\n\n\n\n/* 侧漂导航 */\n.floatNav{right:10px;bottom:10px;width: 60px;font-size: 12px;line-height:16px; text-align: center;position:fixed; z-index:14; display:none;}\n.floatNav.floatNavWidth{ display: none !important;}\n.floatNav .nav_gg{ height: 60px;border-radius: 5px; margin-bottom:5px;width: 100%; position: relative;}\n.floatNav .nav_kjb{ height: 60px;border-radius: 5px;margin-bottom:5px; width: 100%;box-shadow: 0 0 8px rgba(51,51,51,0.15); background-color: #fff; cursor: pointer; position: relative;}\n.floatNav .nav_kjb a{height: 24px;line-height: 24px; padding-top:36px; background-position:center 6px;background-image:url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/cepiaoIcon01.png); background-repeat: no-repeat; width:100%;color: #222222; display:inline-block;text-decoration: none;}\n.floatNav .nav_kjb:hover a{background-image:url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/cepiaoIcon01_hover.png); color: #0084ff;}\n.floatNav .nav_kjb .code{width:192px;height:103px; padding:26px 46px 26px 40px; right:60px;top:-44px;display:none;z-index: 999;overflow:hidden;background-image:url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/tianjia_bg_962.png);position: absolute; cursor: default;}\n.floatNav .nav_kjb .code p{font-size:16px;line-height:26px; text-align:center; margin-bottom: 15px;}\n.floatNav .nav_kjb .code span{font-size:14px;line-height:30px; width: 100px; height: 30px; margin: 0 auto; text-align:center; background: url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/cepiao_tianjia_962.png) no-repeat;display: block; color: #ffffff; cursor: pointer;}\n.floatNav .nav_kjb .code span:hover{background-image: url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/tianjia_962.png);}\n\n.floatNav .nav{padding-top:5px;border-radius: 5px; box-shadow: 0 0 8px rgba(51,51,51,0.15); background-color:#fff;background-image:url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/cepiaoBg_t.png);background-position:top center; background-repeat: no-repeat;width: 100%; background-size: 100% auto;}\n.floatNav .navBg{padding-bottom:5px; width: 100%; height: 100%; background-image:url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/cepiaoBg_b.png);background-position:bottom center; background-repeat: no-repeat; background-size: 100% auto;}\n.floatNav .nav ul li{margin-bottom:4px;}\n.floatNav .nav ul li a{padding-top:30px; background-position:center 0px; width:100%;color: #222222; display:inline-block;text-decoration: none;background-repeat: no-repeat; position: relative;}\n.floatNav .nav ul li a.navIcon01{background-image: url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/cepiaoIcon02.png); }\n.floatNav .nav ul li a.navIcon02{background-image: url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/cepiaoIcon03.png); }\n.floatNav .nav ul li a.navIcon03{background-image: url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/cepiaoIcon04.png); }\n.floatNav .nav ul li a.navIcon04{background-image: url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/cepiaoIcon05.png); }\n.floatNav .nav ul li a.navIcon05{background-image: url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/cepiaoIcon06.png);}\n.floatNav .nav ul li a.navIcon06{background-image: url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/cepiaoIcon07.png); }\n.floatNav .nav ul li a.navIcon07{background-image: url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/cepiaoIcon08.png); }\n.floatNav .nav ul li a.navIcon08{background-image: url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/cepiaoIcon09.png); }\n.floatNav .nav ul li.cur a.navIcon01,.floatNav .nav ul li a.navIcon01:hover{background-image: url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/cepiaoIcon02_hover.png); }\n.floatNav .nav ul li.cur a.navIcon02,.floatNav .nav ul li a.navIcon02:hover{background-image: url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/cepiaoIcon03_hover.png); }\n.floatNav .nav ul li.cur a.navIcon03,.floatNav .nav ul li a.navIcon03:hover{background-image: url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/cepiaoIcon04_hover.png); }\n.floatNav .nav ul li.cur a.navIcon04,.floatNav .nav ul li a.navIcon04:hover{background-image: url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/cepiaoIcon05_hover.png); }\n.floatNav .nav ul li.cur a.navIcon05,.floatNav .nav ul li a.navIcon05:hover{background-image: url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/cepiaoIcon06_hover.png); }\n.floatNav .nav ul li.cur a.navIcon06,.floatNav .nav ul li a.navIcon06:hover{background-image: url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/cepiaoIcon07_hover.png); }\n.floatNav .nav ul li.cur a.navIcon07,.floatNav .nav ul li a.navIcon07:hover{background-image: url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/cepiaoIcon08_hover.png); }\n.floatNav .nav ul li.cur a.navIcon08,.floatNav .nav ul li a.navIcon08:hover{background-image: url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/cepiaoIcon09_hover.png); }\n.floatNav .nav ul li.cur a{color: #0084ff;}\n.floatNav .nav ul li.backTop{ margin-bottom: 0;}\n/* .floatNav .phone .code{position: absolute;width:77px;height:125px; padding:26px 32px 18px 26px; right:60px;top:-58px;display:none; z-index: 999;overflow:hidden;background-image:url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/shk_bg_962.png); cursor: default;}\n.floatNav .phone .code img{width:77px; height:77px;display: block;margin-bottom: 8px;}\n.floatNav .phone .code p{font-size:14px;line-height:16px; color: #5a5e62;text-align:center;} */\n\n\n.floatNav .phone .sjewm{display:none;width:220px;height:142px;padding:15px 10px;box-sizing:border-box; border-radius: 5px; background-color: #fff; box-shadow: #ccc 3px 1px 15px; position: absolute;top:-40px;right:75px;}\n.floatNav .phone .sjewm i{ width: 0; height: 0; position: absolute; top:60px; right:-16px; border-right:8px solid transparent;border-left: 8px solid #fff;border-bottom: 8px solid transparent;border-top:8px solid transparent; }\n.floatNav .phone .sjewm .code{ display: block; width:100px; float: left; text-align: center; }\n.floatNav .phone .sjewm .code img{width:70%;height:auto; margin: 0 auto; margin-bottom: 10px;}\n.floatNav .phone .sjewm .code p{font-size: 14px; line-height: 16px;color: #5a5e62; width: 100%; text-align: center;}\n\n\n.floatNav .nav_kjb:hover .code,.floatNav .phone:hover .sjewm{\n  -webkit-animation: ani_x_fixed_tool_pop .3s 0s ease-out forwards;\n  -moz-animation: ani_x_fixed_tool_pop .3s 0s ease-out forwards;\n  -o-animation: ani_x_fixed_tool_pop .3s 0s ease-out forwards;\n  animation: ani_x_fixed_tool_pop .3s 0s ease-out forwards;\n  filter:alpha(opacity=100);\n  display: block;\n}\n@-webkit-keyframes ani_x_fixed_tool_pop{\n  0%{opacity:.5;-webkit-transform:scale(.5);-webkit-transform-origin:center right;}\n  60%{opacity:1;-webkit-transform:scale(1);-webkit-transform-origin:center right;}\n  100%{opacity:1;-webkit-transform:scale(1);-webkit-transform-origin:center right;}\n}\n@-moz-keyframes ani_x_fixed_tool_pop{\n  0%{opacity:.5;-webkit-transform:scale(.5);-moz-transform-origin:center right;}\n  60%{opacity:1;-webkit-transform:scale(1);-moz-transform-origin:center right;}\n  100%{opacity:1;-webkit-transform:scale(1);-moz-transform-origin:center right;}\n}\n@-o-keyframes ani_x_fixed_tool_pop{\n  0%{opacity:.5;-webkit-transform:scale(.5);-o-transform-origin:center right;}\n  60%{opacity:1;-webkit-transform:scale(1);-o-transform-origin:center right;}\n  100%{opacity:1;-webkit-transform:scale(1);-o-transform-origin:center right;}\n}\n@keyframes ani_x_fixed_tool_pop{\n  0%{opacity:.5;transform:scale(.5);transform-origin:center right;display: block;}\n  60%{opacity:1;transform:scale(1);transform-origin:center right;}\n  100%{opacity:1;transform:scale(1);transform-origin:center right;}\n}\n\n/*底部悬浮广告*/\n.floatBottom{position:fixed;bottom:0px;border-radius:5px;width:100%;z-index:13;display:none;}\n.floatBottom img{width:100%;}\n.floatBottom .close{ background: url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/bottomFalseClose.png) no-repeat; cursor: pointer; width: 40px;height: 40px; position: absolute; top: 0; right: 0; display: block;}\n.floatBottom .close:hover{background-image:url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/bottomFalseCloseCur.png)}\n\n/*顶通*/\n/*顶通样式顶替*/\n.nav_wrapper_bg.newtopbz{background:#181818 !important;position: relative;z-index: 100;}\n.nav_wrapper_bg.newtopbz .nav_wrapper .navli .nav_tit a{color: #fff;}\n.nav_wrapper_bg.newtopbz .nav_wrapper .navli .nav_tit .group{ background-image:url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/nav_icon_spirit_.png);}\n.nav_wrapper_bg.newtopbz .nav_wrapper .search_icon .btn_icon{ background-image:url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/nav_icon_spirit_.png);}\n.nav_wrapper_bg.newtopbz .nav_wrapper .app_icon .btn_icon{ background-image:url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/nav_icon_spirit_.png);}\n.nav_wrapper_bg.newtopbz .nav_wrapper .user_icon .btn_icon{ background-image:url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/nav_icon_spirit_.png);}\n.nav_wrapper_bg.newtopbz .nav_wrapper .class_icon .group{ background-image:url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/nav_icon_spirit_.png);}\n.nav_wrapper_bg.newtopbz .nav_wrapper .class_icon .btn_icon{ background-image:url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/nav_icon_spirit_.png);}\n.nav_wrapper_bg.newtopbz .nav_wrapper .navli.rotate180 .nav_tit .group{background-image:url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/nav_icon_spirit_hover.png) !important;}\n.nav_wrapper_bg.newtopbz .nav_wrapper .navli .nav_tit .aigcLogo{ background-image: url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/LogoAIGCwhite.png);}\n.nav_wrapper_bg.newtopbz .nav_wrapper .navli .nav_tit .aigcLogo:hover{ background-image: url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/LogoAIGCwhiteH.png);}\n\n.nav_wrapper_bg{width: 100%;height:46px;margin:0 auto;background:#fff url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/nav_bg.jpg) repeat-x;}\n.nav_wrapper_bg .nav_wrapper{width:100%;height:46px;margin: 0 auto;position: relative;z-index: 51;}\n.nav_wrapper_bg .nav_wrapper .nav_list{width:962px;margin: 0 auto;height: 46px