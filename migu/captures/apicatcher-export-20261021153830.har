e-height:0.8rem;}\r\n\r\n/* 图文左右横滑02 */\r\n.henghuaimgtextList02 {overflow: hidden;}\r\n.henghuaimgtextList02 .swiper-container ul.swiper-wrapper {display: -webkit-box;display: -ms-flexbox; -webkit-box-pack: justify; -ms-flex-pack: justify;}\r\n.henghuaimgtextList02 .swiper-container ul li {position: relative;width:65.14%;/*height:1.8rem;*/padding:0.24rem 0;margin-right:2.86%;background-color:#ffffff;border-radius:3px;-webkit-border-radius:3px;}\r\n.henghuaimgtextList02 .swiper-container ul li:last-of-type{margin-right: 0;}\r\n.henghuaimgtextList02 .swiper-container ul li .content{width:100%;height:100%;}\r\n.henghuaimgtextList02 .swiper-container ul li a{color: #333333;}\r\n.henghuaimgtextList02 .swiper-container ul li .img{width:26.43%;margin-left:3.52%;}\r\n.henghuaimgtextList02 .swiper-container ul li .img img {width: 100%; display: block;}\r\n.henghuaimgtextList02 .swiper-container ul li .text{padding: 0 4.51%; width: 61.03%;color: #333333;font-size: 0.28rem;overflow: hidden;text-overflow: ellipsis; display: -webkit-box;-webkit-line-clamp:3; -webkit-box-orient: vertical;}\r\n\r\n/*军事大图展示--第二批*/\r\n.ImageText2_junshi_Con01{width: 93.33%;margin: 0 auto;position:relative;}\r\n.ImageText2_junshi_Con01 a{display:block;}\r\n.ImageText2_junshi_Con01 img{border-radius:3px;-webkit-border-radius:3px;}\r\n.ImageText2_junshi_Con01 i{color:#fff;line-height:0.5rem;padding:0 0.1rem;font-size:0.32rem; width: 50%;}\r\n.ImageText2_junshi_Con01 i a{color:#fff;background:#333333;display:initial;}\r\n.ImageText2_junshi_Con01 .poi01{position:absolute;left:0.2rem;bottom:0.94rem;}\r\n.ImageText2_junshi_Con01 .poi02{position:absolute;left:0.2rem;bottom:0.3rem;}\r\n/* wmj20201027央视看点*/\r\n.ysw19422_congyskd .tabScore2_sport_Con4 .list li:nth-child(5),.ysw19422_congyskd .tabScore2_sport_Con4 .list li:nth-child(6){display: block;}\r\n#SUBD1604472643332601 li:nth-child(3),#SUBD1604472643332601 li:nth-child(4){margin-bottom:0;}\r\n\r\n/*军事图文混排--第二批*/\r\n.ImageText2_junshi_Con02{width: 93.33%;margin: 0 auto;}\r\n.ImageText2_junshi_Con02 ul{margin-bottom:0.2rem;}\r\n.ImageText2_junshi_Con02 li{background:#fff;margin-top:0.2rem;display:none;border-radius:5px;-webkit-border-radius:5px;}\r\n.ImageText2_junshi_Con02 li .box{overflow:hidden;display: -webkit-box;display: -moz-box;display: -ms-flexbox;display: -o-box;display: box;}\r\n.ImageText2_junshi_Con02 li .img{width:37.7%;margin-right:0.2rem;border-radius:3px;-webkit-border-radius:3px;}\r\n.ImageText2_junshi_Con02 li .img img{border-radius:5px;-webkit-border-radius:5px;}\r\n.ImageText2_junshi_Con02 li .word{display: -webkit-box;-webkit-box-flex: 1;display: box;-webkit-box-pack: justify;-webkit-box-orient: vertical;padding-right:0.2rem;}\r\n.ImageText2_junshi_Con02 li .word h3{margin-top:0.04rem;font-size:0.32rem;line-height:0.48rem;color:#333;text-overflow: ellipsis;display: -webkit-box;-webkit-box-orient: vertical;-webkit-line-clamp:2;overflow: hidden;} \r\n.ImageText2_junshi_Con02 li .word h3 a{color:#333;}\r\n.ImageText2_junshi_Con02 li .word .tagListRemove{color:#999;font-size:0.22rem;line-height:0.48rem;overflow:hidden;}\r\n.ImageText2_junshi_Con02 li .word .tagListRemove a{pointer-events: none;color:#999;line-height:0.48rem;float:left;margin-right:0.26rem;display:inline-block;}\r\n.ImageText2_junshi_Con02 li .word .tagListRemove a:last-of-type{margin-right:0;}\r\n.ImageText2_junshi_Con02 li:nth-child(1),.ImageText2_junshi_Con02 li:nth-child(2),.ImageText2_junshi_Con02 li:nth-child(3),.ImageText2_junshi_Con02 li:nth-child(4){display:block;}\r\n/*loading 换一换*/\r\n.loading{display:block;cursor: pointer;font-size:0.32rem;line-height:0.36rem;width:100%;text-align:center;padding:0.22rem 0;background:#fff;position:relative;}\r\n.loading span{color:#BF0614;padding-right:0.07rem;}\r\n.loading i{position: absolute;top:50%;margin-top:-0.18rem;width: 0.36rem;background: url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1604367490409644/ysw19422_14loadingbtn.png) no-repeat left center;height: 0.36rem;background-size:0.36rem 0.36rem;}\r\n\r\n/*tab切换*/\r\n.tiyuqiehuan .tabs_2{width:200%;overflow: hidden;}\r\n.tiyuqiehuan .tabs_3{width:200%;overflow: hidden;}\r\n.tiyuqiehuan .tabs_4{width:400%;overflow: hidden;}\r\n.tiyuqiehuan .tabs_2 .box{width:50%;}\r\n.tiyuqiehuan .tabs_3 .box{width:33.33%;}\r\n.tiyuqiehuan .tabs_4 .box{width:25%;}\r\n.tiyuqiehuan .tabs_2 div[class^=\"box\"] {float: left;text-align: left;}\r\n.tiyuqiehuan .tabs_3 div[class^=\"box\"] {float: left;text-align: left;}\r\n.tiyuqiehuan .tabs_4 div[class^=\"box\"] {float: left;text-align: left;}\r\n.tabScore2_pianku_Con5 .tabs_4{width:400%;overflow: hidden;}\r\n.tabScore2_pianku_Con5 .tabs_4 .box{width:25%;}\r\n.tabScore2_pianku_Con5 .tabs_4 div[class^=\"box\"] {float: left;text-align: left;}\r\n/*体育切换*/\r\n.tiyuqiehuan .qiehuantab{text-align:center;}\r\n.tiyuqiehuan .qiehuantab .swiper-tab{display:inline-block;background:none;-webkit-tap-highlight-color:rgba(0,0,0,0);-webkit-tap-highlight-color:transparent;}\r\n.tiyuqiehuan .qiehuantab .swiper-tab .swiper-wrapper{background:none;-webkit-tap-highlight-color:rgba(0,0,0,0);-webkit-tap-highlight-color:transparent;justify-content:center;-webkit-box-pack: center;-ms-flex-pack: center; display: -webkit-flex;display:flex;display: -webkit-box;display: -ms-flexbox;margin-bottom:0.25rem;}\r\n.tiyuqiehuan .qiehuantab .swiper-tab .swiper-slide{cursor:pointer;padding:0 0.28rem;line-height:0.56rem;margin-right:0.22rem;font-size: 0.32rem;}\r\n.tiyuqiehuan .qiehuantab .swiper-tab .swiper-slide:last-of-type{margin-right:0;}\r\n.tiyuqiehuan .qiehuantab .swiper-tab .swiper-slide.swiper-slide-thumb-active{position:relative;color:#bf0614;}\r\n.tiyuqiehuan .qiehuantab .swiper-tab .swiper-slide.swiper-slide-thumb-active span{content:'';position:absolute;left:0;top:0;width:100%;height:100%;box-shadow:0 0.02rem 0.03rem 0.02rem rgba(0,0,0,0.2) inset;-webkit-box-shadow:0 0.02rem 0.03rem 0.02rem rgba(0,0,0,0.2) inset;border-radius:0.3rem;-webkit-border-radius:0.3rem;}\r\n\r\n/*体育并列两行图文列表分类--第二批 */\t/* 打模块的时候注意，设计页面用了有换一换和没有换一换的两个效果，用的同一个模块  */\r\n.tabScore2_sport_Con4{width: 93.33%;margin: 0 auto;}\r\n.tabScore2_sport_Con4 .list{overflow:hidden;/*padding-bottom:0.4rem;*/font-size: 0;}\r\n.tabScore2_sport_Con4 .list li{display:none;width:48.6%;float:left;margin:0 2.8% 0.2rem 0;background:#fff;border-radius:3px;-webkit-border-radius:3px;}\r\n.tabScore2_sport_Con4 .list li:nth-child(even){margin-right:0;}\r\n.tabScore2_sport_Con4 .list li .img{display:block;border-top-left-radius:3px;}\r\n.tabScore2_sport_Con4 .list li .img img{border-top-left-radius:3px;-webkit-border-top-left-radius:3px;border-top-right-radius:3px;-webkit-border-top-left-radius:3px;}\r\n.tabScore2_sport_Con4 .list li h3{padding:0.10rem 0.18rem 0;font-size:0.32rem;line-height:0.48rem;color:#333;text-overflow: ellipsis;display: -webkit-box;-webkit-box-orient: vertical;-webkit-line-clamp:3;overflow: hidden;min-height:1.44rem;}\r\n.tabScore2_sport_Con4 .list li h3 a{color:#333;}\r\n.tabScore2_sport_Con4 .list li h3 i{text-overflow: ellipsis; display: -webkit-box;-webkit-box-orient: vertical;-webkit-line-clamp: 3;overflow: hidden;}\r\n.tabScore2_sport_Con4 .list li .tagListRemove{padding-left:0.18rem;padding-top:0.13rem;padding-bottom:0.1rem;min-height:0.48rem;line-height:0.48rem;color:#999;font-size:0.22rem;overflow:hidden;}\r\n.tabScore2_sport_Con4 .list li .tagListRemove a{pointer-events: none;line-height:0.48rem;float:left;color:#999;margin-right:0.26rem;display:inline-block;}\r\n.tabScore2_sport_Con4 .list li .tagListRemove a:last-of-type{margin-right:0;}\r\n.tabScore2_sport_Con4 .btnmore{cursor: pointer;width: 100%;height: 0.8rem;margin-bottom: 0.2rem;background-color: #ffffff;border-radius: 5px;-webkit-border-radius: 5px;text-align: center;font-size: 0.28rem;color: #bf0614;line-height: 0.8rem;}\r\n.tabScore2_sport_Con4 .list li:nth-child(1),.tabScore2_sport_Con4 .list li:nth-child(2),.tabScore2_sport_Con4 .list li:nth-child(3),.tabScore2_sport_Con4 .list li:nth-child(4){display:block;}\r\n.modeContent .tabScore2_sport_Con4{width:100%;}\r\n.modeContent .tabScore2_sport_Con4 .list li:nth-child(5),.modeContent .tabScore2_sport_Con4 .list li:nth-child(6){display:block;}\r\n\r\n/* wmj20201027 */\r\n.tabScore2_sport_Con5{width: 93.33%;margin: 0 auto;}\r\n.tabScore2_sport_Con5 .list{overflow:hidden;/*padding-bottom:0.4rem;*/}\r\n.tabScore2_sport_Con5 .list li{display:none;width:48.6%;float:left;margin:0 2.8% 0.2rem 0;background:#fff;border-radius:3px;-webkit-border-radius:3px;}\r\n.tabScore2_sport_Con5 .list li:nth-child(even){margin-right:0;}\r\n.tabScore2_sport_Con5 .list li .img{display:block;border-top-left-radius:3px;}\r\n.tabScore2_sport_Con5 .list li .img img{border-top-left-radius:3px;-webkit-border-top-left-radius:3px;border-top-right-radius:3px;-webkit-border-top-left-radius:3px;}\r\n.tabScore2_sport_Con5 .list li h3{box-sizing: border-box;padding:0.15rem 0.18rem 0;font-size:0.32rem;line-height:0.48rem;color:#333;text-overflow: ellipsis;display: -webkit-box;-webkit-box-orient: vertical;-webkit-line-clamp:2;overflow: hidden;min-height:1.44rem;}\r\n.tabScore2_sport_Con5 .list li h3 a{color:#333;}\r\n.tabScore2_sport_Con5 .list li h3 i{text-overflow: ellipsis; display: -webkit-box;-webkit-box-orient: vertical;-webkit-line-clamp: 2;overflow: hidden;}\r\n.tabScore2_sport_Con5 .list li .tagListRemove{padding-left:0.18rem;padding-top:0.13rem;padding-bottom:0.1rem;min-height:0.48rem;line-height:0.48rem;color:#999;font-size:0.22rem;overflow:hidden;}\r\n.tabScore2_sport_Con5 .list li .tagListRemove a{pointer-events: none;line-height:0.48rem;float:left;color:#999;margin-right:0.26rem;display:inline-block;}\r\n.tabScore2_sport_Con5 .list li .tagListRemove a:last-of-type{margin-right:0;}\r\n.tabScore2_sport_Con5 .btnmore{width: 100%;height: 0.8rem;margin-bottom: 0.2rem;background-color: #ffffff;border-radius: 5px;-webkit-border-radius: 5px;text-align: center;font-size: 0.28rem;color: #bf0614;line-height: 0.8rem;}\r\n.tabScore2_sport_Con5 .list li:nth-child(1),.tabScore2_sport_Con5 .list li:nth-child(2),.tabScore2_sport_Con5 .list li:nth-child(3),.tabScore2_sport_Con5 .list li:nth-child(4){display:block;}\r\n.tabScore2_sport_Con5 .list li:nth-child(3),.tabScore2_sport_Con5 .list li:nth-child(4){margin-bottom: 0;}\r\n\r\n\r\n/*熊猫*/\r\n.tabScore2_sport_Con4 li{position:relative;}\r\n.tabScore2_sport_Con4 li .xiongmaobox{position:absolute;top:50%;transform:translate(0%,-50%);-webkit-transform:translate(0%,-50%);}\r\n.tabScore2_sport_Con4 li .tit{margin-bottom:0.65rem;overflow:hidden;padding-left:0.43rem;position:relative;display:-webkit-box;display: -moz-box;display: -ms-flexbox;display: -o-box;display: box;}\r\n.tabScore2_sport_Con4 li .tit a{position:relative;display:-webkit-box;display: -moz-box;display: -ms-flexbox;display: -o-box;display: box;}\r\n.tabScore2_sport_Con4 li .tit:first-of-type{margin-top:0.72rem;}\r\n.tabScore2_sport_Con4 li .tit:last-of-type{margin-bottom:0.72rem;}\r\n.tabScore2_sport_Con4 li .tit .imgspe{width:23.5%;margin-right:0.13rem;display:inline-block;position:relative;align-items:center; display: -webkit-flex; display:flex;}\r\n.tabScore2_sport_Con4 li .tit .imgspe img{display:block;}\r\n.tabScore2_sport_Con4 li .tit .imgspe .tu{position:absolute;top:50%;transform:translateY(-50%);-webkit-transform:translateY(-50%);}\r\n.tabScore2_sport_Con4 li .tit .imgspe .biao{padding:0.11rem 0;}\r\n.tabScore2_sport_Con4 li .tit .wordSpe{color:#333;font-size:0.28rem;text-overflow: ellipsis;display: -webkit-box;-webkit-box-orient: vertical;-webkit-line-clamp:1;overflow: hidden;display: -webkit-box;-webkit-box-flex: 1;display: box;-webkit-box-pack: justify;/*position:relative;*/padding: 0.04rem 0 0rem 0.1rem;}\r\n.tabScore2_sport_Con4 li .tit:nth-of-type(1) .imgspe .tu{width:0.39rem;height:0.39rem;left:-0.185rem;}\r\n.tabScore2_sport_Con4 li .tit .imgspe .biao{width:0.8rem;height:0.28rem;left:-0.3rem;}\r\n.tabScore2_sport_Con4 li .tit:nth-of-type(2) .imgspe .tu{width:0.45rem;height:0.45rem;left:-0.195rem;}\r\n.tabScore2_sport_Con4 li .tit:nth-of-type(3) .imgspe .tu{width:0.55rem;height:0.38rem;left:-0.25rem;}\r\n.tabScore2_sport_Con4 li.tit2 .tit:nth-of-type(1) .imgspe .tu{width:0.42rem;height:0.42rem;left:-0.185rem;}\r\n.tabScore2_sport_Con4 li.tit2 .tit:nth-of-type(2) .imgspe .tu{width:0.41rem;height:0.4rem;left:-0.185rem;}\r\n.tabScore2_sport_Con4 li.tit2 .tit:nth-of-type(3) .imgspe .tu{width:0.35rem;height:0.39rem;left:-0.185rem}\r\n\r\n\r\n/*片库轮播图*/\r\n.tabScore2_pianku_Con6{width:100%;padding:0.2rem 0 0.6rem;overflow: hidden;}\r\n.tabScore2_pianku_Con6 .swiper-container{position:relative;overflow:hidden;padding-right:3.34% }\r\n.tabScore2_pianku_Con6 .swiper-container .swiper-wrapper{padding-left:0.24rem;;padding-right:0.24rem;;position:relative;z-index:1;display:-webkit-box;display:-moz-box;display:-ms-flexbox;display:-webkit-flex;display:flex;-webkit-transition-property:-webkit-transform;-moz-transition-property:-moz-transform;-o-transition-property:-o-transform;-ms-transition-property:-ms-transform;transition-property:transform;-webkit-box-sizing:content-box;-moz-box-sizing:content-box;box-sizing:content-box;}\r\n.tabScore2_pianku_Con6 .swiper-container .swiper-wrapper a{display:block;position: relative;}\r\n.tabScore2_pianku_Con6 .swiper-container .swiper-wrapper img{font-size: 0;vertical-align: top;width:100%;height: auto;border-radius:3px;-webkit-border-radius:3px;}\r\n.tabScore2_pianku_Con6 .swiper-container .swiper-wrapper .text{position:absolute;left:0;bottom:0;width:100%;height:0.72rem;}\r\n.tabScore2_pianku_Con6 .swiper-container .swiper-wrapper .text p{-webkit-box-sizing: border-box;box-sizing: border-box;width: 100%;padding:0 0.8rem 0 0.2rem;font-size:0.32rem;color:#ffffff;line-height: 0.72rem;overflow: hidden;text-overflow:ellipsis;white-space: nowrap;}\r\n.tabScore2_pianku_Con6 .swiper-container .swiper-wrapper .swiper-slide.swiper-slide-prev{position:relative;}\r\n.tabScore2_pianku_Con6 .swiper-container .swiper-wrapper{ display: -webkit-box;display: -ms-flexbox; -webkit-box-pack: justify; -ms-flex-pack: justify;}\r\n.tabScore2_pianku_Con6 .swiper-container .swiper-slide { width:50%;padding-right: 0.24rem;position: relative;}\r\n.tabScore2_pianku_Con6 .swiper-container .swiper-slide img { width: 100%; display: block;}\r\n.whiteBg{background:#fff;width:100%;height:100%;position:absolute;left:0;top:0;opacity:0;filter:alpha(opacity=0);-khtml-opacity:0;-moz-opacity:0;}\r\n\r\n/*高清趣图*/\r\n.tabScore3_gaoqingPic_Con01{width: 93.33%;margin: 0 auto;font-size:0;}\r\n.tabScore3_gaoqingPic_Con01 .list li{display:none;width:48.6%;float:left;margin:0 2.8% 0.2rem 0;background:#fff;border-radius:3px;-webkit-border-radius:3px;}\r\n.tabScore3_gaoqingPic_Con01 .list li a{display:block;}\r\n.tabScore3_gaoqingPic_Con01 .list li .img{display:block;border-top-left-radius:3px;}\r\n.tabScore3_gaoqingPic_Con01 .list li .img img{border-top-left-radius:3px;-webkit-border-top-left-radius:3px;border-top-right-radius:3px;-webkit-border-top-left-radius:3px;}\r\n.tabScore3_gaoqingPic_Con01 .list li h3{padding: 0.1rem 0.18rem 0;font-size:0.32rem;line-height:0.48rem;color:#333;text-overflow: ellipsis;display: -webkit-box;-webkit-box-orient: vertical;-webkit-line-clamp:3;overflow: hidden;min-height:1.44rem;}\r\n.tabScore3_gaoqingPic_Con01 .list li .tagListRemove{padding-left:0.18rem;padding-top: 0.13rem;padding-bottom: 0.1rem;min-height:0.48rem;line-height: 0.48rem;color:#999;font-size:0.22rem;overflow:hidden;}\r\n.tabScore3_gaoqingPic_Con01 .list li .tagListRemove a{pointer-events: none;line-height:0.3rem;float:left;color:#999;margin-right:0.25rem;text-overflow: ellipsis;display: -webkit-box;-webkit-box-orient: vertical;-webkit-line-clamp:1;overflow: hidden;}\r\n.tabScore3_gaoqingPic_Con01 .list li .tagListRemove a:last-of-type{margin-right:0;}\r\n.tabScore3_gaoqingPic_Con01 .list li h3 i{text-overflow: ellipsis;  display: -webkit-box;  -webkit-box-orient: vertical;  -webkit-line-clamp: 3;  overflow: hidden;}\r\n.tabScore3_gaoqingPic_Con01 .list li h3 a{color: #333;}\r\n.tabScore3_gaoqingPic_Con01 .list li:nth-child(3n+1){width:100%;position:relative;}\r\n.tabScore3_gaoqingPic_Con01 .list li:nth-child(3n+1) a{display:block;}\r\n.tabScore3_gaoqingPic_Con01 .list li:nth-child(3n+1) img{border-radius:3px;-webkit-border-radius:3px;}\r\n.tabScore3_gaoqingPic_Con01 .list li:nth-child(3n+1) h3{width:50%;min-height:1px;position:absolute;left:0.22rem;bottom:0.3rem;margin-bottom:0.1rem;color:#fff;line-height:0.5rem;padding:0 0.1rem;font-size:0.32rem;font-style:normal;}\r\n.tabScore3_gaoqingPic_Con01 .list li:nth-child(3n+1) h3 i{display: initial;background: #333;color: #fff;}\r\n.tabScore3_gaoqingPic_Con01 .list li:nth-child(3n+1) .tagListRemove{display:none;}\r\n.tabScore3_gaoqingPic_Con01 .list li:nth-child(3n+3){margin-right:0;}\r\n.tabScore3_gaoqingPic_Con01 .list li:nth-child(1),.tabScore3_gaoqingPic_Con01 .list li:nth-child(2),.tabScore3_gaoqingPic_Con01 .list li:nth-child(3){display:block;}\r\n\r\n/*全站导航*/\r\n.quanzhannav{padding:0 6%;}\r\n.quanzhannav .title{height:0.5rem;line-height:0.5rem;display:inline-block;padding:0.3rem 0.4rem 0.3rem 0;font-weight:bold;color:#bf0614;font-size:0.32rem;background: url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1604367490409644/ysw19422_14btnjiantou.png) no-repeat right center;background-size:0.2rem 0.2rem;}\r\n.quanzhannav ul{width:100%;border-bottom:1px solid #e7e7e7;padding-top:0.4rem;}\r\n.quanzhannav ul:first-of-type{padding-top:0;}\r\n.quanzhannav ul:after{content:\"\"; display:block; height:0; clear:both; visibility:hidden; }\r\n.quanzhannav ul li{float:left;width:21.52%;margin-right:4.64%;margin-bottom: 0.4rem;color:#333333;font-size:0.32rem;line-height:0.6rem;text-align:center;}\r\n.quanzhannav ul li a{display:block;width:100%;border:1px solid #999999;-webkit-box-sizing: border-box;box-sizing: border-box;color:#333333;border-radius: 0.12rem;-webkit-border-radius: 0.12rem;}\r\n.quanzhannav ul li.tab2{width:47.68%;}\r\n.quanzhannav ul li.last{margin-right:0;}\r\n\r\n/*全站logo*/\r\n.quanzhanlogo{padding:0.1rem 6% 0;}\r\n.quanzhanlogo ul{width:100%;padding:0.3rem 0;}\r\n.quanzhanlogo ul li{float:left;width:21.52%;margin-right:4.64%;}\r\n.quanzhanlogo ul li:nth-child(4n){margin-right:0;}\r\n.quanzhanlogo ul li a{display:block;width:100%;}\r\n.quanzhanlogo ul li a img{width:100%;}\r\n\r\n/*底部导航*/\r\n.dibunav{position:fixed;bottom:0;z-index:998;width:100%;height:0.98rem;background-color:#ffffff;min-width:320px;max-width:750px;}\r\n.dibunav ul{padding:0 3.335%;}\r\n.dibunav ul:before{content:'';position:absolute;left:50%;top:-0.2rem;z-index:-1;margin-left:-0.6rem;width:1.2rem;height:1.2rem;background-color:#ffffff;border-radius:50%;-webkit-border-radius:50%;}\r\n.dibunav ul li{position:relative;float:left;width:20%;height: 0.98rem;/*padding-top:0.56rem;*/color:#333333;font-size:0.22rem;line-height:0.42rem;text-align:center;}\r\n.dibunav ul li:nth-child(1){background: url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1604367490409644/ysw19422_14icon_paihang.png) no-repeat center 0.12rem;background-size:0.6rem 0.44rem;}\r\n.dibunav ul li:nth-child(2){background: url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1604367490409644/ysw19422_14icon_jiemudan.png) no-repeat center 0.12rem;background-size:0.6rem 0.44rem;}\r\n.dibunav ul li:nth-child(3){padding-top:0;height:0.98rem;}\r\n.dibunav ul li:nth-child(4){background: url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1604367490409644/ysw19422_14icon_kanzhibo.png) no-repeat center 0.12rem;background-size:0.6rem 0.44rem;}\r\n.dibunav ul li:nth-child(5){background: url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1604367490409644/ysw19422_14icon_jmgw.png) no-repeat center 0.12rem;background-size:0.6rem 0.44rem;}\r\n.dibunav ul li a{color:#333333;display: block;padding-top: 0.56rem;}\r\n.dibunav ul li .kandian{position:absolute;left:0;top:-0.1rem;width:100%;height:100%;background: url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1604367490409644/ysw19422_14icon_kandian.png) no-repeat center center;background-size:0.96rem 0.96rem;}\r\n.dibunav ul li .kandian.cur{background: url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1604367490409644/ysw19422_14icon_kandiancur.png) no-repeat center center;background-size:0.96rem 0.96rem;}\r\n\r\n/*看点浮层*/\r\n.kandianfuceng{position:fixed;z-index: 998;text-align:center;width:100%;height:100%;min-width:320px;max-width:750px;background: url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1604367490409644/ysw19422_14qipanbg.jpg) no-repeat center center;background-size:100% 100%;overflow:hidden;/* verflow-y: scroll;-webkit-overflow-scrolling: touch; */}\r\n.kandianfuceng .icon_guanbi{float:right;margin:0.94rem 0.24rem 0.6rem 0;width:0.6rem;height:0.6rem;background: url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1604367490409644/ysw19422_14qipanbtnguanbi.png) no-repeat center center;background-size:100% 100%;}\r\n.kandianbox{width: 93.33%;margin: 0 auto;}\r\n.kandianbox table{width:100%;padding-bottom:2rem;}\r\n.kandianbox table td{width:20%;margin:0.05rem;background-color:rgba(255,255,255,0.77);overflow:hidden;}\r\n.kandianbox table tr td a{display:inline-block;vertical-align:middle;padding:0.26rem 0;overflow:hidden;color:#333333;font-size:0.24rem;line-height:0.4rem;font-family:'Microsoft YaHei';}\r\n.kandianbox table tr td.datu a,.kandianfuceng ul li.xiaotu a,.kandianfuceng ul li.special a{display:inline;}\r\n.kandianbox table tr td.datu a img{width: 2.4rem;height: 1.15rem;margin:0 auto;overflow:hidden;}\r\n.kandianbox table tr td.xiaotu a img{width: 1rem;height: 1rem;margin:0 auto;overflow:hidden;}\r\n.kandianbox table tr td.special{background: url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1604367490409644/ysw19422_14qipanspbg.png) no-repeat center center #fff;background-size:2.74rem 1.33rem;opacity:0.77;}\r\n.kandianbox table tr td.special a{font-weight:bold;font-size:0.34rem;line-height:1.32rem;}\r\n.kandianbox table tr td.special a img{width:0.6rem;margin-right:0.14rem;display:inline-block;vertical-align:middle;}\r\n.kandianbox table tr td.datu,.kandianbox table tr td.special{width:40%;padding:0 0.05rem;}\r\n.kandianbox table tr td.datu a,.kandianbox table tr td.xiaotu a,.kandianbox table tr td.special a {display: inline;padding:0;}\r\n\r\n/*底部logo列表*/\r\n.footerlogolist{width:100%;/* height:1.85rem; */background-color:#555555;overflow:hidden;}\r\n.footerlogolist ul{width:98.4%;margin:0 auto;}\r\n.footerlogolist ul li{width:25%;float:left;}\r\n.footerlogolist ul li .img{width:47.7%;margin:0 auto;margin-top:0.36rem;}\r\n.footerlogolist ul li .img img{width:100%;}\r\n.footerlogolist ul li p{text-align:center;font-size:0.22rem;color:#ffffff;line-height:0.6rem;}\r\n\r\n\r\n\r\n\r\n/*footer*/\r\n.footer{width: 100%;background-color:#444444;}\r\n.footer .link{padding:0.4rem 0 0.38rem;color: #ffffff;font-size: 0.28rem;line-height: 0.28rem;text-align: center;}\r\n.footer .link a{color: #ffffff;padding:0 0.2rem;}\r\n.footer p{color: #ffffff;font-size: 0.22rem;line-height: 0.24rem;text-align: center;padding-bottom: 0.38rem;}\r\n.footer p span{padding:0 0.16rem;}\r\n\r\n/*返回顶部*/\r\n.gotop_btn {display: none;position: fixed;bottom: 1.14rem;right:0.25rem;width:0.85rem;height:0.85rem;background: url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1604367490409644/ysw19422_14icon_totop.png) no-repeat center center;background-size:100% 100%; z-index: 997;}\r\n.wufulinmen{ display: none; position: fixed;bottom: 2.24rem;right:0.13rem;z-index: 997;width: 0.95rem;height: 0.86rem;}\r\n.wufulinmen a{display:block;width:100%;height:100%;}\r\n\r\n/*  换一换旋转动画  */\r\n.rotate-center {\r\n\t-webkit-animation: rotate-center 0.6s ease-in-out both;\r\n\tanimation: rotate-center 0.6s ease-in-out both;\r\n}\r\n@-webkit-keyframes rotate-center {\r\n  0% {\r\n    -webkit-transform: rotate(0);\r\n            transform: rotate(0);\r\n  }\r\n  100% {\r\n    -webkit-transform: rotate(360deg);\r\n            transform: rotate(360deg);\r\n  }\r\n}\r\n@keyframes rotate-center {\r\n  0% {\r\n    -webkit-transform: rotate(0);\r\n            transform: rotate(0);\r\n  }\r\n  100% {\r\n    -webkit-transform: rotate(360deg);\r\n            transform: rotate(360deg);\r\n  }\r\n}\r\n\r\n/* wmj1026 通用广告图*/\r\n.ysw19422_banner_tongyong{width: 100%;margin: 0.4rem auto 0;}\r\n.ysw19422_banner_tongyong img{display: block;width: 93.6%;margin: 0 auto;} \r\n.md002 .md_hd .mh_title.activity{background: url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1604367490409644/ysw19422_activity.png) no-repeat left top; background-size: 0.46rem 0.46rem;}\r\n/* wmj20201027正在直播 */\r\n.ysw19422_zhengzaizhibo {padding:0 3.335% 0;overflow: hidden;margin-top: 0.2rem;}\r\n.ysw19422_zhengzaizhibo .swiper-container ul.swiper-wrapper {display: -webkit-box;display: -ms-flexbox; -webkit-box-pack: justify; -ms-flex-pack: justify;}\r\n.ysw19422_zhengzaizhibo .swiper-container li.swiper-slide {position: relative;width:48.5%;margin-right:2.4%;background-color:#ffffff;border-radius:3px;-webkit-border-radius:3px;}\r\n.ysw19422_zhengzaizhibo .swiper-container li.swiper-slide:last-of-type{margin-right: 0;}\r\n.ysw19422_zhengzaizhibo .swiper-container li.swiper-slide img {width: 100%; display: block;border-radius:3px;-webkit-border-radius:3px;}\r\n.ysw19422_zhengzaizhibo .swiper-container li.swiper-slide .zhiboimg{font-size: 0.22rem;line-height: 0.34rem;color:#ffffff;text-align: center;padding-left: 0.21rem;box-sizing: border-box; display: inline-block; width: 1.24rem;height: 0.39rem;background: url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1604367490409644/ysw19422_zhengzaizhibo.png) left top no-repeat;position: absolute;left:0;top:0;background-size: 1.24rem 0.39rem;}\r\n.ysw19422_zhengzaizhibo .swiper-container li.swiper-slide p{font-size: 0.32rem;color:#333333;line-height:0.48rem;margin-top:0.15rem;padding:0 0.2rem; min-height:1.44rem;text-overflow: ellipsis;display: -webkit-box;-webkit-box-orient: vertical;-webkit-line-clamp: 2;overflow: hidden;}\r\n.ysw19422_zhengzaizhibo .swiper-container li.swiper-slide p i{text-overflow: ellipsis; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden;}\r\n.ysw19422_zhengzaizhibo .swiper-container li.swiper-slide p a{color:#333333;}\r\n/* 悬浮广告位 */\r\n.ysw19422_guanggaowei{display: none; position: fixed;top: 50%;left: 50%;transform: translate(-50%,-50%);z-index: 1000;}\r\n.ysw19422_guanggaowei a{display: inline-block;}\r\n.ysw19422_guanggaowei img{display: block;width: 5.5rem;}\r\n.ysw19422_guanggaowei .ysw19422_close{z-index: 1000;width:0.4rem;height:0.4rem;float: right;margin-bottom: 0.4rem; background: url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1604367490409644/ysw19422_close.png) right top no-repeat;background-size: 0.4rem 0.4rem;}\r\n.ysw19422_bantouming{position: fixed;top: 0;left: 0;z-index: 1000;background-color: rgba(0, 0, 0, 0.5);width: 100%;height: 100%;display: none;}\r\n\r\n/* 体育 */\r\n.tiyuqiehuan .tabScore2_sport_Con4 .list li:nth-child(3),.tiyuqiehuan .tabScore2_sport_Con4 .list li:nth-child(4){margin-bottom: 0;}\r\n\r\n/* wmj20201027节目预告*/\r\n.ysw19422_jiemuyugao{margin: 0 0.24rem;}\r\n.ysw19422_jiemuyugao .more_list{background: #ffffff;height:0.8rem;line-height: 0.8rem;text-align: center;font-size: 0.32rem;color:#666666; border-radius: 5px;  -webkit-border-radius: 5px;}\r\n.ysw19422_jiemuyugao .more_list a{color:#BF0614;display: block;}\r\n.md002 .md_hd .mh_title.none{background:none;padding-left: 0;}\r\n.ysw19422_jiemuyugao .item_list li {background: #ffffff; align-items: center;display: -webkit-flex;display: flex;display: -moz-flex;display: -o-flex; width: 100%;border-radius: 0.12rem;overflow: hidden;height: 1.57rem;margin-bottom: 0.2rem;}\r\n.ysw19422_jiemuyugao .item_list .videoStar {width:27.63%;text-align: left;font-size:0.36rem;color:#333333;float:left;box-sizing: border-box;padding: 0 0 0 0.2rem;}\r\n.ysw19422_jiemuyugao .item_list .videoCont {  width: 71.79%; float: left;}\r\n.ysw19422_jiemuyugao .item_list .videoStar a {font-size: 0.28rem;color: #333333;}\r\n.ysw19422_jiemuyugao .item_list .videoCont p { padding: 0 0.2rem; font-size: 0.32rem; color: #333333; line-height: 0.48rem; margin-bottom: 0.12rem; text-overflow: ellipsis;display: -webkit-box;-webkit-box-orient: vertical;-webkit-line-clamp: 2;overflow: hidden;}\r\n.ysw19422_jiemuyugao .item_list .videoCont>div { overflow: hidden; padding: 0 0.2rem;}\r\n.ysw19422_jiemuyugao .item_list .videoCont p a { color: #333333;}\r\n.ysw19422_jiemuyugao .item_list .videoCont div span { color: #999999; font-size: 0.26rem; float: left;}\r\n.ysw19422_jiemuyugao .item_list .videoCont div span a{color: #999999;}\r\n.ysw19422_jiemuyugao .item_list i.line {border-left:1px solid #f9f9f9;height:1.66rem;display:block;float: left;}\r\n\r\n/* 特别推荐 */\r\n#certify1huodong{padding-top:0;}\r\n.active_bgicon .md_hd{padding-bottom: 0.24rem;}\r\n/* 4K专区 */\r\n.ysw19422_zhuanqu .tabScore2_sport_Con4 .list li:nth-child(3),.ysw19422_zhuanqu .tabScore2_sport_Con4 .list li:nth-child(4){margin-bottom: 0;}\r\n\r\n/* 汽车 */\r\n.md002 .md_hd .mh_title.qiche{background: url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1604367490409644/ysw19422_qicheicon.png) no-repeat left top; background-size: 0.46rem 0.39rem;}\r\n/* ai频道 */\r\n.md002 .md_hd .mh_title.aipindao{background: url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1604367490409644/ysw19422_aipindao.png) no-repeat left top; background-size: 0.46rem 0.46rem;}\r\n\r\n/* 文旅美食专题 */\r\n.md002 .md_hd .mh_title.aipindao{background: url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1604367490409644/ysw19422_aipindao.png) no-repeat left top; background-size: 0.46rem 0.46rem;}\r\n.ysw19422_wenlvmeishi_more{height: 0.8rem;line-height: 0.8rem;text-align: center;font-size: 0.32rem;background-color: #ffffff;border-radius: 5px; -webkit-border-radius: 5px;overflow: hidden;width: 93.33%;margin: 0 auto;}\r\n.ysw19422_wenlvmeishi_more a{display: inline-block;text-align: center;background: url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1604367490409644/ysw19422_qicheicon01.png) left center no-repeat;background-size: 0.11rem 0.25rem;color:#333333;padding-left: 0.18rem;margin-right: 1.01rem;}\r\n.ysw19422_wenlvmeishi_more a:last-child{margin-right: 0;}\r\n\r\n/* 书画 */\r\n.md002 .md_hd .mh_title.shuhua{background: url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1604367490409644/ysw19422_shuhuaimcon.png) no-repeat left top; background-size: 0.46rem 0.37rem;}\r\n\r\n/* 农业 */\r\n.md002 .md_hd .mh_title.nongye{background: url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1604367490409644/ysw19422_nongyeicon.png) no-repeat left top; background-size: 0.46rem 0.50rem;}\r\n\r\n/* 健康 */\r\n.md002 .md_hd .mh_title.jiangkang{background: url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1604367490409644/ysw19422_jiangkangicon.png) no-repeat left top; background-size: 0.46rem 0.45rem;}\r\n\r\n/* 视频 */\r\n.md002 .md_hd .mh_title.shipin{background: url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1604367490409644/ysw19422_videoicon.png) no-repeat left top;background-size: 0.46rem 0.46rem;}\r\n\r\n/* 体育 */\r\n.cntv_sport_main_layout .league_row .item_sty{height: 1.12rem; line-height: 1.12rem;}\r\n\r\n/* 活动力荐 */\r\n.active_bgicon{position:relative;background:url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1604367490409644/ysw19422_activebgicon.png) no-repeat 0 top;background-size:100% 100%;width:100%;height:auto;}\r\n.md002.active_bgicon .md_hd{padding-top: 0.3rem;}\r\n\r\n.Lanmulist_shipin_Con02{width: 93.33%;margin: 0 auto;overflow:hidden;}\r\n.Lanmulist_shipin_Con02 ul{width:100%;padding-bottom:0.24rem;}\r\n.Lanmulist_shipin_Con02 ul li{width:22.855%;float:left;margin-right:2.86%;}\r\n.Lanmulist_shipin_Con02 ul li:nth-child(4n){margin-right:0;}\r\n.Lanmulist_shipin_Con02 ul li p{padding:0.1rem 0;text-align:center;color:#333333;font-size:0.28rem;line-height:0.42rem;}\r\n\r\n/*多语种频道*/\r\n.duoyuzhonglist{padding: 0.1rem 6% 0.2rem;}\r\n.duoyuzhonglist .duoyuzhonglist_top{position: relative;padding: 0.4rem 0;border-top: 1px solid #e7e7e7;}\r\n.duoyuzhonglist .duoyuzhonglist_top span{float: left;font-size: 0.32rem;line-height: 0.32rem;color: #333333;font-weight: bold;padding-left: 0.16rem;border-left: 0.04rem solid #bf0614;}\r\n.duoyuzhonglist .duoyuzhonglist_top:after {content: \"\";display: block;height: 0px;line-height: 0px;clear: both;visibility: hidden;}\r\n.duoyuzhonglist ul{width: 100%;}\r\n.duoyuzhonglist ul li{float: left;width: 21.52%;margin-right: 4.64%;margin-bottom: 0.4rem;color: #333333;font-size: 0.32rem;line-height: 0.6rem;border: 1px solid #999999;box-sizing: border-box;-moz-box-sizing:border-box;-webkit-box-sizing:border-box;border-radius: 0.12rem;-webkit-border-radius: 0.12rem;text-align: center;}\r\n.duoyuzhonglist ul li a {position:relative;display: block;width: 100%;height: 0.6rem;color: #333333;}\r\n.duoyuzhonglist ul li a img{width:0.2rem;position:absolute;left:50%; top:50%; transform:translate(-50%,-50%);-webkit-transform:translate(-50%,-50%);}\r\n\r\n/* 悬浮广告位 */\r\n.ysw19422_guanggaowei .ysw19422_close{position: absolute;right: 0; z-index: 1000;margin-bottom:0;}\r\n.ysw19422_bantouming{position: fixed;top: 0;left:50%;transform: translate(-50%,0);z-index: 1000;min-width: 320px;margin: 0 auto;max-width: 750px;background-color: rgba(0, 0, 0, 0.5);width: 100%;height: 100%;display: none;}\r\n/* 返回顶部上面广告 */\r\n.wufulinmen{ display: none; position: fixed;bottom: 2.24rem;right:0.25rem;z-index: 997;width: 1rem;height:1rem;}\r\n.wufulinmen a{display:block;width:100%;height:100%;}\r\n\r\n/*央视看点与全部地图下的-中国电视报开始*/\r\n.md002 .md_hd .mh_title.yangshikandian{width: 97%;}\r\n.md002 .md_hd .mh_title.yangshikandian i{float: right;}\r\n.md002 .md_hd .mh_title.yangshikandian i img{display: block;width: 1.64rem;height: auto;}\r\n.quanzhanzgdsb{padding: 0.1rem 6% 0;}\r\n.quanzhanzgdsb ul{width: 100%; border-top: 1px solid #e7e7e7;padding: 0.402rem 0 0.202rem;overflow: hidden;}\r\n.quanzhanzgdsb ul li{float:left;width: 21%;}\r\n.quanzhanzgdsb ul li a{display: block;}\r\n.quanzhanzgdsb ul li img{display: block;width:100%;height: auto;}\r\n/*央视看点-中国电视报结束*/\r\n\r\n/*XUQIU-19623,2021更新全站地图*/\r\n.md002 .md_hd .mh_title.caijing{background:url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1604367490409644/ysw19623_caijingicon.png) no-repeat left top;background-size:0.46rem 0.48rem;}\r\n.md002 .md_hd .mh_title.jiaoyu{background:url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1604367490409644/ysw19623_jiaoyuicon.png) no-repeat left top;background-size:0.46rem 0.38rem;}\r\n.md002 .md_hd .mh_title.haiyang{background:url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1604367490409644/ysw19623_haiyangicon.png) no-repeat left top;background-size:0.59rem 0.4rem;}\r\n.md002 .md_hd .mh_title.renren{background:url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1604367490409644/ysw19623_rrdazgzicon.png) no-repeat left top;background-size:0.4rem 0.45rem;}\r\n.md002 .md_hd .mh_title.chanye{background:url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1604367490409644/ysw19422_lineredicon.png) no-repeat left 0.12rem;background-size: 0.08rem 0.54rem;}\r\n.menufuceng.new{background-color: #f9f9f9;}\r\n.md.qzdt .md_hd{position:relative;padding:0 4.27%;margin:0.5rem auto 0.8rem;}\r\n.md.qzdt .md_hd .mh_title{font-size:0.52rem;color: #333333;font-weight:bold;line-height:0.52rem;}\r\n.md.qzdt .md_hd .mh_guanbi{display:block;position:absolute;right:4.27%;top:-0.06rem;width: 0.64rem;height: 0.64rem;background: url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1604367490409644/ysw19623_iconguanbi.png) no-repeat center center;background-size:0.3rem 0.3rem;}\r\n\r\n/*全站地图公共样式*/\r\n.map{padding:0 4.27%;font-size:0;margin-top:0.46rem;}\r\n.map .map_title{font-size:0.4rem;color: #333333;line-height:0.48rem;margin-bottom:0.32rem;font-weight:bold;}\r\n\r\n/*热门\r\n.hotmap ul li{position: relative;float:left;width:23.02%;height:0.8rem;margin-right:2.64%;margin-bottom: 0.18rem;background-color:#FFFFFF;box-shadow: 0px 1px 2px 0px rgba(0,0,0,0.05);border-radius:0.08rem;color:#333333;font-size:0.32rem;line-height:0.8rem;text-align: center;}\r\n.hotmap ul li:nth-child(4n){margin-right:0;}\r\n.hotmap ul li a{display:block;color:#333333;height:100%;}\r\n.hotmap ul li a img{width: 0.2rem;position: absolute;left: 50%;top: 50%;transform: translate(-50%,-50%);-webkit-transform: translate(-50%,-50%);}\r\n*/\r\n.hotmap ul li{position: relative;float:left;padding:0 0.12rem;/*height:0.8rem;*/margin-right:2.64%;margin-bottom: 0.18rem;background-color:#FFFFFF;box-shadow: 0px 1px 2px 0px rgba(0,0,0,0.05);border-radius:0.08rem;color:#333333;font-size:0.32rem;line-height:0.8rem;text-align: center;}\r\n/* .hotmap ul li:nth-child(4n){margin-right:0;} */\r\n.hotmap ul li a{display:block;color:#333333;height:100%;}\r\n.hotmap ul li a img{width: 0.2rem;position: absolute;left: 50%;top: 50%;transform: translate(-50%,-50%);-webkit-transform: translate(-50%,-50%);/* display:inline-block;text-align:center;vertical-align:middle; */}\r\n.hotmap ul li:last-of-type{margin-right:0;}\r\n\r\n/*cctv节目官网*/\r\n.jmgwmap .map_title{display: inline-block;padding-right:0.34rem;background: url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1604367490409644/ysw19623_iconjiantou.png) no-repeat right center;background-size:0.24rem 0.22rem;}\r\n.jmgwmap ul li{float:left;width:23.02%;margin-right:2.64%;margin-bottom: 0.18rem;\r\nbackground: -webkit-linear-gradient(-45deg, #FF5756 0%, #FD7A7A 100%);background: -o-linear-gradient(-45deg, #FF5756 0%, #FD7A7A 100%);\r\nbackground: -moz-linear-gradient(-45deg, #FF5756 0%, #FD7A7A 100%);background:linear-gradient(-45deg, #FF5756 0%, #FD7A7A 100%);\r\nbox-shadow: 0px 1px 2px 0px rgba(0,0,0,0.05);border-radius:0.08rem;color:#FFFFFF;font-size:0.32rem;line-height:0.8rem;text-align: center;}\r\n.jmgwmap ul li:nth-child(8n+1){background: -webkit-linear-gradient(-45deg, #FF5756 0%, #FD7A7A 100%);background: -o-linear-gradient(-45deg, #FF5756 0%, #FD7A7A 100%);\r\nbackground: -moz-linear-gradient(-45deg, #FF5756 0%, #FD7A7A 100%);background:linear-gradient(-45deg, #FF5756 0%, #FD7A7A 100%);}\r\n.jmgwmap ul li:nth-child(8n+2){background: -webkit-linear-gradient(-45deg, #47B7EE 0%, #7CD6FE 100%);;background: -o-linear-gradient(-45deg, #47B7EE 0%, #7CD6FE 100%);\r\nbackground: -moz-linear-gradient(-45deg, #47B7EE 0%, #7CD6FE 100%);;background: linear-gradient(-45deg, #47B7EE 0%, #7CD6FE 100%);}\r\n.jmgwmap ul li:nth-child(8n+3){background: -webkit-linear-gradient(135deg, #37EABA 0%, #34B4BD 100%);;background: -o-linear-gradient(135deg, #37EABA 0%, #34B4BD 100%);\r\nbackground: -moz-linear-gradient(135deg, #37EABA 0%, #34B4BD 100%);;background:linear-gradient(135deg, #37EABA 0%, #34B4BD 100%);;}\r\n.jmgwmap ul li:nth-child(8n+4){background:-webkit- linear-gradient(135deg, #5EA8E2 0%, #6478EA 100%);;background: -o-linear-gradient(135deg, #5EA8E2 0%, #6478EA 100%);\r\nbackground: -moz-linear-gradient(135deg, #5EA8E2 0%, #6478EA 100%);;background:linear-gradient(135deg, #5EA8E2 0%, #6478EA 100%);;}\r\n.jmgwmap ul li:nth-child(8n+5){background: -webkit-linear-gradient(135deg, #FFAD6C 0%, #FD6940 100%);;background: -o-linear-gradient(135deg, #FFAD6C 0%, #FD6940 100%);\r\nbackground: -moz-linear-gradient(135deg, #FFAD6C 0%, #FD6940 100%);;background:linear-gradient(135deg, #FFAD6C 0%, #FD6940 100%);;}\r\n.jmgwmap ul li:nth-child(8n+6){background: -webkit-linear-gradient(134deg, #EA7E70 0%, #DB5B4A 100%);;background: -o-linear-gradient(134deg, #EA7E70 0%, #DB5B4A 100%);\r\nbackground: -moz-linear-gradient(134deg, #EA7E70 0%, #DB5B4A 100%);;background:linear-gradient(134deg, #EA7E70 0%, #DB5B4A 100%);;}\r\n.jmgwmap ul li:nth-child(8n+7){background: -webkit-linear-gradient(135deg, #FCD677 0%, #FE9D26 100%);;background: -o-linear-gradient(135deg, #FCD677 0%, #FE9D26 100%);\r\nbackground: -moz-linear-gradient(135deg, #FCD677 0%, #FE9D26 100%);;background:linear-gradient(135deg, #FCD677 0%, #FE9D26 100%);;}\r\n.jmgwmap ul li:nth-child(8n){background: -webkit-linear-gradient(135deg, #C19AEA 0%, #903FD4 100%);background: -o-linear-gradient(135deg, #C19AEA 0%, #903FD4 100%);\r\nbackground: -moz-linear-gradient(135deg, #C19AEA 0%, #903FD4 100%);background:linear-gradient(135deg, #C19AEA 0%, #903FD4 100%);}\r\n.jmgwmap ul li:nth-child(4n){margin-right:0;}\r\n.jmgwmap ul li a{display:block;color:#FFFFFF;}\r\n\r\n/*地图列表*/\r\n.listmap{padding:0;}\r\n.listmap .map_titlist{padding:0 4.27%;}\r\n.listmap .map_titlist ul {font-size: 0;white-space: nowrap;}\r\n.listmap .map_titlist ul li {position: relative;cursor: pointer;display: inline-block;font-size:0.4rem;color: #333333;font-weight:bold;line-height:0.48rem;padding-bottom:0.32rem;width:22.08%;text-align:center;-webkit-tap-highlight-color:rgba(0,0,0,0);-webkit-tap-highlight-color:transparent;}\r\n.listmap .map_titlist ul li:first-of-type{width:16.88%;text-align:left;}\r\n.listmap .map_titlist ul li:last-of-type{width:16.88%;text-align:right;}\r\n.listmap .map_titlist ul li.cur{color: #BF0614;}\r\n.listmap .map_titlist ul li.cur:after{position: absolute;left: 50%;bottom:0;margin-left: -0.27rem;content: \"\";width: 0.54rem;height: 0.06rem;background-color:#BF0614;border-radius: 3px;}\r\n.listmap .map_titlist ul li:first-of-type.cur:after{position: absolute;left:0.13rem;bottom:0;margin-left:0;content: \"\";width: 0.54rem;height: 0.06rem;background-color:#BF0614;border-radius: 3px;}\r\n.listmap .map_titlist ul li:last-of-type.cur:after{position: absolute;left: auto;bottom:0;margin-left:0;right:0.13rem;content: \"\";width: 0.54rem;height: 0.06rem;background-color:#BF0614;border-radius: 3px;}\r\n.listmap .map_con .listcon{display:none;background-color:#FFFFFF;padding:0.48rem 4.27% 0.3rem;}\r\n.channelnavstyle1 li{float:left;width:48.68%;margin-right:2.64%;margin-bottom: 0.18rem;border:1px solid rgba(0,0,0,0.1);border-radius:0.08rem;box-sizing:border-box;text-align: center;font-size:0.32rem;color: #333333;line-height:0.8rem;}\r\n.channelnavstyle1 li:nth-child(even){margin-right:0;}\r\n.channelnavstyle1 li a{display:block;color:#333333;}\r\n.channelnavstyle2{margin-bottom: 0.14rem;}\r\n.channelnavstyle2 li{float:left;width:23.02%;margin-right:2.64%;margin-bottom: 0.18rem;background-color:rgba(243,243,243,0.70);border-radius:0.08rem;box-sizing:border-box;text-align: center;font-size:0.32rem;color: #333333;line-height:0.8rem;}\r\n.channelnavstyle2 li:nth-child(4n){margin-right:0;}\r\n.channelnavstyle2 li a{display:block;color:#333333;}\r\n\r\n/*推荐*/\r\n.recommend ul li{position: relative;float:left;width:48.68%;height:0.8rem;margin-right:2.64%;margin-bottom: 0.18rem;background: #FFFFFF;box-shadow: 0px 1px 2px 0px rgba(0,0,0,0.05);border-radius:0.08rem;text-align: center;font-size:0.32rem;color: #333333;line-height:0.8rem;}\r\n.recommend ul li:nth-child(even){margin-right:0;}\r\n.recommend ul li a{display:block;color:#333333;height:100%;}\r\n.recommend ul li img{height:0.38rem;width:auto;position: absolute;left: 50%;top: 50%;transform: translate(-50%,-50%);-webkit-transform: translate(-50%,-50%);}\r\n\r\n/* aigc样式 */\r\n.footeraigclist{width: 100%;background-color: #555555;}\r\n.footeraigclist .aigclogo{width:24.3%;padding-top: 0.24rem;margin: 0 auto;}\r\n.footeraigclist .aigclist {padding:0.32rem 0.43rem 0.3rem;display:-webkit-box;display:-moz-box;display:-webkit-flex;display:-moz-flex;display:-ms-flexbox;display: flex;justify-content:space-around;-webkit-justify-content: space-around;}\r\n.footeraigclist .aigclist li{font-size: 0.28rem;line-height: 0.4rem;color: #ffffff; }\r\n.footeraigclist .aigclist li a{color: #ffffff;}\r\n\r\n/*产业头*/\r\n.ind_chanye{width: 100%;overflow: hidden;}\r\n.ind_chanye .title{position: relative;padding: 0.4rem 3.335% 0;}\r\n.ind_chanye .title span{float: left;padding-top: 0.12rem;padding-left: 0.2rem;color: #333333;font-size: 0.4rem;line-height: 0.48rem;\r\nbackground: url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1604367490409644/ysw20010_chanye.png) no-repeat left 0.08rem;background-size: 0.48rem 0.48rem;}\r\n\r\n/*套头图片无链接不能点击查看*/\r\n.taotou img{pointer-events: none;}"
