            "mimeType" : "text/css",
            "size" : 190816,
            "text" : "@charset \"utf-8\";\n*{-webkit-text-size-adjust: none;text-size-adjust: none;-webkit-tap-highlight-color: rgba(0, 0, 0, 0);}\nbody, div, p, ul, ol, dl, dt, dd, li, form, input, table, img, h1, h2, h3, h4, h5, h6{margin:0;padding:0;}\nbody{color:#222222;background:#fff; margin-top:0;font-family: PingFangSC-Regular,Helvetica,Arial,Microsoft Yahei,sans-serif;margin:0 auto; min-width:1022px;background-repeat: no-repeat; background-position: center center;}\nem, b, i{font-style:normal;}\na{color:#222222;text-decoration:none;/*outline: none;*/}\na.cur, a.on:hover, a.cur:hover, .on a:hover, .cur a:hover, a:hover, a:active{text-decoration:none;color:#0084ff !important;}\nimg,a img{border:0 none;}\nimg{width: 100%; height: 100%; display: block;}\nul,ol{list-style-type:none;}\nul:after, ol:after{clear:both;content:\".\";display:block;font-size:0;height:0;line-height:0;visibility:hidden;}\n.vspace{height:10px;font-size:0px;line-height:0px;width:99%;clear:both;overflow:hidden;}\nbody .l, body .left{float:left;clear:none;}\nbody .r, body .right{float:right;clear:none;}\nbody .c, body .c{text-align:center;}\n.clear{ height:0px; line-height:0; font-size:0; overflow:hidden; clear:both;}\ntable {border-spacing: 0;border-collapse: collapse;}\ntable td{padding: 0;}\ninput::-ms-clear, ::-ms-reveal { display: none; }\n/*\n\t.nav_wrapper_bg,#page_bottom{ display: none;}\n*/\n/*a {\n  bblr: expression(this.onFocus=this.blur());\n  IE使用\n  outline-style: none;FF使用\n  \n}\n去除a标签带来的虚框*/\n\n.image img {\n\t-webkit-transition: transform 1.3s;\n\t-moz-transition: transform 1.3s;\n\t-o-transition: transform 1.3s;\n\t-ms-transition: transform 1.3s;\n\t-webkit-perspective: 1000;\n\t-webkit-backface-visibility: hidden;\n\t-moz-perspective: 1000;\n\t-moz-backface-visibility: hidden;\n\t-o-perspective: 1000;\n\t-o-backface-visibility: hidden;\n\t-ms-perspective: 1000;\n\t-ms-backface-visibility: hidden;\n}\n.image:hover img {\n\t-webkit-transform: scale(1.05);\n\t-moz-transform: scale(1.05);\n\t-o-transform: scale(1.05);\n\t-ms-transform: scale(1.05);\n\ttransition: all 1s;\n\t-moz-transition: all 1s;\n\t/* Firefox 4 */\n\t-webkit-transition: all 1s;\n\t/* Safari 和 Chrome */\n\t-o-transition: all 1s;\n\t/* Opera */\n\t-ms-transition: all 1s;\n\t/* Opera */\n}\n\n/*默认分辨率小于1279 ，内容宽度962*/\n\n.column_wrapper{ width:962px; margin: 0 auto; clear: both; position: relative;}\n.column_wrapper .l{width: 588px;}\n.column_wrapper .r{width:374px;}\n\n.end1{display: none;}\n.end2{display: none;}\n.end3{display: none;}\n\n/*广告*/\n.tips{ display:none;width:30px;height:16px; bottom:0px; position: absolute; text-align: center;position: absolute;z-index: 3;font-size: 12px;line-height: 16px;color: rgb(255, 255, 255);background: rgb(0, 0, 0) none repeat scroll 0% 0%;opacity: 0.5;}\n\n/*广告*/\n.galaxyEnd1{display: none;}\n.galaxyEnd2{display: none;}\n.galaxyEnd3{display: none;}\n.galaxyEnd4{display: block;border-radius: 5px;}\n\n.tvCCTV_galaxy01{ padding-bottom: 30px;}\n.tvCCTV_galaxy02{position: relative;padding-top:7px;padding-bottom: 40px;}\n.tvCCTV_galaxy02 ul{width: 1000px;}\n.tvCCTV_galaxy02 ul li{float: left; width: 318px; height: 113px; margin-right: 4px; box-shadow: 0 0 8px rgba(51,51,51,.15); border-radius: 5px;background: #FFFFFF url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/pic01_bg_02.png) no-repeat 0 center;position: relative;}\n.tvCCTV_galaxy02 ul li:nth-child(2n){ background-image: url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/pic01_bg_01.png);}\n.tvCCTV_galaxy02 ul li .img{width: 118px; height: 100%; float: left; position: relative; overflow: hidden;}\n.tvCCTV_galaxy02 ul li .img img{position: absolute; top: 20px;transition: top .2s ease-in-out;z-index: 1;}\n.tvCCTV_galaxy02 ul li .text{float: left;padding: 30px 20px 35px 0;}\n.tvCCTV_galaxy02 ul li .text .title{font-size: 16px; line-height: 20px;color: #222222; margin-bottom: 10px;}\n.tvCCTV_galaxy02 ul li .text .brief{font-size: 14px; line-height: 18px;color: #999999;}\n.tvCCTV_galaxy02 ul li a{position: absolute; width: 100%; height: 100%; top: 0; left: 0; display: block;z-index: 2;}\n.tvCCTV_galaxy02 ul li.piclast{margin-right: 0;}\n.tvCCTV_galaxy02 ul li:hover .img img{top: 0;}\n.tvCCTV_galaxy02 ul li:hover .title{ color: #0084ff;}\n.tvCCTV_galaxy03{ padding-top: 7px; padding-bottom: 40px;}\n/* .tvCCTV_galaxy04{overflow: hidden;position: relative;padding-top:7px;padding-bottom: 40px;}\n.tvCCTV_galaxy04 ul{width: 1000px;}\n.tvCCTV_galaxy04 ul li{width: 178px; height: 101px; margin-right: 18px;border-radius: 5px;float: left;} */\n\n.tvCCTV_galaxy04 {overflow: hidden;width:980px; margin: 0 auto;padding-top:7px;padding-bottom: 40px;position: relative;}\n.tvCCTV_galaxy04 .mgad__brand{ font-size: 0;}\n.tvCCTV_galaxy04 .mgad__brand {width: 100%;white-space: nowrap;-webkit-transition: all 0.6s ease-in-out;transition: all 0.6s ease-in-out;font-size:0;}\n.tvCCTV_galaxy04 .mgad__brand .mgad__brand-item{width:178px; height: 101px;font-size:0;padding: 0 9px;display: inline-block;position: relative;overflow: hidden; text-align:left; transition: all .7s cubic-bezier(.46,.7,.54,1.1);}\n.tvCCTV_galaxy04 .mgad__brand .mgad__brand-item .mgad__brand-wrap {width:2000px;position: absolute;left: 0;top: 0;z-index: 1;height: 100%;}\n.tvCCTV_galaxy04 .mgad__brand .mgad__brand-item .mgad__brand-wrap .mgad__brand-mini{width: 178px;position: relative;float: left;padding: 0 9px;height: 100%;margin: 0;}\n.tvCCTV_galaxy04 .mgad__brand .mgad__brand-item .mgad__brand-wrap .mgad__brand-big {width: 570px; position: relative;float: left;padding: 0 9px;height: 100%;margin: 0;}\n.tvCCTV_galaxy04 .mgad__brand .mgad__brand-item .mgad__brand-wrap  .mgad__brand-mini img, .mgad__brand .mgad__brand-item .mgad__brand-wrap .mgad__brand-big img {width: 100%;height: 100%;border-radius: 4px;display: block;}\n.tvCCTV_galaxy04 .mgad__brand .mgad__brand-item.no-width {width: 0;padding: 0;}\n.tvCCTV_galaxy04 .mgad__brand .mgad__brand-item .mgad__brand-demo{width:178px;height: 101px;opacity: 0;display: block;}\n.tvCCTV_galaxy04 .mgad__brand .mgad__brand-item.end1{display: none;}\n.tvCCTV_galaxy04 .mgad__brand .mgad__brand-item.end2{display: none;}\n.tvCCTV_galaxy04 .mgad__brand .mgad__brand-item.end3{display: none;}\n\n.tvCCTV_galaxy01,.floatNav .nav_gg,.floatBottom{display: none;}\n.tvCCTV_galaxy05{ padding-bottom: 40px;display: none;}\n.tvCCTV_galaxy01 a,.tvCCTV_galaxy03 a,.tvCCTV_galaxy05 a{width: 100%;height: 100%;display: inline-block;position: relative;}\n\n/*标题栏*/\n.textTab{clear: both; padding-bottom: 10px;}\n.textTab h3{ float: left;font-size:26px;line-height:46px;font-weight:bold;display: inline-block;}\n.textTab .right { padding-top: 6px;}\n.textTab .right a{float: left;width: 96px;text-align: center;font-size:18px;margin-left:10px;height:30px;line-height:30px;}\n.textTab .right a.cur{ border-radius: 15px;font-weight: bold;box-shadow:0px 0px 10px rgba(51, 51, 51, 0.15);}\n.textTab .jmd{ float: left;margin-left: 20px; margin-top: 11px; display: inline-block; width: 90px; height:24px; text-align: center; background: url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/zbds_jmd.png) no-repeat;background-size: 100% 100%; font-size: 14px; line-height: 24px;vertical-align:top;}\n.textTab .jmd a{color: #0084FF;padding-left:24px; width: 65px; display: inline-block;}\n.textTab .jmd:hover{background: url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/zbds_jmd_hover.png) no-repeat 0 center; }\n.textTab .jmd:hover a{color:#FFFFFF !important;}\n.textTab .sx{ float: left; margin-right:0px;font-size: 14px;height: 20px; margin-top:7px; display: block; cursor: pointer;}\n.textTab .sx i{display: inline-block;width: 20px; height: 20px; background: url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/zbds_sxan.png) no-repeat center center; vertical-align: top;}\n.textTab .sx b{ margin-left:4px; width:70px; height: 18px; line-height: 18px; border-radius: 10px; border: 1px solid #0084ff; text-align: center;color: #0084FF;display: inline-block; font-weight: normal;}\n.textTab .sx:hover b{ background-color: #0084ff; border-radius: 12px; color: #fff;}\n.textTab .sx.hopt i{-webkit-animation:play 0.4s 1;-moz-animation:play 0.4s 1;-ms-animation:play 0.4s 1;-o-animation:play 0.4s 1;animation:play 0.4s 1;}\n@-webkit-keyframes play{0% {-webkit-transform:rotate(0deg);}100% {-webkit-transform:rotate(360deg);}}\n@-moz-keyframes play{0% {-moz-transform:rotate(0deg);}100% {-moz-transform:rotate(360deg);}}\n@-o-keyframes play{0% {-o-transform:rotate(0deg);}100% {-o-transform:rotate(360deg);}}\n@-ms-keyframes play{0% {-ms-transform:rotate(0deg);}100% {-ms-transform:rotate(360deg);}}\n@keyframes play{0% {transform:rotate(0deg);}100% {transform:rotate(360deg);}}\n.textTab .tit_nav{margin-left:25px;height:30px; margin-top:8px;display: inline-block; vertical-align: top;}\n.textTab .tit_nav a{font-size:14px; margin:0 5px;line-height:30px; padding:0px 10px; display: inline-block;}\n.textTab .tit_nav a:hover{background-color: #fff; border-radius:15px;box-shadow: 0 0 8px rgba(51,51,51,.15);}\n\n/*首屏轮播图*/\n\n.tvCCTV_ind01{height: 318px; width: 100%; position: relative;zoom:1;}\n.tvCCTV_ind01 .tvCCTV_galaxySwiper{ display: none; position:absolute; height:100%;top: 0; left: 0; right:0;z-index:9; overflow: hidden; background-color: #0a0b0c;}\n.tvCCTV_ind01 .tvCCTV_galaxySwiper .galaxyImageHref{ width: 100%; height:100%; display: block;}\n.tvCCTV_ind01 .tvCCTV_galaxySwiper .galaxyImageHref img{  margin: 0 auto;width:auto; height:100%;position: absolute; top: 0; left: 50%;margin-left: -720px;}\n.tvCCTV_ind01 .tvCCTV_galaxySwiper .close{ width: 110px; height: 30px;font-size: 14px;line-height: 30px; border-radius: 15px;top: 30px;background-color: rgba(0,0,0,.5); position: absolute; right:50%;z-index: 3;margin-right: -481px;}\n.tvCCTV_ind01 .tvCCTV_galaxySwiper .close i{line-height:14px; margin-top:8px;width: 32px; margin-right: 15px; border-right: 1px solid #49494c; text-align: center; color: #ff3c00; font-family: Arial, Helvetica, sans-serif; display: inline-block; vertical-align: top;}\n.tvCCTV_ind01 .tvCCTV_galaxySwiper .close em{padding-right:20px; background: url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/galaxySwiperClose.png) no-repeat right center; vertical-align: top; color: #fff; cursor: pointer; }\n.tvCCTV_ind01 .tvCCTV_galaxySwiper .close em:hover{ background-image: url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/galaxySwiperCloseHover.png); color: #999999;}\n.tvCCTV_ind01 .tvCCTV_galaxySwiper .tips{left:50%;margin-left: -481px;}\n\n.tvCCTV_ind01 .firstSwiper{width: 100%; height: 100%;}\n.tvCCTV_ind01 .column_wrapper{height:100%;*z-index: 9;}\n.tvCCTV_ind01 .swiper-container{height:100%;width: 100%;overflow:hidden;position: absolute;top: 0; background:#e6e6e6 url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/zwPic269_78.png) no-repeat 40% center;}\n.tvCCTV_ind01 .swiper-wrapper{position: relative; height: 100%; display: none;}\n.tvCCTV_ind01 .swiper-wrapper.cur{display: block;}\n.tvCCTV_ind01 .swiper-wrapper .swiper-slide{display: none;position: relative; height: 100%; margin: 0 auto;} \n.tvCCTV_ind01 .swiper-wrapper .swiper-slide a{display: block; height: 100%;}\n.tvCCTV_ind01 .swiper-wrapper .swiper-slide img{width: auto; height: 100%;margin: 0 auto;}\n.tvCCTV_ind01 .swiper-wrapper .swiper-slide-current{display: block;z-index: 2;}\n.tvCCTV_ind01 .swiper-wrapper .swiper-slide-current .tips{left:50%;margin-left: -481px;}\n\n.tvCCTV_ind01 .swiper-pagination .bullet{display:block;line-height:30px;height:30px; color:#FFFFFF;font-size: 12px;}\n.tvCCTV_ind01 .swiper-pagination .bullet a{color:#FFFFFF; display: inline-block; height: 100%;} \n.tvCCTV_ind01 .swiper-pagination .active a{color:#0084FF; font-weight: bold;}\n\n/*内轮播*/\n.tvCCTV_ind01 .slider{width: 747px;position: absolute;top: 83px;margin-left: -481px;left: 50%;overflow: hidden; z-index: 3;}\n.tvCCTV_ind01 .slider .btn{width: 20px; height: 40px;top:70px;position: absolute;z-index:10; background-repeat: no-repeat; background-position: center center; cursor: pointer;}\n.tvCCTV_ind01 .slider .btnLeft{ background-image:url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/live_left.png); left: 0;}\n.tvCCTV_ind01 .slider .btnRight{background-image:url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/live_right.png); right:15px;}\n.tvCCTV_ind01 .slider .btnLeft:hover{background-image:url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/live_left_hover.png);}\n.tvCCTV_ind01 .slider .btnRight:hover{background-image:url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/live_right_hover.png);}\n.tvCCTV_ind01 .slider .btnLeft.pro,.tvCCTV_ind01 .slider .btnRight.pro{display: none;}\n.tvCCTV_ind01 .slider .livelb_fuceng{height:223px; width: 112px; position: absolute; top: 0; right: 0;z-index: 6;}\n.tvCCTV_ind01 .slider .con{width: 635px; padding-right: 112px;background-color: transparent;mask:linear-gradient(270deg,rgba(0,0,0,0) 0,rgba(0,0,0,.1) 10px,rgba(0,0,0,.8) 56px,#000) right top;-webkit-mask:linear-gradient(270deg,rgba(0,0,0,0) 0,rgba(0,0,0,.1) 10px,rgba(0,0,0,.8) 56px,#000) right top; position: relative; z-index: 5; }\n.tvCCTV_ind01 .slider .con ul{width: 99999px;}\n.tvCCTV_ind01 .slider .con ul li{width: 144px;padding-right: 15px;float: left;}\n.tvCCTV_ind01 .slider .con ul li .image{width:144px; height: 180px; border-radius: 5px; overflow: hidden;}\n.tvCCTV_ind01 .slider .con ul li .title{font-size: 14px; line-height:18px; height:36px;padding-top:7px;color: #FFFFFF; overflow: hidden;}\n.tvCCTV_ind01 .slider .con ul li .title a{color: #FFFFFF;}\n.tvCCTV_ind01 .slider .con ul li .title a:hover{font-weight: bold;color: #fff!important;}\n\n/* logo 搜索 浮层标题*/\n.tvCCTV_ind01 .floatText{padding: 20px 20px 25px 20px; width: 175px; height: 273px;*background-color:#2a405d;background-co