            "text" : "{\"code\":200,\"msg\":\"Success\",\"data\":{\"videoset\":{\"area\":\"\",\"brief\":\"《运动一起赢》节目是中央广播电视总台体育青少节目中心打造的一档电视与新媒体深度融合的节目。节目致力于宣传和推广群众体育赛事，推动全民健身、科学运动，打造总台全民健身赛事大IP。\",\"channelId\":\"cctv5\",\"column_playdate\":\"周一至周五 16:00\",\"director\":\"\",\"fc\":\"体育\",\"format\":0,\"formatControl\":0,\"image\":\"https://p1.img.cctvpic.com/photoAlbum/vms/standard/img/2024/12/23/VSET3KmMgTxbjIgag9YzE8MW241223.jpg?q=75\",\"pisodeCount\":\"\",\"play_time\":\"\",\"sc\":\"综合赛事\",\"sub_title\":\"\",\"tc\":\"\",\"title\":\"《运动一起赢》\",\"videosettype\":\"1\",\"vip_flag\":0,\"vsetid\":\"VSET1ifhip49hkrvpml4agsh4b\",\"year\":\"\"},\"video\":[{\"ad\":1,\"column_id\":\"TOPC1733885609220532\",\"fc\":\"体育\",\"focus_date\":\"1792405052000\",\"guid\":\"66eb9044cfb743e08d5156260fdf2740\",\"id\":\"VIDEUf2lgh92Ahff4Ari7qQu261019\",\"image\":\"https://p4.img.cctvpic.com/photoworkspace/2026/10/19/2026101918210974933.jpg\",\"keywords\":\"运动一起赢,运动健康,体育文化,中国体育,柔力球\",\"length\":\"00:55:00\",\"mode\":0,\"part\":\"1\",\"pid\":\"\",\"sc\":\"其他,田径\",\"templateType\":1,\"title\":\"[运动一起赢]完整版 20261019\",\"type\":\"0\",\"vip_flag\":0,\"vsetid\":\"VSET1ifhip49hkrvpml4agsh4b\"},{\"ad\":1,\"column_id\":\"TOPC1733885609220532\",\"fc\":\"体育\",\"focus_date\":\"1792146208000\",\"guid\":\"61a0d18c3ae04225944039835ea38b73\",\"id\":\"VIDEYCYSH0gOWyX6EWrTr5W9261016\",\"image\":\"https://p2.img.cctvpic.com/fmspic/2026/10/16/61a0d18c3ae04225944039835ea38b73-63949949-1.jpg\",\"keywords\":\"运动一起赢,石竞沛,石竞沄,东北地区城市足球联赛,舞龙舞狮\",\"length\":\"00:49:58\",\"mode\":0,\"part\":\"2\",\"pid\":\"\",\"sc\":\"新闻\",\"templateType\":1,\"title\":\"[运动一起赢]完整版 20261016\",\"type\":\"0\",\"vip_flag\":0,\"vsetid\":\"VSET1ifhip49hkrvpml4agsh4b\"},{\"ad\":1,\"column_id\":\"TOPC1733885609220532\",\"fc\":\"体育\",\"focus_date\":\"1791972925000\",\"guid\":\"4708ad2db1b74dd8bfdae12b139c7692\",\"id\":\"VIDEMwgYZENXzYAOvGcDZINY261014\",\"image\":\"https://p2.img.cctvpic.com/fmspic/2026/10/14/4708ad2db1b74dd8bfdae12b139c7692-63898