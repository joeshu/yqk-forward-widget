nt-size: 12px; background: #272727;color: #cacaca;}\n.footerPC .footer_bd  img{height: 20px;}\n.footerPC .footer_bd a{color: #cacaca;text-decoration: none;}\n.footerPC .footer_bd .footer_bdCon_l{padding-top: 17px;float: left;}\n.footerPC .footer_bd .footer_bdCon_l p{line-height:32px;}\n.footerPC .footer_bd .footer_bdCon_l p img{margin: 0 8px; height: 20px; vertical-align: middle;} \n.footerPC .footer_bd .footer_bdCon_l a:hover{color: #c10714 !important;text-decoration: underline;}\n.footerPC .footer_bd .footer_bdCon_r{float: right;}\n.footerPC .footer_bd .footer_bdCon_r dl{padding:21px 15px 10px 95px;overflow: hidden;}\n.footerPC .footer_bd .footer_bdCon_r dt img{ height: 25px;}\n.footerPC .footer_bd .footer_bdCon_r dt,.footerPC .footer_bd .footer_bdCon_r dd{float: left;}\n.footerPC .footer_bd .footer_bdCon_r dd{width:85px;margin-left:10px;line-height: 17px; text-align: right;}\n.footerPC .footer_bd .footer_bdCon_r dd a:hover{ color: #cacaca !important;}\n.footerPC .footer_bd .footer_bdCon_r dd img{float: left; height: 25px; margin-right: 15px;}\n.footerPC .footer_bd .footer_bdCon_r p{text-align: right;}\n\n\n/*默认分辨率小于1579 大于1280 ，内容宽度1200  备份(min-width: 1280px) and (max-width: 1579px)*/\n@media screen and (min-width: 1350px) and (max-width: 1683px){\n\t.column_wrapper{width: 1200px;}\n\t.column_wrapper .l{width: 812px;}\n\t.column_wrapper .r{width: 388px;}\n\t\n\t.end3{display: block;}\n\n\t/*广告位*/\n\t.galaxyEnd1{display: none;}\n\t.galaxyEnd2{display: none;}\n\t.galaxyEnd3{display: block;border-radius: 5px;}\n\t.galaxyEnd4{display: none;}\n\n\t.tvCCTV_galaxy01{}\n\t.tvCCTV_galaxy02{ padding-top: 9px;}\n\t.tvCCTV_galaxy02 ul{width: 1204px;}\n\t.tvCCTV_galaxy02 ul li{width: 297px; height: 105px;}\n\t.tvCCTV_galaxy02 ul li.piclast{margin-right: 4px;}\n\t.tvCCTV_galaxy02 ul li.piclast1{margin-right: 0;}\n\t.tvCCTV_galaxy02 ul li .text{padding: 31px 20px 27px 0;}\n\t.tvCCTV_galaxy03{ padding-top: 9px;}\n\t/* .tvCCTV_galaxy04{ padding-top: 9px;}\n\t.tvCCTV_galaxy04 ul{width: 1218px;}\n\t.tvCCTV_galaxy04 ul li{width: 185px; height: 105px;} */\n\n\t.tvCCTV_galaxy04 {width:1218px;padding-top:9px;}\n\t.tvCCTV_galaxy04 .mgad__brand .mgad__brand-item{width:185px; height: 105px;}\n\t.tvCCTV_galaxy04 .mgad__brand .mgad__brand-item .mgad__brand-wrap .mgad__brand-mini{width: 185px;}\n\t.tvCCTV_galaxy04 .mgad__brand .mgad__brand-item .mgad__brand-wrap .mgad__brand-big {width: 591px;}\n\t.tvCCTV_galaxy04 .mgad__brand .mgad__brand-item .mgad__brand-demo{width:185px;height: 105px;}\n\t.tvCCTV_galaxy04 .mgad__brand .mgad__brand-item.end3{display: inline-block;}\n\n\t/*标题栏*/\n\t.textTab .left h3{font-size:28px;line-height:48px;}\n\t.textTab .jmd{ margin-top: 12px;}\n\t.textTab .sx{margin-top:8px;}\n\t.textTab .tit_nav{margin-left:21px;margin-top:9px;}\n\t.textTab .tit_nav a{font-size:14px; margin:0 5px;line-height:30px; padding:0px 10px;}\n\t.textTab .tit_nav a:hover{background-color: #fff; border-radius:15px;}\n\n\t/* 首屏轮播图 */\n\t.tvCCTV_ind01 {height: 397px;}\n\t.tvCCTV_ind01 .tvCCTV_galaxySwiper .galaxyImageHref img{margin-left: -899px;}\n\t.tvCCTV_ind01 .tvCCTV_galaxySwiper .close{margin-right: -600px;}\n\t.tvCCTV_ind01 .tvCCTV_galaxySwiper .tips{margin-left: -600px;}\n\t.tvCCTV_ind01 .firstSearch{left: 385px;}\n\t.tvCCTV_ind01 .floatText{width: 200px; height: 356px; right:-1px; padding: 20px 27px 21px 27px;}\n\t.tvCCTV_ind01 .floatText .liveon{font-size: 20px; line-height: 60px; padding-left: 28px; background: url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/icon-hot_1200.png) no-repeat left center;}\n\t.tvCCTV_ind01 .floatText .liveon.cur{background-image: url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/icon-hot_hover_1200.png);}\n\t.tvCCTV_ind01 .floatText .livetj{font-size: 20px;line-height: 54px; margin-top: 3px;padding-left: 28px; background: url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/icon-jingxuan_1200.png) no-repeat left center;}\n\t.tvCCTV_ind01 .floatText .livetj.cur{background-image: url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/icon-jingxuan_hover_1200.png);}\n\t.tvCCTV_ind01 .swiper-pagination .bullet{line-height:40px;height:40px;font-size: 14px;}\n\t.tvCCTV_ind01 .swiper-wrapper .swiper-slide-current .tips{margin-left: -600px;}\n\n\t.tvCCTV_ind01 .slider{width: 946px;top: 97px;margin-left: -600px;}\n\t.tvCCTV_ind01 .slider .btn{width: 26px; height: 52px;top:91px; }\n\t.tvCCTV_ind01 .slider .btnLeft{background-image:url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/live_left_1200.png);}\n\t.tvCCTV_ind01 .slider .btnRight{ background-image: url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/live_right_1200.png);}\n\t.tvCCTV_ind01 .slider .btnLeft:hover{background-image: url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/live_left_hover_1200.png);}\n\t.tvCCTV_ind01 .slider .btnRight:hover{background-image: url(//p3.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717//live_right_hover_1200.png);}\n\t.tvCCTV_ind01 .slider .livelb_fuceng{height: 280px; width: 138px;}\n\t.tvCCTV_ind01 .slider .con{width: 808px; padding-right: 138px;}\n\t.tvCCTV_ind01 .slider .con ul li{width: 187px;}\n\t.tvCCTV_ind01 .slider .con ul li .image{width:187px;height: 234px;}\n\t.tvCCTV_ind01 .slider .con ul li .title{font-size: 16px; line-height:20px;  padding-top:6px;height:40px;}\n\t\n\n\t/* 导航 */\n\t.tvCCTV_ind02 .end3{display: block;}\n\t.tvCCTV_ind02 .line{height: 75px;width: 1px;margin-top: 37px;background: #c5c5c5;float: left;}\n\t.tvCCTV_ind02 .line2{display: block;height: 75px;width: 1px;margin-top: 37px;background: #c5c5c5;float: left;}\n\t/* 第一个nav */\n\t.tvCCTV_ind02 {height: 138px; padding-bottom: 11px;}\n\t.tvCCTV_ind02 .naviga1{width:748px;padding: 32px 0 0 0px;}\n\t.tvCCTV_ind02 .naviga1 li{float: left;}\n\t.tvCCTV_ind02 .naviga1 .navt{padding: 0 18px;margin-bottom: 20px;}\n\t.tvCCTV_ind02 .naviga1 .navt a{display: inline-block;