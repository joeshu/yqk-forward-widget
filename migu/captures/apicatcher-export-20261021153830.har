ce-visibility: hidden;z-index: 1;-webkit-transition: transform 1.0s;-moz-transition: transform 1.0s;-ms-transition: transform 1.0s;-o-transition: transform 1.0s;transition: transform 1.0s;-webkit-transform: scale(0.75);-moz-transform: scale(0.75);transform: scale(0.75);border-radius: .1rem;overflow: hidden;width: 1.92rem;height: 1.92rem;}\r\n.xuqiu19629_con09 .swiper-wrapper .swiper-slide .img{box-shadow: 0 0 0.14rem rgba(0, 0, 0, 0.15);}\r\n.xuqiu19629_con09 .swiper-wrapper .swiper-slide .img img{border-radius: .1rem;display: block;}\r\n.xuqiu19629_con09 .swiper-wrapper .swiper-slide.swiper-slide-active{-webkit-transform: scale(1);-moz-transform: scale(1);transform: scale(1);box-shadow: 0 0 .1rem rgba(34, 34, 34, 0.6);}\r\n.xuqiu19629_con09 .swiper-wrapper .swiper-slide .text{display: none;}\r\n.xuqiu19629_con09 .swiper-wrapper .swiper-slide.swiper-slide-active .text{display: block;}\r\n.xuqiu19629_con09 .text{margin-top: .3rem;margin-bottom: .38rem;}\r\n.xuqiu19629_con09 .text li{text-align: center;font-size: .28rem;line-height: .4rem;color: #ffffff;display:none;}\r\n.xuqiu19629_con09 .text li a{color: #ffffff;}\r\n\r\n\r\n/*加载更多*/\r\n.loading {text-align: center;font-size: 0;margin: 0 .24rem;box-sizing: border-box;margin-bottom: .3rem;}\r\n.loading .loadingmore p {float: left;display:block;font-size:0.28rem;color:#666666; padding-left: 0.12rem;}\r\n.loading .loadingmore i {background:url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1628562061688972/icon_loading.png) no-repeat; background-size:100% 100%; background-position: center center;width:0.28rem;height: 0.28rem; display:block;float: left; -webkit-animation: rotating 1.2s linear infinite;-moz-animation: rotating 1.2s linear infinite;-o-animation: rotating 1.2s linear infinite;animation: rotating 1.2s linear infinite;}\r\n.btop {border-top:0.18rem solid #E3E8F2;}\r\n.loading .loadingmore {height:.8rem;text-align: center;display:inline-block;overflow: hidden;margin: 0 auto;font-size: 0;align-items: center;display: -webkit-flex;    justify-content: center;display: -webkit-flex;width: 100%;background: #FFFFFF;border-radius: .05rem;}\r\n@keyframes rotating {\r\n\tfrom { -webkit-transform:rotate(0deg) translateZ(0); }\r\n\tto { -webkit-transform:rotate(360deg) translateZ(0); }\r\n}\r\n\r\n\r\n\r\n/*栏目检索*/\r\n.lanmujiansuo19629_ind04{padding: 0 0.24rem;background: #FFFFFF;}\r\n.lanmujiansuo19629_ind04 .top{position:relative;width:100%;height: 0.48rem;overflow:hidden;padding:0.33rem 0;background:url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1628562061688972/icon_jiemu_xq19629.png) no-repeat left center;background-size:4.24rem 0.5rem;}\r\n.lanmujiansuo19629_ind04 .top a{position:absolute;right:0;top:0.34rem;color:#e60012;font-size:0.3rem;height: .42rem;line-height: .42rem;}\r\n.lanmujiansuo19629_ind04 .md_hd{ padding: 0.36rem 0 0.36rem 0.2rem;}\r\n.lanmujiansuo19629_ind04 .md_hd .mh_title{float: left;font-size: 0.48rem;line-height: 0.48rem;color: #333333; font-weight: bold;overflow: hidden;}\r\n.lanmujiansuo19629_ind04 .md_hd .mh_title i{ float: left;}\r\n.lanmujiansuo19629_ind04 .md_hd .mh_title i.borderline{margin-right: 0.2rem;border-left: 0.1rem solid #E42626;height: 0.48rem;line-height: 0.48rem; display: inline-block;float: left;}\r\n.lanmujiansuo19629_ind04 .md_hd:after{ content: \"\";display: block;height: 0;clear: both;visibility: hidden;}\r\n.lanmujiansuo19629_ind04 .md_hd .mh_option{float: right; font-size: 0.3rem; color: #e60012;}\r\n.lanmujiansuo19629_ind04 .md_hd .mh_option a{ font-size: 0.3rem; color: #e60012;line-height: 0.48rem;}\r\n.lanmujiansuo19629_ind04 .demo01_0708{margin-bottom: 0.24rem}\r\n.lanmujiansuo19629_ind04 .demo01_0708 li{float: left;width:16.66%;background-color:#FDF3F2;text-align: center;font-size:0.2rem;line-height:0.3rem;color:#333333;border-right:2px solid #fff;border-bottom:2px solid #fff;box-sizing:border-box;-webkit-box-sizing:border-box;\r\npadding: 0.16rem 0;border-radius:5px;-webkit-border-radius:5px;height: .9rem;}\r\n.l