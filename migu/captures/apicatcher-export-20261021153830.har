\":0,\"pcFetchCount\":0,\"rankId\":0,\"rightItem\":[],\"showNumber\":18,\"skipCount\":0,\"specialTitle\":\"\",\"specialTitleHeight\":0,\"specialTitleWidth\":0,\"tag\":\"\",\"templateType\":202,\"title\":\"直播\",\"titleBackground\":\"\",\"titleBackgroundHeight\":0,\"titleBackgroundWidth\":0,\"titleType\":2},{\"advertisementKey\":\"tuijianshouyemokuai3\",\"advertisementType\":\"\",\"autoOnlineChannel\":0,\"background\":\"\",\"backgroundColor\":\"\",\"backgroundHeight\":0,\"backgroundWidth\":0,\"borderColor\":\"\",\"brief\":\"\",\"buttons\":[],\"channelLocation\":0,\"displayMode\":\"\",\"fetchCount\":0,\"foreground_color\":\"\",\"h5High\":0,\"h5Url\":\"\",\"h5Width\":0,\"hasBackground\":0,\"hasImgmarkLt\":0,\"hasSpecialTitle\":0,\"id\":0,\"imgmarkLtBgColor\":\"\",\"imgmarkLtColor\":\"\",\"isAdvertisement\":1,\"isButtons\":0,\"isMerge\":0,\"isShowLocalChannel\":0,\"isTitleKeyWord\":0,\"is_media_account\":0,\"items\":[],\"leagueId\":\"\",\"loadUrlWidth\":0,\"magicCubeStyle\":\"\",\"media_account_id\":\"\",\"moreBtnLoadUrl\":\"\",\"original\":0,\"pcFetchCount\":0,\"rankId\":0,\"rightItem\":[],\"showNumber\":0,\"skipCount\":0,\"specialTitle\":\"\",\"specialTitleHeight\":0,\"specialTitleWidth\":0,\"tag\":\"\",\"templateType\":223,\"title\":\"\",\"titleBackground\":\"\",\"titleBackgroundHeight\":0,\"titleBackgroundWidth\":0,\"titleType\":0},{\"advertisementKey\":\"\",\"advertisementType\":\"\",\"autoOnlineChannel\":0,\"background\":\"\",\"backgroundColor\":\"\",\"backgroundHeight\":0,\"backgroundWidth\":0,\"borderColor\":\"\",\"brief\":\"\",\"buttons\":[],\"channelLocation\":0,\"displayMode\":\"0x0\",\"extH5High\":0,\"extH5Width\":0,\"fetchCount\":7,\"foreground_color\":\"\",\"h5High\":0,\"h5Url\":\"\",\"h5Width\":0,\"hasBackground\":0,\"hasCopyright\":0,\"hasImgmarkLt\":0,\"hasSpecialTitle\":0,\"id\":15620,\"imgmarkLtBgColor\":\"\",\"imgmarkLtColor\":\"\",\"isAdvertisement\":1,\"isButtons\":0,\"isMerge\":0,\"isShowLocalChannel\":0,\"isTitleKeyWord\":0,\"is_media_account\":0,\"items\":[{\"adid\":\"\",\"brief\":\"紧紧围绕“弘扬伟大长征精神、走好新时代的长征路”主题，回顾呈现中国共产党领导红军进行伟大长征的光辉历程，全面反映胜利完成震撼世界、彪炳史册的长征的伟大意义，集中展示人民军队听党指挥的赤胆忠诚和一往无前的英雄气概，生动展现新时代新征程万众一心推进强国强军事业的壮阔图景。\",\"cornerColour\":\"\",\"cornerStr\":\"\",\"cornerStrRb\":\"\",\"endTime\":0,\"epgChnlChar\":\"\",\"epgDarkDiamondPic\":\"\",\"epgDarkHorizontalPic\":\"\",\"epgDiamondPic\":\"\",\"epgHorizontalPic\":\"\",\"epgId\":0,\"epgName\":\"\",\"epgType\":\"\",\"fc\":\"\",\"homologous\":0,\"hoverText\":\"\",\"img1\":\"https://p3.img.cctvpic.com/photoAlbum/vms/standard/img/2026/10/15/VSETljuxUPmnwP6kjCxepsLy261015.jpg?q=75\",\"img2\":\"\",\"img3\":\"\",\"imgRGB\":\"#856553\",\"isTop\":0,\"is_media_account\":0,\"itemId\":\"VSET1k4vk44vv5bp16kk46n7ha\",\"itemUrl\":\"\",\"jumpUrl\":\"cntvcbox%3A%2F%2Fapp.cntv.cn%2FvideoSet%3Fplayid%3D%26itemId%3DVSET1k4vk44vv5bp16kk46n7ha%26title%3D%25E3%2580%258A%25E4%25BC%259F%25E5%25A4%25A7%25E8%25BF%259C%25E5%25BE%2581%25E3%2580%258B%26vipFlag%3D0\",\"media_account_id\":\"\",\"mid\":\"\",\"playid\":\"\",\"price\":\"\",\"recordNumber\":0,\"sc\":\"\",\"showStyle\":\"0\",\"skinColor\":\"\",\"source\":\"伟大远征\",\"startTime\":0,\"subTitle\":\"\",\"timeLineDate\":0,\"title\":\"《伟大远征》\",\"trackId\":2581393,\"videoLength\":\"\",\"videoSetId\":\"\",\"vip_flag\":0,\"vsetType\":\"\",\"vtype\":\"2\"},{\"adid\":\"\",\"brief\":\"长征，是中国共产党和红军谱写的壮丽史诗。漫漫征途，红军将士在极端艰难的环境与艰苦卓绝的战斗中，始终坚定理想信念、斗志昂扬。长征这一人类历史上的伟大壮举，留给我们最可宝贵的精神财富，就是中国共产党人和红军将士用生命和热血铸就的伟大长征精神。\",\"cornerColour\":\"\",\"cornerStr\":\"\",\"cornerStrRb\":\"\",\"endTime\":0,\"epgChnlChar\":\"\",\"epgDarkDiamondPic\":\"\",\"epgDarkHorizontalPic\":\"\",\"epgDiamondPic\":\"\",\"epgHorizontalPic\":\"\",\"epgId\":0,\"epgName\":\"\",\"epgType\":\"\",\"fc\":\"\",\"homologous\":0,\"hoverText\":\"\",\"img1\":\"https://p1.img.cctvpic.com/photoAlbum/vms/image/32db2db121fcaa531dba2d0d7a85d875.jpg?q=75\",\"img2\":\"\",\"img3\":\"\",\"imgRGB\":\"#856553\",\"isTop\":0,\"is_media_account\":0,\"itemId\":\"VSET1k57a9mm23tbv05b6qim65\",\"itemUrl\":\"\",\"jumpUrl\":\"cntvcbox%3A%2F%2Fapp.cntv.cn%2FvideoSet%3Fplayid%3D%26itemId%3DVSET1k57a9mm23tbv05b6qim65%26title%3D%25E3%2580%258A%25E6%2596%25B0%25E7%259A%2584%25E9%2595%25BF%25E5%25BE%2581%25E4%25B9%258B%25E8%25B7%25AF%25E3%2580%258B%26vipFlag%3D0\",\"media_account_id\":\"\",\"mid\":\"\",\"playid\":\"\",\"price\":\"\",\"recordNumber\":0,\"sc\":\"\",\"showStyle\":\"0\",\"skinColor\":\"\",\"source\":\"长征精神\",\"startTime\":0,\"subTitle\":\"\",\"timeLineDate\":0,\"title\":\"《新的长征之路》\",\"trackId\":2581392,\"videoLength\":\"\",\"videoSetId\":\"\",\"vip_flag\":0,\"vsetType\":\"\",\"vtype\":\"2\"},{\"adid\":\"\",\"brief\":\"节目以\\\"赓续长征精神、奋进复兴征程\\\"为主题，通过直播连线、实地探访等形式展现新时代发展成就。\",\"cornerColour\":\"\",\"cornerStr\":\"\",\"cornerStrRb\":\"\",\"endTime\":0,\"epgChnlChar\":\"\",\"epgDarkDiamondPic\":\"\",\"epgDarkHorizontalPic\":\"\",\"epgDiamondPic\":\"\",\"epgHorizontalPic\":\"\",\"epgId\":0,\"epgName\":\"\",\"epgType\":\"\",\"fc\":\"\",\"homologous\":0,\"hoverText\":\"\",\"img1\":\"https://p2.img.cctvpic.com/photoAlbum/vms/standard/img/2026/9/9/VSETfeM9bxdjNodzcAvD0erd260909.jpg?q=75\",\"img2\":\"\",\"img3\":\"\",\"imgRGB\":\"#856553\",\"isTop\":0,\"is_media_account\":0,\"itemId\":\"VSET1k222v1apfn8mlrklcfk58\",\"itemUrl\":\"\",\"jumpUrl\":\"cntvcbox%3A%2F%2Fapp.cntv.cn%2FvideoSet%3Fplayid%3D%26itemId%3DVSET1k222v1apfn8mlrklcfk58%26title%3D%25E3%2580%258A%25E6%25B1%259F%25E5%25B1%25B1%25E4%25B8%2587%25E9%2587%258C%25E6%2596%25B0%25E9%2595%25BF%25E5%25BE%2581%25E3%2580%258B%26vipFlag%3D0\",\"media_account_id\":\"\",\"mid\":\"\",\"playid\":\"\",\"price\":\"\",\"recordNumber\":0,\"sc\":\"\",\"showStyle\":\"0\",\"skinColor\":\"\",\"source\":\"江山万里新长征\",\"startTime\":0,\"subTitle\":\"\",\"timeLineDate\":0,\"title\":\"《江山万里新长征》\",\"trackId\":2581389,\"videoLength\":\"\",\"videoSetId\":\"\",\"vip_flag\":0,\"vsetType\":\"\",\"vtype\":\"2\"},{\"adid\":\"\",\"brief\":\"以纪念红军长征胜利 90 周年为主题，通过文化学者重走长征路并结合诗词解读，展现长征历史与精神。‌‌\",\"cornerColour\":\"\",\"cornerStr\":\"\",\"cornerStrRb\":\"\",\"endTime\":0,\"epgChnlChar\":\"\",\"epgDarkDiamondPic\":\"\",\"epgDarkHorizontalPic\":\"\",\"epgDiamondPic\":\"\",\"epgHorizontalPic\":\"\",\"epgId\":0,\"epgName\":\"\",\"epgType\":\"\",\"fc\":\"\",\"homologous\":0,\"hoverText\":\"\",\"img1\":\"https://p1.img.cctvpic.com/photoAlbum/vms/standard/img/2026/9/29/VSET2GuCnqEStMKIoaC66Orb260929.jpg?q=75\",\"img2\":\"\",\"img3\":\"\",\"imgRGB\":\"#856553\",\"isTop\":0,\"is_media_account\":0,\"itemId\":\"VSET1k3li17vrv5gmvgupgoh17\",\"itemUrl\":\"\",\"jumpUrl\":\"cntvcbox%3A%2F%2Fapp.cntv.cn%2FvideoSet%3Fplayid%3D%26itemId%3DVSET1k3li17vrv5gmvgupgoh17%26title%3D%25E3%2580%258A%25E8%25AF%2597%25E8%25A1%258C%25E4%25B8%2587%25E9%2587%258C%25E9%2595%25BF%25E5%25BE%2581%25E8%25B7%25AF%25E3%2580%258B%26vipFlag%3D0\",\"media_account_id\":\"\",\"mid\":\"\",\"playid\":\"\",\"price\":\"\",\"recordNumber\":0,\"sc\":\"\",\"showStyle\":\"0\",\"skinColor\":\"\",\"source\":\"诗行万里长征路\",\"startTime\":0,\"subTitle\":\"\",\"timeLineDate\":0,\"title\":\"《诗行万里长征路》\",\"trackId\":2581388,\"videoLength\":\"\",\"videoSetId\":\"\",\"vip_flag\":0,\"vsetType\":\"\",\"vtype\":\"2\"},{\"adid\":\"\",\"brief\":\"用当代的艺术语言和传播方式，让长征精神跨越代际，在新时代重新“活”起来，并转化为走好今天长征路的精神动力‌。\",\"cornerColour\":\"\",\"cornerStr\":\"\",\"cornerStrRb\":\"\",\"endTime\":0,\"epgChnlChar\":\"\",\"epgDarkDiamondPic\":\"\",\"epgDarkHorizontalPic\":\"\",\"epgDiamondPic\":\"\",\"epgHorizontalPic\":\"\",\"epgId\":0,\"epgName\":\"\",\"epgType\":\"\",\"fc\":\"\",\"homologous\":0,\"hoverText\":\"\",\"img1\":\"https://p3.img.cctvpic.com/photoAlbum/vms/standard/img/2026/10/8/VSETs147ubz4MOTL6l9pNB7k261008.jpg?q=75\",\"img2\":\"\",\"img3\":\"\",\"imgRGB\":\"#856553\",\"isTop\":0,\"is_media_account\":0,\"itemId\":\"VSET1k4cn83357vrpbfnpr3qq7\",\"itemUrl\":\"\",\"jumpUrl\":\"cntvcbox%3A%2F%2Fapp.cntv.cn%2FvideoSet%3Fplayid%3D%26itemId%3DVSET1k4cn83357vrpbfnpr3qq7%26title%3D%25E3%2580%258A%25E9%2595%25BF%25E5%25BE%2581%25E6%2596%25B0%25E5%2594%25B1%25E3%2580%258B%26vipFlag%3D0\",\"media_account_id\":\"\",\"mid\":\"\",\"playid\":\"\",\"price\":\"\",\"recordNumber\":0,\"sc\":\"\",\"showStyle\":\"0\",\"skinColor\":\"\",\"source\":\"长征新唱\",\"startTime\":0,\"subTitle\":\"\",\"timeLineDate\":0,\"title\":\"《长征新唱》\",\"trackId\":2581387,\"videoLength\":\"\",\"videoSetId\":\"\",\"vip_flag\":0,\"vsetType\":\"\",\"vtype\":\"2\"},{\"adid\":\"\",\"brief\":\"本片以长征沿途博物馆“镇馆之宝”为切入口，通过重回历史现场，将文物背后鲜为人知的故事和近年来学界对长征研究的新史料、新成果相结合，构建一部弘扬长征精神的有血肉、有筋骨、有灵魂的影像历史。\",\"cornerColour\":\"\",\"cornerStr\":\"\",\"cornerStrRb\":\"\",\"endTime\":0,\"epgChnlChar\":\"\",\"epgDarkDiamondPic\":\"\",\"epgDarkHorizontalPic\":\"\",\"epgDiamondPic\":\"\",\"epgHorizontalPic\":\"\",\"epgId\":0,\"epgName\":\"\",\"epgType\":\"\",\"fc\":\"\",\"homologous\":0,\"hoverText\":\"\",\"img1\":\"https://p1.img.cctvpic.com/photoAlbum/vms/image/b93926d27ef0bfcaf73e7a6ab5db2a97.jpg?q=75\",\"img2\":\"\",\"img3\":\"\",\"imgRGB\":\"#856553\",\"isTop\":0,\"is_media_account\":0,\"itemId\":\"VSET1k4niaurrhlee874a6gh65\",\"itemUrl\":\"\",\"jumpUrl\":\"cntvcbox%3A%2F%2Fapp.cntv.cn%2FvideoSet%3Fplayid%3D%26itemId%3DVSET1k4niaurrhlee874a6gh65%26title%3D%25E3%2580%258A%25E6%2598%259F%25E7%2581%25AB%25E5%258D%25B0%25E8%25AE%25B0%25E2%2580%2594%25E2%2580%2594%25E6%2596%2587%25E7%2589%25A9%25E9%2587%258C%25E7%259A%2584%25E9%2595%25BF%25E5%25BE%2581%25E6%2595%2585%25E4%25BA%258B%25E3%2580%258B%26vipFlag%3D0\",\"media_account_id\":\"\",\"mid\":\"\",\"playid\":\"\",\"price\":\"\",\"recordNumber\":0,\"sc\":\"\",\"showStyle\":\"\",\"skinColor\":\"\",\"source\":\"长征故事\",\"startTime\":0,\"subTitle\":\"\",\"timeLineDate\":0,\"title\":\"《星火印记——文物里的长征故事》\",\"trackId\":2581391,\"videoLength\":\"\",\"videoSetId\":\"\",\"vip_flag\":0,\"vsetType\":\"\",\"vtype\":\"2\"},{\"adid\":\"\",\"brief\":\"该片共六集，围绕纪念中国工农红军长征胜利90周年重要时间节点，深入挖掘中国人民大学、哈尔滨工业大学、兰州大学、西安电子科技大学、中国医科大学、江西理工大学六所高校的校史精髓，讲述长征精神融入高等教育血脉，持续滋养青年成长的鲜活故事。\",\"cornerColour\":\"\",\"cornerStr\":\"\",\"cornerStrRb\":\"\",\"endTime\":0,\"epgChnlChar\":\"\",\"epgDarkDiamondPic\":\"\",\"epgDarkHorizonta