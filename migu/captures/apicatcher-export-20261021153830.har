            "text" : "         <!DOCTYPE html>\r\n<html>\r\n<head><script>(function () { var exp = new Date(); exp.setTime(exp.getTime() + 600000); document.cookie = \"HMY_JC=5b824321e1fc991eefd382847a8f89623060b8bb86aeca12a621b6eb2940ac5f38,\"+\"; expires=\"+exp.toGMTString()+\"; path=/\"; })()</script>\r\n\t<meta http-equiv=\"Content-Type\" content=\"text/html; charset=utf-8\" />\r\n\t<title>CCTV节目官网_央视网</title>\r\n\t<meta name=\"filetype\" content=\"0\">\r\n\t<meta name=\"publishedtype\" content=\"1\">\r\n\t<meta name=\"pagetype\" content=\"2\">\r\n\t<meta name=\"format-detection\" content=\"telephone=no\">\r\n\t<meta name=\"catalogs\" content=\"PAGEdNvWY0LYxCPWjyNDAVa2210805\">\r\n\t<meta name=keywords content=\"CCTV官网 央视网 中央电视台 央视官网 央视节目 央视直播 央视节目单 央视主持人\">\r\n\t<meta name=description content=\"CCTV节目官网是中央电视台电视节目官方呈现平台，提供央视24个频道的直播、点播、节目预告等服务，集纳央视所有栏目、电影、电视剧、纪录片、动画片、体育赛事、特别节目资源，提供节目搜索、检索、订阅、点赞、分享、收藏等多种功能，用户覆盖210多个国家和地区，是网民了解央视、收看央视、参与央视的最佳渠道。\">\r\n\t<meta property=\"og:title\" content=\"CCTV节目官网_央视网\" />\r\n\t<meta property=\"og:image\" content=\"//p4.img.cctvpic.com/photoAlbum/page/performance/img/2021/9/28/1632795780652_242.jpg\" />\r\n\t<meta property=\"og:description\" content=\"CCTV节目官网是中央电视台电视节目官方呈现平台，提供央视24个频道的直播、点播、节目预告等服务，集纳央视所有栏目、电影、电视剧、纪录片、动画片、体育赛事、特别节目资源，提供节目搜索、检索、订阅、点赞、分享、收藏等多种功能，用户覆盖210多个国家和地区，是网民了解央视、收看央视、参与央视的最佳渠道。\" />\r\n\t<meta name=\"apple-mobile-web-app-title\" content=\"CCTV节目官网_央视网\">\r\n\t<meta name=\"spm-id\" content=\"C28340\">\r\n\t<link rel=\"apple-touch-icon-precomposed\" href=\"//p4.img.cctvpic.com/photoAlbum/page/performance/img/2021/9/28/1632795780652_242.jpg\" />\r\n\t<script type=\"text/javascript\" src=\"//r.img.cctvpic.com/photoAlbum/templet/js/jquery-1.7.2.min.js\"></script>\r\n\t<link rel=\"stylesheet\" href=\"//r.img.cctvpic.com/photoAlbum/templet/common/DEPA1628231077516717/style_shouye_new.css\">\r\n\t<script type=\"text/javascript\" src=\"//r.img.cctvpic.com/library/script/jquery-1.7.2.min.js\"></script>\r\n\t<script t