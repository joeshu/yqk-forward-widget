          "status" : 200,
          "content" : {
            "size" : 44205,
            "text" : "html{margin:0;padding:0;font-size: 100%;}\r\nhtml, body, form, p, div, h1, h2, h3, h4, h5, h6{-webkit-text-size-adjust:none;-moz-text-size-adjust:none;-o-text-size-adjust:none;}\r\nbody{margin:0;padding:0; width:100%;font-size:15px;font-family:'PingFang SC','PingFang TC','Microsoft YaHei',\"STHeiti\",arial,helvetica,sans-serif;font-weight:normal;\r\n/*-webkit-user-select: none;\r\n-moz-user-select: none;\r\n-ms-user-select: none;\r\nuser-select: none; */\r\n}\r\nul,li,h1,h2,h3,h4,h5,h6,p{padding:0;margin:0; list-style:none;font-weight:normal;}\r\na{ text-decoration:none;outline:none;}\r\na img,img{border:0;}\r\n/*a:link,a:active,a:visited,a:hover,label:link,label:active,label:visited,label:hover{\r\n\tbackground:none;\r\n\t-webkit-tap-highlight-color:rgba(0,0,0,0);\r\n\t-webkit-tap-highlight-color:transparent;\r\n}*/\r\ni{font-style: normal;}\r\nimg{display: block;width: 100%;}\r\nbody{background-color: #f9f9f9;}\r\ninput,textarea{font-family:'PingFang SC','PingFang TC','Microsoft YaHei',\"STHeiti\",arial,helvetica,sans-serif;font-weight:normal;-webkit-appearance: none;outline:none;}\r\ntextarea{box-sizing: border-box;}\r\n.page_wrap{ width:100%;margin:0 auto;position: relative;min-width: 320px;max-width:750px;overflow: hidden;z-index: 2;}\r\n.clear{clear:both;height:0px;content: '';}\r\n.vertical-container{display: -webkit-box;display: -moz-box;display: -ms-flexbox;display: -o-box;display: box;-webkit-box-orient: horizontal;-moz-box-orient: horizontal;-ms-flex-direction: row;-o-box-orient: horizontal;box-orient: horizontal;-webkit-box-pack: start;-moz-box-pack: start;-ms-flex-pack: start;-o-box-pack: start;box-pack: start;-webkit-box-align: center;-moz-box-align: center;-ms-flex-align: center;-o-box-align: center;box-align: center;}\r\n\r\n/*顶通颜色背景*/\r\n.header_bg{position: absolute;left: 0; top: 0;background:linear-gradient(#281B15,transparent);height: 5.14rem;width: 100%;}\r\n\r\n/*//顶通*/\r\n.headerSearch_ind01{height: .97rem;box-sizing: border-box;padding-top: 0.25rem;display: box;display: -webkit-box;box-orient: horizontal;-webkit-box-orient: horizontal;}\r\n.headerSearch_ind01 .home{display:block;background: url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1628562061688972/logo.png)no-repeat top left;background-size: 0.96rem 0.5rem;width: 0.96rem; height: 0.5rem;margin: 0 .46rem 0 0.24rem;}\r\n.headerSearch_ind01 .geren{width: 0.45rem;height: 0.48rem;background: url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1628562061688972/xuqiu19629_user.png)no-repeat;background-size: 0.45rem 0.48rem;margin-right:0.4rem;display:block;margin-top: .01rem;}\r\n.headerSearch_ind01 .nav{width: 0.44rem;height: 0.39rem;background: url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1628562061688972/xuqiu19629_menu.png)no-repeat top center;background-size: 0.44rem 0.39rem;display:block;margin-top: .06rem;margin-right: .26rem;}\r\n.headerSearch_ind01 .input{box-flex: 1;-webkit-box-flex: 1;box-sizing: border-box;position: relative;/*width:48%;*/height:0.48rem;margin-right:0.49rem;margin-top: .01rem;overflow: hidden;}\r\n.headerSearch_ind01 .input form{width:100%;height:0.48rem;border-radius:1.2rem;background:rgba(255, 255, 255, 0.3);box-sizing:border-box;font-size: 0.3rem;color:#FFFFFF;font-style:normal;outline:none;padding:0 0.2rem 0 0.2rem;border: none;overflow: hidden;}\r\n.headerSearch_ind01 .hsearch {background-image: url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1628562061688972/search.png);background-size: .33rem .33rem; width: 0.33rem;height: 0.33rem;position: absolute;right: 0.2rem;top: .09rem;z-index: 555;}\r\n.headerSearch_ind01 .box { position: absolute;left: 0; top: 50%;color: #fff;padding-left: .3rem;margin-top: -0.23rem;width: 100%;overflow: hidden;box-sizing: border-box; height: 0.48rem;line-height: 0.48rem;}\r\n.headerSearch_ind01 .input form ul{position: absolute;left: 0; top: 0;padding-left: .2rem; color: #FFFFFF;}\r\n.headerSearch_ind01 .input form ul li{padding: 0.03rem 0 0.05rem 0; height: 0.50rem;line-height: 0.40rem;font-size: 0.3rem;}\r\n.header_nav.fixednav {position: fixed; top: 0;left: 0;right: 0; z-index: 800; max-width: 750px; width: 100%;margin: 0 auto;box-sizing: border-box;background: #ffffff;}\r\n\r\n\r\n.header_nav.fixednav .headerSearch_ind01 .home{display:block;background: url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1628562061688972/logo_cur.png)no-repeat top left;background-size: 0.96rem 0.5rem;width: 0.96rem; height: 0.5rem;margin: 0 .46rem 0 0.24rem;}\r\n.header_nav.fixednav .headerSearch_ind01 .geren{width: 0.45rem;height: 0.48rem;background: url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1628562061688972/xuqiu19629_user_cur.png)no-repeat;background-size: 0.45rem 0.48rem;margin-right:0.4rem;display:block;margin-top: .01rem;}\r\n.header_nav.fixednav .headerSearch_ind01 .nav{width: 0.44rem;height: 0.39rem;background: url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1628562061688972/xuqiu19629_menu_cur.png)no-repeat top center;background-size: 0.44rem 0.39rem;display:block;margin-top: .06rem;margin-right: .26rem;}\r\n.header_nav.fixednav .headerSearch_ind01 .input form{width:100%;height:0.48rem;border-radius:1.2rem;background:rgba(228, 228, 228,1);box-sizing:border-box;font-size: 0.3rem;color:#FFFFFF;font-style:normal;outline:none;padding:0 0.2rem 0 0.2rem;border: none;}\r\n.header_nav.fixednav .headerSearch_ind01 .hsearch {background-image: url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1628562061688972/search_cur.png);background-size: .33rem .33rem; width: 0.33rem;height: 0.33rem;position: absolute;right: 0.2rem;top: .09rem;z-index: 555;}\r\n.header_nav.fixednav .headerSearch_ind01 .input form ul{position: absolute;left: 0; top: 0;padding-left: .2rem; color: #333333;}\r\n.header_nav.fixednav .rowScronav_ind02 .one ul.onelist li{color: #333333;}\r\n.header_nav.fixednav .rowScronav_ind02 .one ul.onelist li a{color: #333333;}\r\n.header_vspace{height: 2.21rem;display: none;}\r\n/*通栏广告*/\r\n.tonglan_guanggao{background: url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1628562061688972/shadow.png);position: fixed;width: 100%;height: 100%;z-index: 999;left: 0;top: 0;/* max-width: 750px;min-width: 320px; */display: none;}\r\n.tonglan_guanggao .boxs{position: relative;display: inline-block;width:5.5rem;/* 45% */position: fixed;left: 50%;top: 50%;transform: translate(-50%,-50%);/* max-width: 750px;min-width: 320px; */}\r\n.tonglan_guanggao .boxs img{display: inline-block;width: 100%;}\r\n.tonglan_guanggao .boxs .close{width: .48rem;height: .48rem;background: url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1628562061688972/tonglan_close.png) no-repeat;background-size:100% 100%;position: absolute;right: 0;top: 0;}\r\n.tonglan_guanggao .boxs i{border-bottom-left-radius: .1rem;background: rgba(0, 0, 0, 0.7);height: .36rem;line-height: .36rem;font-size: .24rem;color: #FFFFFF;position: absolute;left: 0;bottom: 0;padding: 0 .12rem;}\r\n/*二级导航*/\r\n\r\n.rowScronav_ind02{/*padding: 0 0.2rem;overflow: hidden;height:1.08rem;*/padding-bottom: .3rem;}\r\n.rowScronav_ind02 .oneCeng{padding: 0 0.24rem;overflow: hidden;height:.69rem;}\r\n.rowScronav_ind02 .one{position:relative;/*line-height:1.1rem;*/}\r\n.rowScronav_ind02 .one ul.onelist{font-size: 0;white-space: nowrap;height: .5rem;margin-top: .19rem;}\r\n.rowScronav_ind02 .one ul.onelist li{cursor:pointer;display:inline-block;font-size:0.32rem;line-height:0.48rem;padding:0 .27rem;color:#ffffff;/*position:relative;overflow:visible;*/\r\nposition: relative;bottom: 0;padding-top: .05rem;}\r\n.rowScronav_ind02 .one ul.onelist li:first-child{padding-left:0;}\r\n.rowScronav_ind02 .one ul.onelist li.last{padding-right:0;}\r\n.rowScronav_ind02 .one ul.onelist li.cur{padding-top: 0;font-size: .36rem;font-weight: bold;}\r\n.rowScronav_ind02 .one ul.onelist li  a{color:#ffffff;}\r\n.rowScronav_ind02 .one ul.onelist li:first-child.cur:after{margin-left:-0.305rem;}\r\n.rowScronav_ind02 .one ul.onelist li:last-child.cur:after{margin-left:-0.095rem;}\r\n.rowScronav_ind02 .one ul.onelist li .nav{display:inline-block;position:relative;}\r\n.rowScronav_ind02 .one ul.onelist li .hot{display:block;position:absolute;top:-0.23rem;right:-0.48rem;padding:0 .05rem;text-align: center;background: #FF3C00;background-clip: padding-box;font-size: .18rem;color: #fff;font-weight: normal;line-height:0.3rem;height:0.3rem;overflow:hidden;border-top-left-radius: .1rem;border-bottom-right-radius: .1rem;}\r\n.rowScronav_ind02 .one ul.onelist li:first-child .hot{top:-0.19rem;}\r\n.rowScronav_ind02 .TwoCeng{border-bottom:1px solid #f4f4f4;}\r\n.rowScronav_ind02 .TwoCeng .wrapper{/*padding: 0 0.2rem;*/overflow: hidden;height:0.78rem;/*display: none;*/}\r\n.rowScronav_ind02 .Two .scroller{position: absolute;/*display:none;*/}\r\n.rowScronav_ind02 .Two .TwoCengGu{max-width:7.5rem;width:7.5rem;}\r\n.rowScronav_ind02 .Two ul.Twolist{padding-bottom:0.8rem;font-size: 0;white-space: nowrap; line-height:0.78rem;height: 0.78rem;}\r\n.rowScronav_ind02 .Two ul.Twolist li{display:inline-block;font-size:0.3rem;padding: 0 0.18rem;color:#333;line-height:0.78rem;}\r\n/*.rowScronav_ind02 .Two ul.Twolist li:first-child{padding-left:0rem;}*/\r\n.rowScronav_ind02 .Two ul.Twolist li:last-child{/*padding-right:0;*/}\r\n.rowScronav_ind02 .Two ul.Twolist li.cur{color:#e42626;position:relative;font-weight:bold;}\r\n.rowScronav_ind02 .Two ul.Twolist li a{color:#333;}\r\n.rowScronav_ind02 .Two ul.Twolist li.cur a{color:#e42626;}\r\n\r\n/*二级页分页效果*/\r\n\r\n.content_tabs{overflow:hidden;}\r\n.content_tabs .boxs{float:left;text-align: left;}\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n/*轮播图*/\r\n.xuqiu19629_lunbo{padding:0 0 0.15rem;}\r\n.xuqiu19629_lunbo .swiper-container{position:relative;/*padding:0 5.87%;*/padding:0 6%;}\r\n.xuqiu19629_lunbo .swiper-container .swiper-wrapper{position:relative;z-index:1;display:-webkit-box;display:-moz-box;display:-ms-flexbox;display:-webkit-flex;display:flex;-webkit-transition-property:-webkit-transform;-moz-transition-property:-moz-transform;-o-transition-property:-o-transform;-ms-transition-property:-ms-transform;transition-property:transform;-webkit-box-sizing:content-box;-moz-box-sizing:content-box;box-sizing:content-box;}\r\n.xuqiu19629_lunbo .swiper-container .swiper-wrapper a{display:block;position: relative;}\r\n.xuqiu19629_lunbo .swiper-container .swiper-wrapper img{font-size: 0;vertical-align: top;width:100%;height: auto;border-radius:.05rem;-webkit-border-radius:.05rem;}\r\n.xuqiu19629_lunbo .swiper-container .swiper-wrapper i{background:#e42626;border-radius:0.05rem;-webkit-border-radius:0.05rem;padding:0 0.06rem;line-height:0.36rem;font-size:0.22rem;color:#fff;font-style:normal;position:absolute;right:0.06rem;top:0.06rem;}\r\n.xuqiu19629_lunbo .swiper-container .swiper-wrapper .text{position:absolute;left:0;bottom:0;/* padding:0 0.8rem 0 0.2rem; */width:100%;height:0.69rem;border-bottom-left-radius: .1rem;border-bottom-right-radius: .1rem;overflow: hidden;}\r\n.xuqiu19629_lunbo .swiper-container .swiper-wrapper .text p{position: absolute;bottom: 0;left: 0;-webkit-box-sizing: border-box;box-sizing: border-box;width: 100%;padding:0 1rem 0 0.17rem;font-size:0.32rem;color:#ffffff;line-height: 0.69rem;overflow: hidden;text-overflow:ellipsis;white-space: nowrap;background: url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1628562061688972/lunbo_Bg.png) repeat-x;background-size: 100% 100%;}\r\n.xuqiu19629_lunbo .swiper-container .swiper-wrapper .swiper-slide.swiper-slide-prev{-webkit-transform: scale(0.93);-moz-transform: scale(0.93);transform: scale(0.93);}\r\n.xuqiu19629_lunbo .swiper-container .swiper-wrapper .swiper-slide.swiper-slide-next{-webkit-transform: scale(0.93);-moz-transform: scale(0.93);transform: scale(0.93);}\r\n.xuqiu19629_lunbo .swiper-container .swiper-wrapper .swiper-slide.swiper-slide-active{-webkit-transform: scale(1);-moz-transform: scale(1);transform: scale(1);}\r\n.xuqiu19629_lunbo .swiper-container .swiper-wrapper .swiper-slide.swiper-slide-active .tit{-webkit-transform: scale(1);-moz-transform: scale(1);transform: scale(1);}\r\n.xuqiu19629_lunbo .swiper-container .swiper-wrapper .swiper-slide.swiper-slide-duplicate-prev{-webkit-transform: scale(0.93);-moz-transform: scale(0.93);transform: scale(0.93);}\r\n.xuqiu19629_lunbo .swiper-container .swiper-wrapper .swiper-slide.swiper-slide-duplicate-next{-webkit-transform: scale(0.93);-moz-transform: scale(0.93);transform: scale(0.93);}\r\n.xuqiu19629_lunbo .swiper-container .swiper-wrapper .swiper-slide.swiper-slide-duplicate-active{-webkit-transform: scale(1);-moz-transform: scale(1);transform: scale(1);}\r\n.xuqiu19629_lunbo .swiper-container .swiper-wrapper .swiper-slide.swiper-slide-duplicate-active .tit{-webkit-transform: scale(1);-moz-transform: scale(1);transform: scale(1);}\r\n.xuqiu19629_lunbo .swiper-container .swiper-wrapper .swiper-slide{-webkit-flex-shrink:0;-ms-flex:0 0 auto;flex-shrink:0;width:100%;height: auto !important;margin:0 auto;position:relative;pointer-events:pointer;-webkit-backface-visibility:hidden;-moz-backface-visibility:hidden;-ms-backface-visibility:hidden;backface-visibility:hidden;z-index:1;-webkit-transition: transform 1.0s;-moz-transition: transform 1.0s;-ms-transition: transform 1.0s; -o-transition: transform 1.0s;transition: transform 1.0s;-webkit-transform: scale(0.93);-moz-transform: scale(0.93);transform: scale(0.93);}\r\n.xuqiu19629_lunbo .swiper-container .swiper-wrapper .swiper-slide .img{position:relative;width: 100%;border-radius: 0.1rem; background:url(http://p1.img.cctvpic.com/photoAlbum/templet/common/DEPA1504516146368634/750x420.jpg) no-repeat;background-size:100% 100%;overflow: hidden;}\r\n.xuqiu19629_lunbo .swiper-container .swiper-wrapper .swiper-slide .img span{border-top-right-radius: .1rem;background: rgba(0, 0, 0, 0.7);height: .36rem;line-height: .36rem;font-size: .24rem;color: #FFFFFF;position: absolute;right: 0;top: 0;padding: 0 .12rem;}\r\n.xuqiu19629_lunbo .swiper-pagination{position: absolute;right:.26rem;bottom:0.19rem;text-align:center;font-size:0.24rem;line-height:0.27rem;color: #ffffff;z-index:998;}\r\n.xuqiu19629_lunbo .swiper-pagination .swiper-pagination-current{color:#0084FF;font-size:0.4rem;line-height: .44rem;}\r\n\r\n\r\n\r\n\r\n\r\n/*推荐  样式2*/\r\n.xuqiu19629_ind01 {overflow: hidden;}\r\n.xuqiu19629_ind01 .swiper-container{/*border-bottom: 1px solid #f2f7fc;*//*padding-left:0.2rem;padding-right:0.2rem;*/margin:0 0.24rem;}\r\n.xuqiu19629_ind01 .swiper-container ul.swiper-wrapper { display: -webkit-box;display: -ms-flexbox; -webkit-box-pack: justify; -ms-flex-pack: justify;}\r\n.xuqiu19629_ind01 .swiper-container li.swiper-slide { width: 21.36%;margin-right: 2.85%;position: relative;}\r\n.xuqiu19629_ind01 .swiper-container li.swiper-slide:last-of-type{margin-right: 0;}\r\n.xuqiu19629_ind01 .swiper-container li.swiper-slide .img{position: relative;}\r\n.xuqiu19629_ind01 .swiper-container li p{color: #333333;font-size: 0.28rem;line-height: 0.48rem;overflow: hidden;text-overflow: ellipsis; display: -webkit-box;-webkit-line-clamp: 1; -webkit-box-orient: vertical;height: .4rem;text-align: center;}\r\n.xuqiu19629_ind01 .swiper-container li.swiper-slide img { width: 84%; display: block;margin:0 auto;}\r\n.xuqiu19629_ind01 .swiper-container li.swiper-slide span { width: 84%; display: block;margin:0 auto;background:url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1628562061688972/ind01_shadown.png);background-size:100%;display:flex;justify-content: center;align-items: center;}\r\n.xuqiu19629_ind01 .swiper-container li.swiper-slide span img{display: block;margin: 11.1%;box-sizing: border-box;}\r\n\r\n/*标题栏样式*/\r\n.top_tit{margin-left: .24rem;padding-left: .52rem;font-size: .4rem;line-height: .54rem;height: .56rem;padding-bottom: .22rem;}\r\n/*正在热播  样式2*/\r\n.top_tit.rb{background: url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1628562061688972/con01_icon.png) no-repeat left .08rem;background-size: .38rem .38rem;}\r\n.xuqiu19629_con01 {padding:0 0.24rem;}\r\n/* .xuqiu19629_con01 .swiper-container{border-bottom: 1px solid #f2f7fc;padding-left:0.2rem;padding-right:0.2rem;} */\r\n.xuqiu19629_con01 .swiper-container ul.swiper-wrapper { display: -webkit-box;display: -ms-flexbox; -webkit-box-pack: justify; -ms-flex-pack: justify;}\r\n.xuqiu19629_con01 .swiper-container li.swiper-slide { width: 30%;margin-right: 3.4%;position: relative;box-shadow: 0 1px .1rem rgba(0, 0, 0, 0.1);border-radius: .1rem;}\r\n.xuqiu19629_con01 .swiper-container li.swiper-slide:last-of-type{margin-right: 0;}\r\n.xuqiu19629_con01 .swiper-container li.swiper-slide .img{position: relative;}\r\n.xuqiu19629_con01 .swiper-container li.swiper-slide .img img{border-top-right-radius: .1rem;border-top-left-radius: .1rem;}\r\n.xuqiu19629_con01 .swiper-container li p{color: #333333;font-size: 0.28rem;line-height: 0.68rem;overflow: hidden;text-overflow: ellipsis; display: -webkit-box;-webkit-line-clamp: 1; -webkit-box-orient: vertical;height: .68rem;text-indent: .2rem;border-bottom-right-radius: .1rem;border-bottom-left-radius: .1rem;background: #FFFFFF;}\r\n\r\n\r\n/*今日热门*/\r\n.top_tit.rm{background: url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1628562061688972/con02_icon.png) no-repeat .04rem .08rem;background-size: .32rem .38rem;}\r\n.xuqiu19629_con02{padding:0 0.24rem;}\r\n.xuqiu19629_con02 ul{overflow: hidden;padding-right: .2rem;margin-right: -.2rem;}\r\n.xuqiu19629_con02 ul li{float:left;width:48.4%;box-shadow: 0 1px .1rem rgba(0, 0, 0, 0.1);margin-bottom: .2rem;display: none;border-radius: .1rem;background: #FFFFFF;vertical-align:middle;}\r\n.xuqiu19629_con02 ul li:nth-child(odd){margin-right: 3.2%;}\r\n.xuqiu19629_con02 ul li:nth-child(-n+4){display: block;}\r\n.xuqiu19629_con02 ul li .img{width: 100%;}\r\n.xuqiu19629_con02 ul li .img img{border-top-right-radius: .1rem;border-top-left-radius: .1rem;}\r\n.xuqiu19629_con02 ul li .text{border-bottom-right-radius: .1rem;border-bottom-left-radius: .1rem;padding: .19rem .2rem .0;font-size: .32rem;line-height: .45rem;color: #222222;height: .9rem;/*overflow: hidden;text-overflow: ellipsis; display: -webkit-box;-webkit-line-clamp: 2; -webkit-box-orient: vertical;*/margin-bottom: .23rem;}\r\n.xuqiu19629_con02 ul li .text p{overflow: hidden;text-overflow: ellipsis; display: -webkit-box;-webkit-line-clamp: 2; -webkit-box-orient: vertical;vertical-align: middle;align-self: center;}\r\n.xuqiu19629_con02 .change{position:relative;width: 100%;height: .8rem;background: #FFFFFF;text-align: center;border-radius: .1rem;box-shadow: 0 1px .1rem rgba(0, 0, 0, 0.1);}\r\n.xuqiu19629_con02 .change span{display: inline-block;height: .8rem;line-height: .8rem;color: #0084FF;padding-right: .07rem;font-size: .28rem;}\r\n.xuqiu19629_con02 .change i{position: absolute;top: 50%;margin-top: -0.18rem;width: 0.36rem;background: url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1628562061688972/con02_change.png) no-repeat center center;height: 0.36rem;background-size: 0.24rem 0.24rem;}\r\n .xuqiu19629_con02 .change i.active{-webkit-animation:play 0.4s 1;-moz-animation:play 0.4s 1;-ms-animation:play 0.4s 1;-o-animation:play 0.4s 1;animation:play 0.4s 1;}\r\n    \r\n    @-webkit-keyframes play{0% {-webkit-transform:rotate(0deg);}100% {-webkit-transform:rotate(360deg);}}\r\n\t@-moz-keyframes play{0% {-moz-transform:rotate(0deg);}100% {-moz-transform:rotate(360deg);}}\r\n\t@-o-keyframes play{0% {-o-transform:rotate(0deg);}100% {-o-transform:rotate(360deg);}}\r\n\t@-ms-keyframes play{0% {-ms-transform:rotate(0deg);}100% {-ms-transform:rotate(360deg);}}\r\n\t@keyframes play{0% {transform:rotate(0deg);}100% {transform:rotate(360deg);}}\r\n\r\n\r\n\r\n\r\n/*直播导视*/\r\n.top_tit.zb{background: url(//p5.img.cctvpic.com/photoAlbum/templet/common/DEPA1628562061688972/con03_icon.png) no-repeat .02rem .1rem;background-size: .36rem .34rem;}\r\n.xuqiu19629_con03{padding: 0 .24rem;overflow: hidden;margin-bottom: .26rem;}\r\n.xuqiu19629_con0