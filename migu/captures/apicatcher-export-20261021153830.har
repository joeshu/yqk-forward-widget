d\":\"8ea1ac60495344b98451c2d15a1770b9\",\"price\":\"\",\"recordNumber\":0,\"sc\":\"生活\",\"showStyle\":\"0\",\"skinColor\":\"\",\"source\":\"日出 承德\",\"startTime\":0,\"subTitle\":\"\",\"timeLineDate\":0,\"title\":\"日出金山岭长城\",\"trackId\":2515347,\"type\":0,\"videoLength\":\"00:00:22\",\"videoSetId\":\"\",\"vip_flag\":0,\"vsetType\":\"\",\"vtype\":\"1\"},{\"ad\":1,\"adid\":\"\",\"brief\":\"黄山是世界文化与自然遗产、世界地质公园……素以奇松、怪石、云海、温泉、冬雪“五绝”著称于世。\",\"cornerColour\":\"\",\"cornerStr\":\"\",\"cornerStrRb\":\"\",\"endTime\":0,\"epgChnlChar\":\"\",\"epgDarkDiamondPic\":\"\",\"epgDarkHorizontalPic\":\"\",\"epgDiamondPic\":\"\",\"epgHorizontalPic\":\"\",\"epgId\":0,\"epgName\":\"\",\"epgType\":\"\",\"fc\":\"原创\",\"homologous\":0,\"hoverText\":\"\",\"img1\":\"https://p2.img.cctvpic.com/apple3g/www/upload/image/20250305/1741162711383032944.jpg?q=75\",\"img2\":\"\",\"img3\":\"\",\"imgRGB\":\"#856553\",\"isTop\":0,\"is_media_account\":0,\"itemId\":\"\",\"itemUrl\":\"\",\"jumpUrl\":\"cntvcbox%3A%2F%2Fapp.cntv.cn%2FsingleVideo%3Fplayid%3D45cfc9152a3540fda8b4c1ca85e87000%26title%3D%25E9%25BB%2584%25E5%25B1%25B1%25E5%25A7%258B%25E4%25BF%25A1%25E6%2596%25B0%25E9%2581%2593%25E6%25B8%2585%25E6%2599%25A8%25E6%2597%25A5%25E5%2587%25BA%26vipFlag%3D0\",\"media_account_id\":\"\",\"mid\":\"\",\"playid\":\"45cfc9152a3540fda8b4c1ca85e87000\",\"price\":\"\",\"recordNumber\":0,\"sc\":\"生活\",\"showStyle\":\"\",\"skinColor\":\"\",\"source\":\"日出 安徽\",\"startTime\":0,\"subTitle\":\"\",\"timeLineDate\":0,\"title\":\"黄山始信新道清晨日出\",\"trackId\":2509787,\"type\":0,\"videoLength\":\"00:00:30\",\"videoSetId\":\"\",\"vip_flag\":0,\"vsetType\":\"\",\"vtype\":\"1\"},{\"ad\":1,\"adid\":\"\",\"brief\":\"南迦巴瓦峰，地处喜马拉雅山脉、念青唐古拉山脉和横断山脉的交会处，是中国西藏自治区林芝市最高的山，海拔7782米，属于喜马拉雅山脉，位于喜马拉雅山脉最东端。星空直播点位于林芝市索松村，处于海拔3000米的雅鲁藏布大峡谷中，面朝南迦巴瓦，雪山及星空观赏效果极佳。\",\"cornerColour\":\"\",\"cornerStr\":\"\",\"cornerStrRb\":\"\",\"endTime\":0,\"epgChnlChar\":\"\",\"epgDarkDiamondPic\":\"\",\"epgDarkHorizontalPic\":\"\",\"epgDiamondPic\":\"\",\"epgHorizontalPic\":\"\",\"epgId\":0,\"epgName\":\"\",\"epgType\":\"\",\"fc\":\"原创\",\"homologous\":0,\"hoverText\":\"\",\"img1\":\"https://p4.img.cctvpic.com/apple3g/www/upload/image/20250305/1741158384329085787.jpg?q=75\",\"img2\":\"\",\"img3\":\"\",\"imgRGB\":\"#856553\",\"isTop\":0,\"is_media_account\":0,\"itemId\":\"\",\"itemUrl\":\"\",\"jumpUrl\":\"cntvcbox%3A%2F%2Fapp.cntv.cn%2FsingleVideo%3Fplayid%3D21ecc939088740f2ba7a9fbd4762f926%26title%3D%25E5%258D%2597%25E8%25BF%25A6%25E5%25B7%25B4%25E7%2593%25A6%25E6%2598%259F%25E7%25A9%25BA%26vipFlag%3D0\",\"media_account_id\":\"\",\"mid\":\"\",\"playid\":\"21ecc939088740f2ba7a9fbd4762f926\",\"price\":\"\",\"recordNumber\":0,\"sc\":\"科教\",\"showStyle\":\"\",\"skinColor\":\"\",\"source\":\"南迦巴瓦 星空\",\"startTime\":0,\"subTitle\":\"\",\"timeLineDate\":0,\"title\":\"南迦巴瓦星空\",\"trackId\":2509786,\"type\":0,\"videoLength\":\"00:00:42\",\"videoSetId\":\"\",\"vip_flag\":0,\"vsetType\":\"\",\"vtype\":\"1\"},{\"ad\":1,\"adid\":\"\",\"brief\":\"“东极岛”是浙江省舟山市普陀区东极镇所辖的所有岛屿的总称，其地理上的正式名称应该是“中街山列岛”。身处大海，四周被东海包围，不仅有浓厚、古朴的渔家特色，更有那美不胜收的风光，它几乎包揽了真正意义上的阳光、碧海、岛礁、海味。东极岛位于中国大陆东端，太阳来得早，但如果是个好天气，那绝美的日出绝对让你大饱眼福。\",\"cornerColour\":\"\",\"cornerStr\":\"\",\"cornerStrRb\":\"\",\"endTime\":0,\"epgChnlChar\":\"\",\"epgDarkDiamondPic\":\"\",\"epgDarkHorizontalPic\":\"\",\"epgDiamondPic\":\"\",\"epgHorizontalPic\":\"\",\"epgId\":0,\"epgName\":\"\",\"epgType\":\"\",\"fc\":\"原创\",\"homologous\":0,\"hoverText\":\"\",\"img1\":\"https://p1.img.cctvpic.com/apple3g/www/upload/image/20241120/1732093517203042801.jpg?q=75\",\"img2\":\"\",\"img3\":\"\",\"imgRGB\":\"#856553\",\"isTop\":0,\"is_media_account\":0,\"itemId\":\"\",\"itemUrl\":\"\",\"jumpUrl\":\"cntvcbox%3A%2F%2Fapp.cntv.cn%2FsingleVideo%3Fplayid%3D5882d7b684a74d008e46f55ce94b0f88%26title%3D%25E6%2589%2593%25E5%258D%25A1%25E4%25B8%259C%25E6%259E%2581%25E5%25B2%259B%25E6%25B8%2585%25E6%2599%25A8%25E7%25BE%258E%25E6%2599%25AF%26vipFlag%3D0\",\"media_account_id\":\"\",\"mid\":\"\",\"playid\":\"5882d7b684a74d008e46f55ce94b0f88\",\"price\":\"\",\"recordNumber\":0,\"sc\":\"生活\",\"showStyle\":\"\",\"skinColor\":\"\",\"source\":\"舟山 日出\",\"startTime\":0,\"subTitle\":\"\",\"timeLineDate\":0,\"title\":\"打卡东极岛清晨美景\",\"trackId\":2495281,\"type\":0,\"videoLength\":\"00:00:22\",\"videoSetId\":\"\",\"vip_flag\":0,\"vsetType\":\"\",\"vtype\":\"1\"},{\"ad\":1,\"adid\":\"\",\"brief\":\"双龙桥，坐落于建水古城西5公里处，横跨泸江与塌冲两河交汇之水面上，因两河蜿蜒盘曲如双龙而得盛名；该桥清乾隆年间先建三孔，道光十九年（1839年）续建十四孔与原建三孔首尾相连、雁齿蝉联、合为一体，故又称“十七孔桥”，是我国古桥建筑艺术的佳作。2006年，双龙桥被国务院列为国家重点文物保护单位。\",\"cornerColour\":\"\",\"cornerStr\":\"\",\"cornerStrRb\":\"\",\"endTime\":0,\"epgChnlChar\":\"\",\"epgDarkDiamondPic\":\"\",\"epgDarkHorizontalPic\":\"\",\"epgDiamondPic\":\"\",\"epgHorizontalPic\":\"\",\"epgId\":0,\"epgName\":\"\",\"epgType\":\"\",\"fc\":\"原创\",\"homologous\":0,\"hoverText\":\"\",\"img1\":\"https://p1.img.cctvpic.com/apple3g/www/upload/image/20240529/1716970122260037146.jpg?q=75\",\"img2\":\"\",\"img3\":\"\",\"imgRGB\":\"#856553\",\"isTop\":0,\"is_media_account\":0,\"itemId\":\"\",\"itemUrl\":\"\",\"jumpUrl\":\"cntvcbox%3A%2F%2Fapp.cntv.cn%2FsingleVideo%3Fplayid%3D03723a7baa1544f0ad73d20a8a485eaa%26title%3D%25E5%259C%25A8%25E5%25BB%25BA%25E6%25B0%25B4%25E5%258F%258C%25E9%25BE%2599%25E6%25A1%25A5%25E6%2585%25A2%25E8%25A7%2582%25E4%25BA%2591%25E6%2599%25AF%26vipFlag%3D0\",\"media_account_id\":\"\",\"mid\":\"\",\"playid\":\"03723a7baa1544f0ad73d20a8a485eaa\",\"price\":\"\",\"recordNumber\":0,\"sc\":\"生活\",\"showStyle\":\"0\",\"skinColor\":\"\",\"source\":\"云南 红河\",\"startTime\":0,\"subTitle\":\"\",\"timeLineDate\":0,\"title\":\"在建水双龙桥慢观云景\",\"trackId\":2471644,\"type\":0,\"videoLength\":\"00:00:15\",\"videoSetId\":\"\",\"vip_flag\":0,\"vsetType\":\"\",\"vtype\":\"1\"},{\"ad\":1,\"adid\":\"\",\"brief\":\"在安徽黟县的卢村，静享宁静清晨是不可缺少的环节。如果能赶上日出，那会是个非常不错的体验。但如果云层遮蔽了艳阳也不必烦恼，云层舞动将会带给你全新的风景！\",\"cornerColour\":\"\",\"cornerStr\":\"\",\"cornerStrRb\":\"\",\"endTime\":0,\"epgChnlChar\":\"\",\"epgDarkDiamondPic\":\"\",\"epgDarkHorizontalPic\":\"\",\"epgDiamondPic\":\"\